---
import "../styles/global.css";
import { u } from "../lib/url";
import { detectLocale, t, altLocalePath, type Locale } from "../lib/i18n";

const {
  title = "Lu Zhang — Battery Scientist & Data Engineer",
  description = "Lu Zhang (张鲁), Ph.D. — Battery scientist with 14+ years at Argonne National Laboratory. R&D 100 Award (2014). 112 papers, 28 US patents, 178 collaborators. Now bridging electrochemistry and ML for industrial-scale energy storage.",
  ogImage,
} = Astro.props;

const pathname = Astro.url.pathname;
const locale: Locale = detectLocale(pathname);
const langPrefix = locale === "zh" ? "/zh" : "";
const altPath = altLocalePath(pathname, import.meta.env.BASE_URL);

const siteUrl = Astro.site?.href ?? "https://rockyzl.github.io/";
const baseUrl = (import.meta.env.BASE_URL ?? "/").replace(/\/+$/, "");
const canonicalUrl = new URL(pathname, siteUrl).href;
// Pages render under the base path (/lu-zhang-site/) but Astro.site is just the
// origin; ensure canonical points to the actual deployment.
const canonical = canonicalUrl;
const ogImageUrl = ogImage ?? "https://rockyzl.github.io/lu-zhang-site/og-default.png";

const nav = [
  { href: `${langPrefix}/about/`,        key: "nav.about" },
  { href: `${langPrefix}/publications/`, key: "nav.publications" },
  { href: `${langPrefix}/patents/`,      key: "nav.patents" },
  { href: `${langPrefix}/projects/`,     key: "nav.projects" },
  { href: `${langPrefix}/talks/`,        key: "nav.talks" },
  { href: `${langPrefix}/press/`,        key: "nav.press" },
  { href: `${langPrefix}/collaborators/`,key: "nav.collaborators" },
  { href: `${langPrefix}/awards/`,       key: "nav.awards" },
  { href: `${langPrefix}/reports/`,      key: "nav.reports" },
  { href: `${langPrefix}/teaching/`,     key: "nav.teaching" },
  { href: `${langPrefix}/ai/`,           key: "nav.ai" },
];
const isActive = (href) => pathname === u(href) || (href !== "/" && pathname.startsWith(u(href)));
const homeHref = locale === "zh" ? "/zh/" : "/";
---
<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Lu Zhang" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={pathname === u("/") || pathname === u("/zh/") ? "profile" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Lu Zhang" />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "zh" ? "en_US" : "zh_CN"} />
    <meta property="profile:first_name" content="Lu" />
    <meta property="profile:last_name" content="Zhang" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Hreflang for bilingual -->
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={new URL(altPath, siteUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(u("/"), siteUrl).href} />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23b8531a'/%3E%3Ctext x='32' y='44' font-family='Georgia' font-size='38' font-weight='600' fill='white' text-anchor='middle'%3EL%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Noto+Serif+SC:wght@400;500;600&display=swap"
    />

    <!-- JSON-LD Person schema (English locale only to avoid duplication) -->
    {locale === "en" && (pathname === u("/") || pathname === u("/about/")) && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Lu Zhang",
        alternateName: "张鲁",
        givenName: "Lu",
        familyName: "Zhang",
        honorificSuffix: "Ph.D.",
        jobTitle: "Data Science Engineer",
        worksFor: {
          "@type": "Organization",
          name: "American Academy of Orthopaedic Surgeons (AAOS)",
        },
        alumniOf: [
          { "@type": "EducationalOrganization", name: "Chinese Academy of Sciences" },
          { "@type": "EducationalOrganization", name: "Florida State University" },
          { "@type": "EducationalOrganization", name: "Shandong University" },
        ],
        affiliation: [
          { "@type": "Organization", name: "Argonne National Laboratory", sameAs: "https://www.anl.gov/" },
        ],
        award: [
          "R&D 100 Award (2014) — for redox-shuttle technology",
          "R&D 100 Award Finalist (2015)",
        ],
        knowsAbout: [
          "Redox flow batteries",
          "Lithium-ion electrolytes",
          "Silicon-anode binders",
          "Organic redox-active molecules",
          "Machine learning for materials discovery",
          "Electrochemistry",
          "Energy storage",
        ],
        url: "https://rockyzl.github.io/lu-zhang-site/",
        sameAs: [
          "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
          "https://github.com/rockyzl",
          "https://www.linkedin.com/in/rockyzl/",
          "https://www.anl.gov/profile/lu-zhang",
        ],
        email: "mailto:zhanglu77@gmail.com",
        description: "Battery scientist with 14+ years at Argonne National Laboratory. R&D 100 Award (2014). 112 peer-reviewed publications, 28 US patents, 4,700+ citations. Now bridging electrochemistry and ML for industrial-scale energy storage.",
      })} />
    )}
  </head>
  <body data-locale={locale}>
    <header class="site">
      <div class="inner">
        <a class="name" href={u(homeHref)}>Lu Zhang</a>
        <nav>
          {nav.map((n) => (
            <a href={u(n.href)} class={isActive(n.href) ? "active" : ""}>{t(n.key, locale)}</a>
          ))}
          <a class="lang-toggle" href={altPath} aria-label="Switch language">{locale === "zh" ? "EN" : "中"}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      © 2026 Lu Zhang ·
      <a href={u("/files/Lu_Zhang_CV.pdf")} target="_blank" rel="noopener">{locale === "zh" ? "下载简历 (PDF)" : "Download CV (PDF)"}</a> ·
      <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en">{t("footer.scholar", locale)}</a> ·
      <a href="https://github.com/rockyzl">{t("footer.github", locale)}</a> ·
      <a href="mailto:zhanglu77@gmail.com">{t("footer.email", locale)}</a>
    </footer>
  </body>
</html>

<style is:global>
  body[data-locale="zh"] {
    --font-serif: "Noto Serif SC", "Newsreader", "PingFang SC",
      "Hiragino Sans GB", "Microsoft YaHei", serif;
  }
  .lang-toggle {
    margin-left: 1.4rem;
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    font-size: 0.78rem !important;
    font-weight: 600 !important;
    color: var(--c-fg) !important;
  }
  .lang-toggle:hover { background: var(--c-bg-soft); color: var(--c-accent) !important; }
  @media (max-width: 760px) {
    .lang-toggle { margin-left: 0.5rem !important; flex-shrink: 0; }
  }
</style>
