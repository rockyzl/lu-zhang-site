---
import "../styles/global.css";
import { u } from "../lib/url";
import { detectLocale, t, altLocalePath, type Locale } from "../lib/i18n";
import ChatWidget from "../components/ChatWidget.astro";

const {
  title = "SciencesLoop — AI engineering for science and operations",
  description = "AI engineer building grounded, testable agents for science and operations, with a scientific foundation in electrochemical energy research.",
  ogImage,
  alternatePath,
} = Astro.props;

const pathname = Astro.url.pathname;
const locale: Locale = detectLocale(pathname);
const langPrefix = locale === "zh" ? "/zh" : "";
const altPath = alternatePath ?? altLocalePath(pathname, import.meta.env.BASE_URL);

const siteUrl = Astro.site?.href ?? "https://sciencesloop.com/";
const baseUrl = (import.meta.env.BASE_URL ?? "/").replace(/\/+$/, "");
const canonicalUrl = new URL(pathname, siteUrl).href;
// Pages render under the base path (/lu-zhang-site/) but Astro.site is just the
// origin; ensure canonical points to the actual deployment.
const canonical = canonicalUrl;
const publicOrigin = siteUrl.replace(/\/+$/, "");
const ogImageUrl = ogImage ?? `${publicOrigin}${u("/og-default.png")}`;

const homeHref = locale === "zh" ? "/zh/" : "/";
// Flat top nav — exactly 5 items. Every other page stays reachable through
// the Research Archive page (publications / patents / talks / reports / awards)
// and the About page (CV / mentorship / research archive).
const navItems = [
  { href: homeHref, key: "nav.home" },
  { href: `${langPrefix}/projects/`, key: "nav.projects" },
  { href: `${langPrefix}/agent/`, key: "nav.agent" },
  { href: `${langPrefix}/blog/`, key: "nav.blog" },
  { href: `${langPrefix}/about/`, key: "nav.about" },
];
const isActive = (href) => {
  const target = u(href);
  if (href === homeHref) return pathname === target;
  return pathname === target || pathname.startsWith(target);
};
---
<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Lu Zhang" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="SciencesLoop Field Notes RSS" href={new URL(u("/rss.xml"), siteUrl).href} />

    <!-- Open Graph -->
    <meta property="og:type" content={pathname === u("/") || pathname === u("/zh/") ? "profile" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SciencesLoop" />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "zh" ? "en_US" : "zh_CN"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lu Zhang — AI engineer building grounded, testable agents for science and operations" />
    <meta property="profile:first_name" content="Lu" />
    <meta property="profile:last_name" content="Zhang" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Hreflang for bilingual -->
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={new URL(altPath, siteUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(u("/"), siteUrl).href} />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230d7361'/%3E%3Ctext x='32' y='45' font-family='ui-monospace, Menlo, monospace' font-size='38' font-weight='700' fill='white' text-anchor='middle'%3EL%3C/text%3E%3C/svg%3E" />
    <!-- The redesign uses only system + monospace font stacks — no webfont/CDN requests. -->

    <!-- JSON-LD Person schema (English locale only to avoid duplication) -->
    {locale === "en" && (pathname === u("/") || pathname === u("/about/")) && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Lu Zhang",
        alternateName: "张鲁",
        givenName: "Lu",
        familyName: "Zhang",
        honorificSuffix: "Ph.D.",
        jobTitle: "AI Engineer · Scientific Systems Builder",
        alumniOf: [
          { "@type": "EducationalOrganization", name: "Chinese Academy of Sciences" },
          { "@type": "EducationalOrganization", name: "Florida State University" },
          { "@type": "EducationalOrganization", name: "Shandong University" },
        ],
        award: [
          "R&D 100 Award (2014) — for redox-shuttle technology",
          "R&D 100 Award Finalist (2015)",
        ],
        knowsAbout: [
          "Redox flow batteries",
          "Lithium-ion electrolytes",
          "Silicon-anode binders",
          "Organic redox-active molecules",
          "Machine learning for materials discovery",
          "Electrochemistry",
          "Energy storage",
        ],
        url: publicOrigin,
        sameAs: [
          "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
          "https://github.com/rockyzl",
          "https://www.linkedin.com/in/lu-zhang-argonne/",
          "https://www.anl.gov/profile/lu-zhang",
        ],
        email: "mailto:zhanglu77@gmail.com",
        description: "AI engineer building grounded, testable agents for science and operations, with a scientific foundation in electrochemical energy research. Former Argonne battery scientist, now building retrieval-grounded, evaluation-driven agent systems with explicit safety boundaries.",
      })} />
    )}
  </head>
  <body data-locale={locale}>
    <header class="site">
      <div class="inner">
        <a class="name" href={u(homeHref)}><span class="brand-loop" aria-hidden="true"></span>SciencesLoop</a>
        <nav>
          {navItems.map((n) => (
            <a href={u(n.href)} class={isActive(n.href) ? "active" : ""}>
              {t(n.key, locale)}
            </a>
          ))}
          <a class="lang-toggle" href={altPath} aria-label="Switch language">{locale === "zh" ? "EN" : "中"}</a>
        </nav>
        <span class="avail"><span class="dot" aria-hidden="true"></span>{t("nav.availability", locale)}</span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      © 2026 SciencesLoop · Lu Zhang ·
      <a href={u("/files/Lu_Zhang_CV.pdf")} target="_blank" rel="noopener">{locale === "zh" ? "学术 CV (PDF)" : "Academic CV (PDF)"}</a> ·
      <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en">{t("footer.scholar", locale)}</a> ·
      <a href="https://github.com/rockyzl">{t("footer.github", locale)}</a> ·
      <a href={u(locale === "zh" ? "/zh/privacy/" : "/privacy/")}>{locale === "zh" ? "隐私政策" : "Privacy"}</a> ·
      <a href={u(locale === "zh" ? "/zh/terms/" : "/terms/")}>{locale === "zh" ? "短信条款" : "SMS Terms"}</a> ·
      <a href={u("/property-sms/")}>{locale === "zh" ? "短信同意" : "SMS Consent"}</a> ·
      <a href="mailto:zhanglu77@gmail.com">{t("footer.email", locale)}</a>
    </footer>
    <ChatWidget locale={locale} />
  </body>
</html>

<style is:global>
  /* zh locale: keep a CJK-capable sans stack (the redesign is sans-only, no
     external webfonts). --font-serif is aliased to sans site-wide, so we point
     both at a system CJK sans so headings and body render crisply. */
  body[data-locale="zh"] {
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
      "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", Roboto, sans-serif;
    --font-serif: var(--font-sans);
  }
</style>
