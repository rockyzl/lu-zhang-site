---
import "../styles/global.css";
import { u } from "../lib/url";
import { detectLocale, altLocalePath, type Locale } from "../lib/i18n";

const {
  title = "SciencesLoop — Evidence-gated scientific workflows",
  description = "SciencesLoop builds evidence-gated scientific workflow software for brownfield laboratories, starting with electrochemistry.",
  ogImage,
  alternatePath,
} = Astro.props;

const pathname = Astro.url.pathname;
const locale: Locale = detectLocale(pathname);
const langPrefix = locale === "zh" ? "/zh" : "";
const altPath = alternatePath ?? altLocalePath(pathname, import.meta.env.BASE_URL);
const siteUrl = Astro.site?.href ?? "https://sciencesloop.com/";
const canonical = new URL(pathname, siteUrl).href;
const publicOrigin = siteUrl.replace(/\/+$/, "");
const ogImageUrl = ogImage ?? `${publicOrigin}${u("/og-default.png")}`;

const labels = locale === "zh"
  ? { home: "首页", approach: "方法", evidence: "证据", applications: "应用", notes: "研究笔记", founder: "创始人" }
  : { home: "Home", approach: "Approach", evidence: "Evidence", applications: "Applications", notes: "Notes", founder: "Founder" };

const homeHref = locale === "zh" ? "/zh/" : "/";
const navItems = [
  { href: homeHref, label: labels.home },
  { href: `${langPrefix}/approach/`, label: labels.approach },
  { href: `${langPrefix}/evidence/`, label: labels.evidence },
  { href: `${langPrefix}/applications/`, label: labels.applications },
  { href: `${langPrefix}/blog/`, label: labels.notes },
  { href: `${langPrefix}/research-archive/`, label: labels.founder },
];

const isActive = (href: string) => {
  const target = u(href);
  if (href === homeHref) return pathname === target;
  return pathname === target || pathname.startsWith(target);
};

const isHome = pathname === u("/") || pathname === u("/zh/");
const isAbout = pathname === u("/about/");
// Vercel provides VERCEL_ENV at build time. Keep local and production builds
// indexable; only preview/development Vercel artifacts receive noindex.
const isNonProductionVercel = Boolean(process.env.VERCEL_ENV && process.env.VERCEL_ENV !== "production");
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SciencesLoop LLC",
  url: publicOrigin,
  email: "mailto:luzhang@sciencesloop.com",
  founder: { "@type": "Person", name: "Lu Zhang" },
  description: "Evidence-gated scientific workflow software for brownfield laboratories, starting with electrochemistry.",
};
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lu Zhang",
  alternateName: "张鲁",
  jobTitle: "Founder, SciencesLoop",
  url: `${publicOrigin}${u("/about/")}`,
  email: "mailto:luzhang@sciencesloop.com",
  sameAs: [
    "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
    "https://github.com/rockyzl",
    "https://www.linkedin.com/in/lu-zhang-argonne/",
  ],
};
---
<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="SciencesLoop" />
    {isNonProductionVercel && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="SciencesLoop Notes RSS" href={new URL(u("/rss.xml"), siteUrl).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SciencesLoop" />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "zh" ? "en_US" : "zh_CN"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SciencesLoop evidence-gated scientific workflow interface" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="alternate" hreflang={locale === "zh" ? "zh-CN" : "en"} href={canonical} />
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={new URL(altPath, siteUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(u("/"), siteUrl).href} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230b2631'/%3E%3Cpath d='M18 19h28v7H25v8h18v7H25v10h-7z' fill='%232db89a'/%3E%3C/svg%3E" />

    {locale === "en" && isHome && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
    {locale === "en" && isAbout && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
  </head>
  <body data-locale={locale}>
    <header class="site">
      <div class="inner">
        <a class="name" href={u(homeHref)} aria-label="SciencesLoop home"><span class="brand-loop" aria-hidden="true"></span>SciencesLoop</a>
        <nav aria-label={locale === "zh" ? "主导航" : "Primary navigation"}>
          {navItems.map((item) => (
            <a href={u(item.href)} class={isActive(item.href) ? "active" : ""} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
          <a class="lang-toggle" href={altPath} aria-label={locale === "zh" ? "Switch to English" : "切换到中文"}>{locale === "zh" ? "EN" : "中"}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site company-footer">
      <span>© 2026 SciencesLoop LLC</span>
      <span aria-hidden="true">·</span>
      <a href="mailto:luzhang@sciencesloop.com">luzhang@sciencesloop.com</a>
      <span aria-hidden="true">·</span>
      <a href={u(locale === "zh" ? "/zh/privacy/" : "/privacy/")}>{locale === "zh" ? "隐私" : "Privacy"}</a>
    </footer>
  </body>
</html>

<style is:global>
  body[data-locale="zh"] {
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", Roboto, sans-serif;
    --font-serif: var(--font-sans);
  }
</style>
