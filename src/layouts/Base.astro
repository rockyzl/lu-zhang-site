---
import "../styles/global.css";
import { u } from "../lib/url";
const { title = "Lu Zhang", description = "Battery scientist & data engineer." } = Astro.props;
const pathname = Astro.url.pathname;
const nav = [
  { href: "/about/", label: "About" },
  { href: "/publications/", label: "Publications" },
  { href: "/patents/", label: "Patents" },
  { href: "/projects/", label: "Projects" },
  { href: "/talks/", label: "Talks" },
  { href: "/press/", label: "Press" },
  { href: "/ai/", label: "AI" },
];
const isActive = (href) => pathname === u(href) || (href !== "/" && pathname.startsWith(u(href)));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23b8531a'/%3E%3Ctext x='32' y='44' font-family='Georgia' font-size='38' font-weight='600' fill='white' text-anchor='middle'%3EL%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap"
    />
  </head>
  <body>
    <header class="site">
      <div class="inner">
        <a class="name" href={u("/")}>Lu Zhang</a>
        <nav>
          {nav.map((n) => (
            <a href={u(n.href)} class={isActive(n.href) ? "active" : ""}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      © 2026 Lu Zhang ·
      <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en">Google Scholar</a> ·
      <a href="https://github.com/rockyzl">GitHub</a> ·
      <a href="mailto:zhanglu77@gmail.com">Email</a>
    </footer>
  </body>
</html>
