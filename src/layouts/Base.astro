---
import "../styles/global.css";
import { u } from "../lib/url";
import { detectLocale, altLocalePath, type Locale } from "../lib/i18n";
import ChatWidget from "../components/ChatWidget.astro";

const {
  title = "SciencesLoop — Evidence-gated scientific workflows",
  description = "SciencesLoop builds evidence-gated scientific workflow software for brownfield laboratories, starting with electrochemistry.",
  ogImage,
  alternatePath,
} = Astro.props;

const pathname = Astro.url.pathname;
const locale: Locale = detectLocale(pathname);
const enableChineseSite = import.meta.env.PUBLIC_ENABLE_ZH === "true";
const isHiddenLocale = locale === "zh" && !enableChineseSite;
const langPrefix = locale === "zh" ? "/zh" : "";
const altPath = alternatePath ?? altLocalePath(pathname, import.meta.env.BASE_URL);
const siteUrl = Astro.site?.href ?? "https://sciencesloop.com/";
const canonical = new URL(pathname, siteUrl).href;
const publicOrigin = siteUrl.replace(/\/+$/, "");
const ogImageUrl = ogImage ?? `${publicOrigin}${u("/og-default.png")}`;

const labels = locale === "zh"
  ? { platform: "平台", electrochemistry: "电化学", lab: "实验室", notes: "研究笔记", about: "关于", loop: "探索循环", pilot: "讨论试点" }
  : { platform: "Platform", electrochemistry: "Electrochemistry", lab: "Lab", notes: "Field Notes", about: "About", loop: "Explore the Loop", pilot: "Discuss a Pilot" };

const homeHref = locale === "zh" ? "/zh/" : "/";
const navItems = [
  { href: `${homeHref}#platform`, label: labels.platform },
  { href: `${homeHref}#electrochemistry`, label: labels.electrochemistry },
  { href: `${langPrefix}/lab/`, label: labels.lab },
  { href: `${langPrefix}/blog/`, label: labels.notes },
  { href: `${langPrefix}/about/`, label: labels.about },
];

const isActive = (href: string) => {
  if (href.includes("#")) return false;
  const target = u(href);
  if (href === homeHref) return pathname === target;
  return pathname === target || pathname.startsWith(target);
};

const isHome = pathname === u("/") || pathname === u("/zh/");
const isAbout = pathname === u("/about/");
// Vercel provides VERCEL_ENV at build time. Keep local and production builds
// indexable; only preview/development Vercel artifacts receive noindex.
const isNonProductionVercel = Boolean(process.env.VERCEL_ENV && process.env.VERCEL_ENV !== "production");
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SciencesLoop LLC",
  url: publicOrigin,
  email: "mailto:luzhang@sciencesloop.com",
  founder: { "@type": "Person", name: "Lu Zhang" },
  description: "Evidence-gated scientific workflow software for brownfield laboratories, starting with electrochemistry.",
};
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lu Zhang",
  alternateName: "张鲁",
  jobTitle: "Founder, SciencesLoop",
  url: `${publicOrigin}${u("/about/")}`,
  email: "mailto:luzhang@sciencesloop.com",
  sameAs: [
    "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
    "https://github.com/rockyzl",
    "https://www.linkedin.com/in/lu-zhang-argonne/",
  ],
};
---
<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="SciencesLoop" />
    {(isNonProductionVercel || isHiddenLocale) && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="SciencesLoop Notes RSS" href={new URL(u("/rss.xml"), siteUrl).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SciencesLoop" />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    {enableChineseSite && <meta property="og:locale:alternate" content={locale === "zh" ? "en_US" : "zh_CN"} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SciencesLoop evidence-gated scientific workflow interface" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {!isHiddenLocale && <link rel="alternate" hreflang={locale === "zh" ? "zh-CN" : "en"} href={canonical} />}
    {enableChineseSite && <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={new URL(altPath, siteUrl).href} />}
    {!isHiddenLocale && <link rel="alternate" hreflang="x-default" href={new URL(u("/"), siteUrl).href} />}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230b2631'/%3E%3Cpath d='M18 19h28v7H25v8h18v7H25v10h-7z' fill='%232db89a'/%3E%3C/svg%3E" />

    {locale === "en" && isHome && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
    {locale === "en" && isAbout && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
  </head>
  <body data-locale={locale} class={isHome ? "page-home" : undefined}>
    <header class="site">
      <div class="inner">
        <a class="name" href={u(homeHref)} aria-label={locale === "zh" ? "SciencesLoop 首页" : "SciencesLoop home"}>
          <svg class="brand-mark" viewBox="0 0 30 30" aria-hidden="true">
            <circle cx="15" cy="15" r="12.5"></circle>
            <path d="M4 16.5h5l2.1-6 3.4 11 2.8-8 2.1 3h6.6"></path>
          </svg>
          <span>SciencesLoop</span>
        </a>
        <nav aria-label={locale === "zh" ? "主导航" : "Primary navigation"}>
          <span class="nav-core">
            {navItems.map((item) => (
              <a href={u(item.href)} class={isActive(item.href) ? "active" : ""} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
            ))}
          </span>
          {enableChineseSite && <a class="lang-toggle" href={altPath} aria-label={locale === "zh" ? "Switch to English" : "切换到中文"}>{locale === "zh" ? "EN" : "中"}</a>}
          <a class="nav-loop" href={u(`${homeHref}#loop`)}>{labels.loop}</a>
          <a class="nav-contact" href="mailto:luzhang@sciencesloop.com?subject=SciencesLoop%20pilot%20discussion">{labels.pilot}<span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site company-footer">
      <div class="company-footer__inner">
        <div class="company-footer__identity">
          <span class="company-footer__name">SciencesLoop LLC</span>
          <p>{locale === "zh" ? "为现有实验室开发证据门控的科学工作流软件。" : "Evidence-gated scientific workflow software for existing laboratories."}</p>
        </div>
        <nav aria-label={locale === "zh" ? "页脚导航" : "Footer navigation"}>
          {navItems.map((item) => <a href={u(item.href)}>{item.label}</a>)}
          <a href={u(locale === "zh" ? "/zh/privacy/" : "/privacy/")}>{locale === "zh" ? "隐私" : "Privacy"}</a>
        </nav>
        <div class="company-footer__contact">
          <span>{locale === "zh" ? "试点交流" : "Pilot conversations"}</span>
          <a href="mailto:luzhang@sciencesloop.com">luzhang@sciencesloop.com</a>
        </div>
        <div class="company-footer__legal">© 2026 SciencesLoop LLC</div>
      </div>
    </footer>
    <ChatWidget locale={locale} />
  </body>
</html>

<style is:global>
  body[data-locale="zh"] {
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", Roboto, sans-serif;
    --font-serif: var(--font-sans);
  }
</style>
