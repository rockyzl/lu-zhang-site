---
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en" } = Astro.props as { locale?: Locale };

// The demo itself (headline, chart, takeaways, collapsed example, links) is a
// self-contained page hosted same-origin in public/demos/. Keep this wrapper thin.
const demoHref = u("/demos/preventive-health-model-lab.html");
const repoHref = "https://github.com/rockyzl/preventive-health-model-lab";
const spaceHref = "https://huggingface.co/spaces/rockyaaos/preventive-health-model-lab";
const agentHref = u("/agent/");

const copy = locale === "zh"
  ? {
      eyebrow: "微调研究 · 8GB 单卡 QLoRA",
      title: "微调开源医疗大模型做安全的健康趋势推理",
      lead: "同任务、同合成数据、同配方微调 Gemma 3 和它的医疗版 MedGemma。看下面一眼就懂:微调修好了什么,以及“医疗”模型是不是真的更强。",
      open: "全屏打开 ↗",
      repoLabel: "代码与完整论述 →",
      spaceLabel: "Hugging Face ↗",
      backLabel: "← 返回 Agent demo 列表",
    }
  : {
      eyebrow: "Fine-tuning study · QLoRA on one 8GB GPU",
      title: "Fine-tuning open medical LLMs for safe health-trend reasoning",
      lead: "Same task, same synthetic data, same recipe on Gemma 3 and its medical sibling MedGemma. The demo below shows, at a glance, what fine-tuning fixed — and whether a “medical” model is actually better.",
      open: "Open full screen ↗",
      repoLabel: "Code & full write-up →",
      spaceLabel: "Hugging Face ↗",
      backLabel: "← Back to the agent demos",
    };
---

<section class="ph-demo">
  <p class="ph-eyebrow">{copy.eyebrow}</p>
  <h1 class="ph-title">{copy.title}</h1>
  <p class="ph-lead">{copy.lead}</p>

  <div class="ph-frame-wrap">
    <iframe src={demoHref} title="Preventive Health Model Lab — results" loading="lazy"></iframe>
  </div>

  <p class="ph-links">
    <a href={demoHref} target="_blank" rel="noopener">{copy.open}</a>
    <a href={repoHref} target="_blank" rel="noopener">{copy.repoLabel}</a>
    <a href={spaceHref} target="_blank" rel="noopener">{copy.spaceLabel}</a>
  </p>
  <p class="ph-back"><a href={agentHref}>{copy.backLabel}</a></p>
</section>

<style>
  .ph-demo { max-width: 900px; margin: 0 auto; }
  .ph-eyebrow {
    font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent, #14655f); font-weight: 700; margin: 0 0 6px;
  }
  .ph-title { margin: 0 0 10px; }
  .ph-lead { max-width: 68ch; color: var(--muted, #5f6f7a); margin: 0 0 18px; }
  .ph-frame-wrap {
    border: 1px solid var(--line, #e3e8ea); border-radius: 12px;
    overflow: hidden; background: var(--card, #fff);
  }
  .ph-frame-wrap iframe { display: block; width: 100%; height: 1000px; border: 0; }
  .ph-links { display: flex; gap: 20px; flex-wrap: wrap; margin: 14px 0 0; }
  .ph-back { margin-top: 12px; }
  @media (max-width: 760px) {
    .ph-frame-wrap iframe { height: 1180px; }
  }
</style>
