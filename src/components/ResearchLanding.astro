---
import { u } from '../lib/url';
import '../styles/landing.css';
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const t = (en: string, cn: string) => zh ? cn : en;
const lp = zh ? '/zh' : '';
const services = [
 { id:'knowledge', need:t('Where did this result come from?','一个结果背后的数据和记录在哪里？'), short:t('Trace the evidence','追溯研究证据'), title:t('Find the evidence behind a result','找到结果背后的研究证据'), description:t("A plot alone rarely tells the full story. Link a result to its sample, measurement conditions, lab notes, and source files so a researcher can check how it was produced.",'单看一张曲线，很难知道结果是怎么来的。把结果与样品、测试条件、实验笔记和原始文件关联起来，让研究者能回头核对。'), outcome:t('A searchable set of selected results, with links to the original records and the context available for each one.','一组可检索的研究结果，附有原始记录链接和目前可获得的实验背景。'), tags:[t('Literature & reports','文献与报告'),t('Experimental records','实验记录'),t('Source-linked records','来源关联记录')] },
 { id:'analysis', need:t('Why did these two experiments differ?','两次实验结果不同，原因可能在哪？'), short:t('Compare experiments','对照两次实验'), title:t('Compare conditions before explaining a difference','先核对实验条件，再解释结果差异'), description:t('Put two runs side by side. Check sample identity, formulation, settings, and missing records before deciding which difference deserves another test.','把两次实验放在一起，对照样品、配方和测试设置，标出缺失的记录，再判断哪处差异值得进一步测试。'), outcome:t('A conditions comparison, missing-information checklist, and proposed next steps for researcher review.','一份实验条件对照、待补信息清单，以及供研究者审阅的后续调查建议。'), tags:[t('Data comparison','数据对比'),t('Scientific context','科学背景'),t('Follow-up planning','后续验证')] },
 { id:'workflow', need:t("A result is in. What happens next?",'数据测完了，下一步却还没定。'), short:t('Move to the next test','推进下一次测试'), title:t('Turn a measured result into a reviewable next step','让测量结果变成可审阅的下一步'), description:t('Take one instrument export through analysis and a researcher review. Keep the result, checks, and proposed follow-up together, rather than piecing them back together from separate files.','从一次仪器导出开始，接上分析和研究者审阅，把结果、核查项与后续实验建议留在同一条记录中，不必再从多个文件里拼凑。'), outcome:t('A scoped pilot showing one measured result, its analysis and checks, and a follow-up proposal for researcher approval.','一个聚焦试点，展示一次测量结果、分析与核查过程，以及供研究者批准的后续实验建议。'), tags:[t('Existing tools','现有工具'),t('Workflow integration','流程衔接'),t('Team collaboration','团队协作')] }
];
const steps = [
 [t('Find the right starting point','找到值得先解决的问题'), t('We map one research bottleneck: what your team is trying to decide, where information gets lost, and which data and tools are available. Together, we define a useful first outcome.','从一个具体科研瓶颈开始：团队需要做什么判断，信息在哪里断开，手头有哪些数据和工具。一起明确第一阶段应当得到的结果。')],
 [t('Connect a focused workflow','围绕一个流程开展试点'), t('We agree on a bounded pilot around selected records, analysis tools, and review steps. Integration and feasibility are assessed for your setup.','选择一组记录、分析工具和审核步骤，约定清晰的试点范围，并结合实际环境评估数据衔接与实施可行性。')],
 [t('Evaluate before expanding','先评估，再决定是否扩展'), t('Agree on checks such as source traceability, researcher-reviewed comparisons, and manual handoffs relative to your current workflow. Review the results and limitations before deciding whether to expand.','事先约定检查方式，例如来源能否追溯、对比结果能否由研究者复核、手动衔接步骤相比原流程有何变化。评估结果与局限，再决定是否扩展。')]
];
const title = t('SciencesLoop — Connected intelligence for science','SciencesLoop — 连接科研知识、数据与工具 · 张鲁 Lu Zhang');
const description = t('Connect scientific knowledge, experimental data, and research tools. Explore focused AI workflow pilots for materials and electrochemistry R&D.','连接科学知识、实验数据与研究工具，围绕材料和电化学研发中的具体问题开展 AI 工作流程试点。');
const origin = Astro.site ?? new URL('https://sciencesloop.com');
const canonical = new URL(u(`${lp}/`),origin).href;
const links = [['/projects/',t('Selected work','项目实践')],['/lab/',t('Research lab','研究实验室')],['/blog/',t('Field notes','研究笔记')],['/research-archive/',t('Research archive','科研档案')],['/about/',t('About the founder','关于创始人')]];
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={new URL(u('/'),origin).href}/><link rel="alternate" hreflang="zh-CN" href={new URL(u('/zh/'),origin).href}/><link rel="alternate" hreflang="x-default" href={new URL(u('/'),origin).href}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="SciencesLoop"/><meta property="og:image" content={new URL(u('/og-default.png'),origin).href}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(u('/og-default.png'),origin).href}/><link rel="icon" href={u('/images/landing-mark.svg')}/><link rel="alternate" type="application/rss+xml" title="SciencesLoop Field Notes" href={u('/rss.xml')}/></head>
<body>
<noscript><style>.need-list,.replay-button,.mobile-menu-button{display:none!important}.service-panel[data-state=inactive]{display:grid!important}.service-panel{padding-bottom:35px} @media(max-width:760px){.service-panel[data-state=inactive]{display:flex!important}}</style></noscript>
<a class="skip-link" href="#main">{t('Skip to content','跳到正文')}</a>
<header class="site-header"><a href={u(`${lp}/`)} class="wordmark" aria-label="SciencesLoop">sciences<span>loop</span><b>.</b></a><div class="nav-group"><nav class="desktop-nav" aria-label={t('Main navigation','主导航')}><a href="#solutions">{t('What we do','我们做什么')}</a><a href="#approach">{t('How we work','如何合作')}</a><a class="nav-cta" href="#start">{t('Start a conversation','聊聊你的需求')} ↗</a></nav><a class="language-link" href={u(zh ? '/' : '/zh/')} lang={zh ? 'en' : 'zh-CN'}>{zh ? 'EN' : '中文'}</a><button class="mobile-menu-button" aria-label={t('Toggle navigation','展开或收起导航')} aria-controls="mobile-nav" aria-expanded="false">☰</button></div></header>
<nav id="mobile-nav" class="mobile-nav" hidden aria-label={t('Mobile navigation','移动导航')}><a href="#solutions">{t('What we do','我们做什么')}</a><a href="#approach">{t('How we work','如何合作')}</a><a href="#start">{t('Start a conversation','聊聊你的需求')}</a></nav>
<main id="main">
<section class="hero shell" aria-labelledby="hero-title"><div class="hero-kicker"><span class="eyebrow">{t('CONNECTED INTELLIGENCE FOR SCIENCE','连接科研中的知识、数据与工具')}</span><span class="hero-index">{t('KNOWLEDGE / ANALYSIS / WORKFLOWS','知识 / 分析 / 工作流程')}</span></div><div class="hero-layout"><h1 id="hero-title">{t('From experiment data','从实验结果，')}<br/><em>{t('to the next decision.','走向有依据的下一步。')}</em></h1><div class="hero-copy"><p>{t('Trace where a result came from, compare it with earlier experiments, and decide what to test next. We build focused workflows around the records and tools your team already uses.','追溯一个结果的来源，对照已有实验，再决定下一步测什么。我们围绕团队现有的记录和工具，搭建聚焦的科研工作流程。')}</p><a class="button button-dark" href="#solutions">{t('Find your starting point','找到你的起点')} ↓</a><span class="hero-audience">{t('Focused workflow pilots for materials and electrochemistry R&D. Scope and feasibility agreed with your team.','面向材料与电化学研发的工作流程试点，与团队共同确定范围和可行性。')}</span></div></div><div class="hero-image-wrap"><img class="hero-image" src={u('/images/research-hero.webp')} alt={t('Conceptual materials research image of glass sample vessels in warm light','暖色光线中的玻璃样品容器，科研概念配图')} width="1536" height="1024" fetchpriority="high"/><div class="image-overlay"></div><div class="image-caption"><span>{t('FROM ISOLATED PIECES','从分散的资料')}</span><span>{t('TO A CONNECTED RESEARCH PICTURE.','到连贯的研究全貌。')}</span></div><span class="image-credit">{t('Concept image','概念配图')}</span></div><div class="hero-service-links">{services.map((s,i)=><a href="#solutions" data-jump={s.id}><span>0{i+1}</span>{s.short} ↓</a>)}</div></section>
<section class="solutions shell" id="solutions" aria-labelledby="solutions-title"><div class="section-heading"><div><span class="eyebrow">{t('01 — WHAT WE DO','01 — 我们做什么')}</span><h2 id="solutions-title">{t('When research gets stuck,','科研卡住的时候，')}<br/><em>{t('find the next question.','先找对下一步问题。')}</em></h2></div><p>{t('Choose the moment your team loses the thread: finding evidence, comparing tests, or moving a result toward the next experiment.','从最容易断线的地方开始：追溯证据、对照实验，或把结果推进到下一次测试。')}</p></div>
<div class="solutions-tabs"><div class="need-list" data-slot="tabs-list" role="tablist" aria-orientation="horizontal" aria-label={t('Choose a research challenge','选择科研中的难题')}>{services.map((s,i)=><button type="button" role="tab" class="need-button" data-slot="tabs-trigger" data-state={i===0?'active':'inactive'} id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-service={s.id}><span class="need-number">0{i+1}</span><span class="need-title">{s.need}</span><span class="need-arrow" aria-hidden="true">↗</span></button>)}</div>
{services.map((s,i)=><div class="service-panel" data-slot="tabs-content" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} tabindex="0" data-state={i===0?'active':'inactive'} ><div class="service-narrative"><h3>{s.title}</h3><p>{s.description}</p><div class="service-tags">{s.tags.map(tag=><span>{tag}</span>)}</div><div class="outcome"><span>{t('WHAT YOU WALK AWAY WITH','你能获得什么')}</span><p>{s.outcome}</p></div><a href="#start" class="text-link">{t('Explore a focused pilot','讨论一个具体试点')} ↗</a></div><div class="scene"><div class="scene-header"><span>{t('SCIENTIFIC WORK, CONNECTED','把科研工作连接起来')}</span><button class="replay-button" type="button" aria-label={t(`Replay: ${s.title}`,`重播：${s.title}`)}>↻ {t('Replay','重播')}</button></div>
{s.id==='knowledge' && <div class="knowledge-scene scene-body"><div class="source-stack">{[[t('Experiment files','实验文件'),t('Measurements + conditions','测量结果与实验条件')],[t('Papers & reports','文献与报告'),t('Findings + references','研究发现与参考来源')],[t('Team knowledge','团队知识'),t('Methods + observations','方法与观察记录')]].map((row,j)=><div class={`source-item step-${j+1}`}><div><strong>{row[0]}</strong><span>{row[1]}</span></div></div>)}</div><div class="join-path" aria-hidden="true"><span></span></div><div class="research-record step-4"><div class="record-top">{t('CONNECTED CONTEXT','关联研究背景')}</div><h4>{t('Electrolyte','电解液')}<br/>{t('research','研究')}</h4><div class="record-tags">{[t('Samples','样品'),t('Conditions','条件'),t('Results','结果')].map(x=><span>{x}</span>)}</div><div class="record-bottom">✓ {t('Links to original records','关联原始记录')}</div></div><div class="scene-takeaway">{t('Find the work. Understand the context. Build on it.','找到已有工作，理解研究背景，再向前一步。')}</div></div>}
{s.id==='analysis' && <div class="analysis-scene scene-body"><div class="comparison-title">{t('COMPARE BEFORE YOU CONCLUDE','先对照条件，再讨论结论')}</div><table class="comparison-table"><caption class="sr-only">{t('Illustrative experiment conditions','实验条件示意')}</caption><thead><tr><th>{t('Experiment context','实验条件')}</th><th>{t('Run A','实验 A')}</th><th>{t('Run B','实验 B')}</th></tr></thead><tbody><tr class="step-1"><th scope="row">{t('Active material','活性物质')}</th><td>{t('Same','相同')}</td><td>{t('Same','相同')}</td></tr><tr class="step-2"><th scope="row">{t('Solvent','溶剂')}</th><td>DMSO</td><td>DMSO</td></tr><tr class="compare-highlight step-3"><th scope="row">{t('Supporting salt','支持电解质盐')}</th><td>LiTFSI</td><td>NaTFSI</td></tr></tbody></table><div class="analysis-insight step-4"><div><span class="insight-label">{t('A DIFFERENCE TO INVESTIGATE','一个值得进一步调查的差异')}</span><p>{t('What else changed with the supporting salt?','更换电解质盐时，还有哪些条件发生了变化？')}</p></div></div><div class="investigation-note"><strong>{t('Before interpreting the difference','解释差异之前，先核查')}</strong><p>{t('Match sample IDs to the original records. Check salt concentration and test temperature; flag anything missing before proposing a follow-up.','将样品编号与原始记录对应，核查盐浓度和测试温度；标出缺失信息，再提出后续验证建议。')}</p></div><div class="scene-takeaway">{t('A useful question—not an unsupported conclusion.','发现差异是提出问题的起点，并不能直接证明因果关系。')}</div></div>}
{s.id==='workflow' && <div class="workflow-scene scene-body"><div class="workflow-caption">{t('YOUR EXISTING LAB. A MORE CONNECTED WAY TO WORK.','沿用现有实验室，让工作更连贯。')}</div><div class="workflow-diagram">{[[t('Lab data','实验数据'),t('Instrument exports and research records','仪器导出与实验记录')],[t('Analysis','数据分析'),t('Your methods, connected to inputs','让已有方法接入数据')],[t('Shared findings','共享研究结果'),t('Results ready for your team to review','交由研究团队评估')]].map((row,j)=><>{j>0 && <span class="flow-arrow" aria-hidden="true">→</span>}<div class={`workflow-node step-${j+1}`}><span class="node-number">0{j+1}</span><h4>{row[0]}</h4><p>{row[1]}</p></div></>)}</div><div class="workflow-rail step-4"><span>{t('Less copying between systems','减少系统间重复复制')}</span><span>{t('More continuity between steps','让前后步骤相互衔接')}</span></div><div class="scene-takeaway">{t('Start with one workflow. Keep what already works.','从一个流程开始，保留已经好用的工具。')}</div></div>}
<div class="scene-footer"><span>{t('Service illustration','服务示意')}</span><span>{t('Not a live system or customer dataset','非实时系统或客户数据')}</span></div></div></div>)}
</div></section>
<section class="approach" id="approach"><div class="shell approach-layout"><div class="approach-intro"><span class="eyebrow">{t('02 — HOW WE WORK','02 — 如何合作')}</span><h2>{t('Start with your science.','从你的科学问题出发。')}<br/><em>{t('Build around your reality.','围绕实际工作来构建。')}</em></h2><p>{t('You don’t need to replace your lab to explore what AI can do for it. Start with a defined problem, the resources you already have, and a result you can evaluate.','探索 AI 如何帮助科研，可以从现有数据和工具开始。先明确一个问题，再约定一项可以实际评估的结果。')}</p><div class="research-evidence"><span>{t('SCIENTIFIC FOUNDATION','科研基础')}</span><p>{t('Explore Lu Zhang’s public research record in electrochemical energy storage. This is prior scientific work, not evidence of a customer deployment.','了解张鲁在电化学储能领域的公开研究记录。这些是既往科研工作，不代表本服务已有客户部署。')}</p><div><a href={u(`${lp}/research-archive/`)}>{t('View the research record','查看科研记录')} ↗</a><a href={u(`${lp}/about/`)}>{t('Meet Lu Zhang, founder','认识创始人张鲁')} ↗</a></div></div><span class="approach-note">{t('Focused pilots · Agreed scope · Researcher-led decisions','聚焦试点 · 明确范围 · 研究者主导决策')}</span></div><div class="pilot-accordion">{steps.map((row,i)=><details open={i===0} data-slot="accordion-item"><summary data-slot="accordion-trigger"><span class="accordion-number">0{i+1}</span><span>{row[0]}</span></summary><div data-slot="accordion-content"><div>{row[1]}</div></div></details>)}</div></div></section>
<section class="contact shell" id="start"><span class="eyebrow">{t('THE NEXT STEP','下一步')}</span><div class="contact-layout"><h2>{t('Bring us the problem','从那个一直困扰你的')}<br/>{t('you keep ','问题开始，')}<em>{t('working around.','一起找出路。')}</em></h2><div><p>{t('One workflow. One research bottleneck. Let’s explore what a useful pilot could look like.','一个工作流程，一个科研瓶颈。一起讨论怎样的试点能对你的工作有所帮助。')}</p><a class="button button-dark" href="mailto:zhanglu77@gmail.com?subject=SciencesLoop%20-%20Research%20workflow%20discussion">{t('Discuss your research workflow','聊聊你的科研工作流程')} ↗</a><p class="contact-safety">{t('Start with a non-confidential summary of the bottleneck and tools involved. No research data needed for the first conversation.','首次沟通只需简述非机密的流程问题和涉及的工具，不需要发送研究数据。')}</p><a class="email-address" href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a></div></div></section>
</main><footer class="site-footer shell"><div class="footer-top"><a class="wordmark" href={u(`${lp}/`)}>sciences<span>loop</span><b>.</b></a><div>{links.map(([path,label])=><a href={u(`${lp}${path}`)}>{label} ↗</a>)}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} SciencesLoop</span><span>{t('Pilot scope and availability confirmed in discussion.','试点范围与服务安排在沟通后确定。')}</span></div><div class="legal"><a href={u('/privacy/')}>{t('Privacy','隐私政策')}</a><a href={u('/terms/')}>{t('Terms','服务条款')}</a>{zh && <a href={u('/zh/about/')}>张鲁 Lu Zhang</a>}</div></footer>
<script>
 const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-service]'));
 const narrowTabs = matchMedia('(max-width: 760px)');
 const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
 const syncOrientation = () => tablist?.setAttribute('aria-orientation', narrowTabs.matches ? 'vertical' : 'horizontal');
 syncOrientation(); narrowTabs.addEventListener('change', syncOrientation);
 const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
 function select(id: string, focus = false) {
   tabs.forEach(tab => { const active = tab.dataset.service === id; tab.dataset.state = active ? 'active' : 'inactive'; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; if(active && focus) tab.focus(); });
   panels.forEach(panel => { const active = panel.id === `panel-${id}`; panel.hidden = !active; panel.dataset.state = active ? 'active' : 'inactive'; });
 }
 select('knowledge');
 tabs.forEach((tab, index) => { tab.addEventListener('click', () => select(tab.dataset.service!)); tab.addEventListener('keydown', event => {
   const forward = narrowTabs.matches ? 'ArrowDown' : 'ArrowRight';
   const backward = narrowTabs.matches ? 'ArrowUp' : 'ArrowLeft';
   let next = index;
   if(event.key===forward) next=(index+1)%tabs.length;
   else if(event.key===backward) next=(index+tabs.length-1)%tabs.length;
   else if(event.key==='Home') next=0;
   else if(event.key==='End') next=tabs.length-1;
   else return;
   event.preventDefault(); select(tabs[next].dataset.service!,true);
 }); });
 document.querySelectorAll<HTMLAnchorElement>('[data-jump]').forEach(link => link.addEventListener('click', () => select(link.dataset.jump!)));
 document.querySelectorAll<HTMLButtonElement>('.replay-button').forEach(button => button.addEventListener('click', () => { if(matchMedia('(prefers-reduced-motion: reduce)').matches) return; button.closest('.scene')?.querySelectorAll<HTMLElement>('[class*="step-"]').forEach(el => { el.style.animation = 'none'; void el.offsetWidth; el.style.animation = ''; }); }));
 const menu = document.querySelector<HTMLButtonElement>('.mobile-menu-button'); const nav = document.getElementById('mobile-nav');
 function closeMenu(){ if(nav && menu){ nav.hidden=true; menu.setAttribute('aria-expanded','false'); } }
 menu?.addEventListener('click', () => { if(nav){ nav.hidden=!nav.hidden; menu.setAttribute('aria-expanded',String(!nav.hidden)); } });
 nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',closeMenu));
 document.addEventListener('keydown',event=>{if(event.key==='Escape' && nav && !nav.hidden){closeMenu();menu?.focus();}});
</script>
</body></html>
