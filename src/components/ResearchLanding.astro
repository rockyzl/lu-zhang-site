---
import { u } from '../lib/url';
import ChatWidget from './ChatWidget.astro';
import '../styles/landing.css';
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const t = (en: string, cn: string) => zh ? cn : en;
const lp = zh ? '/zh' : '';
const services = [
 { id:'knowledge', need:t('Where did this result come from?','一个结果背后的数据和记录在哪里？'), short:t('Trace the evidence','追溯研究证据'), title:t('Find the evidence behind a result','找到结果背后的研究证据'), description:t("A plot alone rarely tells the full story. Link a result to its sample, measurement conditions, lab notes, and source files so a researcher can check how it was produced.",'单看一张曲线，很难知道结果是怎么来的。把结果与样品、测试条件、实验笔记和原始文件关联起来，让研究者能回头核对。'), outcome:t('A searchable set of selected results, with links to the original records and the context available for each one.','一组可检索的研究结果，附有原始记录链接和目前可获得的实验背景。'), tags:[t('Literature & reports','文献与报告'),t('Experimental records','实验记录'),t('Source-linked records','来源关联记录')] },
 { id:'analysis', need:t('Why did these two experiments differ?','两次实验结果不同，原因可能在哪？'), short:t('Compare experiments','对照两次实验'), title:t('Compare conditions before explaining a difference','先核对实验条件，再解释结果差异'), description:t('Put two runs side by side. Check sample identity, formulation, settings, and missing records before deciding which difference deserves another test.','把两次实验放在一起，对照样品、配方和测试设置，标出缺失的记录，再判断哪处差异值得进一步测试。'), outcome:t('A conditions comparison, missing-information checklist, and proposed next steps for researcher review.','一份实验条件对照、待补信息清单，以及供研究者审阅的后续调查建议。'), tags:[t('Data comparison','数据对比'),t('Scientific context','科学背景'),t('Follow-up planning','后续验证')] },
 { id:'workflow', need:t("A result is in. What happens next?",'数据测完了，下一步却还没定。'), short:t('Keep the research thread','延续研究脉络'), title:t('Keep decisions and evidence connected','让研究决定与证据始终相连'), description:t('Connect an instrument result with its sources, analysis, alternative explanations, decision rationale, and researcher review so the inquiry can be revisited and advanced.','从一次结果出发，把原始记录、分析、备选解释、决策理由和研究者审阅连成可追溯的过程，便于回看并决定下一步。'), outcome:t('A scoped pilot showing a result, its evidence and alternatives, and a proposed action for researcher review.','一个聚焦试点，展示怎样追溯结果、比较解释、审阅下一步行动，并保留决定所依据的记录。'), tags:[t('Existing tools','现有工具'),t('Workflow integration','流程衔接'),t('Team collaboration','团队协作')] }
];
const steps = [
 [t('Find the right starting point','找到值得先解决的问题'), t('We map one research bottleneck: what your team is trying to decide, where information gets lost, and which data and tools are available. Together, we define a useful first outcome.','从一个具体科研瓶颈开始：团队需要做什么判断，信息在哪里断开，手头有哪些数据和工具。一起明确第一阶段应当得到的结果。')],
 [t('Connect a focused workflow','围绕一个流程开展试点'), t('We agree on a bounded pilot around selected records, analysis tools, and review steps. Integration and feasibility are assessed for your setup.','选择一组记录、分析工具和审核步骤，约定清晰的试点范围，并结合实际环境评估数据衔接与实施可行性。')],
 [t('Evaluate before expanding','先评估，再决定是否扩展'), t('Agree on checks such as source traceability, researcher-reviewed comparisons, and manual handoffs relative to your current workflow. Review the results and limitations before deciding whether to expand.','事先约定检查方式，例如来源能否追溯、对比结果能否由研究者复核、手动衔接步骤相比原流程有何变化。评估结果与局限，再决定是否扩展。')]
];
const founderStats = [
 { n:'97', l:t('journal papers','篇 SCI 论文'), href:u(`${lp}/publications/`) },
 { n:'28', l:t('patents and applications','项专利与申请'), href:u(`${lp}/patents/`) },
 { n:'4,700+', l:t('citations','次引用'), href:u(`${lp}/research-archive/`) },
 { n:'R&D 100', l:t('Award, 2014','大奖，2014'), href:u(`${lp}/awards/`) }
];
// Hero console: cyclic-voltammetry traces simulated at build time (finite-difference
// diffusion with Butler-Volmer kinetics). Kinetics are fast at every scan rate, so the
// couple is reversible: peak potentials stay fixed and peak current scales with sqrt(v).
// Illustrative only — not measured data.
const cvRates = [10, 20, 40, 60, 100];
const P0 = -13, P1 = 13;
function simulateCV() {
 const alpha = 0.5, lam = 2000, dT = 0.002, dX = Math.sqrt(dT / 0.4);
 const steps = Math.round((2 * (P1 - P0)) / dT), n = Math.ceil((6 * Math.sqrt(2 * (P1 - P0))) / dX);
 let R = new Float64Array(n).fill(1), O = new Float64Array(n);
 const pts: number[][] = [];
 let hi = [0, -Infinity], lo = [0, Infinity];
 for (let k = 0; k <= steps; k++) {
  const T = k * dT, p = T <= P1 - P0 ? P0 + T : P1 - (T - (P1 - P0));
  const kf = Math.exp((1 - alpha) * p), kb = Math.exp(-alpha * p);
  const J = (lam * (R[1] * kf - O[1] * kb)) / (1 + lam * dX * (kf + kb));
  R[0] = R[1] - J * dX; O[0] = O[1] + J * dX;
  const R2 = R.slice(), O2 = O.slice();
  for (let i = 1; i < n - 1; i++) { R2[i] = R[i] + 0.4 * (R[i + 1] - 2 * R[i] + R[i - 1]); O2[i] = O[i] + 0.4 * (O[i + 1] - 2 * O[i] + O[i - 1]); }
  R = R2; O = O2;
  const cur = J;
  if (cur > hi[1]) hi = [p, cur];
  if (cur < lo[1]) lo = [p, cur];
  if (k % 260 === 0) pts.push([p, cur]);
 }
 return { pts, hi, lo };
}
// A reversible response has one dimensionless shape; each scan rate scales it by sqrt(v).
const cvUnit = simulateCV();
const cvRaw = cvRates.map((rate) => { const k = Math.sqrt(rate / 10), sc = (q: number[]) => [q[0], q[1] * k]; return { pts: cvUnit.pts.map(sc), hi: sc(cvUnit.hi), lo: sc(cvUnit.lo) }; });
const cvI = cvRaw.flatMap((c) => [c.hi[1], c.lo[1]]);
const cvMax = Math.max(...cvI), cvMin = Math.min(...cvI);
const PX0 = 54, PW = 648, PY0 = 26, PH = 318;
const cvScale = (PH * 0.84) / (cvMax - cvMin);
const cvZero = PY0 + PH * 0.05 + cvMax * cvScale;
const cvX = (pp: number) => PX0 + ((pp - P0) / (P1 - P0)) * PW;
const cvY = (i: number) => cvZero - i * cvScale;
const cvCurves = cvRaw.map(({ pts, hi, lo }, idx) => {
 const xy = pts.map(([pp, i]) => [+cvX(pp).toFixed(1), +cvY(i).toFixed(1)]);
 const mark = (q: number[]) => [+cvX(q[0]).toFixed(1), +cvY(q[1]).toFixed(1)];
 return { rate: cvRates[idx], d: 'M' + xy.map((q) => q.join(',')).join('L'), peak: mark(hi), valley: mark(lo) };
});
const cvTrend = 'M' + cvCurves.map((c) => c.peak.join(',')).join('L');
// Peak separation of the simulated couple, in mV at 25 °C (RT/F = 25.69 mV).
const cvDeltaEp = Math.round((cvUnit.hi[0] - cvUnit.lo[0]) * 25.69);
const cvDimY = PY0 + PH - 14;
const cvTrendLow = 'M' + cvCurves.map((c) => c.valley.join(',')).join('L');
const cvTicks = [0, 0.2, 0.4, 0.6].map((e) => ({ label: e.toFixed(1), x: +cvX((e - 0.28) / 0.02569).toFixed(1) }));
const cvGridY = [0.2, 0.4, 0.6, 0.8].map((f) => +(PY0 + PH * f).toFixed(1));
// One orchestrated 20 s sequence: question, five scans, analysis, review, then reset.
const CYCLE = 20, pc = (sec: number) => ((sec / CYCLE) * 100).toFixed(2) + '%';
const scanStart = (i: number) => 1.2 + i * 1.5;
const logAt = [0.3, 1.2, 9.2, 11.2];
const cvAnim = [
 ...cvCurves.map((_, i) => `@keyframes sf-draw-${i}{0%,${pc(scanStart(i))}{stroke-dashoffset:1;opacity:var(--o)}${pc(scanStart(i) + 1.4)},93%{stroke-dashoffset:0;opacity:var(--o)}98%{stroke-dashoffset:0;opacity:0}99%,100%{stroke-dashoffset:1;opacity:0}}@keyframes sf-head-${i}{0%,${pc(scanStart(i) - 0.01)}{offset-distance:0%;opacity:0}${pc(scanStart(i))}{offset-distance:0%;opacity:1}${pc(scanStart(i) + 1.4)}{offset-distance:100%;opacity:1}${pc(scanStart(i) + 1.6)},100%{offset-distance:100%;opacity:0}}`),
 `@keyframes sf-peaks{0%,${pc(9.2)}{opacity:0}${pc(9.6)},93%{opacity:1}98%,100%{opacity:0}}`,
 `@keyframes sf-trend{0%,${pc(9.4)}{stroke-dashoffset:1;opacity:1}${pc(10.4)},93%{stroke-dashoffset:0;opacity:1}98%{stroke-dashoffset:0;opacity:0}99%,100%{stroke-dashoffset:1;opacity:0}}`,
 `@keyframes sf-note{0%,${pc(10.4)}{opacity:0}${pc(10.9)},93%{opacity:1}98%,100%{opacity:0}}`,
 ...logAt.map((sec, i) => `@keyframes sf-log-${i}{0%,${pc(sec)}{opacity:.3}${pc(sec + 0.4)},93%{opacity:1}98%,100%{opacity:.3}}`)
].join('');
const consoleLog = [
 [t('Question','问题'), t('Is this redox couple reversible and diffusion-controlled?','这个氧化还原电对可逆吗？受扩散控制吗？')],
 [t('Experiment','实验'), t('Cyclic voltammetry at five scan rates, 10–100 mV/s','五个扫速下的循环伏安，10–100 mV/s')],
 [t('Analysis','分析'), t('Peaks stay put, peak current ∝ √v: reversible, diffusion-controlled','峰电位不随扫速移动，峰电流与 √v 成正比：可逆，受扩散控制')],
 [t('Review','审核'), t('Waiting for researcher approval before the next run','等待研究者确认后再启动下一轮')]
];
const title = t('One-Stop Adaptive AI Workflows for Scientific R&D | SciencesLoop','科研一站式自适应 AI 工作流 | SciencesLoop');
const description = t('A unified R&D workspace connecting experimental data, simulation, machine learning and scientific tools through adaptive, traceable AI workflows. Starting with electrochemistry.','将实验数据、仿真、机器学习与已有科研工具整合到同一工作入口，通过自适应、可追溯的 AI 流程为复杂研发提效，从电化学切入。');
const origin = Astro.site ?? new URL('https://sciencesloop.com');
const canonical = new URL(u(`${lp}/`),origin).href;
const links = [['/battery-ai/',t('Battery & electrochemistry AI','电池与电化学 AI')],['/agent/battery-research/',t('Battery research demo','电池研发 Demo')],['/projects/',t('Selected work','项目实践')],['/lab/',t('Research lab','研究实验室')],['/blog/',t('Field notes','研究笔记')],['/research-archive/',t('Research archive','科研档案')],['/about/',t('About the founder','关于创始人')]];
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={new URL(u('/'),origin).href}/><link rel="alternate" hreflang="zh-CN" href={new URL(u('/zh/'),origin).href}/><link rel="alternate" hreflang="x-default" href={new URL(u('/'),origin).href}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="SciencesLoop"/><meta property="og:image" content={new URL(u('/og-default.png'),origin).href}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(u('/og-default.png'),origin).href}/><link rel="icon" href={u('/images/landing-mark.svg')}/><link rel="alternate" type="application/rss+xml" title="SciencesLoop Field Notes" href={u('/rss.xml')}/><script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": new URL('/#organization', origin).href,
  name: "SciencesLoop",
  url: new URL('/', origin).href,
  description: "Researcher-led adaptive scientific AI workflows linking experimental evidence, simulation, machine learning and model-assisted tool orchestration, starting with battery and electrochemistry R&D.",
  founder: {
    "@type": "Person",
    "@id": new URL('/about/#person', origin).href,
    name: "Lu Zhang",
    url: new URL('/about/', origin).href,
    sameAs: [
      "https://github.com/rockyzl",
      "https://www.linkedin.com/in/lu-zhang-argonne/",
      "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ"
    ]
  }
})} />
</head>
<body>
<noscript><style>.need-list,.replay-button,.mobile-menu-button{display:none!important}.service-panel[data-state=inactive]{display:grid!important}.service-panel{padding-bottom:35px} @media(max-width:760px){.service-panel[data-state=inactive]{display:flex!important}}</style></noscript>
<a class="skip-link" href="#main">{t('Skip to content','跳到正文')}</a>
<header class="site-header site-header-sf"><a href={u(`${lp}/`)} class="wordmark" aria-label="SciencesLoop">sciences<span>loop</span><b>.</b></a><div class="nav-group"><nav class="desktop-nav" aria-label={t('Main navigation','主导航')}><a href="#solutions">{t('What we do','我们做什么')}</a><a href="#approach">{t('How we work','如何合作')}</a><a class="nav-cta" href="#start">{t('Start a conversation','聊聊你的需求')} ↗</a></nav><a class="language-link" href={u(zh ? '/' : '/zh/')} lang={zh ? 'en' : 'zh-CN'}>{zh ? 'EN' : '中文'}</a><button class="mobile-menu-button" aria-label={t('Toggle navigation','展开或收起导航')} aria-controls="mobile-nav" aria-expanded="false">☰</button></div></header>
<nav id="mobile-nav" class="mobile-nav mobile-nav-sf" hidden aria-label={t('Mobile navigation','移动导航')}><a href="#solutions">{t('What we do','我们做什么')}</a><a href="#approach">{t('How we work','如何合作')}</a><a href="#start">{t('Start a conversation','聊聊你的需求')}</a></nav>
<main id="main">
<section class="hero hero-sf" aria-labelledby="hero-title">
<div class="shell">
<p class="sf-status"><span class="sf-status-dot" aria-hidden="true"></span>{t('Pilots open for battery and electrochemistry R&D teams','面向电池与电化学研发团队，试点开放中')}</p>
<div class="sf-layout">
<div class="sf-main">
<h1 id="hero-title"><span>{t('Complex science.','复杂科研，')}</span><span>{t('One workspace.','一站式工作流。')}</span></h1>
<p class="sf-lede">{t('Connect your experimental data, simulations, ML models and lab software in one traceable research loop. Researchers approve the key decisions.','把实验数据、仿真、机器学习模型和现有科研软件接进同一个可追溯的科研闭环，关键决策由研究者确认。')}</p>
<div class="sf-actions">
<a class="sf-button" href={u(`${lp}/agent/battery-research/`)}>{t('Try the battery agent demo','试用电池研发智能体')}</a>
<a class="sf-link" href="#start">{t('Talk through your workflow','聊聊你的研发流程')}</a>
</div>
<p class="sf-scope">{t('Pilot integrations are scoped to your existing systems, available interfaces and researcher-approved actions.','具体集成范围取决于现有系统、可用接口和研究者授权；先验证，再扩展。')}</p>
</div>
<figure class="sf-console" aria-labelledby="sf-console-caption">
<style set:html={cvAnim}></style>
<i class="sf-corner sf-tl" aria-hidden="true"></i><i class="sf-corner sf-tr" aria-hidden="true"></i><i class="sf-corner sf-bl" aria-hidden="true"></i><i class="sf-corner sf-br" aria-hidden="true"></i>
<div class="sf-console-bar"><span>{t('Agent run: redox couple check','智能体运行：氧化还原电对检查')}</span><span class="sf-tag" id="sf-console-caption">{t('Illustration, simulated data','示意，模拟数据')}</span></div>
<svg class="sf-plot" viewBox="0 0 720 396" role="img" aria-label={t('Illustration: an AI agent records cyclic voltammograms at five scan rates, then marks the peaks: their potentials stay fixed while peak current grows with scan rate.','示意图：智能体在五个扫速下记录循环伏安曲线并标出峰位：峰电位保持不变，峰电流随扫速增大。')}>
<g class="sf-grid">{cvGridY.map((y)=><line x1={PX0} x2={PX0+PW} y1={y} y2={y}/>)}{cvTicks.map((k)=><line x1={k.x} x2={k.x} y1={PY0} y2={PY0+PH}/>)}</g>
<line class="sf-zero" x1={PX0} x2={PX0+PW} y1={cvZero.toFixed(1)} y2={cvZero.toFixed(1)}/>
<rect class="sf-frame" x={PX0} y={PY0} width={PW} height={PH}/>
<g class="sf-axis">{cvTicks.map((k)=><text x={k.x} y={PY0+PH+20} text-anchor="middle">{k.label}</text>)}<text class="sf-axis-title" x={PX0+PW} y={PY0+PH+42} text-anchor="end">{t('E / V vs Ag/AgCl','E / V（相对 Ag/AgCl）')}</text><text x={PX0-10} y={(cvZero+4).toFixed(1)} text-anchor="end">0</text><text x={PX0-10} y={PY0+12} text-anchor="end">i</text><text x={PX0+12} y={PY0+22}>{t('10 → 100 mV/s','10 → 100 mV/s')}</text></g>
<g class="sf-traces">{cvCurves.map((c,i)=><path class="sf-trace" d={c.d} pathLength="1" style={`animation-name:sf-draw-${i};--o:${(0.5+i*0.125).toFixed(3)}`}/>)}</g>
<path class="sf-trend" d={cvTrend} pathLength="1"/>
<path class="sf-trend" d={cvTrendLow} pathLength="1"/>
<g class="sf-peaks">{cvCurves.map((c)=><circle cx={c.peak[0]} cy={c.peak[1]} r="3.6"/>)}{cvCurves.map((c)=><circle cx={c.valley[0]} cy={c.valley[1]} r="3.6"/>)}</g>
<text class="sf-note" x={cvCurves[4].peak[0]+14} y={cvCurves[4].peak[1]+2}>{t('Ep fixed, ip ∝ √v','峰位不变，峰电流 ∝ √v')}</text>
<path class="sf-dim" d={`M${cvCurves[0].valley[0]},${cvDimY-6}V${cvDimY}H${cvCurves[0].peak[0]}V${cvDimY-6}`}/>
<text class="sf-note" x={cvCurves[0].peak[0]+12} y={cvDimY+3}>{`ΔEp ≈ ${cvDeltaEp} mV`}</text>
{cvCurves.map((c,i)=><circle class="sf-head" r="4.5" style={`offset-path:path("${c.d}");animation-name:sf-head-${i}`}/>)}
</svg>
<ol class="sf-log">{consoleLog.map(([k,v],i)=><li style={`animation-name:sf-log-${i}`}><span>{k}</span><span>{v}{i===3 && <i class="sf-cursor" aria-hidden="true"></i>}</span></li>)}</ol>
</figure>
</div>
<div class="sf-founder">
<p>{t('Built by a battery scientist. ','由电池科学家创立。')}<a href={u(`${lp}/about/`)}>{t('Lu Zhang','张鲁 Lu Zhang')}</a>{t(' spent 14+ years on battery research at Argonne National Laboratory.',' 在美国阿贡国家实验室从事电池研究 14 年以上。')}</p>
<ul>{founderStats.map((f)=><li><a href={f.href}><strong>{f.n}</strong><span>{f.l}</span></a></li>)}</ul>
</div>
<div class="hero-service-links">{services.map((sv,i)=><a href="#solutions" data-jump={sv.id}><span>0{i+1}</span>{sv.short} ↓</a>)}</div>
</div>
</section>

<section class="operating-layer shell" aria-labelledby="layer-title">
  <div class="layer-intro">
    <div>
      <span class="eyebrow">{t('ONE FRONT DOOR TO YOUR RESEARCH STACK','复杂科研系统的统一入口')}</span>
      <h2 id="layer-title">{t('Your tools stay. The workflow comes together.','保留现有工具，整合为一条工作流。')}</h2>
    </div>
    <p>{t(
      'Like an operating layer for R&D, SciencesLoop aims to connect fragmented tools and data around the research question. The workflow can select approved steps as new evidence arrives—without forcing scientists to jump between platforms.',
      'SciencesLoop 希望成为科研工作的统一编排层：围绕研究问题连接分散的数据和工具，在新证据出现时选择经过批准的下一步，而不是让研究人员在多个平台间来回切换。'
    )}</p>
  </div>
  <div class="layer-diagram" aria-label={t('Research data and tools into an adaptive workflow','科研数据与工具汇入自适应工作流')}>
    <div class="layer-inputs">
      <span>{t('Experimental data & papers','实验数据与文献')}</span>
      <span>{t('Simulation & scientific software','仿真与科学软件')}</span>
      <span>{t('Machine learning & foundation models','机器学习与基础模型')}</span>
      <span>{t('Existing APIs, instruments & tools','已有 API、仪器与工具')}</span>
    </div>
    <div class="layer-core">
      <span class="eyebrow">{t('SCIENCESLOOP · ADAPTIVE ORCHESTRATION','SCIENCESLOOP · 自适应编排')}</span>
      <h3>{t('One connected research workflow','统一的科研工作流')}</h3>
      <p>{t('Choose tools by task · preserve context and provenance · involve researchers at decision points','按任务选择工具 · 保留上下文与证据 · 在关键决策点由研究者审核')}</p>
    </div>
    <div class="layer-outcome">
      <strong>{t('Less switching. Faster iteration. Traceable decisions.','减少平台切换 · 加快研究迭代 · 结果可追溯')}</strong>
      <span>{t('Integration and efficiency gains are goals to validate in scoped pilots, not pre-proven guarantees.','集成范围和提效幅度需要在具体试点中验证，不预先承诺通用效果。')}</span>
    </div>
  </div>
  <div class="layer-links">
    <a class="layer-link" href={u(zh ? '/zh/battery-ai/' : '/battery-ai/')}>{t('First use case: battery & electrochemistry','首个落地场景：电池与电化学')} ↗</a>
    <a class="layer-link" href={u(zh ? '/zh/approach/' : '/approach/')}>{t('See our approach to reliable agents','了解可复核的 Agent 工程方法')} ↗</a>
  </div>
</section>
<section class="solutions shell" id="solutions" aria-labelledby="solutions-title"><div class="section-heading"><div><span class="eyebrow">{t('01 — WHAT WE DO','01 — 我们做什么')}</span><h2 id="solutions-title">{t('When research gets stuck,','科研卡住的时候，')}<br/><em>{t('find the next question.','先找对下一步问题。')}</em></h2></div><p>{t('Choose where your team loses the thread: finding evidence, comparing results, or carrying a decision and its rationale into the next stage.','从最容易断线的地方开始：追溯证据、对照结果，或让决策理由随着研究一起延续。')}</p></div>
<div class="solutions-tabs"><div class="need-list" data-slot="tabs-list" role="tablist" aria-orientation="horizontal" aria-label={t('Choose a research challenge','选择科研中的难题')}>{services.map((s,i)=><button type="button" role="tab" class="need-button" data-slot="tabs-trigger" data-state={i===0?'active':'inactive'} id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-service={s.id}><span class="need-number">0{i+1}</span><span class="need-title">{s.need}</span><span class="need-arrow" aria-hidden="true">↗</span></button>)}</div>
{services.map((s,i)=><div class="service-panel" data-slot="tabs-content" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} tabindex="0" data-state={i===0?'active':'inactive'} ><div class="service-narrative"><h3>{s.title}</h3><p>{s.description}</p><div class="service-tags">{s.tags.map(tag=><span>{tag}</span>)}</div><div class="outcome"><span>{t('WHAT YOU WALK AWAY WITH','你能获得什么')}</span><p>{s.outcome}</p></div><a href="#start" class="text-link">{t('Explore a focused pilot','讨论一个具体试点')} ↗</a></div><div class="scene"><div class="scene-header"><span>{t('SCIENTIFIC WORK, CONNECTED','把科研工作连接起来')}</span><button class="replay-button" type="button" aria-label={t(`Replay: ${s.title}`,`重播：${s.title}`)}>↻ {t('Replay','重播')}</button></div>
{s.id==='knowledge' && <div class="knowledge-scene scene-body"><div class="source-stack">{[[t('Experiment files','实验文件'),t('Measurements + conditions','测量结果与实验条件')],[t('Papers & reports','文献与报告'),t('Findings + references','研究发现与参考来源')],[t('Team knowledge','团队知识'),t('Methods + observations','方法与观察记录')]].map((row,j)=><div class={`source-item step-${j+1}`}><div><strong>{row[0]}</strong><span>{row[1]}</span></div></div>)}</div><div class="join-path" aria-hidden="true"><span></span></div><div class="research-record step-4"><div class="record-top">{t('CONNECTED CONTEXT','关联研究背景')}</div><h4>{t('Electrolyte','电解液')}<br/>{' '}{t('research','研究')}</h4><div class="record-tags">{[t('Samples','样品'),t('Conditions','条件'),t('Results','结果')].map(x=><span>{x}</span>)}</div><div class="record-bottom">✓ {t('Links to original records','关联原始记录')}</div></div><div class="scene-takeaway">{t('Find the work. Understand the context. Build on it.','找到已有工作，理解研究背景，再向前一步。')}</div></div>}
{s.id==='analysis' && <div class="analysis-scene scene-body"><div class="comparison-title">{t('COMPARE BEFORE YOU CONCLUDE','先对照条件，再讨论结论')}</div><table class="comparison-table"><caption class="sr-only">{t('Illustrative experiment conditions','实验条件示意')}</caption><thead><tr><th>{t('Experiment context','实验条件')}</th><th>{t('Run A','实验 A')}</th><th>{t('Run B','实验 B')}</th></tr></thead><tbody><tr class="step-1"><th scope="row">{t('Active material','活性物质')}</th><td>{t('Same','相同')}</td><td>{t('Same','相同')}</td></tr><tr class="step-2"><th scope="row">{t('Solvent','溶剂')}</th><td>DMSO</td><td>DMSO</td></tr><tr class="compare-highlight step-3"><th scope="row">{t('Supporting salt','支持电解质盐')}</th><td>LiTFSI</td><td>NaTFSI</td></tr></tbody></table><div class="analysis-insight step-4"><div><span class="insight-label">{t('A DIFFERENCE TO INVESTIGATE','一个值得进一步调查的差异')}</span><p>{t('What else changed with the supporting salt?','更换电解质盐时，还有哪些条件发生了变化？')}</p></div></div><div class="investigation-note"><strong>{t('Before interpreting the difference','解释差异之前，先核查')}</strong><p>{t('Match sample IDs to the original records. Check salt concentration and test temperature; flag anything missing before proposing a follow-up.','将样品编号与原始记录对应，核查盐浓度和测试温度；标出缺失信息，再提出后续验证建议。')}</p></div><div class="scene-takeaway">{t('A useful question—not an unsupported conclusion.','发现差异是提出问题的起点，并不能直接证明因果关系。')}</div></div>}
{s.id==='workflow' && <div class="workflow-scene scene-body"><div class="workflow-caption">{t('YOUR EXISTING LAB. A MORE CONNECTED WAY TO WORK.','沿用现有实验室，让工作更连贯。')}</div><div class="workflow-diagram">{[[t('Lab data','实验数据'),t('Instrument exports and research records','仪器导出与实验记录')],[t('Analysis','数据分析'),t('Your methods, connected to inputs','让已有方法接入数据')],[t('Shared findings','共享研究结果'),t('Results ready for your team to review','交由研究团队评估')]].map((row,j)=><>{j>0 && <span class="flow-arrow" aria-hidden="true">→</span>}<div class={`workflow-node step-${j+1}`}><span class="node-number">0{j+1}</span><h4>{row[0]}</h4><p>{row[1]}</p></div></>)}</div><div class="workflow-rail step-4"><span>{t('Less copying between systems','减少系统间重复复制')}</span><span>{t('More continuity between steps','让前后步骤相互衔接')}</span></div><div class="scene-takeaway">{t('Start with one workflow. Keep what already works.','从一个流程开始，保留已经好用的工具。')}</div></div>}
<div class="scene-footer"><span>{t('Service illustration','服务示意')}</span><span>{t('Not a live system or customer dataset','非实时系统或客户数据')}</span></div></div></div>)}
</div></section>
<section class="approach" id="approach"><div class="shell approach-layout"><div class="approach-intro"><span class="eyebrow">{t('02 — HOW WE WORK','02 — 如何合作')}</span><h2>{t('Start with your science.','从你的科学问题出发。')}<br/><em>{t('Build around your reality.','围绕实际工作来构建。')}</em></h2><p>{t('You don’t need to replace your lab to explore what AI can do for it. Start with a defined problem, the resources you already have, and a result you can evaluate.','探索 AI 如何帮助科研，可以从现有数据和工具开始。先明确一个问题，再约定一项可以实际评估的结果。')}</p><div class="research-evidence"><span>{t('SCIENTIFIC FOUNDATION','科研基础')}</span><p>{t('Explore Lu Zhang’s public research record in electrochemical energy storage. This is prior scientific work, not evidence of a customer deployment.','了解张鲁在电化学储能领域的公开研究记录。这些是既往科研工作，不代表本服务已有客户部署。')}</p><div><a href={u(`${lp}/research-archive/`)}>{t('View the research record','查看科研记录')} ↗</a><a href={u(`${lp}/about/`)}>{t('Meet Lu Zhang, founder','认识创始人张鲁')} ↗</a></div></div><span class="approach-note">{t('Focused pilots · Agreed scope · Researcher-led decisions','聚焦试点 · 明确范围 · 研究者主导决策')}</span></div><div class="pilot-accordion">{steps.map((row,i)=><details open={i===0} data-slot="accordion-item"><summary data-slot="accordion-trigger"><span class="accordion-number">0{i+1}</span><span>{row[0]}</span></summary><div data-slot="accordion-content"><div>{row[1]}</div></div></details>)}</div></div></section>
<section class="contact shell" id="start"><span class="eyebrow">{t('THE NEXT STEP','下一步')}</span><div class="contact-layout"><h2>{t('Bring us the problem','从那个一直困扰你的')}<br/>{t('you keep ','问题开始，')}<em>{t('working around.','一起找出路。')}</em></h2><div><p>{t('One workflow. One research bottleneck. Let’s explore what a useful pilot could look like.','一个工作流程，一个科研瓶颈。一起讨论怎样的试点能对你的工作有所帮助。')}</p><a class="button button-dark" href="mailto:luzhang@sciencesloop.com?subject=SciencesLoop%20-%20Research%20workflow%20discussion">{t('Discuss your research workflow','聊聊你的科研工作流程')} ↗</a><p class="contact-safety">{t('Start with a non-confidential summary of the bottleneck and tools involved. No research data needed for the first conversation.','首次沟通只需简述非机密的流程问题和涉及的工具，不需要发送研究数据。')}</p><a class="email-address" href="mailto:luzhang@sciencesloop.com">luzhang@sciencesloop.com</a></div></div></section>
</main><footer class="site-footer shell"><div class="footer-top"><a class="wordmark" href={u(`${lp}/`)}>sciences<span>loop</span><b>.</b></a><div>{links.map(([path,label])=><a href={u(`${lp}${path}`)}>{label} ↗</a>)}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} SciencesLoop</span><span>{t('Pilot scope and availability confirmed in discussion.','试点范围与服务安排在沟通后确定。')}</span></div><div class="legal"><a href={u('/privacy/')}>{t('Privacy','隐私政策')}</a><a href={u('/terms/')}>{t('Terms','服务条款')}</a>{zh && <a href={u('/zh/about/')}>张鲁 Lu Zhang</a>}</div></footer>
<script>
 const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-service]'));
 const narrowTabs = matchMedia('(max-width: 760px)');
 const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
 const syncOrientation = () => tablist?.setAttribute('aria-orientation', narrowTabs.matches ? 'vertical' : 'horizontal');
 syncOrientation(); narrowTabs.addEventListener('change', syncOrientation);
 const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
 function select(id: string, focus = false) {
   tabs.forEach(tab => { const active = tab.dataset.service === id; tab.dataset.state = active ? 'active' : 'inactive'; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; if(active && focus) tab.focus(); });
   panels.forEach(panel => { const active = panel.id === `panel-${id}`; panel.hidden = !active; panel.dataset.state = active ? 'active' : 'inactive'; });
 }
 select('knowledge');
 tabs.forEach((tab, index) => { tab.addEventListener('click', () => select(tab.dataset.service!)); tab.addEventListener('keydown', event => {
   const forward = narrowTabs.matches ? 'ArrowDown' : 'ArrowRight';
   const backward = narrowTabs.matches ? 'ArrowUp' : 'ArrowLeft';
   let next = index;
   if(event.key===forward) next=(index+1)%tabs.length;
   else if(event.key===backward) next=(index+tabs.length-1)%tabs.length;
   else if(event.key==='Home') next=0;
   else if(event.key==='End') next=tabs.length-1;
   else return;
   event.preventDefault(); select(tabs[next].dataset.service!,true);
 }); });
 document.querySelectorAll<HTMLAnchorElement>('[data-jump]').forEach(link => link.addEventListener('click', () => select(link.dataset.jump!)));
 document.querySelectorAll<HTMLButtonElement>('.replay-button').forEach(button => button.addEventListener('click', () => { if(matchMedia('(prefers-reduced-motion: reduce)').matches) return; button.closest('.scene')?.querySelectorAll<HTMLElement>('[class*="step-"]').forEach(el => { el.style.animation = 'none'; void el.offsetWidth; el.style.animation = ''; }); }));
 const menu = document.querySelector<HTMLButtonElement>('.mobile-menu-button'); const nav = document.getElementById('mobile-nav');
 function closeMenu(){ if(nav && menu){ nav.hidden=true; menu.setAttribute('aria-expanded','false'); } }
 menu?.addEventListener('click', () => { if(nav){ nav.hidden=!nav.hidden; menu.setAttribute('aria-expanded',String(!nav.hidden)); } });
 nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',closeMenu));
 document.addEventListener('keydown',event=>{if(event.key==='Escape' && nav && !nav.hidden){closeMenu();menu?.focus();}});
</script>
<ChatWidget locale={zh ? 'zh' : 'en'} mode="landing" />
