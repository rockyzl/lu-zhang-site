---
import { u } from '../lib/url';
import '../styles/landing.css';
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const t = (en: string, cn: string) => zh ? cn : en;
const lp = zh ? '/zh' : '';
const services = [
 { id:'knowledge', need:t('Our knowledge is scattered.','资料分散，研究脉络难以串联。'), short:t('Connect knowledge','连接科研知识'), title:t('Connect your research knowledge','把分散的研究知识连接起来'), description:t("Reports in one folder. Measurements in another. The explanation in someone’s notebook. Bring the pieces together without losing the context that makes them useful.",'报告在文件夹里，测量数据在另一处，关键解释还留在某个人的笔记中。连接这些资料，也保留理解它们所需的实验条件和来源。'), outcome:t('A shared, searchable view of your research, with its sources and context intact.','形成可共同检索的研究知识视图，让资料、来源与实验背景保持关联。'), tags:[t('Literature & reports','文献与报告'),t('Experimental records','实验记录'),t('Source-linked answers','可追溯来源')] },
 { id:'analysis', need:t('Our results need an explanation.','实验结果不同，下一步该查什么？'), short:t('Understand results','理解实验结果'), title:t('Turn results into a next step','从结果差异找到下一步问题'), description:t('When experiments disagree, the answer is rarely in one file. Compare conditions, connect relevant evidence, and focus on what is worth investigating next.','当两次实验结果不一致，答案往往藏在多份记录之间。对照实验条件，结合相关证据，帮助团队找到值得进一步验证的问题。'), outcome:t('A clearer comparison and a focused plan for the next investigation.','更清晰的条件对比，以及有重点的下一步验证计划。'), tags:[t('Data comparison','数据对比'),t('Scientific context','科学背景'),t('Follow-up planning','后续验证')] },
 { id:'workflow', need:t("Our tools don’t work together.",'工具之间脱节，重复搬运数据。'), short:t('Connect workflows','衔接工作流程'), title:t('Connect the work between tools','让现有工具之间的工作衔接起来'), description:t('Stop carrying the same information from instrument exports to analysis scripts to team updates. Connect selected steps around the way your team already works.','从仪器导出数据，到运行分析脚本，再到向团队汇报，同一份信息常被反复整理。围绕团队已有的工作方式，逐步连接这些环节。'), outcome:t('One connected workflow, with fewer manual handoffs and your team in control.','减少手动转移与重复整理，让团队掌握整个工作流程。'), tags:[t('Existing tools','现有工具'),t('Workflow integration','流程衔接'),t('Team collaboration','团队协作')] }
];
const steps = [
 [t('Find the right starting point','找到值得先解决的问题'), t('We map one research bottleneck: what your team is trying to decide, where information gets lost, and which data and tools are available. Together, we define a useful first outcome.','从一个具体科研瓶颈开始：团队需要做什么判断，信息在哪里断开，手头有哪些数据和工具。一起明确第一阶段应当得到的结果。')],
 [t('Connect a focused workflow','围绕一个流程开展试点'), t('We agree on a bounded pilot around selected records, analysis tools, and review steps. Integration and feasibility are assessed for your setup.','选择一组记录、分析工具和审核步骤，约定清晰的试点范围，并结合实际环境评估数据衔接与实施可行性。')],
 [t('Evaluate before expanding','先评估，再决定是否扩展'), t('Review the outputs against agreed scientific and operational criteria. Keep what helps, identify the limits, and decide together whether a broader deployment makes sense.','按照约定的科学与工作标准评估结果，保留有帮助的部分，识别局限，再共同决定是否扩大应用范围。')]
];
const title = t('SciencesLoop — Connected intelligence for science','SciencesLoop — 连接科研知识、数据与工具 · 张鲁 Lu Zhang');
const description = t('Connect scientific knowledge, experimental data, and research tools. Explore focused AI workflow pilots for materials and electrochemistry R&D.','连接科学知识、实验数据与研究工具，围绕材料和电化学研发中的具体问题开展 AI 工作流程试点。');
const origin = Astro.site ?? new URL('https://sciencesloop.com');
const canonical = new URL(u(`${lp}/`),origin).href;
const links = [['/projects/',t('Selected work','项目实践')],['/lab/',t('Research lab','研究实验室')],['/blog/',t('Field notes','研究笔记')],['/research-archive/',t('Research archive','科研档案')],['/about/',t('About the founder','关于创始人')]];
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={new URL(u('/'),origin).href}/><link rel="alternate" hreflang="zh-CN" href={new URL(u('/zh/'),origin).href}/><link rel="alternate" hreflang="x-default" href={new URL(u('/'),origin).href}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="SciencesLoop"/><meta property="og:image" content={new URL(u('/og-default.png'),origin).href}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(u('/og-default.png'),origin).href}/><link rel="icon" href={u('/images/landing-mark.svg')}/><link rel="alternate" type="application/rss+xml" title="SciencesLoop Field Notes" href={u('/rss.xml')}/></head>
<body>
<a class="skip-link" href="#main">{t('Skip to content','跳到正文')}</a>
<header class="site-header"><a href={u(`${lp}/`)} class="wordmark" aria-label="SciencesLoop">sciences<span>loop</span><b>.</b></a><div class="nav-group"><nav class="desktop-nav" aria-label={t('Main navigation','主导航')}><a href="#solutions">{t('What we do','我们做什么')}</a><a href="#approach">{t('How we work','如何合作')}</a><a class="nav-cta" href="#start">{t('Start a conversation','聊聊你的需求')} ↗</a></nav><a class="language-link" href={u(zh ? '/' : '/zh/')} lang={zh ? 'en' : 'zh-CN'}>{zh ? 'EN' : '中文'}</a><button class="mobile-menu-button" aria-label={t('Toggle navigation','展开或收起导航')} aria-controls="mobile-nav" aria-expanded="false">☰</button></div></header>
<nav id="mobile-nav" class="mobile-nav" hidden aria-label={t('Mobile navigation','移动导航')}><a href="#solutions">{t('What we do','我们做什么')}</a><a href="#approach">{t('How we work','如何合作')}</a><a href="#start">{t('Start a conversation','聊聊你的需求')}</a></nav>
<main id="main">
<section class="hero shell" aria-labelledby="hero-title"><div class="hero-kicker"><span class="eyebrow">{t('CONNECTED INTELLIGENCE FOR SCIENCE','连接科研中的知识、数据与工具')}</span><span class="hero-index">{t('KNOWLEDGE / ANALYSIS / WORKFLOWS','知识 / 分析 / 工作流程')}</span></div><div class="hero-layout"><h1 id="hero-title">{t('Your research.','让你的研究，')}<br/><em>{t('Working as one.','连接成整体。')}</em></h1><div class="hero-copy"><p>{t('Bring your data, scientific knowledge, and tools together. Give your team a clearer path from experimental results to the next decision.','连接实验数据、科学知识与研究工具，让团队从实验结果到下一步决策，有一条更清晰的路径。')}</p><a class="button button-dark" href="#solutions">{t('Find your starting point','找到你的起点')} ↓</a><span class="hero-audience">{t('Built around materials and electrochemistry R&D.','围绕材料与电化学研发中的实际需求。')}</span></div></div><div class="hero-image-wrap"><img class="hero-image" src={u('/images/research-hero.webp')} alt={t('Conceptual materials research image of glass sample vessels in warm light','暖色光线中的玻璃样品容器，科研概念配图')} width="1536" height="1024" fetchpriority="high"/><div class="image-overlay"></div><div class="image-caption"><span>{t('FROM ISOLATED PIECES','从分散的资料')}</span><span>{t('TO A CONNECTED RESEARCH PICTURE.','到连贯的研究全貌。')}</span></div><span class="image-credit">{t('Concept image','概念配图')}</span></div><div class="hero-service-links">{services.map((s,i)=><a href="#solutions" data-jump={s.id}><span>0{i+1}</span>{s.short} ↓</a>)}</div></section>
<section class="solutions shell" id="solutions" aria-labelledby="solutions-title"><div class="section-heading"><div><span class="eyebrow">{t('01 — WHAT WE DO','01 — 我们做什么')}</span><h2 id="solutions-title">{t('Less friction.','少一些阻碍。')}<br/><em>{t('More scientific progress.','多一些科研进展。')}</em></h2></div><p>{t('Start with the part of your work that feels harder than it should.','从那些反复耗费精力的科研环节开始。')}</p></div>
<div class="solutions-tabs"><div class="need-list" data-slot="tabs-list" role="tablist" aria-label={t('Choose a research challenge','选择科研中的难题')}>{services.map((s,i)=><button type="button" role="tab" class="need-button" data-slot="tabs-trigger" data-state={i===0?'active':'inactive'} id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-service={s.id}><span class="need-number">0{i+1}</span><span class="need-title">{s.need}</span><span class="need-arrow" aria-hidden="true">↗</span></button>)}</div>
{services.map((s,i)=><div class="service-panel" data-slot="tabs-content" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} tabindex="0" data-state={i===0?'active':'inactive'} hidden={i!==0}><div class="service-narrative"><h3>{s.title}</h3><p>{s.description}</p><div class="service-tags">{s.tags.map(tag=><span>{tag}</span>)}</div><div class="outcome"><span>{t('WHAT YOU WALK AWAY WITH','你能获得什么')}</span><p>{s.outcome}</p></div><a href="#start" class="text-link">{t('Explore a focused pilot','讨论一个具体试点')} ↗</a></div><div class="scene"><div class="scene-header"><span>{t('SCIENTIFIC WORK, CONNECTED','把科研工作连接起来')}</span><button class="replay-button" type="button" aria-label={t(`Replay: ${s.title}`,`重播：${s.title}`)}>↻ {t('Replay','重播')}</button></div>
{s.id==='knowledge' && <div class="knowledge-scene scene-body"><div class="source-stack">{[[t('Experiment files','实验文件'),t('Measurements + conditions','测量结果与实验条件')],[t('Papers & reports','文献与报告'),t('Findings + references','研究发现与参考来源')],[t('Team knowledge','团队知识'),t('Methods + observations','方法与观察记录')]].map((row,j)=><div class={`source-item step-${j+1}`}><div><strong>{row[0]}</strong><span>{row[1]}</span></div></div>)}</div><div class="join-path" aria-hidden="true"><span></span></div><div class="research-record step-4"><div class="record-top">{t('CONNECTED CONTEXT','关联研究背景')}</div><h4>{t('Electrolyte','电解液')}<br/>{t('research','研究')}</h4><div class="record-tags">{[t('Samples','样品'),t('Conditions','条件'),t('Results','结果')].map(x=><span>{x}</span>)}</div><div class="record-bottom">✓ {t('Sources stay connected','保留来源关联')}</div></div><div class="scene-takeaway">{t('Find the work. Understand the context. Build on it.','找到已有工作，理解研究背景，再向前一步。')}</div></div>}
{s.id==='analysis' && <div class="analysis-scene scene-body"><div class="comparison-title">{t('COMPARE BEFORE YOU CONCLUDE','先对照条件，再讨论结论')}</div><table class="comparison-table"><caption class="sr-only">{t('Illustrative experiment conditions','实验条件示意')}</caption><thead><tr><th>{t('Experiment context','实验条件')}</th><th>{t('Run A','实验 A')}</th><th>{t('Run B','实验 B')}</th></tr></thead><tbody><tr class="step-1"><th scope="row">{t('Active material','活性物质')}</th><td>{t('Same','相同')}</td><td>{t('Same','相同')}</td></tr><tr class="step-2"><th scope="row">{t('Solvent','溶剂')}</th><td>DMSO</td><td>DMSO</td></tr><tr class="compare-highlight step-3"><th scope="row">{t('Supporting salt','支持电解质盐')}</th><td>LiTFSI</td><td>NaTFSI</td></tr></tbody></table><div class="analysis-insight step-4"><div><span class="insight-label">{t('A DIFFERENCE TO INVESTIGATE','一个值得进一步调查的差异')}</span><p>{t('What else changed with the supporting salt?','更换电解质盐时，还有哪些条件发生了变化？')}</p></div></div><div class="scene-takeaway">{t('A useful question—not an unsupported conclusion.','发现差异是提出问题的起点，并不能直接证明因果关系。')}</div></div>}
{s.id==='workflow' && <div class="workflow-scene scene-body"><div class="workflow-caption">{t('YOUR EXISTING LAB. A MORE CONNECTED WAY TO WORK.','沿用现有实验室，让工作更连贯。')}</div><div class="workflow-diagram">{[[t('Lab data','实验数据'),t('Instrument exports and research records','仪器导出与实验记录')],[t('Analysis','数据分析'),t('Your methods, connected to inputs','让已有方法接入数据')],[t('Shared findings','共享研究结果'),t('Results ready for your team to review','交由研究团队评估')]].map((row,j)=><>{j>0 && <span class="flow-arrow" aria-hidden="true">→</span>}<div class={`workflow-node step-${j+1}`}><span class="node-number">0{j+1}</span><h4>{row[0]}</h4><p>{row[1]}</p></div></>)}</div><div class="workflow-rail step-4"><span>{t('Less copying between systems','减少系统间重复复制')}</span><span>{t('More continuity between steps','让前后步骤相互衔接')}</span></div><div class="scene-takeaway">{t('Start with one workflow. Keep what already works.','从一个流程开始，保留已经好用的工具。')}</div></div>}
<div class="scene-footer"><span>{t('Service illustration','服务示意')}</span><span>{t('Not a live system or customer dataset','非实时系统或客户数据')}</span></div></div></div>)}
</div></section>
<section class="approach" id="approach"><div class="shell approach-layout"><div class="approach-intro"><span class="eyebrow">{t('02 — HOW WE WORK','02 — 如何合作')}</span><h2>{t('Start with your science.','从你的科学问题出发。')}<br/><em>{t('Build around your reality.','围绕实际工作来构建。')}</em></h2><p>{t('You don’t need to replace your lab to explore what AI can do for it. Start with a defined problem, the resources you already have, and a result you can evaluate.','探索 AI 如何帮助科研，可以从现有数据和工具开始。先明确一个问题，再约定一项可以实际评估的结果。')}</p><span class="approach-note">{t('Focused pilots · Agreed scope · Researcher-led decisions','聚焦试点 · 明确范围 · 研究者主导决策')}</span></div><div class="pilot-accordion">{steps.map((row,i)=><details open={i===0} data-slot="accordion-item"><summary data-slot="accordion-trigger"><span class="accordion-number">0{i+1}</span><span>{row[0]}</span></summary><div data-slot="accordion-content"><div>{row[1]}</div></div></details>)}</div></div></section>
<section class="contact shell" id="start"><span class="eyebrow">{t('THE NEXT STEP','下一步')}</span><div class="contact-layout"><h2>{t('Bring us the problem','从那个一直困扰你的')}<br/>{t('you keep ','问题开始，')}<em>{t('working around.','一起找出路。')}</em></h2><div><p>{t('One workflow. One research bottleneck. Let’s explore what a useful pilot could look like.','一个工作流程，一个科研瓶颈。一起讨论怎样的试点能对你的工作有所帮助。')}</p><a class="button button-dark" href="mailto:zhanglu77@gmail.com?subject=SciencesLoop%20-%20Research%20workflow%20discussion">{t('Discuss your research workflow','聊聊你的科研工作流程')} ↗</a></div></div></section>
</main><footer class="site-footer shell"><div class="footer-top"><a class="wordmark" href={u(`${lp}/`)}>sciences<span>loop</span><b>.</b></a><div>{links.map(([path,label])=><a href={u(`${lp}${path}`)}>{label} ↗</a>)}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} SciencesLoop</span><span>{t('Pilot scope and availability confirmed in discussion.','试点范围与服务安排在沟通后确定。')}</span></div><div class="legal"><a href={u('/privacy/')}>{t('Privacy','隐私政策')}</a><a href={u('/terms/')}>{t('Terms','服务条款')}</a>{zh && <a href={u('/zh/about/')}>张鲁 Lu Zhang</a>}</div></footer>
<script>
 const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-service]'));
 const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
 function select(id: string, focus = false) {
   tabs.forEach(tab => { const active = tab.dataset.service === id; tab.dataset.state = active ? 'active' : 'inactive'; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; if(active && focus) tab.focus(); });
   panels.forEach(panel => { const active = panel.id === `panel-${id}`; panel.hidden = !active; panel.dataset.state = active ? 'active' : 'inactive'; });
 }
 tabs.forEach((tab, index) => { tab.addEventListener('click', () => select(tab.dataset.service!)); tab.addEventListener('keydown', event => { let next = index; if(event.key==='ArrowRight') next=(index+1)%tabs.length; else if(event.key==='ArrowLeft') next=(index+tabs.length-1)%tabs.length; else if(event.key==='Home') next=0; else if(event.key==='End') next=tabs.length-1; else return; event.preventDefault(); select(tabs[next].dataset.service!,true); }); });
 document.querySelectorAll<HTMLAnchorElement>('[data-jump]').forEach(link => link.addEventListener('click', () => select(link.dataset.jump!)));
 document.querySelectorAll<HTMLButtonElement>('.replay-button').forEach(button => button.addEventListener('click', () => { if(matchMedia('(prefers-reduced-motion: reduce)').matches) return; button.closest('.scene')?.querySelectorAll<HTMLElement>('[class*="step-"]').forEach(el => { el.style.animation = 'none'; void el.offsetWidth; el.style.animation = ''; }); }));
 const menu = document.querySelector<HTMLButtonElement>('.mobile-menu-button'); const nav = document.getElementById('mobile-nav');
 function closeMenu(){ if(nav && menu){ nav.hidden=true; menu.setAttribute('aria-expanded','false'); } }
 menu?.addEventListener('click', () => { if(nav){ nav.hidden=!nav.hidden; menu.setAttribute('aria-expanded',String(!nav.hidden)); } });
 nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',closeMenu));
 document.addEventListener('keydown',event=>{if(event.key==='Escape' && nav && !nav.hidden){closeMenu();menu?.focus();}});
</script>
</body></html>
