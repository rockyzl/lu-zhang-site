---
interface Props { locale?: "en" | "zh"; }
const { locale = "en" } = Astro.props;
const apiBaseUrl = (import.meta.env.PUBLIC_REDOX_RFB_API_URL ?? "https://rockyaaos-redox-rfb-predictor.hf.space").trim();
const zh = locale === "zh";
const copy = zh ? {
  eyebrow: "独立研究 · 水系液流电池",
  title: "预测有机分子的氧化还原电位",
  lead: "输入 SMILES 或化学名称。名称助手会先给出可能的名称选项；结构来自 PubChem（找不到时才由 LLM 提议），随后由 RDKit 验证、绘制并由你确认。",
  inputType: "输入方式",
  smiles: "SMILES",
  chemicalName: "化学名称（结构助手）",
  label: "SMILES",
  nameLabel: "化学名称",
  hint: "例如：O=C1C=CC(=O)C=C1（对苯醌）",
  nameHint: "例如：p-benzoquinone、anthraquinone 或 1,4-benzoquinone",
  nameAssistant: "名称助手",
  nameAssistantLead: "先选择一个可能的标准名称，再查看任何结构。",
  originalName: "保留原输入",
  submit: "预览结构",
  resolving: "名称助手正在查找选项…",
  previewing: "RDKit 正在生成结构…",
  confirmTitle: "请确认分子结构",
  confirmLead: "请检查二维结构和 canonical SMILES。确认后才会运行电位预测。",
  confirm: "确认结构并预测",
  edit: "返回修改输入",
  structure: "二维分子结构",
  structureSource: "结构来源",
  editableSmiles: "编辑 SMILES",
  redraw: "重新绘制编辑后的结构",
  editAssistant: "结构编辑助手",
  editAssistantLead: "用自然语言描述你想要的结构变化；助手会提出最多 3 个候选，你仍可选择、编辑并确认。",
  editPlaceholder: "例如：把这个分子改成 oxoammonium form",
  editSend: "提出结构选项",
  howTitle: "这个流程怎样工作？",
  howSteps: [
    ["1. 输入", "你可以直接输入 SMILES；也可以输入化学名称。名称助手先给出可能的名称选项。"],
    ["2. 结构确认", "RDKit 解析并标准化该结构，生成二维图。你检查图和 canonical SMILES 后，主动确认。"],
    ["3. 电位预测", "确认后，RDKit 描述符和 Morgan fingerprint 被送入固定模型，输出 RedDB DFT 电位尺度上的预测值。"],
  ],
  modelTitle: "电位由什么模型预测？",
  modelLead: "在线预测器不是 LLM，也不会现场运行 DFT。它是一个在 RedDB DFT 标签上训练好的 Random Forest 回归模型。",
  modelPipeline: [
    ["分子结构", "确认后的 canonical SMILES"],
    ["结构特征", "26 个 RDKit 描述符 + 1024 位 Morgan fingerprint"],
    ["机器学习", "300 棵决策树分别给出估计，再取平均"],
    ["输出", "水系氧化还原电位，V vs SHE（RedDB DFT 尺度）"],
  ],
  llmRole: "PubChem 是名称到结构的首选来源；只有 PubChem 找不到时，LLM 才会提出候选。LLM 不预测电位，也不替代结构确认。",
  loading: "正在预测…",
  resolved: "用于预测的 SMILES",
  value: "预测氧化还原电位",
  target: "目标",
  model: "模型",
  limitationTitle: "如何理解这个数值",
  limitation: "这是 RedDB 的 DFT 派生标签尺度上的模型预测，不是实验测量值。模型主要见过醌类和含氮芳香分子；远离这些化学家族的输入属于外推。",
  privacy: "提交的 SMILES 或化学名称会发送给公开预测服务。请不要提交保密分子。",
  invalid: "请输入 SMILES 或化学名称。",
  nameFailed: "无法可靠地把这个名称解析成分子结构。请改用 SMILES。",
  unavailable: "预测服务暂时不可用，请稍后重试。",
  source: "查看在线服务说明",
} : {
  eyebrow: "Independent research · aqueous flow batteries",
  title: "Predict an organic molecule's redox potential",
  lead: "Enter a SMILES string or chemical name. The structure assistant first offers possible name matches; structures come from PubChem when available (with LLM fallback), then RDKit validates, draws, and you confirm them.",
  inputType: "Input type",
  smiles: "SMILES",
  chemicalName: "Chemical name (structure assistant)",
  label: "SMILES",
  nameLabel: "Chemical name",
  hint: "Example: O=C1C=CC(=O)C=C1 (p-benzoquinone)",
  nameHint: "Example: p-benzoquinone, anthraquinone, or 1,4-benzoquinone",
  nameAssistant: "Name assistant",
  nameAssistantLead: "Choose a possible standardized name before viewing any structure.",
  originalName: "Keep my original input",
  submit: "Preview structure",
  resolving: "The name assistant is finding options…",
  previewing: "RDKit is rendering the structure…",
  confirmTitle: "Confirm the molecular structure",
  confirmLead: "Check the 2D structure and canonical SMILES. Prediction starts only after confirmation.",
  confirm: "Confirm structure and predict",
  edit: "Edit input",
  structure: "2D molecular structure",
  structureSource: "Structure source",
  editableSmiles: "Edit SMILES",
  redraw: "Render edited structure",
  editAssistant: "Structure editing assistant",
  editAssistantLead: "Describe a structure change in plain language. The assistant may propose up to three candidates; you still select, edit, and confirm one.",
  editPlaceholder: "For example: convert this molecule to the oxoammonium form",
  editSend: "Propose structure options",
  howTitle: "How this works",
  howSteps: [
    ["1. Enter", "You can enter a SMILES string directly, or a chemical name. In name mode, the assistant first offers possible name matches."],
    ["2. Confirm structure", "RDKit parses and canonicalizes the structure, then renders a 2D diagram. You inspect the diagram and canonical SMILES before explicitly confirming it."],
    ["3. Predict potential", "After confirmation, RDKit descriptors and a Morgan fingerprint go to the fixed model, which returns a prediction on RedDB's DFT potential scale."],
  ],
  modelTitle: "What model predicts the potential?",
  modelLead: "The live predictor is not an LLM and does not run DFT on demand. It is a Random Forest regression model trained on RedDB's DFT-derived labels.",
  modelPipeline: [
    ["Molecular structure", "The confirmed canonical SMILES"],
    ["Structure features", "26 RDKit descriptors + a 1024-bit Morgan fingerprint"],
    ["Machine learning", "300 decision trees each estimate a value; their estimates are averaged"],
    ["Output", "Aqueous redox potential, V vs SHE (RedDB DFT scale)"],
  ],
  llmRole: "PubChem is the preferred name-to-structure source; the LLM proposes candidates only if PubChem cannot find a name. The LLM does not predict potential and does not replace structure confirmation.",
  loading: "Predicting…",
  resolved: "SMILES used for prediction",
  value: "Predicted redox potential",
  target: "Target",
  model: "Model",
  limitationTitle: "How to read this number",
  limitation: "This is a model prediction on RedDB's DFT-derived label scale, not an experimental measurement. The training domain is mainly quinones and aza-aromatics; inputs far from those families are extrapolations.",
  privacy: "The submitted SMILES or chemical name is sent to a public prediction service. Do not submit confidential molecules.",
  invalid: "Enter a SMILES string or chemical name.",
  nameFailed: "This name could not be reliably resolved to a molecular structure. Try a SMILES string instead.",
  unavailable: "The prediction service is unavailable. Please try again later.",
  source: "View service notes",
};
---

<section class="rrp" aria-labelledby="redox-title">
  <p class="rrp-eyebrow">{copy.eyebrow}</p>
  <h1 id="redox-title">{copy.title}</h1>
  <p class="rrp-lead">{copy.lead}</p>

  <form data-redox-form class="rrp-card">
    <label for="redox-input-type">{copy.inputType}</label>
    <select id="redox-input-type" data-redox-input-type>
      <option value="smiles">{copy.smiles}</option>
      <option value="name">{copy.chemicalName}</option>
    </select>
    <label for="redox-smiles" data-redox-label>{copy.label}</label>
    <input id="redox-smiles" data-redox-smiles value="O=C1C=CC(=O)C=C1" maxlength="512" autocomplete="off" spellcheck="false" />
    <p class="rrp-hint" data-redox-hint>{copy.hint}</p>
    <button type="submit" data-redox-submit>{copy.submit}</button>
    <p class="rrp-status" data-redox-status aria-live="polite"></p>
  </form>

  <section class="rrp-name-chat" data-redox-name-chat hidden aria-live="polite">
    <p class="rrp-result-label">{copy.nameAssistant}</p>
    <p>{copy.nameAssistantLead}</p>
    <div class="rrp-option-list" data-redox-name-options></div>
  </section>

  <section class="rrp-confirm" data-redox-confirm hidden aria-live="polite">
    <div>
      <p class="rrp-result-label">{copy.confirmTitle}</p>
      <p class="rrp-confirm-lead">{copy.confirmLead}</p>
      <p class="rrp-resolved"><span>{copy.resolved}:</span> <code data-redox-confirm-smiles></code></p>
      <p class="rrp-source" data-redox-source></p>
      <div class="rrp-option-list" data-redox-candidates></div>
      <label class="rrp-edit-label" for="redox-edit-smiles">{copy.editableSmiles}</label>
      <input id="redox-edit-smiles" data-redox-edit-smiles maxlength="512" autocomplete="off" spellcheck="false" />
      <div class="rrp-actions">
        <button type="button" data-redox-confirm-button>{copy.confirm}</button>
        <button type="button" class="rrp-secondary" data-redox-redraw>{copy.redraw}</button>
        <button type="button" class="rrp-secondary" data-redox-edit>{copy.edit}</button>
      </div>
    </div>
    <figure><img data-redox-confirm-image alt={copy.structure} /><figcaption>{copy.structure}</figcaption></figure>
  </section>

  <section class="rrp-edit-chat" data-redox-edit-chat hidden>
    <p class="rrp-result-label">{copy.editAssistant}</p>
    <p>{copy.editAssistantLead}</p>
    <p class="rrp-chat-reply" data-redox-chat-reply aria-live="polite"></p>
    <div class="rrp-option-list" data-redox-chat-options></div>
    <label for="redox-chat-instruction">{copy.editAssistant}</label>
    <input id="redox-chat-instruction" data-redox-chat-input maxlength="400" autocomplete="off" placeholder={copy.editPlaceholder} />
    <button type="button" data-redox-chat-send>{copy.editSend}</button>
  </section>

  <section class="rrp-result" data-redox-result hidden aria-live="polite">
    <div class="rrp-result-structure"><img data-redox-result-image alt={copy.structure} /><p class="rrp-resolved"><span>{copy.resolved}:</span> <code data-redox-result-smiles></code></p></div>
    <p class="rrp-result-label">{copy.value}</p>
    <strong data-redox-value></strong>
    <dl>
      <div><dt>{copy.model}</dt><dd data-redox-model></dd></div>
      <div><dt>{copy.target}</dt><dd data-redox-target></dd></div>
    </dl>
  </section>

  <section class="rrp-how" aria-labelledby="redox-how-title">
    <p class="rrp-result-label" id="redox-how-title">{copy.howTitle}</p>
    <ol>
      {copy.howSteps.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}
    </ol>
  </section>

  <section class="rrp-model" aria-labelledby="redox-model-title">
    <p class="rrp-result-label" id="redox-model-title">{copy.modelTitle}</p>
    <p class="rrp-model-lead">{copy.modelLead}</p>
    <div class="rrp-model-pipeline">
      {copy.modelPipeline.map(([title, text]) => <div><strong>{title}</strong><span>{text}</span></div>)}
    </div>
    <p class="rrp-model-llm">{copy.llmRole}</p>
  </section>

  <aside class="rrp-note">
    <strong>{copy.limitationTitle}</strong>
    <p>{copy.limitation}</p>
    <p>{copy.privacy}</p>
    <a href="https://huggingface.co/spaces/rockyaaos/redox-rfb-predictor" target="_blank" rel="noreferrer">{copy.source} ↗</a>
  </aside>
</section>

<style>
  .rrp { max-width: 800px; margin: 0 auto; padding: 3rem 1.25rem 5rem; color: #17212b; }
  .rrp-eyebrow { margin: 0 0 .55rem; color: #147a49; font-size: .8rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .rrp h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.3rem); line-height: 1.06; letter-spacing: -.04em; }
  .rrp-lead { max-width: 720px; color: #4b5966; font-size: 1.08rem; line-height: 1.65; }
  .rrp-card, .rrp-name-chat, .rrp-confirm, .rrp-edit-chat, .rrp-result, .rrp-how, .rrp-model, .rrp-note { border: 1px solid #dbe5df; border-radius: 16px; padding: 1.35rem; margin-top: 1.5rem; background: #fff; box-shadow: 0 9px 26px rgba(17, 55, 38, .06); }
  .rrp label, .rrp-result-label { display: block; font-weight: 750; margin-bottom: .55rem; }
  .rrp input, .rrp select { box-sizing: border-box; width: 100%; border: 1px solid #b8c9bd; border-radius: 9px; padding: .85rem; margin-bottom: .75rem; background: #fff; }
  .rrp input { font: 500 .96rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  .rrp-hint, .rrp-status { color: #64726b; font-size: .88rem; }
  .rrp button { border: 0; border-radius: 9px; background: #147a49; color: white; font-weight: 750; padding: .75rem 1.05rem; cursor: pointer; }
  .rrp button:disabled { cursor: wait; opacity: .7; }
  .rrp-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
  .rrp-option-list { display: flex; flex-wrap: wrap; gap: .55rem; margin: .7rem 0; }
  .rrp-option-list button { background: #edf4ef; color: #22533b; text-align: left; padding: .55rem .7rem; font-size: .85rem; }
  .rrp-option-list button[aria-pressed="true"] { background: #147a49; color: #fff; }
  .rrp-source, .rrp-chat-reply { color: #536159; font-size: .88rem; line-height: 1.45; }
  .rrp-edit-label { margin-top: .9rem; }
  .rrp-edit-chat { background: #fbfdfb; box-shadow: none; }
  .rrp .rrp-secondary { background: #edf4ef; color: #24533a; }
  .rrp-confirm { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(220px, .75fr); align-items: center; gap: 1.5rem; }
  .rrp-confirm-lead { color: #526259; margin-top: 0; line-height: 1.5; }
  .rrp-confirm figure { margin: 0; text-align: center; }
  .rrp-confirm img, .rrp-result-structure img { width: 100%; max-width: 360px; min-height: 150px; object-fit: contain; background: #fbfdfb; border: 1px solid #e4ece7; border-radius: 10px; }
  .rrp-confirm figcaption { color: #65736b; font-size: .8rem; margin-top: .35rem; }
  .rrp-result-label { color: #526259; font-size: .88rem; text-transform: uppercase; letter-spacing: .06em; }
  .rrp-result strong { color: #08703d; font-size: clamp(2rem, 7vw, 3.6rem); letter-spacing: -.045em; }
  .rrp-resolved { color: #506059; font-size: .9rem; margin: 0 0 1rem; }
  .rrp-resolved span { font-weight: 700; }
  .rrp-resolved code { overflow-wrap: anywhere; }
  .rrp-result-structure { display: grid; grid-template-columns: minmax(200px, .8fr) minmax(0, 1.2fr); gap: 1.25rem; align-items: center; margin-bottom: 1.25rem; }
  .rrp-result-structure .rrp-resolved { margin: 0; }
  .rrp dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin: 1.4rem 0 0; }
  .rrp dl div { border-top: 1px solid #e4ece7; padding-top: .7rem; }
  .rrp dt { color: #65736b; font-size: .78rem; font-weight: 700; text-transform: uppercase; }
  .rrp dd { margin: .25rem 0 0; font-weight: 650; }
  .rrp-note { background: #f4faf6; box-shadow: none; color: #435149; line-height: 1.55; }
  .rrp-how { box-shadow: none; background: #fbfdfb; }
  .rrp-how ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; list-style: none; margin: 0; padding: 0; }
  .rrp-how li { border-top: 2px solid #b9d7c2; padding-top: .65rem; color: #526259; line-height: 1.5; font-size: .92rem; }
  .rrp-how li strong, .rrp-how li span { display: block; }
  .rrp-how li strong { color: #17683f; margin-bottom: .25rem; }
  .rrp-model { background: #f7faf8; box-shadow: none; }
  .rrp-model-lead { max-width: 680px; color: #4e5e55; line-height: 1.55; margin-top: 0; }
  .rrp-model-pipeline { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .7rem; }
  .rrp-model-pipeline div { position: relative; border: 1px solid #dbe8df; border-radius: 10px; padding: .75rem; background: #fff; min-height: 78px; }
  .rrp-model-pipeline strong, .rrp-model-pipeline span { display: block; }
  .rrp-model-pipeline strong { color: #166b40; font-size: .82rem; margin-bottom: .35rem; }
  .rrp-model-pipeline span { color: #536159; font-size: .84rem; line-height: 1.4; }
  .rrp-model-llm { color: #536159; font-size: .9rem; line-height: 1.5; margin: 1rem 0 0; }
  .rrp-note p { margin: .55rem 0; }
  .rrp-note a { color: #086a3a; font-weight: 700; }
  @media (max-width: 640px) { .rrp-confirm, .rrp-result-structure, .rrp-how ol, .rrp-model-pipeline { grid-template-columns: 1fr; } }
</style>

<script define:vars={{ apiBaseUrl, copy }}>
  const form = document.querySelector("[data-redox-form]");
  const input = document.querySelector("[data-redox-smiles]");
  const inputType = document.querySelector("[data-redox-input-type]");
  const inputLabel = document.querySelector("[data-redox-label]");
  const hint = document.querySelector("[data-redox-hint]");
  const button = document.querySelector("[data-redox-submit]");
  const status = document.querySelector("[data-redox-status]");
  const nameChat = document.querySelector("[data-redox-name-chat]");
  const nameOptions = document.querySelector("[data-redox-name-options]");
  const confirm = document.querySelector("[data-redox-confirm]");
  const confirmButton = document.querySelector("[data-redox-confirm-button]");
  const editButton = document.querySelector("[data-redox-edit]");
  const redrawButton = document.querySelector("[data-redox-redraw]");
  const confirmSmiles = document.querySelector("[data-redox-confirm-smiles]");
  const editSmiles = document.querySelector("[data-redox-edit-smiles]");
  const source = document.querySelector("[data-redox-source]");
  const candidates = document.querySelector("[data-redox-candidates]");
  const confirmImage = document.querySelector("[data-redox-confirm-image]");
  const editChat = document.querySelector("[data-redox-edit-chat]");
  const chatInput = document.querySelector("[data-redox-chat-input]");
  const chatSend = document.querySelector("[data-redox-chat-send]");
  const chatReply = document.querySelector("[data-redox-chat-reply]");
  const chatOptions = document.querySelector("[data-redox-chat-options]");
  const result = document.querySelector("[data-redox-result]");
  const value = document.querySelector("[data-redox-value]");
  const model = document.querySelector("[data-redox-model]");
  const target = document.querySelector("[data-redox-target]");
  const resultSmiles = document.querySelector("[data-redox-result-smiles]");
  const resultImage = document.querySelector("[data-redox-result-image]");
  let selectedStructure = null;

  const endpoint = (path) => new URL(path, `${apiBaseUrl.replace(/\/$/, "")}/`).href;
  const setStructureImage = (image, svg) => {
    image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
  };
  const requestJson = async (path, body) => {
    const response = await fetch(endpoint(path), {
      method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data.schema_version !== "redox-rfb-live-v1") throw new Error(data?.detail || "request failed");
    return data;
  };

  function candidateButton(candidate, selected, onClick) {
    const item = document.createElement("button");
    item.type = "button";
    item.textContent = candidate.label || candidate.smiles;
    item.setAttribute("aria-pressed", String(selected));
    item.addEventListener("click", onClick);
    return item;
  }

  function renderCandidateChoices(list, active, mount) {
    mount.replaceChildren(...list.map((candidate) => candidateButton(
      candidate,
      candidate.smiles === active.smiles,
      () => showStructure(candidate, list),
    )));
  }

  function showStructure(candidate, list = [candidate]) {
    selectedStructure = candidate;
    confirmSmiles.textContent = candidate.smiles;
    editSmiles.value = candidate.smiles;
    source.textContent = `${copy.structureSource}: ${candidate.source || "RDKit validation"}`;
    setStructureImage(confirmImage, candidate.svg);
    renderCandidateChoices(list, candidate, candidates);
    confirm.hidden = false;
    editChat.hidden = false;
    result.hidden = true;
  }

  function manualCandidate(structure) {
    return {
      id: "manual", label: copy.editableSmiles, source: "RDKit validation", smiles: structure.smiles, svg: structure.svg,
    };
  }

  function setInputMode() {
    const isName = inputType?.value === "name";
    inputLabel.textContent = isName ? copy.nameLabel : copy.label;
    hint.textContent = isName ? copy.nameHint : copy.hint;
    input.value = isName ? "p-benzoquinone" : "O=C1C=CC(=O)C=C1";
    input.maxLength = isName ? 200 : 512;
    nameChat.hidden = true;
    confirm.hidden = true;
    editChat.hidden = true;
    result.hidden = true;
    selectedStructure = null;
  }
  inputType?.addEventListener("change", setInputMode);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    let raw = input?.value.trim();
    if (!raw) { status.textContent = copy.invalid; result.hidden = true; return; }
    button.disabled = true;
    button.textContent = copy.previewing;
    status.textContent = "";
    result.hidden = true;
    confirm.hidden = true;
    editChat.hidden = true;
    nameChat.hidden = true;
    selectedStructure = null;
    try {
      if (inputType?.value === "name") {
        button.textContent = copy.resolving;
        const data = await requestJson("v1/suggest-name", { name: raw });
        const labels = [raw, ...(Array.isArray(data.suggestions) ? data.suggestions : [])]
          .filter((item, index, all) => typeof item === "string" && item.trim() && all.indexOf(item) === index)
          .slice(0, 6);
        nameOptions.replaceChildren(...labels.map((name) => candidateButton(
          { label: name }, false, () => resolveSelectedName(name),
        )));
        nameChat.hidden = false;
      } else {
        const data = await requestJson("v1/preview-structure", { smiles: raw });
        showStructure(manualCandidate(data));
      }
    } catch (_) {
      status.textContent = inputType?.value === "name" ? copy.nameFailed : copy.unavailable;
    } finally {
      button.disabled = false;
      button.textContent = copy.submit;
    }
  });

  async function resolveSelectedName(name) {
    status.textContent = copy.resolving;
    nameChat.hidden = true;
    try {
      const data = await requestJson("v1/resolve-name", { name });
      if (!Array.isArray(data.candidates) || data.candidates.length === 0) throw new Error("no structure candidates");
      showStructure(data.candidates[0], data.candidates);
      status.textContent = "";
    } catch (_) {
      status.textContent = copy.nameFailed;
      nameChat.hidden = false;
    }
  }

  redrawButton?.addEventListener("click", async () => {
    const smiles = editSmiles.value.trim();
    if (!smiles) return;
    redrawButton.disabled = true;
    status.textContent = copy.previewing;
    try {
      const data = await requestJson("v1/preview-structure", { smiles });
      showStructure(manualCandidate(data));
      status.textContent = "";
    } catch (_) {
      status.textContent = copy.unavailable;
    } finally {
      redrawButton.disabled = false;
    }
  });

  editButton?.addEventListener("click", () => {
    confirm.hidden = true;
    editChat.hidden = true;
    nameChat.hidden = true;
    input.focus();
  });

  chatSend?.addEventListener("click", async () => {
    const instruction = chatInput.value.trim();
    if (!instruction || !selectedStructure) return;
    chatSend.disabled = true;
    chatReply.textContent = copy.resolving;
    chatOptions.replaceChildren();
    try {
      const data = await requestJson("v1/structure-chat", {
        instruction, current_smiles: selectedStructure.smiles,
      });
      chatReply.textContent = data.reply || "";
      const proposed = Array.isArray(data.candidates) ? data.candidates : [];
      chatOptions.replaceChildren(...proposed.map((candidate) => candidateButton(
        candidate, false, () => showStructure(candidate, proposed),
      )));
    } catch (_) {
      chatReply.textContent = copy.unavailable;
    } finally {
      chatSend.disabled = false;
    }
  });

  confirmButton?.addEventListener("click", async () => {
    if (!selectedStructure) return;
    confirmButton.disabled = true;
    confirmButton.textContent = copy.loading;
    status.textContent = "";
    result.hidden = true;
    try {
      const data = await requestJson("v1/predict", { smiles: selectedStructure.smiles });
      if (!Number.isFinite(data?.prediction?.value)) throw new Error("bad response");
      value.textContent = `${data.prediction.value.toFixed(3)} ${data.prediction.unit}`;
      model.textContent = data.model.label;
      target.textContent = data.target.reference;
      resultSmiles.textContent = selectedStructure.smiles;
      setStructureImage(resultImage, selectedStructure.svg);
      result.hidden = false;
    } catch (_) {
      status.textContent = copy.unavailable;
    } finally {
      confirmButton.disabled = false;
      confirmButton.textContent = copy.confirm;
    }
  });
</script>
