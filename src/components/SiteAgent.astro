---
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en", mode = "full" } = Astro.props as { locale?: Locale; mode?: "full" | "home" };
const agentApiUrl = import.meta.env.PUBLIC_AGENT_API_URL ?? "https://api.sciencesloop.com/api/agent";
const isHomeMode = mode === "home";

const copy = locale === "zh"
  ? {
      eyebrow: "站内智能体",
      title: "问 Lu Zhang 网站智能体",
      lead: agentApiUrl
        ? "这是一个公开安全的 SciencesLoop 智能体：它会调用后端 RAG / LLM API，目标是基于公开网站内容回答，并在可用时返回引用来源。"
        : "这是一个公开安全的站内智能体：当前本地模式不调用外部模型，只把访客问题映射到公开网站里的论文、项目、学术 CV、AI 工作和联系方式。",
      placeholder: "输入关键词：agent, RAG, MLOps, battery, Argonne, publications, contact...",
      send: "查询",
      starter: "可以先问：",
      status: agentApiUrl ? "public-safe RAG agent" : "public-safe static agent",
      statusBadge: "公开语料",
      matched: "匹配主题",
      next: "建议下一步",
      plan: "执行路径",
      actionsLabel: "可执行导航",
      followupsLabel: "继续追问",
      thinking: "正在检索公开语料并生成回答...",
      apiError: "实时 agent 暂时不可用，已切换到本地规则回答。",
      sources: "来源",
      note: agentApiUrl
        ? "当前版本调用 SciencesLoop 后端，只使用公开网站语料；未连接私人文件。可用时会返回引用来源。"
        : "当前版本在浏览器端运行，只基于公开网站内容做导航；未连接私人文件。线上 API 不可用时会保留这个本地 fallback。",
      fallback: "我现在只能回答公开网站里的核心主题。可以试试 agent reliability、AI for science、MLOps、battery、Argonne、publication、patent、academic CV、contact、VoiceRAG。",
      actions: {
        ai: "看研究方向",
        publications: "看论文",
        cv: "学术 CV",
        contact: "联系 Lu",
        roadmap: "查看路线图",
      },
      prompts: [
        "Lu 的 AI for Science 方向是什么？",
        "哪些证据体现 agent reliability 能力？",
        "他有哪些 MLOps / evaluation 经验？",
        "他的电池和液流电池背景是什么？",
        "Lu 的主要合作者是谁？",
        "我应该先看哪些论文或专利？",
      ],
    }
  : {
      eyebrow: "Site Agent",
      title: "Ask Lu Zhang's Website Agent",
      lead: agentApiUrl
        ? "A public-safe SciencesLoop agent backed by a RAG / LLM API. It is intended to answer from public website content and returns cited sources when available."
        : "A public-safe site agent for this portfolio. In local mode it does not call an external model; it maps visitor questions to the most relevant public research, AI work, academic CV, and contact paths.",
      placeholder: "Type keywords: agent, RAG, MLOps, battery, Argonne, publications, contact...",
      send: "Ask",
      starter: "Try asking:",
      status: agentApiUrl ? "public-safe RAG agent" : "public-safe static agent",
      statusBadge: "public corpus",
      matched: "Matched topic",
      next: "Suggested next step",
      plan: "Agent path",
      actionsLabel: "Next actions",
      followupsLabel: "Follow up",
      thinking: "Retrieving public context and generating an answer...",
      apiError: "Live agent is temporarily unavailable, so I switched to the local rules answer.",
      sources: "Sources",
      note: agentApiUrl
        ? "This version calls the SciencesLoop backend using only public website corpus. It is not connected to private files and returns cited sources when available."
        : "This version runs in the browser and only routes across public site content. It is not connected to private files, and it remains available as a local fallback when the live API is unavailable.",
      fallback: "I can answer the core public site topics for now. Try agent reliability, AI for science, MLOps, battery, Argonne, publication, patent, academic CV, contact, or VoiceRAG.",
      actions: {
        ai: "View programs",
        publications: "View publications",
        cv: "Academic CV",
        contact: "Contact Lu",
        roadmap: "View roadmap",
      },
      prompts: [
        "What is Lu's AI for Science direction?",
        "What evidence shows agent reliability skills?",
        "What MLOps and evaluation experience does he have?",
        "What is his battery and redox-flow background?",
        "Who are Lu's main collaborators?",
        "Which papers or patents should I look at first?",
      ],
    };

const links = {
  ai: u(locale === "zh" ? "/zh/ai/" : "/ai/"),
  publications: u(locale === "zh" ? "/zh/publications/" : "/publications/"),
  patents: u(locale === "zh" ? "/zh/patents/" : "/patents/"),
  projects: u(locale === "zh" ? "/zh/projects/" : "/projects/"),
  collaborators: u(locale === "zh" ? "/zh/collaborators/" : "/collaborators/"),
  about: u(locale === "zh" ? "/zh/about/" : "/about/"),
  awards: u(locale === "zh" ? "/zh/awards/" : "/awards/"),
  cv: u("/files/Lu_Zhang_CV.pdf"),
  scholar: "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
  github: "https://github.com/rockyzl",
  linkedin: "https://www.linkedin.com/in/lu-zhang-argonne/",
  email: "mailto:zhanglu77@gmail.com",
  voicerag: "https://voicerag.sciencesloop.com/",
};
---

<section class={`agent-shell agent-shell--${mode}`} data-site-agent data-locale={locale}>
  <div class="agent-panel">
    {!isHomeMode && (
      <div class="agent-copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.title}</h1>
        <p class="lead">{copy.lead}</p>
        <div class="agent-actions">
          <a class="btn btn-primary" href={links.ai}>{copy.actions.ai}</a>
          <a class="btn btn-ghost" href={links.publications}>{copy.actions.publications}</a>
          <a class="btn btn-ghost" href={links.cv} target="_blank" rel="noopener">{copy.actions.cv}</a>
          <a class="btn btn-ghost" href={links.email}>{copy.actions.contact}</a>
        </div>
      </div>
    )}

    <div class="agent-card" aria-live="polite">
      <div class="agent-card-header">
        <div>
          <div class="agent-title">SciencesLoop Agent</div>
          <div class="agent-subtitle">{copy.status}</div>
        </div>
        <span class="agent-status">{copy.statusBadge}</span>
      </div>

      <form class="agent-form" data-agent-form>
        <input name="query" type="text" autocomplete="off" placeholder={copy.placeholder} />
        <button type="submit">{copy.send}</button>
      </form>

      <div class="agent-answer" data-agent-answer>
        <div class="agent-topic">{copy.matched}: {locale === "zh" ? "开始" : "Start"}</div>
        <div>
          {locale === "zh"
            ? "你好。我可以帮你快速了解 Lu 的 AI for Science、agent 系统、电池材料、论文专利和职业背景。"
            : "Hi. I can help you navigate Lu's AI for Science, agent systems, battery materials, publications, patents, and career background."}
        </div>
        <div class="agent-next">{copy.next}: <a href={links.ai}>{copy.actions.ai}</a></div>
      </div>

      <div class="agent-suggestions">
        <div class="agent-label">{copy.starter}</div>
        {copy.prompts.map((prompt) => (
          <button type="button" data-agent-prompt={prompt}>{prompt}</button>
        ))}
      </div>

      <div class="agent-quicklinks" aria-label="Agent quick links">
        <a href={links.ai}>{copy.actions.ai}</a>
        <a href={links.projects}>{locale === "zh" ? "软件" : "Software"}</a>
        <a href={links.publications}>{copy.actions.publications}</a>
        <a href={links.about}>{locale === "zh" ? "背景" : "Background"}</a>
      </div>
      <p class="agent-note">{copy.note}</p>
    </div>
  </div>
</section>

<script define:vars={{ links, fallback: copy.fallback, agentApiUrl, labels: { matched: copy.matched, next: copy.next, plan: copy.plan, actionsLabel: copy.actionsLabel, followupsLabel: copy.followupsLabel, thinking: copy.thinking, apiError: copy.apiError, sources: copy.sources } }}>
  const answerSets = {
    en: [
      {
        topic: "AI for Science agents",
        next: `<a href="${links.ai}">Open AI projects</a>`,
        keys: ["agent", "agents", "rag", "mcp", "langgraph", "workflow", "harness", "ai for science", "scientific agent"],
        html: `Lu's current direction is AI for Science through reliable agent systems: context engineering, evaluation harnesses, multi-agent orchestration, traceable workflow execution, and human-in-the-loop scientific decision support. The public site highlights this as a bridge between battery science and applied AI systems.`,
      },
      {
        topic: "MLOps and evaluation",
        next: `<a href="${links.ai}">Review AI systems work</a>`,
        keys: ["mlops", "eval", "evaluation", "observability", "trace", "smoke test", "deployment", "azure", "docker", "search"],
        html: `Lu's recent AI engineering profile emphasizes application-layer reliability practices: retrieval checks, smoke tests, trace review, Docker/Azure deployment-readiness learning, and rollback-aware search-index workflows. This is application-layer AI/MLOps practice, not model pretraining or infrastructure ownership.`,
      },
      {
        topic: "Battery materials and redox-flow background",
        next: `<a href="${links.publications}">Browse publications</a>`,
        keys: ["battery", "redox", "flow", "electrolyte", "redoxmer", "materials"],
        html: `Lu's scientific base is battery materials and electrochemistry: redox-flow batteries, redox-active organic molecules, Li-ion electrolyte additives, redox shuttles, silicon-anode binders, and molecular design. See <a href="${links.publications}">publications</a> and <a href="${links.patents}">patents</a>.`,
      },
      {
        topic: "Publications and patents",
        next: `<a href="${links.scholar}" target="_blank" rel="noopener">Open Google Scholar</a>`,
        keys: ["publication", "paper", "citation", "scholar", "patent"],
        html: `For publication depth, use the <a href="${links.publications}">publication list</a> and <a href="${links.scholar}" target="_blank" rel="noopener">Google Scholar</a>. For invention output, see <a href="${links.patents}">patents</a>.`,
      },
      {
        topic: "Argonne and autonomous discovery",
        next: `<a href="${links.projects}">Review research projects</a>`,
        keys: ["argonne", "anl", "autonomous", "discovery", "robotic", "jcesr", "doe", "national lab"],
        html: `Lu spent 14+ years at Argonne working on battery materials, redox molecules, DOE/JCESR programs, and selected AI/ML, high-throughput, and autonomous-discovery collaborations. The strongest positioning is AI for Science built on deep scientific domain expertise.`,
      },
      {
        topic: "Scientific collaborators",
        next: `<a href="${links.collaborators}">Open collaborators</a>`,
        keys: ["collaborator", "collaborators", "collaboraror", "collaboration", "coauthor", "co-author", "co authors", "coworker", "partner"],
        html: `The <a href="${links.collaborators}">Collaborators</a> page lists Lu's public co-author network from peer-reviewed publications, including principal collaborators by co-authored paper count and institutional context where available.`,
      },
      {
        topic: "VoiceRAG / Lightyear demo",
        next: `<a href="${links.voicerag}" target="_blank" rel="noopener">Open VoiceRAG</a>`,
        keys: ["voicerag", "voice", "guangnian", "lightyear", "sciencesloop"],
        html: `The VoiceRAG / Lightyear work is a live voice-RAG demo/prototype using realtime voice interaction and retrieval patterns. Open <a href="${links.voicerag}" target="_blank" rel="noopener">voicerag.sciencesloop.com</a>.`,
      },
      {
        topic: "Contact and profile links",
        next: `<a href="${links.cv}" target="_blank" rel="noopener">Open academic CV</a>`,
        keys: ["cv", "resume", "linkedin", "github", "contact", "email"],
        html: `Use the <a href="${links.cv}" target="_blank" rel="noopener">academic CV PDF</a> for the public academic record, <a href="${links.linkedin}" target="_blank" rel="noopener">LinkedIn</a> for career context, <a href="${links.github}" target="_blank" rel="noopener">GitHub</a> for code, or <a href="${links.email}">email Lu</a>.`,
      },
    ],
    zh: [
      {
        topic: "AI for Science 智能体",
        next: `<a href="${links.ai}">打开 AI 项目</a>`,
        keys: ["agent", "智能体", "rag", "mcp", "langgraph", "workflow", "工作流", "ai for science"],
        html: `Lu 现在的主线是把可靠 agent 系统用于 AI for Science：context engineering、evaluation harnesses、multi-agent orchestration、可追踪工作流和 human-in-the-loop 科学决策支持。这个方向把电池材料科学背景和应用层 AI 系统结合起来。`,
      },
      {
        topic: "MLOps 与 evaluation",
        next: `<a href="${links.ai}">查看 AI 系统工作</a>`,
        keys: ["mlops", "eval", "evaluation", "评估", "观测", "trace", "smoke test", "部署", "azure", "docker", "search"],
        html: `Lu 最近公开可描述的 AI 工程重点是应用层可靠性实践：retrieval checks、smoke tests、trace review、Docker/Azure deployment-readiness learning，以及可回滚的 search-index 工作流。这是应用层 AI/MLOps 实践，不是模型预训练或底层基础设施所有权。`,
      },
      {
        topic: "电池材料与液流电池",
        next: `<a href="${links.publications}">浏览论文</a>`,
        keys: ["battery", "电池", "redox", "flow", "液流", "electrolyte", "电解液", "redoxmer", "materials", "材料"],
        html: `Lu 的科学基础是电池材料和电化学：液流电池、氧化还原活性有机分子、锂离子电解液添加剂、redox shuttle、硅负极粘合剂和分子设计。可看 <a href="${links.publications}">论文</a> 和 <a href="${links.patents}">专利</a>。`,
      },
      {
        topic: "论文与专利",
        next: `<a href="${links.scholar}" target="_blank" rel="noopener">打开 Google Scholar</a>`,
        keys: ["publication", "paper", "论文", "citation", "引用", "scholar", "patent", "专利"],
        html: `论文和引用看 <a href="${links.publications}">publication list</a> 与 <a href="${links.scholar}" target="_blank" rel="noopener">Google Scholar</a>。发明成果看 <a href="${links.patents}">专利</a>。`,
      },
      {
        topic: "Argonne 与 autonomous discovery",
        next: `<a href="${links.projects}">查看科研项目</a>`,
        keys: ["argonne", "anl", "阿贡", "autonomous", "自主发现", "discovery", "robotic", "机器人", "jcesr", "doe", "国家实验室"],
        html: `Lu 在 Argonne 有 14+ 年电池材料、redox molecules、DOE/JCESR 项目经验，并参与过部分 AI/ML、高通量和 autonomous-discovery 合作。最强定位是以深厚科学背景为基础的 AI for Science。`,
      },
      {
        topic: "科研合作者",
        next: `<a href="${links.collaborators}">打开合作者页面</a>`,
        keys: ["collaborator", "collaborators", "collaboraror", "collaboration", "coauthor", "co-author", "合作者", "合作", "共同作者", "共同发表"],
        html: `<a href="${links.collaborators}">Collaborators</a> 页面列出 Lu 基于公开论文整理的共同作者网络，包括主要合作者、共同发表数量和可公开展示的机构信息。`,
      },
      {
        topic: "VoiceRAG / Lightyear demo",
        next: `<a href="${links.voicerag}" target="_blank" rel="noopener">打开 VoiceRAG</a>`,
        keys: ["voicerag", "voice", "语音", "guangnian", "光年", "lightyear", "sciencesloop"],
        html: `VoiceRAG / Lightyear 是一个在线 voice-RAG demo/prototype，结合 realtime voice interaction 和检索模式。打开 <a href="${links.voicerag}" target="_blank" rel="noopener">voicerag.sciencesloop.com</a>。`,
      },
      {
        topic: "联系与公开链接",
        next: `<a href="${links.cv}" target="_blank" rel="noopener">打开学术 CV</a>`,
        keys: ["cv", "resume", "简历", "linkedin", "github", "contact", "email", "联系"],
        html: `公开学术记录看 <a href="${links.cv}" target="_blank" rel="noopener">学术 CV PDF</a>，职业背景看 <a href="${links.linkedin}" target="_blank" rel="noopener">LinkedIn</a>，代码看 <a href="${links.github}" target="_blank" rel="noopener">GitHub</a>，也可以 <a href="${links.email}">邮件联系 Lu</a>。`,
      },
    ],
  };

  function reply(locale, query) {
    const normalized = query.toLowerCase();
    const set = answerSets[locale] || answerSets.en;
    const match = set.find((item) => item.keys.some((key) => normalized.includes(key.toLowerCase())));
    const topic = match ? match.topic : "Fallback";
    const html = match ? match.html : fallback;
    const next = match ? match.next : `<a href="${links.ai}">AI projects</a>`;
    return `
      <div class="agent-topic">${labels.matched}: ${topic}</div>
      <div>${html}</div>
      <div class="agent-next">${labels.next}: ${next}</div>
    `;
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function renderApiAnswer(data) {
    const citations = Array.isArray(data.citations) ? data.citations.slice(0, 5) : [];
    const agent = data.agent || {};
    const plan = Array.isArray(agent.plan) ? agent.plan.slice(0, 4) : [];
    const actions = Array.isArray(agent.actions) ? agent.actions.slice(0, 4) : [];
    const followups = Array.isArray(agent.followups) ? agent.followups.slice(0, 4) : [];
    const sources = citations
      .map((item) => {
        const title = escapeHtml(item.title || item.url || "Source");
        const url = escapeHtml(item.url || "#");
        return `<li><a href="${url}" target="_blank" rel="noopener">[${escapeHtml(item.id || "")}] ${title}</a></li>`;
      })
      .join("");
    const planHtml = plan.length
      ? `<div class="agent-plan"><div class="agent-source-title">${labels.plan}</div><ol>${plan
          .map((item) => `<li>${escapeHtml(item)}</li>`)
          .join("")}</ol></div>`
      : "";
    const actionsHtml = actions.length
      ? `<div class="agent-action-list"><div class="agent-source-title">${labels.actionsLabel}</div>${actions
          .map((item) => {
            const label = escapeHtml(item.label || item.url || "Open");
            const url = escapeHtml(item.url || "#");
            return `<a href="${url}" target="_blank" rel="noopener">${label}</a>`;
          })
          .join("")}</div>`
      : "";
    const followupHtml = followups.length
      ? `<div class="agent-followups"><div class="agent-source-title">${labels.followupsLabel}</div>${followups
          .map((item) => `<button type="button" data-agent-prompt="${escapeHtml(item)}">${escapeHtml(item)}</button>`)
          .join("")}</div>`
      : "";
    return `
      <div class="agent-topic">${labels.matched}: ${escapeHtml(agent.label || data.mode || "live agent")}</div>
      <div>${escapeHtml(data.answer || "").replaceAll("\n", "<br />")}</div>
      ${planHtml}
      ${actionsHtml}
      ${followupHtml}
      ${
        sources
          ? `<div class="agent-sources"><div class="agent-source-title">${labels.sources}</div><ol>${sources}</ol></div>`
          : ""
      }
    `;
  }

  async function askLiveAgent(locale, query) {
    if (!agentApiUrl) return null;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 18000);
    try {
      const response = await fetch(agentApiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, locale }),
        signal: controller.signal,
      });
      if (!response.ok) throw new Error(`Agent API returned ${response.status}`);
      return await response.json();
    } finally {
      window.clearTimeout(timeout);
    }
  }

  async function handleQuery({ locale, query, answer }) {
    if (!query.trim()) return;
    if (agentApiUrl) {
      answer.innerHTML = `<div class="agent-topic">${labels.matched}: live agent</div><div>${labels.thinking}</div>`;
      try {
        const data = await askLiveAgent(locale, query);
        if (data) {
          answer.innerHTML = renderApiAnswer(data);
          return;
        }
      } catch (error) {
        answer.innerHTML = `
          <div class="agent-topic">${labels.matched}: fallback</div>
          <div>${labels.apiError}</div>
          ${reply(locale, query)}
        `;
        return;
      }
    }
    answer.innerHTML = reply(locale, query);
  }

  document.querySelectorAll("[data-site-agent]").forEach((root) => {
    const locale = root.getAttribute("data-locale") || "en";
    const answer = root.querySelector("[data-agent-answer]");
    const form = root.querySelector("[data-agent-form]");
    const input = form?.querySelector("input[name='query']");

    root.addEventListener("click", async (event) => {
      const button = event.target.closest?.("[data-agent-prompt]");
      if (!button) return;
      const query = button.getAttribute("data-agent-prompt") || "";
      if (input) input.value = query;
      if (answer) await handleQuery({ locale, query, answer });
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const query = input?.value || "";
      if (answer) await handleQuery({ locale, query, answer });
    });
  });
</script>
