---
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en", mode = "full" } = Astro.props as { locale?: Locale; mode?: "full" | "home" };
const agentApiUrl = import.meta.env.PUBLIC_AGENT_API_URL ?? "https://api.sciencesloop.com/api/agent";
const isHomeMode = mode === "home";

const copy = locale === "zh"
  ? {
      eyebrow: "站内智能体",
      title: "认识一下 Loopi — SciencesLoop 智能体",
      lead: agentApiUrl
        ? "这是一个 SciencesLoop 站内问答 demo：它基于公开网站内容回答，并在可用时返回引用来源。"
        : "这是一个 SciencesLoop 站内问答 demo：当前本地模式不调用外部模型，只把访客问题映射到公开网站里的研究方向、论文、项目、学术 CV 和联系方式。",
      placeholder: "输入关键词：agent, workflow, evaluation, battery, publications, contact...",
      send: "查询",
      starter: "可以先问：",
      status: agentApiUrl ? "public-site RAG demo" : "public-site static demo",
      statusBadge: "公开网站内容",
      matched: "匹配主题",
      next: "建议下一步",
      plan: "执行路径",
      actionsLabel: "可执行导航",
      followupsLabel: "继续探索",
      thinking: "正在检索公开语料并生成回答...",
      apiError: "实时 agent 暂时不可用，已切换到本地规则回答。",
      sources: "来源",
      note: agentApiUrl
        ? "当前版本调用 SciencesLoop 后端，只使用公开网站内容；可用时会返回引用来源。"
        : "当前版本在浏览器端运行，只基于公开网站内容做导航；线上 API 不可用时会保留这个本地 fallback。",
      fallback: "我现在只能回答网站里的核心主题。可以试试 agent reliability、case studies、technical evolution、AI for science、workflow、battery、Argonne、publication、patent、academic CV、contact。",
      actions: {
        ai: "看 Programs",
        publications: "看论文",
        cv: "学术 CV",
        contact: "联系 Lu",
        roadmap: "查看路线图",
      },
      prompts: [
        "Lu 建过哪些 AI 系统？",
        "他怎么让 agent 可靠、可测？",
        "Property OS 是什么？怎么做安全门控的？",
        "这个 SciencesLoop Agent demo 是怎么工作的？",
        "他在 RAG、评测、安全护栏方面有什么经验？",
        "科学背景如何影响他的 AI 工程？",
      ],
    }
  : {
      eyebrow: "Site Agent",
      title: "Meet Loopi — the SciencesLoop agent",
      lead: agentApiUrl
        ? "A SciencesLoop site Q&A demo backed by a RAG / LLM API. It answers from public website content and returns cited sources when available."
        : "A SciencesLoop site Q&A demo. In local mode it does not call an external model; it maps visitor questions to the most relevant public research, programs, academic CV, and contact paths.",
      placeholder: "Type keywords: agent, workflow, evaluation, battery, publications, contact...",
      send: "Ask",
      starter: "Try asking:",
      status: agentApiUrl ? "public-site RAG demo" : "public-site static demo",
      statusBadge: "public site",
      matched: "Matched topic",
      next: "Suggested next step",
      plan: "Agent path",
      actionsLabel: "Next actions",
      followupsLabel: "Keep exploring",
      thinking: "Retrieving public context and generating an answer...",
      apiError: "Live agent is temporarily unavailable, so I switched to the local rules answer.",
      sources: "Sources",
      note: agentApiUrl
        ? "This version calls the SciencesLoop backend using public website content and returns cited sources when available."
        : "This version runs in the browser and only routes across public site content. It remains available as a local fallback when the live API is unavailable.",
      fallback: "I can answer the core site topics for now. Try agent reliability, case studies, technical evolution, AI for science, workflow, battery, Argonne, publication, patent, academic CV, or contact.",
      actions: {
        ai: "View Programs",
        publications: "View publications",
        cv: "Academic CV",
        contact: "Contact Lu",
        roadmap: "View roadmap",
      },
      prompts: [
        "What AI systems has Lu built?",
        "How does he keep agents grounded and testable?",
        "What's Property OS, and how is it safety-gated?",
        "How does the SciencesLoop Agent (this demo) work?",
        "What's his experience with RAG, evals, and safety guardrails?",
        "How does his science background inform his AI engineering?",
      ],
    };

const links = {
  ai: u(locale === "zh" ? "/zh/programs/" : "/programs/"),
  approach: u(locale === "zh" ? "/zh/approach/" : "/approach/"),
  evolution: u(locale === "zh" ? "/zh/evolution/" : "/evolution/"),
  cases: u(locale === "zh" ? "/zh/programs/#case-studies" : "/programs/#case-studies"),
  publications: u(locale === "zh" ? "/zh/publications/" : "/publications/"),
  patents: u(locale === "zh" ? "/zh/patents/" : "/patents/"),
  projects: u(locale === "zh" ? "/zh/projects/" : "/projects/"),
  collaborators: u(locale === "zh" ? "/zh/mentorship-collaborators/" : "/mentorship-collaborators/"),
  about: u(locale === "zh" ? "/zh/about/" : "/about/"),
  awards: u(locale === "zh" ? "/zh/awards/" : "/awards/"),
  cv: u("/files/Lu_Zhang_CV.pdf"),
  scholar: "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
  github: "https://github.com/rockyzl",
  linkedin: "https://www.linkedin.com/in/lu-zhang-argonne/",
  email: "mailto:luzhang@sciencesloop.com",
};
---

<section class={`agent-shell agent-shell--${mode}`} data-site-agent data-locale={locale}>
  <div class="agent-solo">
    <div class="agent-id">
      <span class="agent-avatar" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
          <path d="M20 12a8 8 0 1 1-3.2-6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <circle cx="9.2" cy="10.6" r="1.15" fill="currentColor" />
          <circle cx="14.8" cy="10.6" r="1.15" fill="currentColor" />
          <path d="M8.7 14.3a4.2 4.2 0 0 0 6.6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </span>
      <div class="agent-id-text">
        <h1 class="agent-id-name">Loopi</h1>
        <div class="agent-id-sub">{locale === "zh" ? "SciencesLoop 智能体 · " : "the SciencesLoop agent · "}{copy.status}</div>
      </div>
    </div>
    <p class="agent-solo-lead">
      {locale === "zh"
        ? "问我关于 Lu 的工作 —— 我只根据公开网站内容回答，而且必标来源。"
        : "Ask about Lu's work — I answer only from the public site, and I always cite my sources."}
    </p>

    <div class="agent-card" aria-live="polite">
      <div class="agent-answer" data-agent-answer>
        <div class="agent-topic">{copy.matched}: {locale === "zh" ? "开始" : "Start"}</div>
        <div class="agent-answer-body">
          {locale === "zh"
            ? "你好，我是 Loopi 👋 可以问我 Lu 建过哪些 AI 系统、他怎么让 agent 可靠可测，或者这些工作背后的科学背景。"
            : "Hi, I'm Loopi 👋 Ask about the AI systems Lu has built, how he keeps agents grounded and testable, or the science background behind the work."}
        </div>
      </div>

      <div class="agent-suggestions">
        <div class="agent-label">{copy.starter}</div>
        {copy.prompts.map((prompt) => (
          <button type="button" data-agent-prompt={prompt}>{prompt}</button>
        ))}
      </div>

      <form class="agent-form" data-agent-form>
        <input name="query" type="text" autocomplete="off" placeholder={copy.placeholder} />
        <button type="submit">{copy.send}</button>
      </form>
    </div>

    <p class="agent-howcap">
      {locale === "zh"
        ? "Loopi 的工作方式：一个有界、会自检的循环 —— retrieve → reason → act → verify"
        : "How Loopi works: a bounded, self-verifying loop — retrieve → reason → act → verify"}
    </p>
  </div>
</section>

<style is:global>
  /* Rendered-markdown typography inside the agent answer. The answer is injected
     via innerHTML at runtime, so Astro scoped styles don't reach it — keep these
     global, namespaced under .agent-answer-body. */
  .agent-answer-body p { margin: 0 0 .6rem; }
  .agent-answer-body p:last-child { margin-bottom: 0; }
  .agent-answer-body ul,
  .agent-answer-body ol { margin: .4rem 0 .6rem; padding-left: 1.3rem; }
  .agent-answer-body ul:last-child,
  .agent-answer-body ol:last-child { margin-bottom: 0; }
  .agent-answer-body li { margin: .28rem 0; }
  .agent-answer-body strong { font-weight: 700; color: var(--c-ink); }
  /* clickable inline citation markers [1], [2]… */
  .agent-answer-body .agent-cite { color: var(--c-accent); font-weight: 700; font-size: .82em; vertical-align: 1px; padding: 0 1px; }
  .agent-answer-body .agent-cite:hover { text-decoration: underline; }
  /* sources list: keep the [n] prefix, drop the <ol> auto-number (no dup) */
  .agent-sources ul.agent-src { list-style: none; margin: 0; padding: 0; }

  /* Loop-engineering trace — the agentic loop, collapsible (no clutter at rest) */
  .agent-loop { margin-top: .9rem; padding-top: .75rem; border-top: 1px solid var(--c-border-soft); }
  .agent-loop summary { list-style: none; cursor: pointer; display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; font-family: var(--font-mono); font-size: .72rem; color: var(--c-muted); }
  .agent-loop summary::-webkit-details-marker { display: none; }
  .agent-loop summary::before { content: "▸"; color: var(--c-accent); transition: transform .15s; }
  .agent-loop[open] summary::before { transform: rotate(90deg); }
  .agent-loop summary .lk { color: var(--c-accent); letter-spacing: .08em; text-transform: uppercase; font-weight: 700; }
  .agent-loop summary .lstages { color: var(--c-muted); }
  .agent-loop summary .lcnt { color: var(--c-muted); margin-left: auto; }
  .agent-loop-steps { list-style: none; margin: .75rem 0 .2rem; padding: .1rem 0 .1rem .35rem; display: grid; gap: .55rem; border-left: 2px solid var(--c-border); }
  .agent-loop-steps li { position: relative; padding-left: 1rem; font-size: .8rem; line-height: 1.4; color: var(--c-fg); }
  .agent-loop-steps li::before { content: ""; position: absolute; left: -5px; top: .42em; width: 7px; height: 7px; border-radius: 50%; background: var(--c-accent); }
  .agent-loop-steps li.lp-verify::before { background: var(--c-honey, #c1863c); }
  .agent-loop-steps .lph { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .06em; color: var(--c-accent); font-weight: 700; margin-right: .35rem; }
  .agent-loop-steps li.lp-verify .lph { color: var(--c-honey, #c1863c); }
  .agent-loop-steps code { font-family: var(--font-mono); font-size: .74rem; color: var(--c-accent-deep, var(--c-accent)); background: var(--c-bg-soft); border-radius: 4px; padding: 0 .3em; }
  .agent-loop-steps .lsm { color: var(--c-muted); }
  .agent-answer-body code {
    font-family: var(--font-mono);
    font-size: .84em;
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border-soft);
    border-radius: 4px;
    padding: 0 .3em;
  }
  /* Give the matched-topic label the same live teal accent the widget uses. */
  .agent-answer .agent-topic { color: var(--c-accent); }

  /* Loopi identity in the agent card header. */
  .agent-card-header { display: flex; align-items: center; gap: .6rem; }
  .agent-head-text { margin-right: auto; }
  .agent-avatar {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: var(--c-accent);
    color: #fff;
    box-shadow: 0 2px 6px rgba(13, 115, 97, 0.3);
  }

  /* --- Simplified single-column Agent Demo (Loopi) --- */
  .agent-solo { max-width: 720px; margin: 0 auto; }
  .agent-id { display: flex; align-items: center; gap: 0.8rem; margin: 2.2rem 0 0; }
  .agent-id .agent-avatar { width: 42px; height: 42px; }
  .agent-id .agent-id-name { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; margin: 0; }
  .agent-id-sub { font-family: var(--font-mono); font-size: 0.78rem; color: var(--c-muted); margin-top: 0.12rem; }
  .agent-solo-lead { color: var(--c-fg); font-size: 1rem; line-height: 1.6; margin: 1.1rem 0 1.4rem; max-width: 58ch; }
  .agent-solo .agent-card { display: block; }
  .agent-solo .agent-suggestions { margin-top: 1rem; }
  .agent-solo .agent-form {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border-soft);
  }
  .agent-howcap {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--c-muted);
    text-align: center;
    margin: 1.1rem auto 3rem;
    max-width: 62ch;
  }
</style>

<script define:vars={{ links, fallback: copy.fallback, agentApiUrl, labels: { matched: copy.matched, next: copy.next, plan: copy.plan, actionsLabel: copy.actionsLabel, followupsLabel: copy.followupsLabel, thinking: copy.thinking, apiError: copy.apiError, sources: copy.sources } }}>
  const answerSets = {
    en: [
      {
        topic: "AI for Science agents",
        next: `<a href="${links.ai}">Open Programs</a>`,
        keys: ["agent", "agents", "rag", "mcp", "langgraph", "workflow", "harness", "ai for science", "scientific agent"],
        html: `Lu's current direction is AI for Science through reliable agent systems: context engineering, evaluation harnesses, multi-agent orchestration, traceable workflow execution, and human-in-the-loop scientific decision support. The public site highlights this as a bridge between battery science and applied AI systems.`,
      },
      {
        topic: "Reliable agent approach",
        next: `<a href="${links.approach}">Open Approach</a>`,
        keys: ["approach", "reliable", "reliability", "context engineering", "golden set", "acceptance contract", "human review", "human-in-the-loop"],
        html: `The <a href="${links.approach}">Approach</a> page explains the reliability stack: foundation models, agent engineering, context engineering, and evaluation harnesses. The emphasis is on measurable behavior, grounded context, explicit tools, and human review.`,
      },
      {
        topic: "Case studies",
        next: `<a href="${links.cases}">Open Case Studies</a>`,
        keys: ["case", "case study", "case studies", "rfb", "scifm", "molecular property", "molecular-property", "chemgraph"],
        html: `The <a href="${links.cases}">case studies</a> section covers the RFB formulation agent, ChemGraph workflow contributions, the scifm registry, and a public molecular-property ML pipeline, with maturity labels preserved.`,
      },
      {
        topic: "Technical evolution",
        next: `<a href="${links.evolution}">Open Evolution</a>`,
        keys: ["evolution", "timeline", "technical evolution", "commit", "commits", "trajectory"],
        html: `The <a href="${links.evolution}">Technical Evolution</a> page frames the path from scientific research to data science, LLM/agent systems, and 2026 production reliability work, with figures from the commit-history audit.`,
      },
      {
        topic: "MLOps and evaluation",
        next: `<a href="${links.ai}">Review Programs</a>`,
        keys: ["mlops", "eval", "evaluation", "observability", "trace", "smoke test", "deployment", "azure", "docker", "search"],
        html: `Lu's recent AI engineering profile emphasizes application-layer reliability practices: retrieval checks, smoke tests, trace review, Docker/Azure deployment-readiness learning, and rollback-aware search-index workflows. This is application-layer AI/MLOps practice, not model pretraining or infrastructure ownership.`,
      },
      {
        topic: "Battery materials and redox-flow background",
        next: `<a href="${links.publications}">Browse publications</a>`,
        keys: ["battery", "redox", "flow", "electrolyte", "redoxmer", "materials"],
        html: `Lu's scientific base is battery materials and electrochemistry: redox-flow batteries, redox-active organic molecules, Li-ion electrolyte additives, redox shuttles, silicon-anode binders, and molecular design. See <a href="${links.publications}">publications</a> and <a href="${links.patents}">patents</a>.`,
      },
      {
        topic: "Publications and patents",
        next: `<a href="${links.scholar}" target="_blank" rel="noopener">Open Google Scholar</a>`,
        keys: ["publication", "paper", "citation", "scholar", "patent"],
        html: `For publication depth, use the <a href="${links.publications}">publication list</a> and <a href="${links.scholar}" target="_blank" rel="noopener">Google Scholar</a>. For invention output, see <a href="${links.patents}">patents</a>.`,
      },
      {
        topic: "Argonne and autonomous discovery",
        next: `<a href="${links.projects}">Review research projects</a>`,
        keys: ["argonne", "anl", "autonomous", "discovery", "robotic", "jcesr", "doe", "national lab"],
        html: `Lu spent 14+ years at Argonne working on battery materials, redox molecules, DOE/JCESR programs, and selected AI/ML, high-throughput, and autonomous-discovery collaborations. The strongest positioning is AI for Science built on deep scientific domain expertise.`,
      },
      {
        topic: "Scientific collaborators",
        next: `<a href="${links.collaborators}">Open Mentorship & Collaborators</a>`,
        keys: ["collaborator", "collaborators", "collaboraror", "collaboration", "coauthor", "co-author", "co authors", "coworker", "partner"],
        html: `The <a href="${links.collaborators}">Mentorship & Collaborators</a> page combines Lu's public co-author network, direct mentees, JCESR team leadership, and patent-only collaborators where available.`,
      },
      {
        topic: "Contact and profile links",
        next: `<a href="${links.cv}" target="_blank" rel="noopener">Open academic CV</a>`,
        keys: ["cv", "resume", "linkedin", "github", "contact", "email"],
        html: `Use the <a href="${links.cv}" target="_blank" rel="noopener">academic CV PDF</a> for the public academic record, <a href="${links.linkedin}" target="_blank" rel="noopener">LinkedIn</a> for career context, <a href="${links.github}" target="_blank" rel="noopener">GitHub</a> for code, or <a href="${links.email}">email Lu</a>.`,
      },
    ],
    zh: [
      {
        topic: "AI for Science 智能体",
        next: `<a href="${links.ai}">打开 Programs</a>`,
        keys: ["agent", "智能体", "rag", "mcp", "langgraph", "workflow", "工作流", "ai for science"],
        html: `Lu 现在的主线是把可靠 agent 系统用于 AI for Science：context engineering、evaluation harnesses、multi-agent orchestration、可追踪工作流和 human-in-the-loop 科学决策支持。这个方向把电池材料科学背景和应用层 AI 系统结合起来。`,
      },
      {
        topic: "可靠 agent 方法",
        next: `<a href="${links.approach}">打开方法页</a>`,
        keys: ["approach", "方法", "可靠", "reliability", "context engineering", "golden set", "acceptance contract", "human review", "human-in-the-loop"],
        html: `<a href="${links.approach}">方法页</a> 解释可靠 agent 的四层结构：foundation models、agent engineering、context engineering 和 evaluation harnesses。重点是可测量行为、grounded context、明确工具和人工 review。`,
      },
      {
        topic: "Case studies",
        next: `<a href="${links.cases}">打开案例</a>`,
        keys: ["case", "case study", "case studies", "案例", "rfb", "scifm", "molecular property", "molecular-property", "chemgraph"],
        html: `<a href="${links.cases}">case studies</a> 包含 RFB formulation agent、ChemGraph workflow contributions、scifm registry 和公开 molecular-property ML pipeline，并保留 maturity 标签。`,
      },
      {
        topic: "技术演化",
        next: `<a href="${links.evolution}">打开演化页</a>`,
        keys: ["evolution", "演化", "timeline", "时间线", "technical evolution", "commit", "commits", "trajectory"],
        html: `<a href="${links.evolution}">技术演化页</a> 解释从科学研究到 data science、LLM/agent systems，再到 2026 production reliability work 的连续路径，并包含 commit-history audit 图。`,
      },
      {
