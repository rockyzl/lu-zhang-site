      },
      {
        topic: "电池材料与液流电池",
        next: `<a href="${links.publications}">浏览论文</a>`,
        keys: ["battery", "电池", "redox", "flow", "液流", "electrolyte", "电解液", "redoxmer", "materials", "材料"],
        html: `Lu 的科学基础是电池材料和电化学：液流电池、氧化还原活性有机分子、锂离子电解液添加剂、redox shuttle、硅负极粘合剂和分子设计。可看 <a href="${links.publications}">论文</a> 和 <a href="${links.patents}">专利</a>。`,
      },
      {
        topic: "论文与专利",
        next: `<a href="${links.scholar}" target="_blank" rel="noopener">打开 Google Scholar</a>`,
        keys: ["publication", "paper", "论文", "citation", "引用", "scholar", "patent", "专利"],
        html: `论文和引用看 <a href="${links.publications}">publication list</a> 与 <a href="${links.scholar}" target="_blank" rel="noopener">Google Scholar</a>。发明成果看 <a href="${links.patents}">专利</a>。`,
      },
      {
        topic: "Argonne 与 autonomous discovery",
        next: `<a href="${links.projects}">查看科研项目</a>`,
        keys: ["argonne", "anl", "阿贡", "autonomous", "自主发现", "discovery", "robotic", "机器人", "jcesr", "doe", "国家实验室"],
        html: `Lu 在 Argonne 有 14+ 年电池材料、redox molecules、DOE/JCESR 项目经验，并参与过部分 AI/ML、高通量和 autonomous-discovery 合作。最强定位是以深厚科学背景为基础的 AI for Science。`,
      },
      {
        topic: "科研合作者",
        next: `<a href="${links.collaborators}">打开指导与合作者页面</a>`,
        keys: ["collaborator", "collaborators", "collaboraror", "collaboration", "coauthor", "co-author", "合作者", "合作", "共同作者", "共同发表"],
        html: `<a href="${links.collaborators}">指导与合作者</a> 页面合并展示 Lu 的公开共同作者网络、直接指导学生/博士后、JCESR 团队领导和部分仅专利合作者。`,
      },
      {
        topic: "联系与公开链接",
        next: `<a href="${links.cv}" target="_blank" rel="noopener">打开学术 CV</a>`,
        keys: ["cv", "resume", "简历", "linkedin", "github", "contact", "email", "联系"],
        html: `公开学术记录看 <a href="${links.cv}" target="_blank" rel="noopener">学术 CV PDF</a>，职业背景看 <a href="${links.linkedin}" target="_blank" rel="noopener">LinkedIn</a>，代码看 <a href="${links.github}" target="_blank" rel="noopener">GitHub</a>，也可以 <a href="${links.email}">邮件联系 Lu</a>。`,
      },
    ],
  };

  function reply(locale, query) {
    const normalized = query.toLowerCase();
    const set = answerSets[locale] || answerSets.en;
    const match = set.find((item) => item.keys.some((key) => normalized.includes(key.toLowerCase())));
    const topic = match ? match.topic : "Fallback";
    const html = match ? match.html : fallback;
    const next = match ? match.next : `<a href="${links.ai}">Programs</a>`;
    return `
      <div class="agent-topic">${labels.matched}: ${topic}</div>
      <div>${html}</div>
      <div class="agent-next">${labels.next}: ${next}</div>
    `;
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  // Minimal, XSS-safe markdown -> HTML for agent answers (same approach as the
  // floating ChatWidget). Escape FIRST so no raw HTML survives, then re-introduce
  // a small known set of tags: **bold**, *italic*, `code`, [label](url) links,
  // and ordered/unordered lists. Fixes raw ** and list markers showing through.
  function renderInline(escaped) {
    return escaped
      .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/__([^_]+)__/g, "<strong>$1</strong>")
      .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>")
      .replace(/`([^`]+)`/g, "<code>$1</code>");
  }
  function renderMarkdown(raw) {
    const escaped = escapeHtml(raw || "").replace(/\r\n/g, "\n").trim();
    if (!escaped) return "";
    return escaped
      .split(/\n{2,}/)
      .map((block) => {
        const lines = block.split("\n").filter((l) => l.trim() !== "");
        if (!lines.length) return "";
        if (lines.every((l) => /^\s*\d+\.\s+/.test(l))) {
          // Preserve the source ordinal via value=, so blank-line-separated
          // items (each its own block) don't all restart at "1.".
          return `<ol>${lines.map((l) => {
            const n = (l.match(/^\s*(\d+)\.\s+/) || [])[1] || "";
            return `<li value="${n}">${renderInline(l.replace(/^\s*\d+\.\s+/, ""))}</li>`;
          }).join("")}</ol>`;
        }
        if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
          return `<ul>${lines.map((l) => `<li>${renderInline(l.replace(/^\s*[-*]\s+/, ""))}</li>`).join("")}</ul>`;
        }
        return `<p>${renderInline(lines.join("<br />"))}</p>`;
      })
      .join("");
  }

  // Keep source cards short: long academic titles get truncated at a word
  // boundary so the sources list stays scannable.
  function shortSourceTitle(value) {
    const s = String(value ?? "").replace(/\s+/g, " ").trim();
    return s.length > 64 ? `${s.slice(0, 63).replace(/\s+\S*$/, "").trim()}…` : s;
  }

  function renderApiAnswer(data) {
    const allCites = Array.isArray(data.citations) ? data.citations : [];
    const citations = allCites.slice(0, 6);
    // Map citation id -> url so inline [n] markers become clickable links.
    const citeMap = {};
    allCites.forEach((c) => { if (c && c.id != null && c.url) citeMap[String(c.id)] = c.url; });
    const answerHtml = renderMarkdown(data.answer || "").replace(/\[(\d+)\]/g, (m, n) =>
      citeMap[n] ? `<a class="agent-cite" href="${escapeHtml(citeMap[n])}" target="_blank" rel="noopener">[${n}]</a>` : m);
    const agent = data.agent || {};
    const followups = Array.isArray(agent.followups) ? agent.followups.slice(0, 4) : [];
    const sources = citations
      .map((item) => {
        const title = escapeHtml(shortSourceTitle(item.title || item.url || "Source"));
        const url = escapeHtml(item.url || "#");
        return `<li><a href="${url}" target="_blank" rel="noopener">[${escapeHtml(item.id || "")}] ${title}</a></li>`;
      })
      .join("");
    const followupHtml = followups.length
      ? `<div class="agent-followups"><div class="agent-source-title">${labels.followupsLabel}</div>${followups
          .map((item) => `<button type="button" data-agent-prompt="${escapeHtml(item)}">${escapeHtml(item)}</button>`)
          .join("")}</div>`
      : "";
    const trace = Array.isArray(data.trace) ? data.trace : [];
    const traceHtml = trace.length
      ? `<details class="agent-loop"><summary><span class="lk">Loop engineering</span><span class="lstages">retrieve → reason → act → verify</span><span class="lcnt">${trace.length} steps · verified ✓</span></summary><ol class="agent-loop-steps">${trace
          .map((s) => `<li class="lp-${escapeHtml(s.phase || "")}"><span class="lph">${escapeHtml(String(s.phase || "").toUpperCase())}</span>${s.tool ? ` <code>${escapeHtml(s.tool)}</code>` : ""}${s.detail ? ` <span class="ldt">${escapeHtml(s.detail)}</span>` : ""} <span class="lsm">${escapeHtml(s.summary || "")}</span></li>`)
          .join("")}</ol></details>`
      : "";
    return `
      <div class="agent-topic">${labels.matched}: ${escapeHtml(agent.label || data.mode || "live agent")}</div>
      <div class="agent-answer-body">${answerHtml}</div>
      ${traceHtml}
      ${followupHtml}
      ${
        sources
          ? `<div class="agent-sources"><div class="agent-source-title">${labels.sources}</div><ul class="agent-src">${sources}</ul></div>`
          : ""
      }
    `;
  }

  async function askLiveAgent(locale, query) {
    if (!agentApiUrl) return null;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 35000);
    try {
      const response = await fetch(agentApiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, locale }),
        signal: controller.signal,
      });
      if (!response.ok) throw new Error(`Agent API returned ${response.status}`);
      return await response.json();
    } finally {
      window.clearTimeout(timeout);
    }
  }

  async function handleQuery({ locale, query, answer }) {
    if (!query.trim()) return;
    if (agentApiUrl) {
      answer.innerHTML = `<div class="agent-topic">${labels.matched}: live agent</div><div>${labels.thinking}</div>`;
      try {
        const data = await askLiveAgent(locale, query);
        if (data) {
          answer.innerHTML = renderApiAnswer(data);
          return;
        }
      } catch (error) {
        answer.innerHTML = `
          <div class="agent-topic">${labels.matched}: fallback</div>
          <div>${labels.apiError}</div>
          ${reply(locale, query)}
        `;
        return;
      }
    }
    answer.innerHTML = reply(locale, query);
  }

  document.querySelectorAll("[data-site-agent]").forEach((root) => {
    const locale = root.getAttribute("data-locale") || "en";
    const answer = root.querySelector("[data-agent-answer]");
    const form = root.querySelector("[data-agent-form]");
    const input = form?.querySelector("input[name='query']");

    root.addEventListener("click", async (event) => {
      const button = event.target.closest?.("[data-agent-prompt]");
      if (!button) return;
      const query = button.getAttribute("data-agent-prompt") || "";
      if (input) input.value = query;
      if (answer) await handleQuery({ locale, query, answer });
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const query = input?.value || "";
      if (answer) await handleQuery({ locale, query, answer });
    });
  });
</script>
