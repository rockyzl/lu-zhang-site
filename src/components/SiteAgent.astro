---
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en", mode = "full" } = Astro.props as { locale?: Locale; mode?: "full" | "home" };
const agentApiUrl = import.meta.env.PUBLIC_AGENT_API_URL ?? "https://api.sciencesloop.com/api/agent";
const isHomeMode = mode === "home";

const copy = locale === "zh"
  ? {
      eyebrow: "站内智能体",
      title: "认识一下 Loopi — SciencesLoop 智能体",
      lead: agentApiUrl
        ? "这是一个 SciencesLoop 站内问答 demo：它基于公开网站内容回答，并在可用时返回引用来源。"
        : "这是一个 SciencesLoop 站内问答 demo：当前本地模式不调用外部模型，只把访客问题映射到公开网站里的研究方向、论文、项目、学术 CV 和联系方式。",
      placeholder: "输入关键词：agent, workflow, evaluation, battery, publications, contact...",
      send: "查询",
      starter: "可以先问：",
      status: agentApiUrl ? "public-site RAG demo" : "public-site static demo",
      statusBadge: "公开网站内容",
      matched: "匹配主题",
      next: "建议下一步",
      plan: "执行路径",
      actionsLabel: "可执行导航",
      followupsLabel: "继续追问",
      thinking: "正在检索公开语料并生成回答...",
      apiError: "实时 agent 暂时不可用，已切换到本地规则回答。",
      sources: "来源",
      note: agentApiUrl
        ? "当前版本调用 SciencesLoop 后端，只使用公开网站内容；可用时会返回引用来源。"
        : "当前版本在浏览器端运行，只基于公开网站内容做导航；线上 API 不可用时会保留这个本地 fallback。",
      fallback: "我现在只能回答网站里的核心主题。可以试试 agent reliability、case studies、technical evolution、AI for science、workflow、battery、Argonne、publication、patent、academic CV、contact。",
      actions: {
        ai: "看 Programs",
        publications: "看论文",
        cv: "学术 CV",
        contact: "联系 Lu",
        roadmap: "查看路线图",
      },
      prompts: [
        "Lu 建过哪些 AI 系统？",
        "他怎么让 agent 可靠、可测？",
        "Property OS 是什么？怎么做安全门控的？",
        "这个 SciencesLoop Agent demo 是怎么工作的？",
        "他在 RAG、评测、安全护栏方面有什么经验？",
        "科学背景如何影响他的 AI 工程？",
      ],
    }
  : {
      eyebrow: "Site Agent",
      title: "Meet Loopi — the SciencesLoop agent",
      lead: agentApiUrl
        ? "A SciencesLoop site Q&A demo backed by a RAG / LLM API. It answers from public website content and returns cited sources when available."
        : "A SciencesLoop site Q&A demo. In local mode it does not call an external model; it maps visitor questions to the most relevant public research, programs, academic CV, and contact paths.",
      placeholder: "Type keywords: agent, workflow, evaluation, battery, publications, contact...",
      send: "Ask",
      starter: "Try asking:",
      status: agentApiUrl ? "public-site RAG demo" : "public-site static demo",
      statusBadge: "public site",
      matched: "Matched topic",
      next: "Suggested next step",
      plan: "Agent path",
      actionsLabel: "Next actions",
      followupsLabel: "Follow up",
      thinking: "Retrieving public context and generating an answer...",
      apiError: "Live agent is temporarily unavailable, so I switched to the local rules answer.",
      sources: "Sources",
      note: agentApiUrl
        ? "This version calls the SciencesLoop backend using public website content and returns cited sources when available."
        : "This version runs in the browser and only routes across public site content. It remains available as a local fallback when the live API is unavailable.",
      fallback: "I can answer the core site topics for now. Try agent reliability, case studies, technical evolution, AI for science, workflow, battery, Argonne, publication, patent, academic CV, or contact.",
      actions: {
        ai: "View Programs",
        publications: "View publications",
        cv: "Academic CV",
        contact: "Contact Lu",
        roadmap: "View roadmap",
      },
      prompts: [
        "What AI systems has Lu built?",
        "How does he keep agents grounded and testable?",
        "What's Property OS, and how is it safety-gated?",
        "How does the SciencesLoop Agent (this demo) work?",
        "What's his experience with RAG, evals, and safety guardrails?",
        "How does his science background inform his AI engineering?",
      ],
    };

const links = {
  ai: u(locale === "zh" ? "/zh/programs/" : "/programs/"),
  approach: u(locale === "zh" ? "/zh/approach/" : "/approach/"),
  evolution: u(locale === "zh" ? "/zh/evolution/" : "/evolution/"),
  cases: u(locale === "zh" ? "/zh/programs/#case-studies" : "/programs/#case-studies"),
  publications: u(locale === "zh" ? "/zh/publications/" : "/publications/"),
  patents: u(locale === "zh" ? "/zh/patents/" : "/patents/"),
  projects: u(locale === "zh" ? "/zh/projects/" : "/projects/"),
  collaborators: u(locale === "zh" ? "/zh/mentorship-collaborators/" : "/mentorship-collaborators/"),
  about: u(locale === "zh" ? "/zh/about/" : "/about/"),
  awards: u(locale === "zh" ? "/zh/awards/" : "/awards/"),
  cv: u("/files/Lu_Zhang_CV.pdf"),
  scholar: "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
  github: "https://github.com/rockyzl",
  linkedin: "https://www.linkedin.com/in/lu-zhang-argonne/",
  email: "mailto:zhanglu77@gmail.com",
};
---

<section class={`agent-shell agent-shell--${mode}`} data-site-agent data-locale={locale}>
  <div class="agent-panel">
    {!isHomeMode && (
      <div class="agent-copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.title}</h1>
        <p class="lead">{copy.lead}</p>
        <div class="agent-actions">
          <a class="btn btn-primary" href={links.ai}>{copy.actions.ai}</a>
          <a class="btn btn-ghost" href={links.publications}>{copy.actions.publications}</a>
          <a class="btn btn-ghost" href={links.cv} target="_blank" rel="noopener">{copy.actions.cv}</a>
          <a class="btn btn-ghost" href={links.email}>{copy.actions.contact}</a>
        </div>
      </div>
    )}

    <div class="agent-card" aria-live="polite">
      <div class="agent-card-header">
        <span class="agent-avatar" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M20 12a8 8 0 1 1-3.2-6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <circle cx="9.2" cy="10.6" r="1.15" fill="currentColor" />
            <circle cx="14.8" cy="10.6" r="1.15" fill="currentColor" />
            <path d="M8.7 14.3a4.2 4.2 0 0 0 6.6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </span>
        <div class="agent-head-text">
          <div class="agent-title">Loopi</div>
          <div class="agent-subtitle">{copy.status}</div>
        </div>
        <span class="agent-status">{copy.statusBadge}</span>
      </div>

      <form class="agent-form" data-agent-form>
        <input name="query" type="text" autocomplete="off" placeholder={copy.placeholder} />
        <button type="submit">{copy.send}</button>
      </form>

      <div class="agent-answer" data-agent-answer>
        <div class="agent-topic">{copy.matched}: {locale === "zh" ? "开始" : "Start"}</div>
        <div>
          {locale === "zh"
            ? "你好，我是 Loopi 👋 可以问我 Lu 建过哪些 AI 系统、他怎么让 agent 可靠可测，或者这些工作背后的科学背景。"
            : "Hi, I'm Loopi 👋 Ask about the AI systems Lu has built, how he keeps agents grounded and testable, or the science background behind the work."}
        </div>
        <div class="agent-next">{copy.next}: <a href={links.ai}>{copy.actions.ai}</a></div>
      </div>

      <div class="agent-suggestions">
        <div class="agent-label">{copy.starter}</div>
        {copy.prompts.map((prompt) => (
          <button type="button" data-agent-prompt={prompt}>{prompt}</button>
        ))}
      </div>

      <div class="agent-quicklinks" aria-label="Agent quick links">
        <a href={links.ai}>{copy.actions.ai}</a>
        <a href={links.approach}>{locale === "zh" ? "方法" : "Approach"}</a>
        <a href={links.cases}>{locale === "zh" ? "案例" : "Case Studies"}</a>
        <a href={links.projects}>{locale === "zh" ? "科研项目" : "Research Projects"}</a>
        <a href={links.publications}>{copy.actions.publications}</a>
        <a href={links.about}>{locale === "zh" ? "背景" : "Background"}</a>
      </div>
      <p class="agent-note">{copy.note}</p>
    </div>
  </div>
</section>

<style is:global>
  /* Rendered-markdown typography inside the agent answer. The answer is injected
     via innerHTML at runtime, so Astro scoped styles don't reach it — keep these
     global, namespaced under .agent-answer-body. */
  .agent-answer-body p { margin: 0 0 .6rem; }
  .agent-answer-body p:last-child { margin-bottom: 0; }
  .agent-answer-body ul,
  .agent-answer-body ol { margin: .4rem 0 .6rem; padding-left: 1.3rem; }
  .agent-answer-body ul:last-child,
  .agent-answer-body ol:last-child { margin-bottom: 0; }
  .agent-answer-body li { margin: .28rem 0; }
  .agent-answer-body strong { font-weight: 700; color: var(--c-ink); }
  .agent-answer-body code {
    font-family: var(--font-mono);
    font-size: .84em;
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border-soft);
    border-radius: 4px;
    padding: 0 .3em;
  }
  /* Give the matched-topic label the same live teal accent the widget uses. */
  .agent-answer .agent-topic { color: var(--c-accent); }

  /* Loopi identity in the agent card header. */
  .agent-card-header { display: flex; align-items: center; gap: .6rem; }
  .agent-head-text { margin-right: auto; }
  .agent-avatar {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: var(--c-accent);
    color: #fff;
    box-shadow: 0 2px 6px rgba(13, 115, 97, 0.3);
  }
</style>

<script define:vars={{ links, fallback: copy.fallback, agentApiUrl, labels: { matched: copy.matched, next: copy.next, plan: copy.plan, actionsLabel: copy.actionsLabel, followupsLabel: copy.followupsLabel, thinking: copy.thinking, apiError: copy.apiError, sources: copy.sources } }}>
