  function reply(locale, query) {
    const normalized = query.toLowerCase();
    const set = answerSets[locale] || answerSets.en;
    const match = set.find((item) => item.keys.some((key) => normalized.includes(key.toLowerCase())));
    const topic = match ? match.topic : "Fallback";
    const html = match ? match.html : fallback;
    const next = match ? match.next : `<a href="${links.ai}">Programs</a>`;
    return `
      <div class="agent-topic">${labels.matched}: ${topic}</div>
      <div>${html}</div>
      <div class="agent-next">${labels.next}: ${next}</div>
    `;
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  // Minimal, XSS-safe markdown -> HTML for agent answers (same approach as the
  // floating ChatWidget). Escape FIRST so no raw HTML survives, then re-introduce
  // a small known set of tags: **bold**, *italic*, `code`, [label](url) links,
  // and ordered/unordered lists. Fixes raw ** and list markers showing through.
  function renderInline(escaped) {
    return escaped
      .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/__([^_]+)__/g, "<strong>$1</strong>")
      .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>")
      .replace(/`([^`]+)`/g, "<code>$1</code>");
  }
  function renderMarkdown(raw) {
    const escaped = escapeHtml(raw || "").replace(/\r\n/g, "\n").trim();
    if (!escaped) return "";
    return escaped
      .split(/\n{2,}/)
      .map((block) => {
        const lines = block.split("\n").filter((l) => l.trim() !== "");
        if (!lines.length) return "";
        if (lines.every((l) => /^\s*\d+\.\s+/.test(l))) {
          // Preserve the source ordinal via value=, so blank-line-separated
          // items (each its own block) don't all restart at "1.".
          return `<ol>${lines.map((l) => {
            const n = (l.match(/^\s*(\d+)\.\s+/) || [])[1] || "";
            return `<li value="${n}">${renderInline(l.replace(/^\s*\d+\.\s+/, ""))}</li>`;
          }).join("")}</ol>`;
        }
        if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
          return `<ul>${lines.map((l) => `<li>${renderInline(l.replace(/^\s*[-*]\s+/, ""))}</li>`).join("")}</ul>`;
        }
        return `<p>${renderInline(lines.join("<br />"))}</p>`;
      })
      .join("");
  }

  // Keep source cards short: long academic titles get truncated at a word
  // boundary so the sources list stays scannable.
  function shortSourceTitle(value) {
    const s = String(value ?? "").replace(/\s+/g, " ").trim();
    return s.length > 64 ? `${s.slice(0, 63).replace(/\s+\S*$/, "").trim()}…` : s;
  }

  function renderApiAnswer(data) {
    const citations = Array.isArray(data.citations) ? data.citations.slice(0, 5) : [];
    const agent = data.agent || {};
    const plan = Array.isArray(agent.plan) ? agent.plan.slice(0, 4) : [];
    const actions = Array.isArray(agent.actions) ? agent.actions.slice(0, 4) : [];
    const followups = Array.isArray(agent.followups) ? agent.followups.slice(0, 4) : [];
    const sources = citations
      .map((item) => {
        const title = escapeHtml(shortSourceTitle(item.title || item.url || "Source"));
        const url = escapeHtml(item.url || "#");
        return `<li><a href="${url}" target="_blank" rel="noopener">[${escapeHtml(item.id || "")}] ${title}</a></li>`;
      })
      .join("");
    const planHtml = plan.length
      ? `<div class="agent-plan"><div class="agent-source-title">${labels.plan}</div><ol>${plan
          .map((item) => `<li>${escapeHtml(item)}</li>`)
          .join("")}</ol></div>`
      : "";
    const actionsHtml = actions.length
      ? `<div class="agent-action-list"><div class="agent-source-title">${labels.actionsLabel}</div>${actions
          .map((item) => {
            const label = escapeHtml(item.label || item.url || "Open");
            const url = escapeHtml(item.url || "#");
            return `<a href="${url}" target="_blank" rel="noopener">${label}</a>`;
          })
          .join("")}</div>`
      : "";
    const followupHtml = followups.length
      ? `<div class="agent-followups"><div class="agent-source-title">${labels.followupsLabel}</div>${followups
          .map((item) => `<button type="button" data-agent-prompt="${escapeHtml(item)}">${escapeHtml(item)}</button>`)
          .join("")}</div>`
      : "";
    return `
      <div class="agent-topic">${labels.matched}: ${escapeHtml(agent.label || data.mode || "live agent")}</div>
      <div class="agent-answer-body">${renderMarkdown(data.answer || "")}</div>
      ${planHtml}
      ${actionsHtml}
      ${followupHtml}
      ${
        sources
          ? `<div class="agent-sources"><div class="agent-source-title">${labels.sources}</div><ol>${sources}</ol></div>`
          : ""
      }
    `;
  }

  async function askLiveAgent(locale, query) {
    if (!agentApiUrl) return null;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 18000);
    try {
      const response = await fetch(agentApiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, locale }),
        signal: controller.signal,
      });
      if (!response.ok) throw new Error(`Agent API returned ${response.status}`);
      return await response.json();
    } finally {
      window.clearTimeout(timeout);
    }
  }

  async function handleQuery({ locale, query, answer }) {
    if (!query.trim()) return;
    if (agentApiUrl) {
      answer.innerHTML = `<div class="agent-topic">${labels.matched}: live agent</div><div>${labels.thinking}</div>`;
      try {
        const data = await askLiveAgent(locale, query);
        if (data) {
          answer.innerHTML = renderApiAnswer(data);
          return;
        }
      } catch (error) {
        answer.innerHTML = `
          <div class="agent-topic">${labels.matched}: fallback</div>
          <div>${labels.apiError}</div>
          ${reply(locale, query)}
        `;
        return;
      }
    }
    answer.innerHTML = reply(locale, query);
  }

  document.querySelectorAll("[data-site-agent]").forEach((root) => {
    const locale = root.getAttribute("data-locale") || "en";
    const answer = root.querySelector("[data-agent-answer]");
    const form = root.querySelector("[data-agent-form]");
    const input = form?.querySelector("input[name='query']");

    root.addEventListener("click", async (event) => {
      const button = event.target.closest?.("[data-agent-prompt]");
      if (!button) return;
      const query = button.getAttribute("data-agent-prompt") || "";
      if (input) input.value = query;
      if (answer) await handleQuery({ locale, query, answer });
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const query = input?.value || "";
      if (answer) await handleQuery({ locale, query, answer });
    });
  });
</script>
