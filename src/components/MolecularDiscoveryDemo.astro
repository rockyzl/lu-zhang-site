---
interface Props { locale?: "en" | "zh"; }
const { locale = "en" } = Astro.props;
const apiBaseUrl = (import.meta.env.PUBLIC_MOLECULAR_DISCOVERY_API_URL ?? "https://molecular-discovery-demo-api-1038659864130.us-central1.run.app").trim();
const zh = locale === "zh";
const copy = zh ? {
  eyebrow: "独立研究 · 分子发现工作流",
  title: "先看结构和证据缺口，再谈分子性质",
  lead: "输入化学名称或 SMILES。PubChem 先解析名称，展示可确认、可编辑的结构；受限的后端再用 RDKit 生成结构描述符，并明确列出它还不知道什么。",
  inputType: "输入方式", name: "化学名称", smiles: "SMILES", label: "化学名称", hint: "例如：caffeine、aspirin 或 O=C(O)c1ccccc1O",
  preview: "解析并预览结构", resolving: "正在从 PubChem 解析身份…", confirmTitle: "确认分子结构", confirmLead: "请检查 PubChem 名称、二维结构和可编辑的 SMILES。只有确认后，才会运行 RDKit 分析。",
  canonical: "用于分析的 SMILES", edit: "编辑 SMILES", analyze: "确认结构并分析", back: "返回修改输入", structure: "PubChem 二维结构", source: "身份来源：PubChem PUG-REST", loading: "正在运行 RDKit 结构分析…",
  resultTitle: "结构分析结果", formula: "分子式", weight: "分子量", logp: "RDKit LogP", tpsa: "拓扑极性表面积", groups: "官能团标记", gaps: "尚未得到的性质证据", warnings: "重要边界", noGroups: "未检测到已标记的官能团。",
  howTitle: "这个 Demo 做了什么？", steps: [["1. 解析身份", "化学名称由浏览器直接向 PubChem 查询；SMILES 也会先得到 PubChem 身份记录。"], ["2. 人工确认", "你查看二维结构，并可编辑 SMILES。页面不把名称猜测直接当作模型输入。"], ["3. 本地结构计算", "受限 API 用 RDKit 计算分子式、分子量、LogP、TPSA 和官能团等结构描述符。"], ["4. 公开缺口", "它不会编造氧化还原电位、溶解度或电导率；没有已连接证据源时，缺口本身就是结果。"]],
  modelTitle: "这里没有性质预测模型", model: "在线服务不是 LLM，也不在现场运行 DFT 或性质预测模型。它是一个有边界的工作流：PubChem 提供化学身份，RDKit 计算结构描述符，规则引擎把没有来源支持的性质标为缺口。",
  privacy: "你的输入会发送给 PubChem 和公开的结构分析服务。请不要提交保密分子、专有结构或未公开的研究内容。", invalid: "请输入化学名称或 SMILES。", resolveFail: "PubChem 无法可靠地解析这个输入。请检查拼写或改用 SMILES。", apiFail: "结构分析服务暂时不可用，请稍后重试。", openPubChem: "在 PubChem 查看记录",
} : {
  eyebrow: "Independent research · molecular discovery workflow",
  title: "See the structure and evidence gaps before claiming a molecular property",
  lead: "Enter a chemical name or SMILES. PubChem resolves the identity and shows a confirmable, editable structure; a restricted backend then calculates RDKit descriptors and makes its remaining evidence gaps explicit.",
  inputType: "Input type", name: "Chemical name", smiles: "SMILES", label: "Chemical name", hint: "Examples: caffeine, aspirin, or O=C(O)c1ccccc1O",
  preview: "Resolve and preview structure", resolving: "Resolving identity through PubChem…", confirmTitle: "Confirm the molecular structure", confirmLead: "Check the PubChem name, 2D structure, and editable SMILES. RDKit analysis starts only after you confirm.",
  canonical: "SMILES for analysis", edit: "Edit SMILES", analyze: "Confirm structure and analyze", back: "Edit input", structure: "PubChem 2D structure", source: "Identity source: PubChem PUG-REST", loading: "Running RDKit structure analysis…",
  resultTitle: "Structure analysis", formula: "Formula", weight: "Molecular weight", logp: "RDKit LogP", tpsa: "Topological polar surface area", groups: "Functional-group flags", gaps: "Property evidence still missing", warnings: "Important boundaries", noGroups: "No flagged functional group was detected.",
  howTitle: "What this demo does", steps: [["1. Resolve identity", "A chemical name is looked up directly from the browser through PubChem; a SMILES also receives a PubChem identity record first."], ["2. Confirm structure", "You inspect the 2D structure and can edit the SMILES. A name guess is never silently treated as model input."], ["3. Calculate structure features", "The restricted API uses RDKit to calculate formula, molecular weight, LogP, TPSA, and functional-group flags."], ["4. Show gaps", "It does not invent redox potential, solubility, or conductivity. When no source-backed connector is active, the gap is itself a result."]],
  modelTitle: "There is no property-prediction model here", model: "The live service is not an LLM and it does not run DFT or a property predictor on demand. It is a bounded workflow: PubChem supplies chemical identity, RDKit calculates structure descriptors, and a rule layer labels properties without a connected evidence source as gaps.",
  privacy: "Your input is sent to PubChem and to the public structure-analysis service. Do not submit confidential molecules, proprietary structures, or unpublished research content.", invalid: "Enter a chemical name or SMILES.", resolveFail: "PubChem could not reliably resolve this input. Check the spelling or try a SMILES string.", apiFail: "The structure-analysis service is temporarily unavailable. Please try again later.", openPubChem: "Open PubChem record",
};
---

<section class="mda" aria-labelledby="mda-title">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1 id="mda-title">{copy.title}</h1>
  <p class="lead">{copy.lead}</p>
  <form class="card" data-mda-form>
    <label for="mda-type">{copy.inputType}</label>
    <select id="mda-type" data-mda-type><option value="name">{copy.name}</option><option value="smiles">{copy.smiles}</option></select>
    <label for="mda-input" data-mda-label>{copy.label}</label>
    <input id="mda-input" data-mda-input value="caffeine" maxlength="500" autocomplete="off" spellcheck="false" />
    <p class="hint" data-mda-hint>{copy.hint}</p>
    <button type="submit" data-mda-preview>{copy.preview}</button><p class="status" data-mda-status aria-live="polite"></p>
  </form>
  <section class="card confirm" data-mda-confirm hidden aria-live="polite">
    <div><p class="label">{copy.confirmTitle}</p><p>{copy.confirmLead}</p><p class="identity" data-mda-identity></p><p class="source">{copy.source}</p><label for="mda-smiles">{copy.edit}</label><input id="mda-smiles" data-mda-smiles maxlength="500" autocomplete="off" spellcheck="false" /><p class="resolved"><strong>{copy.canonical}:</strong> <code data-mda-canonical></code></p><div class="actions"><button type="button" data-mda-analyze>{copy.analyze}</button><button type="button" class="secondary" data-mda-back>{copy.back}</button></div></div>
    <figure><img data-mda-image alt={copy.structure} /><figcaption>{copy.structure}</figcaption><a data-mda-pubchem target="_blank" rel="noreferrer">{copy.openPubChem} ↗</a></figure>
  </section>
  <section class="card result" data-mda-result hidden aria-live="polite"><p class="label">{copy.resultTitle}</p><p class="resolved"><strong>{copy.canonical}:</strong> <code data-mda-result-smiles></code></p><dl><div><dt>{copy.formula}</dt><dd data-mda-formula></dd></div><div><dt>{copy.weight}</dt><dd data-mda-weight></dd></div><div><dt>{copy.logp}</dt><dd data-mda-logp></dd></div><div><dt>{copy.tpsa}</dt><dd data-mda-tpsa></dd></div></dl><h2>{copy.groups}</h2><div class="chips" data-mda-groups></div><h2>{copy.gaps}</h2><ul data-mda-gaps></ul><h2>{copy.warnings}</h2><ul data-mda-warnings></ul></section>
  <section class="card how"><p class="label">{copy.howTitle}</p><ol>{copy.steps.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}</ol></section>
  <aside class="card note"><strong>{copy.modelTitle}</strong><p>{copy.model}</p><p>{copy.privacy}</p></aside>
</section>

<style>
  .mda{max-width:850px;margin:auto;padding:3rem 1.25rem 5rem;color:#17212b}.eyebrow,.label{color:#147a49;font-size:.8rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.eyebrow{margin:0 0 .55rem}.mda h1{margin:0;font-size:clamp(2rem,5vw,3.3rem);line-height:1.06;letter-spacing:-.04em}.lead{max-width:750px;color:#4b5966;font-size:1.08rem;line-height:1.65}.card{border:1px solid #dbe5df;border-radius:16px;padding:1.35rem;margin-top:1.5rem;background:#fff;box-shadow:0 9px 26px rgba(17,55,38,.06)}.mda label{display:block;font-weight:750;margin-bottom:.55rem}.mda input,.mda select{box-sizing:border-box;width:100%;border:1px solid #b8c9bd;border-radius:9px;padding:.85rem;margin-bottom:.75rem;background:#fff}.mda input{font:500 .96rem ui-monospace,SFMono-Regular,Menlo,monospace}.hint,.status,.source,.identity,.resolved{color:#536159;font-size:.9rem;line-height:1.5}.mda button{border:0;border-radius:9px;background:#147a49;color:#fff;font-weight:750;padding:.75rem 1.05rem;cursor:pointer}.mda button:disabled{opacity:.7;cursor:wait}.secondary{background:#edf4ef!important;color:#24533a!important}.confirm{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(220px,.8fr);gap:1.5rem;align-items:center}.confirm figure{margin:0;text-align:center}.confirm img{width:100%;max-width:340px;min-height:160px;object-fit:contain;background:#fbfdfb;border:1px solid #e4ece7;border-radius:10px}.confirm figcaption,.confirm figure a{display:block;color:#65736b;font-size:.82rem;margin-top:.4rem}.confirm figure a{color:#086a3a;font-weight:700}.actions{display:flex;flex-wrap:wrap;gap:.7rem}.result h2{font-size:.92rem;margin:1.4rem 0 .6rem;color:#526259;text-transform:uppercase;letter-spacing:.05em}.result ul{margin:0;padding-left:1.15rem;color:#536159;line-height:1.55}.result dl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem}.result dl div{border-top:1px solid #e4ece7;padding-top:.7rem}.result dt{color:#65736b;font-size:.76rem;font-weight:700;text-transform:uppercase}.result dd{margin:.25rem 0 0;font-weight:700}.chips{display:flex;flex-wrap:wrap;gap:.5rem}.chips span{border:1px solid #cfe0d4;border-radius:999px;padding:.25rem .55rem;font-size:.84rem;color:#22533b;background:#f5faf6}.how{background:#fbfdfb;box-shadow:none}.how ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;list-style:none;margin:0;padding:0}.how li{border-top:2px solid #b9d7c2;padding-top:.65rem;color:#526259;line-height:1.5;font-size:.9rem}.how strong,.how span{display:block}.how strong{color:#17683f;margin-bottom:.25rem}.note{background:#f4faf6;box-shadow:none;color:#435149;line-height:1.55}.note p{margin:.55rem 0}@media(max-width:640px){.confirm,.result dl,.how ol{grid-template-columns:1fr}}
</style>

<script define:vars={{ apiBaseUrl, copy }}>
  const form=document.querySelector('[data-mda-form]'), type=document.querySelector('[data-mda-type]'), input=document.querySelector('[data-mda-input]'), label=document.querySelector('[data-mda-label]'), hint=document.querySelector('[data-mda-hint]'), preview=document.querySelector('[data-mda-preview]'), status=document.querySelector('[data-mda-status]'), confirm=document.querySelector('[data-mda-confirm]'), smiles=document.querySelector('[data-mda-smiles]'), canonical=document.querySelector('[data-mda-canonical]'), identity=document.querySelector('[data-mda-identity]'), image=document.querySelector('[data-mda-image]'), pubchem=document.querySelector('[data-mda-pubchem]'), analyze=document.querySelector('[data-mda-analyze]'), back=document.querySelector('[data-mda-back]'), result=document.querySelector('[data-mda-result]');
  const endpoint=(path)=>new URL(path,`${apiBaseUrl.replace(/\/$/, '')}/`).href;
  let compound=null;
  const field=(selector)=>document.querySelector(selector);
  const setType=()=>{const isName=type.value==='name';label.textContent=isName?copy.name:copy.smiles;hint.textContent=isName?copy.hint:(copy.name==='Chemical name'?'Example: CCO or O=C(O)c1ccccc1O':'例如：CCO 或 O=C(O)c1ccccc1O');}; type.addEventListener('change',setType);
  const propertyUrl=(value, namespace)=>`https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/${namespace}/${encodeURIComponent(value)}/property/Title,SMILES,InChIKey,MolecularFormula,MolecularWeight/JSON`;
  const setBusy=(busy,message)=>{preview.disabled=busy;preview.textContent=busy?message:copy.preview;status.textContent=message||'';};
  form.addEventListener('submit',async(e)=>{e.preventDefault();const value=input.value.trim();if(!value){status.textContent=copy.invalid;return;}setBusy(true,copy.resolving);confirm.hidden=true;result.hidden=true;try{const response=await fetch(propertyUrl(value,type.value));if(!response.ok)throw new Error('pubchem');const record=(await response.json()).PropertyTable.Properties[0];if(!record?.CID||!record?.SMILES)throw new Error('record');compound=record;smiles.value=record.SMILES;canonical.textContent=record.SMILES;identity.textContent=`${record.Title||value} · CID ${record.CID} · ${record.MolecularFormula||''}`;image.src=`https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/cid/${record.CID}/PNG?image_size=large`;pubchem.href=`https://pubchem.ncbi.nlm.nih.gov/compound/${record.CID}`;confirm.hidden=false;status.textContent='';}catch(_){status.textContent=copy.resolveFail;}finally{setBusy(false,'');}});
  back.addEventListener('click',()=>{confirm.hidden=true;result.hidden=true;input.focus();});
  analyze.addEventListener('click',async()=>{const value=smiles.value.trim();if(!value){status.textContent=copy.invalid;return;}analyze.disabled=true;analyze.textContent=copy.loading;result.hidden=true;try{const response=await fetch(endpoint('/api/v1/forward/analyze'),{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({molecule_input:value,resolution_options:{input_format:'smiles'},engine:'plain'})});if(!response.ok)throw new Error('api');const data=await response.json(),d=data.structure_descriptor;field('[data-mda-result-smiles]').textContent=data.molecule.canonical_smiles;field('[data-mda-formula]').textContent=d.formula;field('[data-mda-weight]').textContent=`${d.molecular_weight} g/mol`;field('[data-mda-logp]').textContent=d.logp;field('[data-mda-tpsa]').textContent=`${d.tpsa} Å²`;const groups=field('[data-mda-groups]');groups.replaceChildren(...(d.functional_group_flags.length?d.functional_group_flags:[copy.noGroups]).map(x=>{const el=document.createElement('span');el.textContent=x;return el;}));const addList=(sel,items,render=x=>x)=>{const el=field(sel);el.replaceChildren(...items.map(x=>{const li=document.createElement('li');li.textContent=render(x);return li;}));};addList('[data-mda-gaps]',data.gaps,x=>`${x.property_name}: ${x.recommended_action}`);addList('[data-mda-warnings]',data.warnings);result.hidden=false;result.scrollIntoView({behavior:'smooth',block:'start'});}catch(_){status.textContent=copy.apiFail;}finally{analyze.disabled=false;analyze.textContent=copy.analyze;}});
</script>
