---
// Floating public-site guide. It preserves the existing live endpoint and
// local fallback, and adds one explicit, bounded chemistry tool: molecule
// identity resolution plus calculated structure descriptors. It is not a
// chemistry authority or an instrument controller.
//
// This is a FRESH floating-chat UX. It does NOT reuse the inline agent card
// markup, but it DOES reuse SiteAgent.astro's backend contract verbatim:
//   - config:   PUBLIC_AGENT_API_URL (same default endpoint)
//   - request:  POST { query, locale } as JSON, 18s AbortController timeout
//   - response: { answer, citations:[{id,title,url}], agent:{followups[]}, mode }
//   - fallback: local keyword rules over the public corpus when the API errors
// Public-safe guardrails only: answers route across public site content.
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en" } = Astro.props as { locale?: Locale };
const agentApiUrl = import.meta.env.PUBLIC_AGENT_API_URL ?? "https://api.sciencesloop.com/api/agent";

// Same public link map SiteAgent uses, so local-fallback answers point to the
// same public pages.
const links = {
  home: u(locale === "zh" ? "/zh/" : "/"),
  platform: u(locale === "zh" ? "/zh/#platform" : "/#platform"),
  electrochemistry: u(locale === "zh" ? "/zh/#electrochemistry" : "/#electrochemistry"),
  lab: u(locale === "zh" ? "/zh/lab/" : "/lab/"),
  evidence: u(locale === "zh" ? "/zh/evidence/" : "/evidence/"),
  notes: u(locale === "zh" ? "/zh/blog/" : "/blog/"),
  approach: u(locale === "zh" ? "/zh/approach/" : "/approach/"),
  chemistry: u(locale === "zh" ? "/zh/agent/molecular-discovery/" : "/agent/molecular-discovery/"),
  redox: u(locale === "zh" ? "/zh/agent/redox-rfb-predictor/" : "/agent/redox-rfb-predictor/"),
  battery: u(locale === "zh" ? "/zh/agent/battery-early-warning/" : "/agent/battery-early-warning/"),
  publications: u(locale === "zh" ? "/zh/publications/" : "/publications/"),
  patents: u(locale === "zh" ? "/zh/patents/" : "/patents/"),
  projects: u(locale === "zh" ? "/zh/projects/" : "/projects/"),
  collaborators: u(locale === "zh" ? "/zh/mentorship-collaborators/" : "/mentorship-collaborators/"),
  about: u(locale === "zh" ? "/zh/about/" : "/about/"),
  scholar: "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
  github: "https://github.com/rockyzl",
  linkedin: "https://www.linkedin.com/in/lu-zhang-argonne/",
  email: "mailto:luzhang@sciencesloop.com",
  cv: u("/files/Lu_Zhang_CV.pdf"),
};

const copy = locale === "zh"
  ? {
      title: "Loopi",
      subtitle: "公开站点与实验室指南",
      placeholder: "询问平台、证据或公开 Demo…",
      send: "发送",
      sendAria: "发送消息",
      close: "关闭对话",
      expand: "展开对话窗口",
      shrink: "收起对话窗口",
      reset: "开始新对话",
      tabChat: "对话",
      tabHistory: "历史",
      historyEmpty: "还没有提问记录。",
      historyHint: "点任意问题可重新提问",
      launcherOpen: "询问 Loopi",
      greeting: "你好，我是 Loopi，SciencesLoop 的公开站点与实验室指南。我可以帮助你检查平台概念、证据和公开 Demo，并尽量标出来源。我不会控制仪器，也不会把网站内容当成实验结果或科学建议。",
      thinking: "正在思考…",
      apiError: "实时 agent 暂时不可用，这是我能基于公开网站内容回答的部分。",
      rateLimit: "稍等一下——问得太快了，过一会儿再试。",
      sources: "来源",
      followupsLabel: "继续追问",
      startersLabel: "从公开材料开始：",
      starters: [
        "SciencesLoop 的实验循环如何工作？",
        "有哪些证据与限制？",
        "分析分子：咖啡因",
      ],
      scope: "真实工具：分子名称或 SMILES → PubChem 身份 + RDKit 计算描述符。不要输入保密结构；结果不是实验测量或科学建议。",
      fallback: "我目前只能解释公开站点内容。可以询问实验循环、adaptive electrochemistry、证据边界、National Lab 合作、分子身份确认、电池回放、Lab、技术方法或试点联系。",
      molecule: {
        heading: "分子身份与描述符",
        databaseIdentity: "PubChem 候选记录",
        structureIdentity: "提交结构的 RDKit 计算身份",
        calculated: "RDKit 计算描述符",
        source: "来源",
        boundary: "边界",
        boundaryText: "不含实验测量或 ML 预测。使用前请人工确认候选结构。",
        privacy: "公开输入演示：名称/SMILES 会发送到 SciencesLoop 公共分析服务及 PubChem，并可能出现在网络或服务日志中。请勿提交保密/专有结构、未发表研究、个人数据或商业秘密。",
        originalInput: "原始输入",
        submittedSmiles: "提交的 SMILES",
        resolverConfidence: "解析器报告",
        ambiguity: "歧义标记",
        noAmbiguity: "未报告",
        retrievedAt: "检索时间",
        formula: "分子式",
        molecularWeight: "分子量",
        exactMass: "精确质量",
        logP: "RDKit Crippen LogP",
        tpsa: "TPSA",
        donorsAcceptors: "HBD / HBA",
        rings: "环 / 芳香环",
        rotatable: "可旋转键",
        charge: "形式电荷",
        smiles: "Canonical SMILES",
        inchiKey: "InChIKey",
        record: "打开来源响应",
        gaps: "证据缺口",
        warnings: "警告",
        invalidInput: "未能解析该名称或 SMILES。请检查公开输入后重试。",
        serviceError: "分子分析服务暂时无法验证结果；未返回任何化学值。请稍后重试。",
      },
    }
  : {
      title: "Loopi",
      subtitle: "Public site & lab guide",
      placeholder: "Ask about the platform, evidence, or demos…",
      send: "Send",
      sendAria: "Send message",
      close: "Close chat",
      expand: "Expand chat window",
      shrink: "Collapse chat window",
      reset: "New chat",
      tabChat: "Chat",
      tabHistory: "History",
      historyEmpty: "No questions yet.",
      historyHint: "Tap any question to ask it again",
      launcherOpen: "Ask Loopi",
      greeting: "Hi, I'm Loopi, the bounded SciencesLoop site and lab guide. I can help you inspect platform concepts, evidence, and public demos, with sources when available. I do not control instruments or treat website content as experimental results or scientific advice.",
      thinking: "Thinking…",
      apiError: "Live agent is temporarily unavailable — here's what I can answer from the public site.",
      rateLimit: "Give me a moment — too many questions at once. Please try again shortly.",
      sources: "Sources",
      followupsLabel: "Follow up",
      startersLabel: "Start from public evidence:",
      starters: [
        "How does the SciencesLoop experimental loop work?",
        "What evidence exists, and what are the limits?",
        "Analyze molecule: caffeine",
      ],
      scope: "Real tool: molecule name or SMILES → PubChem identity + RDKit-calculated descriptors. Do not enter confidential structures; results are not experimental measurements or scientific advice.",
      fallback: "I can explain the public site for now. Try experimental loop, adaptive electrochemistry, evidence boundaries, National Lab collaboration, molecular identity confirmation, battery replay, Lab, technical approach, or pilot contact.",
      molecule: {
        heading: "Molecule identity & descriptors",
        databaseIdentity: "Candidate PubChem record",
        structureIdentity: "RDKit identity from submitted structure",
        calculated: "RDKit-calculated descriptors",
        source: "Source",
        boundary: "Boundary",
        boundaryText: "No experimental measurements or ML predictions are included. Confirm the candidate structure before use.",
        privacy: "Public-input demo: names/SMILES are sent to the SciencesLoop public analysis service and PubChem, and may appear in network or service logs. Do not submit confidential or proprietary structures, unpublished research, personal data, or trade secrets.",
        originalInput: "Original input",
        submittedSmiles: "Submitted SMILES",
        resolverConfidence: "Resolver report",
        ambiguity: "Ambiguity flags",
        noAmbiguity: "None reported",
        retrievedAt: "Retrieved at",
        formula: "Formula",
        molecularWeight: "Molecular weight",
        exactMass: "Exact mass",
        logP: "RDKit Crippen LogP",
        tpsa: "TPSA",
        donorsAcceptors: "HBD / HBA",
        rings: "Rings / aromatic",
        rotatable: "Rotatable bonds",
        charge: "Formal charge",
        smiles: "Canonical SMILES",
        inchiKey: "InChIKey",
        record: "Open source response",
        gaps: "Evidence gaps",
        warnings: "Warnings",
        invalidInput: "No candidate record or valid structure was returned. Check the public name or SMILES and try again.",
        serviceError: "The analysis service could not validate a result, so no chemistry values were returned. Please try again later.",
      },
    };
---

<div class="chat-widget cw-root" data-chat-widget data-locale={locale}>
  <!-- Panel: rendered above the launcher, hidden until opened -->
  <div class="cw-panel" id="cw-panel" role="dialog" aria-modal="false" aria-label={copy.title} hidden>
    <header class="cw-head">
      <span class="cw-avatar" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M20 12a8 8 0 1 1-3.2-6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <circle cx="9.2" cy="10.6" r="1.15" fill="currentColor" />
          <circle cx="14.8" cy="10.6" r="1.15" fill="currentColor" />
          <path d="M8.7 14.3a4.2 4.2 0 0 0 6.6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </span>
      <div class="cw-head-text">
        <div class="cw-title">{copy.title}</div>
        <div class="cw-subtitle">{copy.subtitle}</div>
      </div>
      <div class="cw-head-actions">
        <button type="button" class="cw-reset" data-cw-reset aria-label={copy.reset} title={copy.reset}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 11a8 8 0 1 0-.6 3M20 5v6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="cw-expand" data-cw-expand aria-label={copy.expand} aria-pressed="false">
          <svg class="cw-icon-expand" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 3h6v6M21 3l-7 7M9 21H3v-6M3 21l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg class="cw-icon-shrink" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14 10l7-7M15 3h6M21 3v6M10 14l-7 7M9 21H3M3 21v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="cw-close" data-cw-close aria-label={copy.close}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <div class="cw-tabs" role="tablist" aria-label={locale === "zh" ? "Loopi 视图" : "Loopi views"}>
      <button type="button" role="tab" class="cw-tab is-on" data-cw-tab="chat" aria-selected="true" aria-controls="cw-chat-view">{copy.tabChat}</button>
      <button type="button" role="tab" class="cw-tab" data-cw-tab="history" aria-selected="false" aria-controls="cw-history-view">{copy.tabHistory}</button>
    </div>

    <div class="cw-messages" id="cw-chat-view" role="tabpanel" data-cw-messages aria-live="polite" aria-atomic="false">
      <div class="cw-msg cw-msg--agent">
        <div class="cw-bubble">{copy.greeting}</div>
      </div>
    </div>

    <div class="cw-history" id="cw-history-view" role="tabpanel" data-cw-history hidden>
      <div class="cw-history-hint" data-cw-history-hint hidden>{copy.historyHint}</div>
      <div class="cw-history-empty" data-cw-history-empty>{copy.historyEmpty}</div>
      <div class="cw-history-list" data-cw-history-list></div>
    </div>

    <div class="cw-starters" data-cw-starters>
      <div class="cw-starters-label">{copy.startersLabel}</div>
      <div class="cw-chips">
        {copy.starters.map((s) => (
          <button type="button" class="cw-chip" data-cw-prompt={s}>{s}</button>
        ))}
      </div>
      <p class="cw-scope">{copy.scope}</p>
    </div>

    <p class="cw-input-note">{copy.molecule.privacy}</p>
    <form class="cw-form" data-cw-form>
      <input
        class="cw-input"
        name="q"
        type="text"
        autocomplete="off"
        placeholder={copy.placeholder}
        aria-label={copy.placeholder}
      />
      <button type="submit" class="cw-send" data-cw-send aria-label={copy.sendAria}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12l16-8-6 16-2.5-6.5L4 12z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08" />
        </svg>
        <span class="cw-send-text">{copy.send}</span>
      </button>
    </form>
  </div>

  <!-- Launcher: fixed circular button, bottom-right -->
  <button
    type="button"
    class="cw-launcher"
    data-cw-launcher
    aria-label={copy.launcherOpen}
    aria-expanded="false"
    aria-controls="cw-panel"
  >
    <svg class="cw-icon-open" width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M20 12a8 8 0 1 1-3.2-6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <circle cx="9.2" cy="10.6" r="1.15" fill="currentColor" />
      <circle cx="14.8" cy="10.6" r="1.15" fill="currentColor" />
      <path d="M8.7 14.3a4.2 4.2 0 0 0 6.6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <svg class="cw-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </button>
</div>

<style is:global>
  .cw-root {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 900;
    font-family: var(--font-sans);
  }

  /* ---- Launcher bubble ---- */
  .cw-launcher {
    position: relative;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 999px;
    border: none;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 10px 26px -8px rgba(13, 115, 97, 0.55), 0 2px 6px rgba(27, 32, 28, 0.14);
    transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
  }
  .cw-launcher:hover {
    background: var(--accent-deep);
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -10px rgba(13, 115, 97, 0.6), 0 3px 8px rgba(27, 32, 28, 0.16);
  }
  .cw-launcher:focus-visible {
    outline: 3px solid var(--accent-soft);
    outline-offset: 3px;
  }
  .cw-icon-close { display: none; }
  .cw-root.cw-open .cw-icon-open { display: none; }
  .cw-root.cw-open .cw-icon-close { display: block; }

  /* ---- Panel ---- */
  .cw-panel {
    position: absolute;
    right: 0;
    bottom: 72px;
    width: 360px;
    max-width: calc(100vw - 40px);
    /* Fixed height (not just max) so switching Chat <-> History doesn't resize
       the panel — both views flex-fill the same space. */
    height: min(72vh, 500px);
    max-height: min(72vh, 500px);
    display: flex;
    flex-direction: column;
    background: var(--c-card);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .cw-panel[hidden] { display: none; }

  /* Expanded state — reshape to a TALL panel at the SAME compact width, so more
     of the conversation is visible. Not a "size up" (no wider box); the shape
     just changes from a short card to a full-height column. */
  .cw-panel.cw-expanded {
    width: min(560px, calc(100vw - 40px));
    height: min(760px, calc(100vh - 104px));
    max-height: min(760px, calc(100vh - 104px));
  }

  @media (prefers-reduced-motion: no-preference) {
    .cw-panel {
      transform-origin: bottom right;
      animation: cw-pop .18s cubic-bezier(.2, .8, .3, 1);
    }
    @keyframes cw-pop {
      from { opacity: 0; transform: translateY(8px) scale(.98); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
  }

  /* ---- Header ---- */
  .cw-head {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .8rem 1rem;
    border-bottom: 1px solid var(--c-border-soft);
    background: linear-gradient(180deg, var(--accent-soft), var(--c-card));
  }
  .cw-head-text { margin-right: auto; }
  .cw-avatar {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 2px 6px rgba(13, 115, 97, 0.3);
  }
  .cw-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: .92rem;
    color: var(--c-ink);
    letter-spacing: -0.01em;
  }
  .cw-subtitle {
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .04em;
    color: var(--c-muted);
    margin-top: .12rem;
  }
  .cw-head-actions { display: flex; align-items: center; gap: .2rem; flex-shrink: 0; }
  .cw-close, .cw-expand, .cw-reset {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--c-muted);
    cursor: pointer;
    transition: background .15s, color .15s, border-color .15s;
  }
  .cw-close:hover, .cw-expand:hover, .cw-reset:hover { background: var(--c-bg-soft); color: var(--c-ink); }
  .cw-close:focus-visible, .cw-expand:focus-visible, .cw-reset:focus-visible { outline: 2px solid var(--accent-soft); outline-offset: 2px; }

  /* tabs (Chat / History) */
  .cw-tabs { display: flex; padding: 0 1rem; border-bottom: 1px solid var(--c-border-soft); background: var(--c-card); }
  .cw-tab { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--c-muted); background: none; border: none; border-bottom: 2px solid transparent; padding: .55rem .3rem; margin-right: 1rem; cursor: pointer; }
  .cw-tab.is-on { color: var(--c-ink); border-bottom-color: var(--accent); }
  .cw-tab:hover { color: var(--c-ink); }

  /* history view */
  .cw-history { flex: 1 1 auto; min-height: 130px; overflow-y: auto; padding: .85rem 1rem 1rem; display: none; }
  .cw-history-hint { font-family: var(--font-mono); font-size: .68rem; color: var(--c-muted); margin-bottom: .6rem; }
  .cw-history-empty { color: var(--c-muted-2); font-size: .85rem; padding: 1rem 0; }
  .cw-history-list { display: flex; flex-direction: column; gap: .35rem; }
  .cw-history-item { text-align: left; font: inherit; font-size: .82rem; line-height: 1.4; color: var(--c-fg-2); background: var(--c-bg-soft); border: 1px solid var(--line); border-radius: 9px; padding: .5rem .65rem; cursor: pointer; transition: border-color .15s, color .15s, background .15s; }
  .cw-history-item:hover { border-color: var(--accent-soft); color: var(--accent); background: var(--accent-soft); }

  /* view toggle: History tab hides the live chat surfaces */
  .cw-root.cw-view-history .cw-messages,
  .cw-root.cw-view-history .cw-starters,
  .cw-root.cw-view-history .cw-form { display: none; }
  .cw-root.cw-view-history .cw-history { display: block; }
  /* expand ⇄ shrink icon swap, driven by the panel's expanded class */
  .cw-icon-shrink { display: none; }
  .cw-panel.cw-expanded .cw-icon-expand { display: none; }
  .cw-panel.cw-expanded .cw-icon-shrink { display: block; }

  /* ---- Messages ---- */
  .cw-messages {
    flex: 1 1 auto;
    min-height: 130px;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: .7rem;
    background:
      linear-gradient(180deg, rgba(220, 239, 232, 0.28), rgba(251, 250, 245, 0.0) 90px);
  }
  .cw-msg { display: flex; }
  .cw-msg--user { justify-content: flex-end; }
  .cw-msg--agent { justify-content: flex-start; }
  .cw-bubble {
    max-width: 84%;
    padding: .55rem .75rem;
    border-radius: 14px;
    font-size: .9rem;
    line-height: 1.55;
    color: var(--c-fg);
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .cw-msg--user .cw-bubble {
    background: var(--accent);
    color: #fff;
    border-bottom-right-radius: 5px;
  }
  .cw-msg--user .cw-bubble a { color: #eafff8; }
  .cw-msg--agent .cw-bubble {
    background: var(--c-card);
    border: 1px solid var(--line);
    border-bottom-left-radius: 5px;
  }
  .cw-msg--agent .cw-bubble a { color: var(--accent); font-weight: 600; }

  /* rendered markdown inside an agent bubble */
  .cw-bubble p { margin: 0 0 .5rem; }
  .cw-bubble p:last-child { margin-bottom: 0; }
  .cw-bubble ul, .cw-bubble ol { margin: .35rem 0 .5rem; padding-left: 1.2rem; }
  .cw-bubble ul:last-child, .cw-bubble ol:last-child { margin-bottom: 0; }
  .cw-bubble li { margin: .2rem 0; }
  .cw-msg--agent .cw-bubble strong { font-weight: 700; color: var(--c-ink); }
  /* clickable inline citation markers [1], [2]… */
