<script define:vars={{ agentApiUrl, locale, links, copy }}>
  (() => {
    const root = document.querySelector("[data-chat-widget]");
    if (!root) return;

    const launcher = root.querySelector("[data-cw-launcher]");
    const panel = root.querySelector("#cw-panel");
    const closeBtn = root.querySelector("[data-cw-close]");
    const expandBtn = root.querySelector("[data-cw-expand]");
    const messages = root.querySelector("[data-cw-messages]");
    const form = root.querySelector("[data-cw-form]");
    const input = form.querySelector(".cw-input");
    const sendBtn = form.querySelector("[data-cw-send]");
    const resetBtn = root.querySelector("[data-cw-reset]");
    const tabs = [...root.querySelectorAll("[data-cw-tab]")];
    const historyList = root.querySelector("[data-cw-history-list]");
    const historyEmpty = root.querySelector("[data-cw-history-empty]");
    const historyHint = root.querySelector("[data-cw-history-hint]");
    const greetingHTML = messages.innerHTML; // captured for "New chat" reset

    // Client-side conversation history (turns). The backend contract is
    // single-turn { query, locale } (see SiteAgent.astro), so history is kept
    // for display; each request still sends just { query, locale }.
    const history = [];
    let pending = false;

    /* ---------- cross-page persistence (sessionStorage) ----------
       This is a static MPA: every navigation is a full page reload, so the
       conversation must be saved and rehydrated to survive across pages.
       sessionStorage keeps it for the tab's browsing session (clears on close). */
    const STORE_KEY = "sl-chat-widget-v2"; // v2: fresh schema (drops stale pre-fix transcripts)
    let transcript = []; // [{role:"user",text} | {role:"agent",html}] — current conversation
    let questionLog = []; // just the questions asked, for the History tab (survives "New chat")
    function persist() {
      try {
        sessionStorage.setItem(STORE_KEY, JSON.stringify({
          transcript: transcript.slice(-60),
          questionLog: questionLog.slice(-80),
          open: !panel.hidden,
          expanded: panel.classList.contains("cw-expanded"),
          view: root.classList.contains("cw-view-history") ? "history" : "chat",
        }));
      } catch (e) { /* storage blocked/full — degrade to in-memory only */ }
    }
    function loadSaved() {
      try { const raw = sessionStorage.getItem(STORE_KEY); return raw ? JSON.parse(raw) : null; }
      catch (e) { return null; }
    }

    /* ---------- local keyword fallback (public corpus, same as SiteAgent) ---------- */
    const answerSets = {
      en: [
        { keys: ["loop", "workflow", "control plane", "objective", "protocol", "approval", "instrument", "measurement", "next experiment"],
          html: `The SciencesLoop thesis is an evidence-aware control plane: objective → evidence → protocol → human approval → instrument boundary → measurement → analysis → next experiment. The current public proof is a bounded software prototype, not autonomous hardware control. <a href="${links.home}#loop">Inspect the loop</a>.` },
        { keys: ["electrochemistry", "cv", "cyclic voltammetry", "adaptive", "eis"],
          html: `Adaptive electrochemistry is the first controlled proof. The public interface uses an illustrative CV trace to show protocol, artifact, analysis, and approval states; it is not experimental data and is not connected to a physical instrument. <a href="${links.electrochemistry}">See the proof boundary</a>.` },
        { keys: ["evidence", "limit", "limitation", "maturity", "provenance", "reproducible", "uncertainty", "trust"],
          html: `Public evidence includes runnable bounded demos, source-linked artifacts, identity confirmation, replayable analysis, and explicit limitations. It does not establish laboratory deployment, wet-lab validation, or instrument control. <a href="${links.evidence}">Inspect the evidence register</a>.` },
        { keys: ["national lab", "doe lab", "user facility", "argonne", "partner", "partnership"],
          html: `A National Laboratory or DOE user-facility partnership is not a universal requirement. It can strengthen projects where real facility needs, instrument boundaries, or validation access are central. SciencesLoop does not currently claim a committed National Lab or university partnership.` },
        { keys: ["molecule", "molecular", "identity", "property", "smiles", "pubchem", "rdkit", "chemistry"],
          html: `Loopi can retrieve a candidate PubChem record for a public chemical name, or validate a submitted SMILES, then calculate bounded RDKit structure descriptors. Try <code>Analyze molecule: caffeine</code> or <code>SMILES: CCO</code>. It does not return experimental measurements or property predictions. <a href="${links.chemistry}">Open the full molecular workflow</a>.` },
        { keys: ["battery", "early warning", "replay", "eis improve"],
          html: `The <a href="${links.battery}">Battery Early-Warning Replay</a> uses transformed public KIT v2 data to compare matched forecasts with and without EIS. It is an offline research replay, not a production alarm, and results vary by aging mode and model.` },
        { keys: ["lab", "demo", "demos", "scientific agent"],
          html: `The <a href="${links.lab}">Lab</a> collects public demos as evidence for one control-plane thesis: bounded tool use, identity checks, replayable analysis, evidence gaps, and human review. Each demo retains its own maturity and limitation labels.` },
        { keys: ["approach", "architecture", "layer", "adapter", "safety gate", "evaluation"],
          html: `The <a href="${links.approach}">technical approach</a> separates evidence/data, models/computation, protocol-as-code, instrument adapters/safety gates, and trace/evaluation/human review. The present instrument adapter is a proposed boundary, not a validated deployment.` },
        { keys: ["cv", "resume", "linkedin", "github", "contact", "email"],
          html: `Use the <a href="${links.cv}" target="_blank" rel="noopener">academic CV PDF</a>, <a href="${links.linkedin}" target="_blank" rel="noopener">LinkedIn</a>, <a href="${links.github}" target="_blank" rel="noopener">GitHub</a>, or <a href="${links.email}">email Lu</a>.` },
      ],
      zh: [
        { keys: ["循环", "工作流", "控制平面", "目标", "协议", "批准", "仪器", "测量", "下一实验"],
          html: `SciencesLoop 的主线是证据感知控制平面：目标 → 证据 → 协议 → 人工批准 → 仪器边界 → 测量 → 分析 → 下一实验。当前公开证据是受限软件原型，不是自主硬件控制。<a href="${links.home}#loop">查看循环</a>。` },
        { keys: ["电化学", "cv", "循环伏安", "自适应", "eis"],
          html: `自适应电化学是首个受控验证。公开界面用示意 CV 曲线展示协议、产物、分析与批准状态；不是实验数据，也未连接真实仪器。<a href="${links.electrochemistry}">查看边界</a>。` },
        { keys: ["证据", "限制", "成熟度", "来源", "可重现", "不确定性", "信任"],
          html: `公开证据包括可运行的受限 Demo、来源链接、身份确认、可重放分析与显式限制；不证明实验室部署、湿实验验证或仪器控制。<a href="${links.evidence}">查看证据登记</a>。` },
        { keys: ["national lab", "国家实验室", "用户设施", "argonne", "阿贡", "合作", "伙伴"],
          html: `National Lab 或 DOE user facility 合作不是普遍硬要求。当真实设施需求、仪器边界或验证访问是项目核心时，它可以增强可信度。SciencesLoop 当前不声称已有承诺的 National Lab 或大学合作。` },
        { keys: ["分子", "身份", "性质", "smiles", "pubchem", "rdkit", "化学"],
          html: `Loopi 可以为公开化学名称检索 PubChem 候选记录，或验证提交的 SMILES，再计算受限的 RDKit 结构描述符。试试 <code>分析分子：咖啡因</code> 或 <code>SMILES: CCO</code>。它不返回实验测量或性质预测。<a href="${links.chemistry}">打开完整分子工作流</a>。` },
        { keys: ["电池", "早期预警", "回放", "eis 改善"],
          html: `<a href="${links.battery}">电池早期预警回放</a>使用转换后的公开 KIT v2 数据，比较有无 EIS 的配对预测。它是离线研究回放，不是生产报警，结果随老化模式和模型变化。` },
        { keys: ["lab", "实验室", "demo", "演示", "scientific agent"],
          html: `<a href="${links.lab}">Lab</a> 把公开 Demo 组织成同一条控制平面证据：受限工具使用、身份检查、可重放分析、证据缺口与人工审查。每个 Demo 保留自己的成熟度和限制。` },
        { keys: ["方法", "架构", "层", "适配器", "安全门", "评估"],
          html: `<a href="${links.approach}">技术方法</a>区分证据/数据、模型/计算、协议即代码、仪器适配/安全门、追踪/评估/人工审查。当前仪器适配器是设计边界，不是已验证部署。` },
        { keys: ["cv", "resume", "简历", "linkedin", "github", "contact", "email", "联系"],
          html: `公开记录看 <a href="${links.cv}" target="_blank" rel="noopener">学术 CV PDF</a>，职业背景看 <a href="${links.linkedin}" target="_blank" rel="noopener">LinkedIn</a>，代码看 <a href="${links.github}" target="_blank" rel="noopener">GitHub</a>，也可 <a href="${links.email}">邮件联系 Lu</a>。` },
      ],
    };

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    // Minimal, XSS-safe markdown → HTML for agent answers. Input is escaped
    // FIRST, so no raw HTML can survive; we then re-introduce a small, known set
    // of inline/block tags. Handles **bold**, *italic*, `code`, [label](url)
    // links, and ordered/unordered lists — enough to render the API's markdown
    // instead of showing raw ** and list markers.
    function renderInline(escaped) {
      return escaped
        .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/__([^_]+)__/g, "<strong>$1</strong>")
        .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>")
        .replace(/`([^`]+)`/g, "<code>$1</code>");
    }
    function renderMarkdown(raw) {
      const escaped = escapeHtml(raw || "").replace(/\r\n/g, "\n").trim();
      if (!escaped) return "";
      return escaped
        .split(/\n{2,}/)
        .map((block) => {
          const lines = block.split("\n").filter((l) => l.trim() !== "");
          if (!lines.length) return "";
          if (lines.every((l) => /^\s*\d+\.\s+/.test(l))) {
            // Preserve the source ordinal via value=, so blank-line-separated
            // items (each its own block) don't all restart at "1.".
            return `<ol>${lines.map((l) => {
              const n = (l.match(/^\s*(\d+)\.\s+/) || [])[1] || "";
              return `<li value="${n}">${renderInline(l.replace(/^\s*\d+\.\s+/, ""))}</li>`;
            }).join("")}</ol>`;
          }
          if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
            return `<ul>${lines.map((l) => `<li>${renderInline(l.replace(/^\s*[-*]\s+/, ""))}</li>`).join("")}</ul>`;
          }
          return `<p>${renderInline(lines.join("<br />"))}</p>`;
        })
        .join("");
    }

    function localReply(query) {
      const normalized = query.toLowerCase();
      const set = answerSets[locale] || answerSets.en;
      const match = set.find((item) => item.keys.some((key) => normalized.includes(key.toLowerCase())));
      return match ? match.html : copy.fallback;
    }

    function parseMoleculeIntent(query) {
      const value = String(query || "").trim();
      const patterns = [
        { kind: "smiles", pattern: /^smiles\s*[:：]\s*(.+)$/i },
        { kind: "name", pattern: /^(?:analy[sz]e\s+)?molecule\s*[:：]\s*(.+)$/i },
        { kind: "name", pattern: /^分析分子\s*[:：]\s*(.+)$/i },
        { kind: "name", pattern: /^(?:what\s+are\s+|show\s+|inspect\s+|calculate\s+)?(?:the\s+)?(?:molecular|chemical)\s+(?:properties|descriptors)\s+(?:of|for)\s+(.+?)[?.!]*$/i },
        { kind: "name", pattern: /^(?:查询|分析|计算)(.+?)(?:的)?(?:分子性质|结构描述符)[？?。]*$/i },
      ];
      for (const item of patterns) {
        const match = value.match(item.pattern);
        const input = match?.[1]?.trim();
        if (input) return { kind: item.kind, value: input };
      }
      return null;
    }

    function formatNumber(value, digits = 3) {
      return Number(value).toLocaleString(locale === "zh" ? "zh-CN" : "en-US", {
        maximumFractionDigits: digits,
      });
    }

    function humanizeEvidence(value) {
      return String(value || "").replaceAll("_", " ");
    }

    function renderMoleculeResult(result, intent) {
      const identity = result.identity;
      const provenance = identity.provenance;
      const values = result.descriptors.values;
      const sourceLabel = provenance.kind === "database_identity"
        ? copy.molecule.databaseIdentity
        : copy.molecule.structureIdentity;
      const sourceDetail = provenance.kind === "database_identity"
        ? `${provenance.source} · CID ${provenance.recordId}`
        : `${provenance.source} · ${copy.molecule.submittedSmiles}`;
      const sourceLink = provenance.kind === "database_identity"
        ? `<a href="${escapeHtml(provenance.sourceUrl)}" target="_blank" rel="noopener">${escapeHtml(copy.molecule.record)}</a>`
        : "";
      const gaps = Array.isArray(result.evidenceGaps) ? result.evidenceGaps.slice(0, 4) : [];
      const warnings = Array.isArray(result.warnings)
        ? result.warnings
            .map((warning) => String(warning).replace(/calculated locally with RDKit/gi, "calculated with RDKit by the analysis service"))
            .slice(0, 3)
        : [];
      const gapsHtml = gaps.length
        ? `<div><strong>${escapeHtml(copy.molecule.gaps)}</strong><ul class="cw-molecule-card__list">${gaps.map((gap) => `<li>${escapeHtml(humanizeEvidence(gap.propertyName))}: ${escapeHtml(humanizeEvidence(gap.status))}. ${escapeHtml(gap.recommendedAction)}</li>`).join("")}</ul></div>`
        : "";
      const warningsHtml = warnings.length
        ? `<div><strong>${escapeHtml(copy.molecule.warnings)}</strong><ul class="cw-molecule-card__list">${warnings.map((warning) => `<li>${escapeHtml(warning)}</li>`).join("")}</ul></div>`
        : "";

      return `<div class="cw-molecule-card">
        <div class="cw-molecule-card__head"><strong>${escapeHtml(copy.molecule.heading)}</strong><span>${escapeHtml(copy.molecule.calculated)}</span></div>
        <section class="cw-molecule-card__identity">
          <p class="cw-molecule-card__label">${escapeHtml(sourceLabel)}</p>
          <dl>
            <div><dt>${escapeHtml(copy.molecule.originalInput)}</dt><dd>${escapeHtml(intent.value)}</dd></div>
            <div><dt>${escapeHtml(copy.molecule.source)}</dt><dd>${escapeHtml(sourceDetail)}${sourceLink ? ` · ${sourceLink}` : ""}</dd></div>
            <div><dt>${escapeHtml(copy.molecule.resolverConfidence)}</dt><dd>${escapeHtml(identity.resolverConfidence)}</dd></div>
            <div><dt>${escapeHtml(copy.molecule.ambiguity)}</dt><dd>${identity.ambiguityFlags.length ? escapeHtml(identity.ambiguityFlags.join(", ")) : escapeHtml(copy.molecule.noAmbiguity)}</dd></div>
            ${provenance.kind === "database_identity" ? `<div><dt>${escapeHtml(copy.molecule.retrievedAt)}</dt><dd>${escapeHtml(new Date(provenance.retrievedAt).toLocaleString(locale === "zh" ? "zh-CN" : "en-US"))}</dd></div>` : ""}
            <div><dt>${escapeHtml(copy.molecule.smiles)}</dt><dd><code>${escapeHtml(identity.canonicalSmiles)}</code></dd></div>
            <div><dt>${escapeHtml(copy.molecule.inchiKey)}</dt><dd><code>${escapeHtml(identity.inchiKey)}</code></dd></div>
          </dl>
        </section>
        <section class="cw-molecule-card__metrics">
          <p class="cw-molecule-card__label">${escapeHtml(copy.molecule.calculated)}</p>
          <dl>
            <div><dt>${escapeHtml(copy.molecule.formula)}</dt><dd>${escapeHtml(values.formula)}</dd></div>
            <div><dt>${escapeHtml(copy.molecule.molecularWeight)}</dt><dd>${formatNumber(values.molecularWeight)} g/mol</dd></div>
            <div><dt>${escapeHtml(copy.molecule.exactMass)}</dt><dd>${formatNumber(values.exactMolecularWeight, 4)} Da</dd></div>
            <div><dt>${escapeHtml(copy.molecule.logP)}</dt><dd>${formatNumber(values.logP, 4)}</dd></div>
            <div><dt>${escapeHtml(copy.molecule.tpsa)}</dt><dd>${formatNumber(values.tpsa)} Å²</dd></div>
            <div><dt>${escapeHtml(copy.molecule.donorsAcceptors)}</dt><dd>${values.hydrogenBondDonors} / ${values.hydrogenBondAcceptors}</dd></div>
            <div><dt>${escapeHtml(copy.molecule.rings)}</dt><dd>${values.ringCount} / ${values.aromaticRingCount}</dd></div>
            <div><dt>${escapeHtml(copy.molecule.rotatable)}</dt><dd>${values.rotatableBonds}</dd></div>
            <div><dt>${escapeHtml(copy.molecule.charge)}</dt><dd>${values.formalCharge}</dd></div>
          </dl>
        </section>
        <aside class="cw-molecule-card__boundary"><strong>${escapeHtml(copy.molecule.boundary)}</strong><p>${escapeHtml(copy.molecule.boundaryText)}</p>${gapsHtml}${warningsHtml}</aside>
      </div>`;
    }

    function moleculeErrorHtml(error) {
      const code = error && typeof error === "object" ? error.code : "";
      if (code === "rate_limited") return escapeHtml(copy.rateLimit);
      if (code === "invalid_input") return escapeHtml(copy.molecule.invalidInput);
      return `${escapeHtml(copy.molecule.serviceError)} <span class="cw-muted">(${escapeHtml(code || "service unavailable")})</span>`;
    }

    /* ---------- DOM helpers ---------- */
    function scrollToBottom() {
      messages.scrollTop = messages.scrollHeight;
    }

    function addUserMessage(text) {
      const row = document.createElement("div");
      row.className = "cw-msg cw-msg--user";
      const bubble = document.createElement("div");
      bubble.className = "cw-bubble";
      bubble.textContent = text;
      row.appendChild(bubble);
      messages.appendChild(row);
      scrollToBottom();
    }

    // Returns the bubble element so the caller can replace its content once the
    // answer arrives.
    function addAgentMessage(html) {
      const row = document.createElement("div");
      row.className = "cw-msg cw-msg--agent";
      const bubble = document.createElement("div");
      bubble.className = "cw-bubble";
      bubble.innerHTML = html;
      row.appendChild(bubble);
      messages.appendChild(row);
      scrollToBottom();
      return bubble;
    }

    function thinkingHtml() {
      return `<span class="cw-dots" aria-label="${escapeHtml(copy.thinking)}"><span></span><span></span><span></span></span>`;
    }

    // Keep source cards short: long academic titles get truncated at a word
    // boundary so the sources list stays scannable.
    function shortSourceTitle(value) {
      const s = String(value ?? "").replace(/\s+/g, " ").trim();
      return s.length > 60 ? `${s.slice(0, 59).replace(/\s+\S*$/, "").trim()}…` : s;
    }

    // Build the agent answer bubble from the live API response, reusing the same
    // response shape SiteAgent parses: answer text + citations + followups.
    function renderApiAnswer(data) {
      const allCites = Array.isArray(data.citations) ? data.citations : [];
      const citations = allCites.slice(0, 6);
      // Map citation id -> url so inline [n] markers become clickable links.
      const citeMap = {};
      allCites.forEach((c) => { if (c && c.id != null && c.url) citeMap[String(c.id)] = c.url; });
      const answer = renderMarkdown(data.answer || "").replace(/\[(\d+)\]/g, (m, n) =>
        citeMap[n] ? `<a class="cw-cite" href="${escapeHtml(citeMap[n])}" target="_blank" rel="noopener">[${n}]</a>` : m);
      const agent = data.agent || {};
      const followups = Array.isArray(agent.followups) ? agent.followups.slice(0, 3) : [];
      // Reserved, evidence-first rendering contract for future backend tools.
      // Nothing is shown unless the API supplies real tool metadata. A result
      // card intentionally exposes identity, source/model, status, and limits.
      const toolResults = Array.isArray(data.tool_results)
        ? data.tool_results.slice(0, 4)
        : (Array.isArray(data.tools) ? data.tools.slice(0, 4) : []);

      const sources = citations
        .map((item) => {
          const title = escapeHtml(shortSourceTitle(item.title || item.url || "Source"));
          const url = escapeHtml(item.url || "#");
          const id = escapeHtml(item.id || "");
          return `<li><a href="${url}" target="_blank" rel="noopener">${id ? "[" + id + "] " : ""}${title}</a></li>`;
        })
        .join("");
      const sourcesHtml = sources
        ? `<div class="cw-sources"><div class="cw-sources-title">${escapeHtml(copy.sources)}</div><ul class="cw-src">${sources}</ul></div>`
        : "";
      const followupsHtml = followups.length
        ? `<div class="cw-followups">${followups
            .map((f) => `<button type="button" data-cw-prompt="${escapeHtml(f)}">${escapeHtml(f)}</button>`)
            .join("")}</div>`
        : "";
      const toolsHtml = toolResults.length
        ? `<div class="cw-tools" aria-label="Tool results">${toolResults.map((tool) => {
            const name = escapeHtml(tool.name || tool.tool || "Tool");
            const identity = escapeHtml(tool.input_identity || tool.input || "Not supplied");
            const source = escapeHtml(tool.source_model || tool.source || tool.model || "Not supplied");
            const status = escapeHtml(tool.status || "reported");
            const limits = escapeHtml(tool.limits || tool.limitations || "No limits supplied by backend");
            return `<article class="cw-tool"><div class="cw-tool__head"><strong>${name}</strong><span>${status}</span></div><dl><div><dt>Input identity</dt><dd>${identity}</dd></div><div><dt>Source / model</dt><dd>${source}</dd></div><div><dt>Limits</dt><dd>${limits}</dd></div></dl></article>`;
          }).join("")}</div>`
        : "";
      return `<div>${answer || escapeHtml(copy.fallback)}</div>${toolsHtml}${sourcesHtml}${followupsHtml}`;
    }

    /* ---------- live API (same contract as SiteAgent.astro) ---------- */
    async function askLiveAgent(query) {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 35000);
      try {
        const response = await fetch(agentApiUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query, locale }),
          signal: controller.signal,
        });
        if (!response.ok) {
          const err = new Error(`Agent API returned ${response.status}`);
          err.status = response.status;
          throw err;
        }
        return await response.json();
      } finally {
        window.clearTimeout(timeout);
      }
    }

    /* ---------- send flow with abuse/cost guard ---------- */
    function setPending(state) {
      pending = state;
      sendBtn.disabled = state;
      input.disabled = state;
      root.classList.toggle("cw-pending", state);
    }

    async function send(query) {
      const q = (query || "").trim();
      if (!q || pending) return; // debounce: ignore while a request is in flight
      const moleculeIntent = parseMoleculeIntent(q);

      if (root.classList.contains("cw-view-history")) showView("chat"); // asking jumps back to chat
      root.classList.add("cw-conversing"); // hide starter chips after first turn
      addUserMessage(q);
      history.push({ role: "user", text: q });
      // Chemistry inputs/results remain in the current DOM only. They are
      // deliberately excluded from sessionStorage and the History tab.
      if (!moleculeIntent) {
        transcript.push({ role: "user", text: q });
        if (questionLog[questionLog.length - 1] !== q) questionLog.push(q);
        persist();
      }
      input.value = "";
      setPending(true);

      const bubble = addAgentMessage(thinkingHtml());

      const moleculeTool = window.__loopiMoleculeTool;
      if (moleculeIntent) {
        if (!moleculeTool) {
          bubble.innerHTML = `<div>${escapeHtml(copy.molecule.serviceError)}</div>`;
          setPending(false);
          scrollToBottom();
          if (!input.disabled) input.focus();
          return;
        }
        try {
          const result = moleculeIntent.kind === "smiles"
            ? await moleculeTool.analyzeMoleculeSmiles(moleculeIntent.value)
            : await moleculeTool.analyzeMoleculeName(moleculeIntent.value);
          bubble.innerHTML = renderMoleculeResult(result, moleculeIntent);
          history.push({ role: "agent", text: `${copy.molecule.heading}: ${result.identity.inputName}` });
        } catch (error) {
          bubble.innerHTML = `<div>${moleculeErrorHtml(error)}</div>`;
        } finally {
          setPending(false);
          scrollToBottom();
          if (!input.disabled) input.focus();
        }
        return;
      }

      if (!agentApiUrl) {
        // No endpoint configured → local fallback only (graceful degrade).
        const html = localReply(q);
        bubble.innerHTML = html;
        history.push({ role: "agent", text: html });
        transcript.push({ role: "agent", html });
        persist();
        scrollToBottom();
        setPending(false);
        return;
      }

      try {
        const data = await askLiveAgent(q);
        const html = renderApiAnswer(data);
        bubble.innerHTML = html;
        history.push({ role: "agent", text: data.answer || "" });
      } catch (error) {
        if (error && error.status === 429) {
          // Rate limited — do NOT retry/hammer the backend.
          bubble.innerHTML = `<div>${escapeHtml(copy.rateLimit)}</div>`;
        } else {
          // Any other error/timeout → friendly note + local public-corpus answer.
          bubble.innerHTML = `<div>${escapeHtml(copy.apiError)}</div><div style="margin-top:.5rem">${localReply(q)}</div>`;
        }
      } finally {
        // Record the FINAL agent bubble (answer or error fallback), then save.
        transcript.push({ role: "agent", html: bubble.innerHTML });
        persist();
        setPending(false);
        scrollToBottom();
        if (!input.disabled) input.focus();
      }
    }

    /* ---------- open/close ---------- */
    function openPanel(focus = true) {
      panel.hidden = false;
      root.classList.add("cw-open");
      launcher.setAttribute("aria-expanded", "true");
      launcher.setAttribute("aria-label", copy.close);
      if (focus) window.requestAnimationFrame(() => input.focus());
      persist();
    }
    function closePanel() {
      panel.hidden = true;
      root.classList.remove("cw-open");
      launcher.setAttribute("aria-expanded", "false");
      launcher.setAttribute("aria-label", copy.launcherOpen);
      launcher.focus();
      persist();
    }
    function togglePanel() {
      if (panel.hidden) openPanel();
      else closePanel();
    }

    function toggleExpand() {
      const expanded = panel.classList.toggle("cw-expanded");
      expandBtn.setAttribute("aria-pressed", expanded ? "true" : "false");
      expandBtn.setAttribute("aria-label", expanded ? copy.shrink : copy.expand);
      scrollToBottom();
      persist();
    }

    function renderHistory() {
      const items = questionLog.slice().reverse();
      historyList.innerHTML = items
        .map((q) => `<button type="button" class="cw-history-item" data-cw-prompt="${escapeHtml(q)}">${escapeHtml(q)}</button>`)
        .join("");
      const has = items.length > 0;
      historyEmpty.hidden = has;
      if (historyHint) historyHint.hidden = !has;
    }
    function showView(view) {
      const isHistory = view === "history";
      root.classList.toggle("cw-view-history", isHistory);
      tabs.forEach((t) => {
        const selected = t.getAttribute("data-cw-tab") === view;
        t.classList.toggle("is-on", selected);
        t.setAttribute("aria-selected", selected ? "true" : "false");
      });
      if (isHistory) renderHistory();
      persist();
    }
    // "New chat": clear the current conversation but KEEP the question history.
    function resetChat() {
      transcript = [];
      messages.innerHTML = greetingHTML;
      root.classList.remove("cw-conversing");
      showView("chat");
      persist();
      window.requestAnimationFrame(() => input.focus());
    }

    launcher.addEventListener("click", togglePanel);
    closeBtn.addEventListener("click", closePanel);
    expandBtn.addEventListener("click", toggleExpand);
    resetBtn.addEventListener("click", resetChat);
    tabs.forEach((t) => t.addEventListener("click", () => showView(t.getAttribute("data-cw-tab"))));
    tabs.forEach((tab, index) => tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      showView(next.getAttribute("data-cw-tab"));
      next.focus();
    }));

    // Esc closes the panel when it's open.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) closePanel();
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      send(input.value);
    });

    // Delegated: starter chips + dynamically-rendered followup chips both send.
    root.addEventListener("click", (e) => {
      const chip = e.target.closest?.("[data-cw-prompt]");
      if (!chip) return;
      send(chip.getAttribute("data-cw-prompt") || "");
    });

    // Rehydrate a conversation saved earlier this browsing session, so the chat
    // history carries across page navigations. Appends after the greeting.
    (function restore() {
      const saved = loadSaved();
      if (!saved) return;
      if (Array.isArray(saved.transcript) && saved.transcript.length) {
        transcript = saved.transcript;
        transcript.forEach((turn) => {
          if (turn.role === "user") addUserMessage(turn.text);
          else if (turn.role === "agent") addAgentMessage(turn.html);
        });
        root.classList.add("cw-conversing");
      }
      if (Array.isArray(saved.questionLog)) questionLog = saved.questionLog;
      renderHistory();
      if (saved.expanded) {
        panel.classList.add("cw-expanded");
        expandBtn.setAttribute("aria-pressed", "true");
        expandBtn.setAttribute("aria-label", copy.shrink);
      }
      if (saved.view === "history") showView("history");
      if (saved.open) openPanel(false); // reopen without stealing focus/scroll
    })();
  })();
</script>
