---
// Floating chat-bot widget — a launcher bubble (bottom-right, every page) that
// pops out a slide-in chat panel for multi-turn Q&A with the SciencesLoop agent.
//
// This is a FRESH floating-chat UX. It does NOT reuse the inline agent card
// markup, but it DOES reuse SiteAgent.astro's backend contract verbatim:
//   - config:   PUBLIC_AGENT_API_URL (same default endpoint)
//   - request:  POST { query, locale } as JSON, 18s AbortController timeout
//   - response: { answer, citations:[{id,title,url}], agent:{followups[]}, mode }
//   - fallback: local keyword rules over the public corpus when the API errors
// Public-safe guardrails only: answers route across public site content.
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en" } = Astro.props as { locale?: Locale };
const agentApiUrl = import.meta.env.PUBLIC_AGENT_API_URL ?? "https://api.sciencesloop.com/api/agent";

// Same public link map SiteAgent uses, so local-fallback answers point to the
// same public pages.
const links = {
  ai: u(locale === "zh" ? "/zh/programs/" : "/programs/"),
  approach: u(locale === "zh" ? "/zh/approach/" : "/approach/"),
  evolution: u(locale === "zh" ? "/zh/evolution/" : "/evolution/"),
  cases: u(locale === "zh" ? "/zh/programs/#case-studies" : "/programs/#case-studies"),
  publications: u(locale === "zh" ? "/zh/publications/" : "/publications/"),
  patents: u(locale === "zh" ? "/zh/patents/" : "/patents/"),
  projects: u(locale === "zh" ? "/zh/projects/" : "/projects/"),
  collaborators: u(locale === "zh" ? "/zh/mentorship-collaborators/" : "/mentorship-collaborators/"),
  about: u(locale === "zh" ? "/zh/about/" : "/about/"),
  scholar: "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en",
  github: "https://github.com/rockyzl",
  linkedin: "https://www.linkedin.com/in/lu-zhang-argonne/",
  email: "mailto:zhanglu77@gmail.com",
  cv: u("/files/Lu_Zhang_CV.pdf"),
};

const copy = locale === "zh"
  ? {
      title: "Loopi",
      subtitle: "SciencesLoop 智能体",
      placeholder: "问问 Lu 的工作…",
      send: "发送",
      sendAria: "发送消息",
      close: "关闭对话",
      expand: "展开对话窗口",
      shrink: "收起对话窗口",
      reset: "开始新对话",
      tabChat: "对话",
      tabHistory: "历史",
      historyEmpty: "还没有提问记录。",
      historyHint: "点任意问题可重新提问",
      launcherOpen: "和 Loopi 聊聊",
      greeting: "你好，我是 Loopi 👋 SciencesLoop 的智能体。我只根据公开网站内容回答，还会标出处。可以问我 Lu 建过哪些 AI 系统、他怎么让 agent 可靠可测，或者这些工作背后的科学背景。",
      thinking: "正在思考…",
      apiError: "实时 agent 暂时不可用，这是我能基于公开网站内容回答的部分。",
      rateLimit: "稍等一下——问得太快了，过一会儿再试。",
      sources: "来源",
      followupsLabel: "继续追问",
      startersLabel: "可以先问：",
      starters: [
        "Lu 建过哪些 AI 系统？",
        "他怎么让 agent 可靠、可测？",
        "Property OS 是什么？怎么做安全门控的？",
      ],
      fallback: "我现在只能回答网站里的核心主题。可以试试 agent reliability、case studies、technical evolution、AI for science、workflow、battery、Argonne、publication、patent、academic CV、contact。",
    }
  : {
      title: "Loopi",
      subtitle: "SciencesLoop agent",
      placeholder: "Ask about Lu's work…",
      send: "Send",
      sendAria: "Send message",
      close: "Close chat",
      expand: "Expand chat window",
      shrink: "Collapse chat window",
      reset: "New chat",
      tabChat: "Chat",
      tabHistory: "History",
      historyEmpty: "No questions yet.",
      historyHint: "Tap any question to ask it again",
      launcherOpen: "Chat with Loopi",
      greeting: "Hi, I'm Loopi 👋 the SciencesLoop agent. I only answer from the public site — and I cite my sources. Ask me about the AI systems Lu has built, how he keeps agents grounded and testable, or the science behind the work.",
      thinking: "Thinking…",
      apiError: "Live agent is temporarily unavailable — here's what I can answer from the public site.",
      rateLimit: "Give me a moment — too many questions at once. Please try again shortly.",
      sources: "Sources",
      followupsLabel: "Follow up",
      startersLabel: "Try asking:",
      starters: [
        "What AI systems has Lu built?",
        "How does he keep agents grounded and testable?",
        "What's Property OS, and how is it safety-gated?",
      ],
      fallback: "I can answer the core site topics for now. Try agent reliability, case studies, technical evolution, AI for science, workflow, battery, Argonne, publication, patent, academic CV, or contact.",
    };
---

<div class="chat-widget cw-root" data-chat-widget data-locale={locale}>
  <!-- Panel: rendered above the launcher, hidden until opened -->
  <div class="cw-panel" id="cw-panel" role="dialog" aria-modal="false" aria-label={copy.title} hidden>
    <header class="cw-head">
      <span class="cw-avatar" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M20 12a8 8 0 1 1-3.2-6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <circle cx="9.2" cy="10.6" r="1.15" fill="currentColor" />
          <circle cx="14.8" cy="10.6" r="1.15" fill="currentColor" />
          <path d="M8.7 14.3a4.2 4.2 0 0 0 6.6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </span>
      <div class="cw-head-text">
        <div class="cw-title">{copy.title}</div>
        <div class="cw-subtitle">{copy.subtitle}</div>
      </div>
      <div class="cw-head-actions">
        <button type="button" class="cw-reset" data-cw-reset aria-label={copy.reset} title={copy.reset}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 11a8 8 0 1 0-.6 3M20 5v6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="cw-expand" data-cw-expand aria-label={copy.expand} aria-pressed="false">
          <svg class="cw-icon-expand" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 3h6v6M21 3l-7 7M9 21H3v-6M3 21l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg class="cw-icon-shrink" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14 10l7-7M15 3h6M21 3v6M10 14l-7 7M9 21H3M3 21v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="cw-close" data-cw-close aria-label={copy.close}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <div class="cw-tabs" role="tablist">
      <button type="button" class="cw-tab is-on" data-cw-tab="chat">{copy.tabChat}</button>
      <button type="button" class="cw-tab" data-cw-tab="history">{copy.tabHistory}</button>
    </div>

    <div class="cw-messages" data-cw-messages aria-live="polite" aria-atomic="false">
      <div class="cw-msg cw-msg--agent">
        <div class="cw-bubble">{copy.greeting}</div>
      </div>
    </div>

    <div class="cw-history" data-cw-history hidden>
      <div class="cw-history-hint" data-cw-history-hint hidden>{copy.historyHint}</div>
      <div class="cw-history-empty" data-cw-history-empty>{copy.historyEmpty}</div>
      <div class="cw-history-list" data-cw-history-list></div>
    </div>

    <div class="cw-starters" data-cw-starters>
      <div class="cw-starters-label">{copy.startersLabel}</div>
      <div class="cw-chips">
        {copy.starters.map((s) => (
          <button type="button" class="cw-chip" data-cw-prompt={s}>{s}</button>
        ))}
      </div>
    </div>

    <form class="cw-form" data-cw-form>
      <input
        class="cw-input"
        name="q"
        type="text"
        autocomplete="off"
        placeholder={copy.placeholder}
        aria-label={copy.placeholder}
      />
      <button type="submit" class="cw-send" data-cw-send aria-label={copy.sendAria}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12l16-8-6 16-2.5-6.5L4 12z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08" />
        </svg>
        <span class="cw-send-text">{copy.send}</span>
      </button>
    </form>
  </div>

  <!-- Launcher: fixed circular button, bottom-right -->
  <button
    type="button"
    class="cw-launcher"
    data-cw-launcher
    aria-label={copy.launcherOpen}
    aria-expanded="false"
    aria-controls="cw-panel"
  >
    <svg class="cw-icon-open" width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M20 12a8 8 0 1 1-3.2-6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <circle cx="9.2" cy="10.6" r="1.15" fill="currentColor" />
      <circle cx="14.8" cy="10.6" r="1.15" fill="currentColor" />
      <path d="M8.7 14.3a4.2 4.2 0 0 0 6.6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <svg class="cw-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </button>
</div>

<style is:global>
  .cw-root {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 900;
    font-family: var(--font-sans);
  }

  /* ---- Launcher bubble ---- */
  .cw-launcher {
    position: relative;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 999px;
    border: none;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 10px 26px -8px rgba(13, 115, 97, 0.55), 0 2px 6px rgba(27, 32, 28, 0.14);
    transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
  }
  .cw-launcher:hover {
    background: var(--accent-deep);
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -10px rgba(13, 115, 97, 0.6), 0 3px 8px rgba(27, 32, 28, 0.16);
  }
  .cw-launcher:focus-visible {
    outline: 3px solid var(--accent-soft);
    outline-offset: 3px;
  }
  .cw-icon-close { display: none; }
  .cw-root.cw-open .cw-icon-open { display: none; }
  .cw-root.cw-open .cw-icon-close { display: block; }

  /* ---- Panel ---- */
  .cw-panel {
    position: absolute;
    right: 0;
    bottom: 72px;
    width: 360px;
    max-width: calc(100vw - 40px);
    /* Fixed height (not just max) so switching Chat <-> History doesn't resize
       the panel — both views flex-fill the same space. */
    height: min(72vh, 500px);
    max-height: min(72vh, 500px);
    display: flex;
    flex-direction: column;
    background: var(--c-card);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .cw-panel[hidden] { display: none; }

  /* Expanded state — reshape to a TALL panel at the SAME compact width, so more
     of the conversation is visible. Not a "size up" (no wider box); the shape
     just changes from a short card to a full-height column. */
  .cw-panel.cw-expanded {
    width: min(560px, calc(100vw - 40px));
    height: min(760px, calc(100vh - 104px));
    max-height: min(760px, calc(100vh - 104px));
  }

  @media (prefers-reduced-motion: no-preference) {
    .cw-panel {
      transform-origin: bottom right;
      animation: cw-pop .18s cubic-bezier(.2, .8, .3, 1);
    }
    @keyframes cw-pop {
      from { opacity: 0; transform: translateY(8px) scale(.98); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
  }

  /* ---- Header ---- */
  .cw-head {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .8rem 1rem;
    border-bottom: 1px solid var(--c-border-soft);
    background: linear-gradient(180deg, var(--accent-soft), var(--c-card));
  }
  .cw-head-text { margin-right: auto; }
  .cw-avatar {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 2px 6px rgba(13, 115, 97, 0.3);
  }
  .cw-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: .92rem;
    color: var(--c-ink);
    letter-spacing: -0.01em;
  }
  .cw-subtitle {
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .04em;
    color: var(--c-muted);
    margin-top: .12rem;
  }
  .cw-head-actions { display: flex; align-items: center; gap: .2rem; flex-shrink: 0; }
  .cw-close, .cw-expand, .cw-reset {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--c-muted);
    cursor: pointer;
    transition: background .15s, color .15s, border-color .15s;
  }
  .cw-close:hover, .cw-expand:hover, .cw-reset:hover { background: var(--c-bg-soft); color: var(--c-ink); }
  .cw-close:focus-visible, .cw-expand:focus-visible, .cw-reset:focus-visible { outline: 2px solid var(--accent-soft); outline-offset: 2px; }

  /* tabs (Chat / History) */
  .cw-tabs { display: flex; padding: 0 1rem; border-bottom: 1px solid var(--c-border-soft); background: var(--c-card); }
  .cw-tab { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--c-muted); background: none; border: none; border-bottom: 2px solid transparent; padding: .55rem .3rem; margin-right: 1rem; cursor: pointer; }
  .cw-tab.is-on { color: var(--c-ink); border-bottom-color: var(--accent); }
  .cw-tab:hover { color: var(--c-ink); }

  /* history view */
  .cw-history { flex: 1 1 auto; min-height: 130px; overflow-y: auto; padding: .85rem 1rem 1rem; display: none; }
  .cw-history-hint { font-family: var(--font-mono); font-size: .68rem; color: var(--c-muted); margin-bottom: .6rem; }
  .cw-history-empty { color: var(--c-muted-2); font-size: .85rem; padding: 1rem 0; }
  .cw-history-list { display: flex; flex-direction: column; gap: .35rem; }
  .cw-history-item { text-align: left; font: inherit; font-size: .82rem; line-height: 1.4; color: var(--c-fg-2); background: var(--c-bg-soft); border: 1px solid var(--line); border-radius: 9px; padding: .5rem .65rem; cursor: pointer; transition: border-color .15s, color .15s, background .15s; }
  .cw-history-item:hover { border-color: var(--accent-soft); color: var(--accent); background: var(--accent-soft); }

  /* view toggle: History tab hides the live chat surfaces */
  .cw-root.cw-view-history .cw-messages,
  .cw-root.cw-view-history .cw-starters,
  .cw-root.cw-view-history .cw-form { display: none; }
  .cw-root.cw-view-history .cw-history { display: block; }
  /* expand ⇄ shrink icon swap, driven by the panel's expanded class */
  .cw-icon-shrink { display: none; }
  .cw-panel.cw-expanded .cw-icon-expand { display: none; }
  .cw-panel.cw-expanded .cw-icon-shrink { display: block; }

  /* ---- Messages ---- */
  .cw-messages {
    flex: 1 1 auto;
    min-height: 130px;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: .7rem;
    background:
      linear-gradient(180deg, rgba(220, 239, 232, 0.28), rgba(251, 250, 245, 0.0) 90px);
  }
  .cw-msg { display: flex; }
  .cw-msg--user { justify-content: flex-end; }
  .cw-msg--agent { justify-content: flex-start; }
  .cw-bubble {
    max-width: 84%;
    padding: .55rem .75rem;
    border-radius: 14px;
    font-size: .9rem;
    line-height: 1.55;
    color: var(--c-fg);
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .cw-msg--user .cw-bubble {
    background: var(--accent);
    color: #fff;
    border-bottom-right-radius: 5px;
  }
  .cw-msg--user .cw-bubble a { color: #eafff8; }
  .cw-msg--agent .cw-bubble {
    background: var(--c-card);
    border: 1px solid var(--line);
    border-bottom-left-radius: 5px;
  }
  .cw-msg--agent .cw-bubble a { color: var(--accent); font-weight: 600; }

  /* rendered markdown inside an agent bubble */
  .cw-bubble p { margin: 0 0 .5rem; }
  .cw-bubble p:last-child { margin-bottom: 0; }
  .cw-bubble ul, .cw-bubble ol { margin: .35rem 0 .5rem; padding-left: 1.2rem; }
  .cw-bubble ul:last-child, .cw-bubble ol:last-child { margin-bottom: 0; }
  .cw-bubble li { margin: .2rem 0; }
  .cw-msg--agent .cw-bubble strong { font-weight: 700; color: var(--c-ink); }
  /* clickable inline citation markers [1], [2]… */
  .cw-bubble .cw-cite { color: var(--accent); font-weight: 700; font-size: .82em; padding: 0 1px; vertical-align: 1px; }
  .cw-bubble .cw-cite:hover { text-decoration: underline; }
  .cw-bubble code {
    font-family: var(--font-mono);
    font-size: .82em;
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border-soft);
    border-radius: 4px;
    padding: 0 .28em;
  }

  /* thinking dots */
  .cw-dots { display: inline-flex; gap: 4px; align-items: center; height: 1.1em; }
  .cw-dots span {
    width: 6px; height: 6px; border-radius: 999px; background: var(--c-muted-2);
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cw-dots span { animation: cw-blink 1.2s infinite ease-in-out; }
    .cw-dots span:nth-child(2) { animation-delay: .18s; }
    .cw-dots span:nth-child(3) { animation-delay: .36s; }
    @keyframes cw-blink {
      0%, 80%, 100% { opacity: .3; }
      40% { opacity: 1; }
    }
  }

  /* sources + followups inside an agent bubble */
  .cw-sources {
    margin-top: .55rem;
    padding-top: .5rem;
    border-top: 1px solid var(--c-border-soft);
  }
  .cw-sources-title {
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: .3rem;
  }
  .cw-sources ol { margin: 0; padding-left: 1.1rem; }
  .cw-sources ul.cw-src { list-style: none; margin: 0; padding: 0; }
  .cw-sources li { font-size: .78rem; color: var(--c-muted); margin: .15rem 0; }
  .cw-followups {
    margin-top: .55rem;
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
  }

  /* ---- Starter chips ---- */
  .cw-starters {
    padding: 0 1rem .6rem;
    border-top: 1px solid var(--c-border-soft);
    padding-top: .7rem;
  }
  .cw-root.cw-conversing .cw-starters { display: none; }
  .cw-starters-label {
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: .4rem;
  }
  .cw-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .cw-chip, .cw-followups button {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--c-bg-soft);
    color: var(--c-fg-2);
    font: inherit;
    font-size: .78rem;
    line-height: 1.3;
    text-align: left;
    padding: .3rem .6rem;
    cursor: pointer;
    transition: border-color .15s, color .15s, background .15s;
  }
  .cw-chip:hover, .cw-followups button:hover {
    border-color: var(--accent-soft);
    color: var(--accent);
    background: var(--accent-soft);
  }
  .cw-chip:focus-visible, .cw-followups button:focus-visible {
    outline: 2px solid var(--accent-soft);
    outline-offset: 2px;
  }

  /* ---- Input row ---- */
  .cw-form {
    display: flex;
    gap: .5rem;
    padding: .75rem 1rem 1rem;
    border-top: 1px solid var(--c-border-soft);
    background: var(--c-card);
  }
  .cw-input {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: .9rem;
    color: var(--c-fg);
    background: var(--c-bg-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: .5rem .7rem;
    transition: border-color .15s, box-shadow .15s;
  }
  .cw-input::placeholder { color: var(--c-muted-2); }
  .cw-input:focus {
    outline: none;
    border-color: var(--accent-soft);
    box-shadow: 0 0 0 3px rgba(13, 115, 97, 0.12);
  }
  .cw-send {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font: inherit;
    font-size: .85rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border: none;
    border-radius: 10px;
    padding: .5rem .8rem;
    cursor: pointer;
    transition: background .15s, opacity .15s;
  }
  .cw-send:hover { background: var(--accent-deep); }
  .cw-send:focus-visible { outline: 3px solid var(--accent-soft); outline-offset: 2px; }
  .cw-send:disabled { opacity: .55; cursor: not-allowed; }
  .cw-root.cw-pending .cw-input { opacity: .7; }

  /* ---- Mobile: near-full-width panel, launcher stays reachable ---- */
  @media (max-width: 480px) {
    .cw-root { right: 14px; bottom: 14px; }
    .cw-panel {
      width: calc(100vw - 28px);
      max-height: min(76vh, 620px);
      bottom: 68px;
    }
    .cw-send-text { display: none; }
    .cw-send { padding: .5rem .6rem; }
  }
</style>

<script define:vars={{ agentApiUrl, locale, links, copy }}>
  (() => {
    const root = document.querySelector("[data-chat-widget]");
    if (!root) return;

    const launcher = root.querySelector("[data-cw-launcher]");
    const panel = root.querySelector("#cw-panel");
    const closeBtn = root.querySelector("[data-cw-close]");
    const expandBtn = root.querySelector("[data-cw-expand]");
    const messages = root.querySelector("[data-cw-messages]");
    const form = root.querySelector("[data-cw-form]");
    const input = form.querySelector(".cw-input");
    const sendBtn = form.querySelector("[data-cw-send]");
    const resetBtn = root.querySelector("[data-cw-reset]");
    const tabs = [...root.querySelectorAll("[data-cw-tab]")];
    const historyList = root.querySelector("[data-cw-history-list]");
    const historyEmpty = root.querySelector("[data-cw-history-empty]");
    const historyHint = root.querySelector("[data-cw-history-hint]");
    const greetingHTML = messages.innerHTML; // captured for "New chat" reset

    // Client-side conversation history (turns). The backend contract is
    // single-turn { query, locale } (see SiteAgent.astro), so history is kept
    // for display; each request still sends just { query, locale }.
    const history = [];
    let pending = false;

    /* ---------- cross-page persistence (sessionStorage) ----------
       This is a static MPA: every navigation is a full page reload, so the
       conversation must be saved and rehydrated to survive across pages.
       sessionStorage keeps it for the tab's browsing session (clears on close). */
    const STORE_KEY = "sl-chat-widget-v2"; // v2: fresh schema (drops stale pre-fix transcripts)
    let transcript = []; // [{role:"user",text} | {role:"agent",html}] — current conversation
    let questionLog = []; // just the questions asked, for the History tab (survives "New chat")
    function persist() {
      try {
        sessionStorage.setItem(STORE_KEY, JSON.stringify({
          transcript: transcript.slice(-60),
          questionLog: questionLog.slice(-80),
          open: !panel.hidden,
          expanded: panel.classList.contains("cw-expanded"),
          view: root.classList.contains("cw-view-history") ? "history" : "chat",
        }));
      } catch (e) { /* storage blocked/full — degrade to in-memory only */ }
    }
    function loadSaved() {
      try { const raw = sessionStorage.getItem(STORE_KEY); return raw ? JSON.parse(raw) : null; }
      catch (e) { return null; }
    }

    /* ---------- local keyword fallback (public corpus, same as SiteAgent) ---------- */
    const answerSets = {
      en: [
        { keys: ["agent", "agents", "rag", "mcp", "langgraph", "workflow", "harness", "ai for science", "scientific agent"],
          html: `Lu's current direction is AI for Science through reliable agent systems: context engineering, evaluation harnesses, multi-agent orchestration, traceable workflow execution, and human-in-the-loop scientific decision support. See <a href="${links.ai}">Programs</a>.` },
        { keys: ["approach", "reliable", "reliability", "grounded", "testable", "context engineering", "golden set", "acceptance contract", "human review", "human-in-the-loop"],
          html: `The <a href="${links.approach}">Approach</a> page explains the reliability stack: foundation models, agent engineering, context engineering, and evaluation harnesses — measurable behavior, grounded context, explicit tools, and human review.` },
        { keys: ["case", "case study", "case studies", "rfb", "scifm", "molecular property", "molecular-property", "chemgraph"],
          html: `The <a href="${links.cases}">case studies</a> cover the RFB formulation agent, ChemGraph workflow contributions, the scifm registry, and a public molecular-property ML pipeline, with maturity labels preserved.` },
        { keys: ["evolution", "timeline", "technical evolution", "commit", "commits", "trajectory"],
          html: `The <a href="${links.evolution}">Technical Evolution</a> page frames the path from scientific research to data science, LLM/agent systems, and 2026 production reliability work.` },
        { keys: ["mlops", "eval", "evaluation", "observability", "trace", "smoke test", "deployment", "azure", "docker", "search"],
          html: `Lu's AI engineering emphasizes application-layer reliability: retrieval checks, smoke tests, trace review, Docker/Azure deployment-readiness, and rollback-aware search-index workflows — application-layer AI/MLOps, not model pretraining.` },
        { keys: ["battery", "redox", "flow", "electrolyte", "redoxmer", "materials", "property os"],
          html: `Lu's scientific base is battery materials and electrochemistry: redox-flow batteries, redox-active organic molecules, Li-ion electrolyte additives, redox shuttles, and molecular design. See <a href="${links.publications}">publications</a> and <a href="${links.patents}">patents</a>.` },
        { keys: ["publication", "paper", "citation", "scholar", "patent"],
          html: `For publication depth use the <a href="${links.publications}">publication list</a> and <a href="${links.scholar}" target="_blank" rel="noopener">Google Scholar</a>. For invention output see <a href="${links.patents}">patents</a>.` },
        { keys: ["argonne", "anl", "autonomous", "discovery", "robotic", "jcesr", "doe", "national lab"],
          html: `Lu spent 14+ years at Argonne on battery materials, redox molecules, DOE/JCESR programs, and selected AI/ML, high-throughput, and autonomous-discovery collaborations — AI for Science built on deep scientific domain expertise.` },
        { keys: ["cv", "resume", "linkedin", "github", "contact", "email"],
          html: `Use the <a href="${links.cv}" target="_blank" rel="noopener">academic CV PDF</a>, <a href="${links.linkedin}" target="_blank" rel="noopener">LinkedIn</a>, <a href="${links.github}" target="_blank" rel="noopener">GitHub</a>, or <a href="${links.email}">email Lu</a>.` },
      ],
      zh: [
        { keys: ["agent", "智能体", "rag", "mcp", "langgraph", "workflow", "工作流", "ai for science"],
          html: `Lu 现在的主线是把可靠 agent 系统用于 AI for Science：context engineering、evaluation harnesses、multi-agent orchestration、可追踪工作流和 human-in-the-loop 科学决策支持。见 <a href="${links.ai}">Programs</a>。` },
        { keys: ["approach", "方法", "可靠", "可测", "grounded", "reliability", "context engineering", "golden set", "human review", "human-in-the-loop"],
          html: `<a href="${links.approach}">方法页</a> 解释可靠 agent 的四层：foundation models、agent engineering、context engineering 和 evaluation harnesses。重点是可测量行为、grounded context、明确工具和人工 review。` },
        { keys: ["case", "案例", "rfb", "scifm", "molecular property", "molecular-property", "chemgraph"],
          html: `<a href="${links.cases}">case studies</a> 包含 RFB formulation agent、ChemGraph workflow、scifm registry 和公开 molecular-property ML pipeline，并保留 maturity 标签。` },
        { keys: ["evolution", "演化", "timeline", "时间线", "technical evolution", "trajectory"],
          html: `<a href="${links.evolution}">技术演化页</a> 解释从科学研究到 data science、LLM/agent systems，再到 2026 production reliability work 的连续路径。` },
        { keys: ["mlops", "eval", "evaluation", "评估", "trace", "smoke test", "部署", "azure", "docker", "search"],
          html: `Lu 的 AI 工程重点是应用层可靠性：retrieval checks、smoke tests、trace review、Docker/Azure deployment-readiness，以及可回滚的 search-index 工作流。是应用层 AI/MLOps，不是模型预训练。` },
        { keys: ["battery", "电池", "redox", "flow", "液流", "electrolyte", "电解液", "redoxmer", "materials", "材料", "property os"],
          html: `Lu 的科学基础是电池材料和电化学：液流电池、氧化还原活性有机分子、锂离子电解液添加剂、redox shuttle 和分子设计。见 <a href="${links.publications}">论文</a> 和 <a href="${links.patents}">专利</a>。` },
        { keys: ["publication", "paper", "论文", "citation", "引用", "scholar", "patent", "专利"],
          html: `论文看 <a href="${links.publications}">publication list</a> 与 <a href="${links.scholar}" target="_blank" rel="noopener">Google Scholar</a>；发明成果看 <a href="${links.patents}">专利</a>。` },
        { keys: ["argonne", "anl", "阿贡", "autonomous", "自主发现", "discovery", "jcesr", "doe", "国家实验室"],
          html: `Lu 在 Argonne 有 14+ 年电池材料、redox molecules、DOE/JCESR 项目经验，并参与过部分 AI/ML、高通量和 autonomous-discovery 合作——以深厚科学背景为基础的 AI for Science。` },
        { keys: ["cv", "resume", "简历", "linkedin", "github", "contact", "email", "联系"],
          html: `公开记录看 <a href="${links.cv}" target="_blank" rel="noopener">学术 CV PDF</a>，职业背景看 <a href="${links.linkedin}" target="_blank" rel="noopener">LinkedIn</a>，代码看 <a href="${links.github}" target="_blank" rel="noopener">GitHub</a>，也可 <a href="${links.email}">邮件联系 Lu</a>。` },
      ],
    };

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    // Minimal, XSS-safe markdown → HTML for agent answers. Input is escaped
    // FIRST, so no raw HTML can survive; we then re-introduce a small, known set
    // of inline/block tags. Handles **bold**, *italic*, `code`, [label](url)
    // links, and ordered/unordered lists — enough to render the API's markdown
    // instead of showing raw ** and list markers.
    function renderInline(escaped) {
      return escaped
        .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/__([^_]+)__/g, "<strong>$1</strong>")
        .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>")
        .replace(/`([^`]+)`/g, "<code>$1</code>");
    }
    function renderMarkdown(raw) {
      const escaped = escapeHtml(raw || "").replace(/\r\n/g, "\n").trim();
      if (!escaped) return "";
      return escaped
        .split(/\n{2,}/)
        .map((block) => {
          const lines = block.split("\n").filter((l) => l.trim() !== "");
          if (!lines.length) return "";
          if (lines.every((l) => /^\s*\d+\.\s+/.test(l))) {
            // Preserve the source ordinal via value=, so blank-line-separated
            // items (each its own block) don't all restart at "1.".
            return `<ol>${lines.map((l) => {
              const n = (l.match(/^\s*(\d+)\.\s+/) || [])[1] || "";
              return `<li value="${n}">${renderInline(l.replace(/^\s*\d+\.\s+/, ""))}</li>`;
            }).join("")}</ol>`;
          }
          if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
            return `<ul>${lines.map((l) => `<li>${renderInline(l.replace(/^\s*[-*]\s+/, ""))}</li>`).join("")}</ul>`;
          }
          return `<p>${renderInline(lines.join("<br />"))}</p>`;
        })
        .join("");
    }

    function localReply(query) {
      const normalized = query.toLowerCase();
      const set = answerSets[locale] || answerSets.en;
      const match = set.find((item) => item.keys.some((key) => normalized.includes(key.toLowerCase())));
      return match ? match.html : copy.fallback;
    }

    /* ---------- DOM helpers ---------- */
    function scrollToBottom() {
      messages.scrollTop = messages.scrollHeight;
    }

    function addUserMessage(text) {
      const row = document.createElement("div");
      row.className = "cw-msg cw-msg--user";
      const bubble = document.createElement("div");
      bubble.className = "cw-bubble";
      bubble.textContent = text;
      row.appendChild(bubble);
      messages.appendChild(row);
      scrollToBottom();
    }

    // Returns the bubble element so the caller can replace its content once the
    // answer arrives.
    function addAgentMessage(html) {
      const row = document.createElement("div");
      row.className = "cw-msg cw-msg--agent";
      const bubble = document.createElement("div");
      bubble.className = "cw-bubble";
      bubble.innerHTML = html;
      row.appendChild(bubble);
      messages.appendChild(row);
      scrollToBottom();
      return bubble;
    }

    function thinkingHtml() {
      return `<span class="cw-dots" aria-label="${escapeHtml(copy.thinking)}"><span></span><span></span><span></span></span>`;
    }

    // Keep source cards short: long academic titles get truncated at a word
    // boundary so the sources list stays scannable.
    function shortSourceTitle(value) {
      const s = String(value ?? "").replace(/\s+/g, " ").trim();
      return s.length > 60 ? `${s.slice(0, 59).replace(/\s+\S*$/, "").trim()}…` : s;
    }

    // Build the agent answer bubble from the live API response, reusing the same
    // response shape SiteAgent parses: answer text + citations + followups.
    function renderApiAnswer(data) {
      const allCites = Array.isArray(data.citations) ? data.citations : [];
      const citations = allCites.slice(0, 6);
      // Map citation id -> url so inline [n] markers become clickable links.
      const citeMap = {};
      allCites.forEach((c) => { if (c && c.id != null && c.url) citeMap[String(c.id)] = c.url; });
      const answer = renderMarkdown(data.answer || "").replace(/\[(\d+)\]/g, (m, n) =>
        citeMap[n] ? `<a class="cw-cite" href="${escapeHtml(citeMap[n])}" target="_blank" rel="noopener">[${n}]</a>` : m);
      const agent = data.agent || {};
      const followups = Array.isArray(agent.followups) ? agent.followups.slice(0, 3) : [];

      const sources = citations
        .map((item) => {
          const title = escapeHtml(shortSourceTitle(item.title || item.url || "Source"));
          const url = escapeHtml(item.url || "#");
          const id = escapeHtml(item.id || "");
          return `<li><a href="${url}" target="_blank" rel="noopener">${id ? "[" + id + "] " : ""}${title}</a></li>`;
        })
        .join("");
      const sourcesHtml = sources
        ? `<div class="cw-sources"><div class="cw-sources-title">${escapeHtml(copy.sources)}</div><ul class="cw-src">${sources}</ul></div>`
        : "";
      const followupsHtml = followups.length
        ? `<div class="cw-followups">${followups
            .map((f) => `<button type="button" data-cw-prompt="${escapeHtml(f)}">${escapeHtml(f)}</button>`)
            .join("")}</div>`
        : "";
      return `<div>${answer || escapeHtml(copy.fallback)}</div>${sourcesHtml}${followupsHtml}`;
    }

    /* ---------- live API (same contract as SiteAgent.astro) ---------- */
    async function askLiveAgent(query) {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 35000);
      try {
        const response = await fetch(agentApiUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query, locale }),
          signal: controller.signal,
        });
        if (!response.ok) {
          const err = new Error(`Agent API returned ${response.status}`);
          err.status = response.status;
          throw err;
        }
        return await response.json();
      } finally {
        window.clearTimeout(timeout);
      }
    }

    /* ---------- send flow with abuse/cost guard ---------- */
    function setPending(state) {
      pending = state;
      sendBtn.disabled = state;
      input.disabled = state;
      root.classList.toggle("cw-pending", state);
    }

    async function send(query) {
      const q = (query || "").trim();
      if (!q || pending) return; // debounce: ignore while a request is in flight

      if (root.classList.contains("cw-view-history")) showView("chat"); // asking jumps back to chat
      root.classList.add("cw-conversing"); // hide starter chips after first turn
      addUserMessage(q);
      history.push({ role: "user", text: q });
      transcript.push({ role: "user", text: q });
      if (questionLog[questionLog.length - 1] !== q) questionLog.push(q); // log for History tab
      persist();
      input.value = "";
      setPending(true);

      const bubble = addAgentMessage(thinkingHtml());

      if (!agentApiUrl) {
        // No endpoint configured → local fallback only (graceful degrade).
        const html = localReply(q);
        bubble.innerHTML = html;
        history.push({ role: "agent", text: html });
        transcript.push({ role: "agent", html });
        persist();
        scrollToBottom();
        setPending(false);
        return;
      }

      try {
        const data = await askLiveAgent(q);
        const html = renderApiAnswer(data);
        bubble.innerHTML = html;
        history.push({ role: "agent", text: data.answer || "" });
      } catch (error) {
        if (error && error.status === 429) {
          // Rate limited — do NOT retry/hammer the backend.
          bubble.innerHTML = `<div>${escapeHtml(copy.rateLimit)}</div>`;
        } else {
          // Any other error/timeout → friendly note + local public-corpus answer.
          bubble.innerHTML = `<div>${escapeHtml(copy.apiError)}</div><div style="margin-top:.5rem">${localReply(q)}</div>`;
        }
      } finally {
        // Record the FINAL agent bubble (answer or error fallback), then save.
        transcript.push({ role: "agent", html: bubble.innerHTML });
        persist();
        setPending(false);
        scrollToBottom();
        if (!input.disabled) input.focus();
      }
    }

    /* ---------- open/close ---------- */
    function openPanel(focus = true) {
      panel.hidden = false;
      root.classList.add("cw-open");
      launcher.setAttribute("aria-expanded", "true");
      launcher.setAttribute("aria-label", copy.close);
      if (focus) window.requestAnimationFrame(() => input.focus());
      persist();
    }
    function closePanel() {
      panel.hidden = true;
      root.classList.remove("cw-open");
      launcher.setAttribute("aria-expanded", "false");
      launcher.setAttribute("aria-label", copy.launcherOpen);
      launcher.focus();
      persist();
    }
    function togglePanel() {
      if (panel.hidden) openPanel();
      else closePanel();
    }

    function toggleExpand() {
      const expanded = panel.classList.toggle("cw-expanded");
      expandBtn.setAttribute("aria-pressed", expanded ? "true" : "false");
      expandBtn.setAttribute("aria-label", expanded ? copy.shrink : copy.expand);
      scrollToBottom();
      persist();
    }

    function renderHistory() {
      const items = questionLog.slice().reverse();
      historyList.innerHTML = items
        .map((q) => `<button type="button" class="cw-history-item" data-cw-prompt="${escapeHtml(q)}">${escapeHtml(q)}</button>`)
        .join("");
      const has = items.length > 0;
      historyEmpty.hidden = has;
      if (historyHint) historyHint.hidden = !has;
    }
    function showView(view) {
      const isHistory = view === "history";
      root.classList.toggle("cw-view-history", isHistory);
      tabs.forEach((t) => t.classList.toggle("is-on", t.getAttribute("data-cw-tab") === view));
      if (isHistory) renderHistory();
      persist();
    }
    // "New chat": clear the current conversation but KEEP the question history.
    function resetChat() {
      transcript = [];
      messages.innerHTML = greetingHTML;
      root.classList.remove("cw-conversing");
      showView("chat");
      persist();
      window.requestAnimationFrame(() => input.focus());
    }

    launcher.addEventListener("click", togglePanel);
    closeBtn.addEventListener("click", closePanel);
    expandBtn.addEventListener("click", toggleExpand);
    resetBtn.addEventListener("click", resetChat);
    tabs.forEach((t) => t.addEventListener("click", () => showView(t.getAttribute("data-cw-tab"))));

    // Esc closes the panel when it's open.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) closePanel();
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      send(input.value);
    });

    // Delegated: starter chips + dynamically-rendered followup chips both send.
    root.addEventListener("click", (e) => {
      const chip = e.target.closest?.("[data-cw-prompt]");
      if (!chip) return;
      send(chip.getAttribute("data-cw-prompt") || "");
    });

    // Rehydrate a conversation saved earlier this browsing session, so the chat
    // history carries across page navigations. Appends after the greeting.
    (function restore() {
      const saved = loadSaved();
      if (!saved) return;
      if (Array.isArray(saved.transcript) && saved.transcript.length) {
        transcript = saved.transcript;
        transcript.forEach((turn) => {
          if (turn.role === "user") addUserMessage(turn.text);
          else if (turn.role === "agent") addAgentMessage(turn.html);
        });
        root.classList.add("cw-conversing");
      }
      if (Array.isArray(saved.questionLog)) questionLog = saved.questionLog;
      renderHistory();
      if (saved.expanded) {
        panel.classList.add("cw-expanded");
        expandBtn.setAttribute("aria-pressed", "true");
        expandBtn.setAttribute("aria-label", copy.shrink);
      }
      if (saved.view === "history") showView("history");
      if (saved.open) openPanel(false); // reopen without stealing focus/scroll
    })();
  })();
</script>
