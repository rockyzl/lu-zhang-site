---
// Stylized agent / orchestration graph — a central core node (the agent) with
// radiating satellite nodes, connecting edges, and a few bright "signal" dots
// along them. Reads as agent orchestration / retrieval graph / connected
// intelligence — the AI-engineer positioning, not chemistry.
//
// Used as the portrait placeholder until a real photo is dropped at
// public/images/portrait.jpg. Designed to read well at both 4:5 hero
// aspect and 1:1 about-page square. (Filename kept for import stability.)
---
<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" aria-label="Stylized agent orchestration graph">
  <defs>
    <radialGradient id="haloLZ" cx="50%" cy="42%" r="55%">
      <stop offset="0%" stop-color="rgba(255,255,255,0.16)"/>
      <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
    </radialGradient>
  </defs>
  <circle cx="100" cy="90" r="80" fill="url(#haloLZ)" />

  <!-- Edges: hub -> satellites + a few mesh links -->
  <g stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round" fill="none">
    <!-- hub (100,92) to satellites -->
    <line x1="100" y1="92" x2="50"  y2="58" />
    <line x1="100" y1="92" x2="150" y2="52" />
    <line x1="100" y1="92" x2="160" y2="114" />
    <line x1="100" y1="92" x2="46"  y2="120" />
    <line x1="100" y1="92" x2="106" y2="150" />
    <!-- mesh links between satellites -->
    <line x1="50"  y1="58"  x2="150" y2="52"  opacity="0.45" />
    <line x1="160" y1="114" x2="106" y2="150" opacity="0.45" />
    <line x1="46"  y1="120" x2="106" y2="150" opacity="0.45" />
  </g>

  <!-- Satellite nodes -->
  <g stroke="rgba(255,255,255,0.92)" stroke-width="2" fill="rgba(255,255,255,0.12)">
    <circle cx="50"  cy="58"  r="7" />
    <circle cx="150" cy="52"  r="7" />
    <circle cx="160" cy="114" r="7" />
    <circle cx="46"  cy="120" r="7" />
    <circle cx="106" cy="150" r="6.5" />
  </g>

  <!-- Core (orchestrator) node: double ring + center dot -->
  <g transform="translate(100,92)">
    <circle r="13" fill="rgba(255,255,255,0.10)" stroke="rgba(255,255,255,0.95)" stroke-width="2.2" />
    <circle r="4.2" fill="rgba(255,255,255,0.95)" />
  </g>

  <!-- Bright signal dots travelling the edges -->
  <circle cx="125" cy="72"  r="2.6" fill="white" opacity="0.95" />
  <circle cx="73"  cy="106" r="2.2" fill="white" opacity="0.8" />
  <circle cx="133" cy="131" r="2.0" fill="white" opacity="0.65" />

  <!-- L · Z monogram, restrained -->
  <text x="100" y="190" text-anchor="middle"
        font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
        font-size="14" font-weight="500" letter-spacing="0.18em"
        fill="rgba(255,255,255,0.85)">L · Z</text>
</svg>
