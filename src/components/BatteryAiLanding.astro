---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";

const { locale = "en" } = Astro.props;
const zh = locale === "zh";
const t = (en: string, cn: string) => (zh ? cn : en);

const questions = [
  {
    title: t("Where did this result come from?", "这组结果从哪里来？"),
    body: t(
      "Connect a curve or result to sample identity, measurement settings, test conditions and source records. Missing context should remain visible.",
      "把曲线或结果关联到样品编号、测试设置、实验条件与原始记录。缺失的信息应当明确标出。"
    ),
  },
  {
    title: t("Why did two experiments differ?", "两次实验为什么不同？"),
    body: t(
      "Compare conditions and competing explanations before drawing a conclusion. Use validated numerical tools where appropriate.",
      "先对照实验条件与可能的解释，再形成判断；数值计算交给适当的可验证工具。"
    ),
  },
  {
    title: t("What is worth testing next?", "下一步实验值得测什么？"),
    body: t(
      "Organize evidence, uncertainty and proposed follow-ups for a scientist to assess. Researchers remain in control of experiments.",
      "整理证据、不确定性与后续实验建议，由研究人员判断；实际实验仍由研究人员负责。"
    ),
  },
];

const stages = [
  {
    number: "01",
    title: t("Workflow assessment", "工作流程评估"),
    body: t("Choose one bottleneck, document available data and define a measurable success criterion.", "聚焦一个实际瓶颈，梳理可用数据，并约定可测量的验收标准。"),
  },
  {
    number: "02",
    title: t("Historical-data replay", "历史数据回放"),
    body: t("Start with selected historical or public records; trace the output back to inputs and analysis steps.", "从选定的历史数据或公开数据出发，追溯结果所依据的输入与分析步骤。"),
  },
  {
    number: "03",
    title: t("Researcher-reviewed pilot", "研究者审核的试点"),
    body: t("Test recommendations in shadow mode. A live instrument step is considered only after feasibility, controls and explicit human approval.", "先以旁路模式审阅建议。是否接入真实仪器，要经过可行性与安全边界评估，并取得明确人工批准。"),
  },
];
---
<Base
  title={t("Battery & Electrochemistry AI Workflows | SciencesLoop", "电池与电化学研发 AI 工作流程 | SciencesLoop")}
  description={t(
    "One-stop, adaptive AI workflows for battery and electrochemistry R&D: integrate experiments, simulation, machine learning and existing scientific tools in a unified workspace.",
    "面向电池与电化学研发的一站式自适应 AI 工作流：在统一入口整合实验数据、仿真、机器学习和已有科研工具。"
  )}
  alternatePath={u(zh ? "/battery-ai/" : "/zh/battery-ai/")}
>
  <div class="container battery-ai-page">
    <section class="battery-hero">
      <p class="eyebrow">{t("BATTERY & ELECTROCHEMISTRY · SCIENTIFIC AI", "电池与电化学 · 科学 AI")}</p>
      <h1>{t("One R&D workspace. Built around your battery lab.", "一个工作入口，连接电池研发的复杂工具体系")}</h1>
      <p class="lead">{t(
        "Instead of moving between disconnected tools, bring experimental data, simulation software, ML models and foundation-model tool calling into one adaptive research workspace. The workflow can select the next approved tool as the scientific question evolves.",
        "不再在分散的平台间反复调取数据、运行模型。将实验数据、仿真软件、机器学习模型与基础模型工具调用连接到同一工作入口，随着科研问题变化，按需调用经过批准的工具。"
      )}</p>
      <p class="status">{t(
        "This is a scoped integration and orchestration pilot—not an already universal platform. We assess each legacy system, interface and scientific tool before claiming support or efficiency gains.",
        "当前是有边界的数据和工具整合试点，并非已经兼容所有科研体系的平台。每种旧系统、接口和科学工具均需先做可行性验证，提效效果也需实际评估。"
      )}</p>
      <div class="actions">
        <a class="primary" href="mailto:luzhang@sciencesloop.com?subject=Battery%20and%20electrochemistry%20AI%20pilot">{t("Discuss a research bottleneck", "聊一个具体研发难题")}</a>
        <a class="secondary" href={u(zh ? "/zh/agent/battery-research/" : "/agent/battery-research/")}>{t("Explore the public-data demo", "查看公开数据演示")}</a>
      </div>
    </section>

    <section aria-labelledby="questions">
      <p class="eyebrow">{t("THE FIRST USE CASES", "优先解决的问题")}</p>
      <h2 id="questions">{t("The workflow adapts to the question", "让工具链随科研问题而调整")}</h2>
      <div class="question-grid">
        {questions.map((question) => (
          <article class="question"><h3>{question.title}</h3><p>{question.body}</p></article>
        ))}
      </div>
      <p>{t(
        "For example: retrieve CV or EIS measurements, check sample and test context, call an appropriate fitting, simulation or ML tool, then compare evidence before a scientist approves a follow-up. Available tools depend on the team's actual integrations and validated scope.",
        "例如：读取 CV 或 EIS 数据，核对样品与测试条件，按问题调用合适的拟合、仿真或机器学习工具，比较证据后交由研究者审批后续步骤。实际可调用的工具以团队现有集成与验证范围为准。"
      )}</p>
    </section>

    <section aria-labelledby="evidence" class="evidence">
      <p class="eyebrow">{t("SHOW THE EVIDENCE", "展示现有证据")}</p>
      <h2 id="evidence">{t("What you can inspect today", "目前可以检查的内容")}</h2>
      <p>{t(
        "The Battery Research Workbench demonstrates analysis on a public measured-data case, with source-linked inputs and bounded numerical tools. It is a research demo—not proof of production accuracy on your instruments or autonomous lab operation.",
        "Battery Research Workbench 展示基于公开实测数据的分析流程，包含可追溯输入与有边界的数值工具。这是科研演示，不代表已验证客户仪器上的生产准确率或实现无人值守实验室。"
      )}</p>
      <div class="evidence-links">
        <a href={u(zh ? "/zh/agent/battery-research/" : "/agent/battery-research/")}>{t("Battery Research Workbench (public-data demo)", "电池研发工作台（公开数据演示）")}</a>
        <a href={u(zh ? "/zh/energy-materials-ai/" : "/energy-materials-ai/")}>{t("Energy materials research prototype", "能源材料研发原型")}</a>
        <a href={u(zh ? "/zh/about/" : "/about/")}>{t("About founder Lu Zhang", "了解创始人张鲁 Lu Zhang")}</a>
      </div>
    </section>

    <section aria-labelledby="pilot">
      <p class="eyebrow">{t("A PRACTICAL ENGAGEMENT", "可执行的合作路径")}</p>
      <h2 id="pilot">{t("Start small, evaluate, then expand", "先做小范围验证，再决定是否扩展")}</h2>
      <div class="step-grid">
        {stages.map((stage) => (
          <article class="step"><span>{stage.number}</span><h3>{stage.title}</h3><p>{stage.body}</p></article>
        ))}
      </div>
    </section>

    <section class="closing">
      <h2>{t("Bring one difficult, recurring research decision.", "带来一个反复困扰团队的具体科研判断。")}</h2>
      <p>{t(
        "SciencesLoop combines electrochemistry research experience with AI systems engineering. The goal is a workflow your scientists can inspect and challenge—not a black-box claim.",
        "SciencesLoop 将电化学研究经验与 AI 系统工程结合起来，目标是让科研人员可以检查、质疑并改进的流程，而不是黑箱结论。"
      )}</p>
      <a href="mailto:luzhang@sciencesloop.com?subject=SciencesLoop%20R%26D%20workflow">{t("Describe your workflow", "介绍你的研发流程")}</a>
    </section>
  </div>
</Base>
<style>
  .battery-ai-page { padding: 2.8rem 0 5rem; }
  .battery-ai-page h1 { max-width: 970px; font-size: clamp(2.1rem, 4.4vw, 4.5rem); line-height: 1.12; letter-spacing: -.035em; }
  .battery-ai-page h2 { margin: .4rem 0 1.25rem; font-size: clamp(1.5rem, 2.7vw, 2.5rem); }
  .battery-ai-page h3 { font-size: 1.1rem; margin: 0 0 .65rem; }
  .battery-ai-page p { max-width: 820px; }
  .battery-ai-page .lead { font-size: clamp(1.1rem, 2vw, 1.35rem); max-width: 830px; line-height: 1.65; }
  .battery-ai-page .eyebrow { color: var(--c-accent); letter-spacing: .12em; font-size: .77rem; font-weight: 700; }
  .battery-hero { padding-bottom: 3.5rem; }
  .battery-ai-page .status { color: var(--c-muted); font-size: .91rem; }
  .battery-ai-page .actions { display: flex; flex-wrap: wrap; gap: .9rem; padding-top: .9rem; }
  .battery-ai-page .actions a, .battery-ai-page .closing a { border-radius: .55rem; padding: .85rem 1.1rem; font-weight: 650; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
  .battery-ai-page .primary, .battery-ai-page .closing a { background: var(--c-accent); color: white; }
  .battery-ai-page .secondary { border: 1px solid var(--c-border); color: var(--c-fg); }
  .battery-ai-page section:not(.battery-hero) { padding-top: 2.3rem; }
  .battery-ai-page .question-grid, .battery-ai-page .step-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .85rem; margin: 1.5rem 0; }
  .battery-ai-page .question, .battery-ai-page .step { padding: 1.25rem; border: 1px solid var(--c-border); border-radius: .8rem; background: var(--c-card); }
  .battery-ai-page .question p, .battery-ai-page .step p { font-size: .95rem; color: var(--c-muted); }
  .battery-ai-page .step span { display: block; font-size: .8rem; font-weight: 800; color: var(--c-accent); padding-bottom: .75rem; }
  .battery-ai-page .evidence-links { display: flex; flex-direction: column; align-items: flex-start; gap: .75rem; padding: 1rem 0; }
  .battery-ai-page .evidence-links a { color: var(--c-accent); font-weight: 650; text-underline-offset: 3px; }
  .battery-ai-page .closing { margin-top: 2.5rem; padding: 2rem 1.5rem !important; border: 1px solid var(--c-border); border-radius: 1rem; background: var(--c-card); }
  @media (max-width: 800px) {
    .battery-ai-page { padding-top: 1.5rem; }
    .battery-ai-page .question-grid, .battery-ai-page .step-grid { grid-template-columns: 1fr; }
    .battery-ai-page .actions { flex-direction: column; }
    .battery-ai-page .actions a { width: 100%; }
  }
</style>
