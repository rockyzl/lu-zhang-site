---
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en" } = Astro.props as { locale?: Locale };
const apiBaseUrl = (import.meta.env.PUBLIC_MIST_TRANSFER_API_URL ?? "").trim();
const repoHref = "https://github.com/rockyzl/mist-transfer-benchmark";
const agentHref = u(locale === "zh" ? "/zh/agent/" : "/agent/");

const copy = locale === "zh"
  ? {
      eyebrow: "张鲁独立研究 · MIST transfer benchmark",
      title: "Fine-tuned 分子基础模型能否匹敌专用模型？",
      lead: "我设计并运行了这项独立 benchmark：在相同 QM9 数据划分和 12 个分子性质上，将发布的 fine-tuned MIST 与优化后的 Ridge、XGBoost、MLP 和 ensemble 公平比较。",
      storyTitle: "一个很简单的故事",
      story: "想象四位学生拿到同一个分子。Ridge 只用一把直尺找规律；XGBoost 用许多判断题组合答案；MLP 从分子指纹学习弯曲的规律；MIST 先读过大量分子，再回答这道题。这个演示让他们同时作答。模型意见一致时只是一个线索，意见不同时则提醒我们继续检查；真正决定谁更好的是从未参与训练的测试数据。",
      apiUnavailable: "实时 API 尚未配置",
      apiUnavailableDetail: "公开站点可播放乙醇的四模型真实保存结果；任意新分子的实时预测需要私有后端。",
      apiReady: "实时 API 已配置",
      apiReadyDetail: "提交时会向版本化的 POST /v1/predict 端点发送一个 SMILES。",
      apiInvalid: "API 配置无效",
      apiInvalidDetail: "预测服务必须使用 HTTPS；本机开发可使用 localhost HTTP。",
      smilesLabel: "SMILES",
      smilesPlaceholder: "例如：CCO",
      smilesHelp: "一次输入一个分子，最多 512 个字符。后端会用 RDKit 检查它是否可以解析。",
      examplesLabel: "试一个例子",
      examples: [
        ["甲烷", "C"],
        ["乙醇", "CCO"],
        ["乙酸", "CC(=O)O"],
        ["吡啶", "c1ccncc1"],
      ],
      predict: "预测 12 个性质",
      replay: "查看乙醇四模型示例",
      predicting: "四个模型正在预测…",
      clear: "清空",
      contractTitle: "浏览器和模型怎样连接？",
      contract: "浏览器只发送 {\"smiles\":\"CCO\"}，不携带 cookie、账号或 API token。后端必须一次返回四个模型、12 个目标及其单位，并声明 schema_version=\"live-demo-prediction-v1\"；否则页面拒绝显示。",
      modelTitle: "这四个模型有什么区别？",
      modelItems: [
        ["ECFP Ridge", "圆形分子指纹上的线性基线。"],
        ["ECFP XGBoost", "同类分子指纹上的非线性树模型。"],
        ["ECFP MLP", "同类分子指纹上的小型神经网络。"],
        ["MIST-28M", "预训练分子编码器的 QM9 专用检查点。"],
      ],
      loadingTitle: "正在计算四组结果",
      loadingDetail: "后端会验证分子，并返回全部 12 个性质。",
      successTitle: "预测完成",
      successDetail: "四个模型和全部 12 个性质都通过了浏览器端协议检查。",
      errorTitle: "暂时无法预测",
      resultKicker: "模型原生单位输出",
      comparisonFor: "对比分子",
      noTruth: "没有实测真值",
      focusLabel: "重点电子性质",
      tableCaption: "四个模型对这个 SMILES 的全部 12 个 QM9 性质预测",
      property: "性质",
      unit: "单位",
      limitationsTitle: "怎样读这些数字",
      limitations: [
        "它们是模型预测，不是实测值、置信区间或正式 benchmark 分数。",
        "QM9 主要覆盖小型有机分子和 DFT 计算标签；远离这个化学域时，误差可能明显增大。",
        "四个模型意见不一致，不等于经过校准的不确定性。",
        "HOMO、LUMO 和 gap 与分子筛选有关，但不能直接代表电解液、电极界面或电池性能。",
      ],
      privacy: "页面不会保存输入，但配置的预测服务会收到你提交的 SMILES。请不要输入保密分子。",
      source: "查看方法与源码 →",
      back: "← 返回 Agent demo",
      inputRequired: "请先输入一个 SMILES。",
      inputTooLong: "SMILES 不能超过 512 个字符。",
      inputControl: "SMILES 不能包含控制字符。",
      requestFailed: "请求失败。请检查预测服务是否在线，并允许 SciencesLoop 的跨域请求。",
      timeout: "预测在 45 秒后超时。",
      responseRejected: "后端返回的数据不符合版本化预测协议。",
      sampleOnly: "公开演示目前只保存了乙醇（CCO）的结果。请选择乙醇；任意 SMILES 需要启动私有实时后端。",
      savedResult: "已载入本地固定模型生成的乙醇保存结果；这不是浏览器实时推理。",
      propertyNames: {
        mu: "偶极矩 μ",
        alpha: "各向同性极化率 α",
        homo: "HOMO 能量",
        lumo: "LUMO 能量",
        gap: "HOMO–LUMO 能隙",
        r2: "电子空间范围 ⟨R²⟩",
        zpve: "零点振动能",
        u0: "0 K 内能 U₀",
        u298: "298 K 内能 U",
        h298: "298 K 焓 H",
        g298: "298 K 自由能 G",
        cv: "热容 Cᵥ",
      },
    }
  : {
      eyebrow: "Independent research by Lu Zhang · MIST transfer benchmark",
      title: "Can a fine-tuned molecular foundation model match task-specific models?",
      lead: "I designed and ran this independent benchmark to compare the released fine-tuned MIST checkpoint with optimized Ridge, XGBoost, MLP, and an ensemble on the same QM9 split and all 12 molecular properties.",
      storyTitle: "A simple story",
      story: "Imagine four students receive the same molecule. Ridge uses a ruler to find a straight-line pattern. XGBoost combines many decision questions. The MLP learns curved patterns from a molecular fingerprint. MIST first studied a large molecular library, then answers this task. This demo lets all four answer together. Agreement is a clue and disagreement is a reason to inspect; unseen test data decides which student is actually better.",
      apiUnavailable: "Live API is not configured",
      apiUnavailableDetail: "The public site can replay real saved four-model results for ethanol. New molecules require the private live backend.",
      apiReady: "Live API is configured",
      apiReadyDetail: "Submissions go to the versioned POST /v1/predict endpoint with one SMILES string.",
      apiInvalid: "API configuration is invalid",
      apiInvalidDetail: "The prediction service must use HTTPS; localhost HTTP is allowed for local development.",
      smilesLabel: "SMILES",
      smilesPlaceholder: "For example: CCO",
      smilesHelp: "Enter one molecule, up to 512 characters. The backend checks whether RDKit can parse it.",
      examplesLabel: "Try an example",
      examples: [
        ["Methane", "C"],
        ["Ethanol", "CCO"],
        ["Acetic acid", "CC(=O)O"],
        ["Pyridine", "c1ccncc1"],
      ],
      predict: "Predict 12 properties",
      replay: "View ethanol four-model example",
      predicting: "Running four predictors…",
      clear: "Clear",
      contractTitle: "How does the browser reach the models?",
      contract: "The browser sends only {\"smiles\":\"CCO\"}, without cookies, accounts, or API tokens. The backend must return all four models, all 12 targets and units, and schema_version=\"live-demo-prediction-v1\" in one response; otherwise the page refuses to render it.",
      modelTitle: "What are the four models?",
      modelItems: [
        ["ECFP Ridge", "A linear baseline over circular molecular fingerprints."],
        ["ECFP XGBoost", "A nonlinear tree ensemble over the same kind of fingerprints."],
        ["ECFP MLP", "A small neural network over the same kind of fingerprints."],
        ["MIST-28M", "A QM9-specific checkpoint of a pretrained molecular encoder."],
      ],
      loadingTitle: "Computing four sets of predictions",
      loadingDetail: "The backend validates the molecule and returns all 12 properties.",
      successTitle: "Prediction complete",
      successDetail: "All four models and all 12 properties passed the browser contract.",
      errorTitle: "Prediction is unavailable",
      resultKicker: "Native-unit model output",
      comparisonFor: "Comparison for",
      noTruth: "No measured truth",
      focusLabel: "Highlighted electronic properties",
      tableCaption: "All 12 QM9 property predictions from four models for this SMILES",
      property: "Property",
      unit: "Unit",
      limitationsTitle: "How to read these numbers",
      limitations: [
        "They are model predictions, not measurements, confidence intervals, or official benchmark scores.",
        "QM9 mainly covers small organic molecules with DFT-computed labels; error can grow outside that chemical domain.",
        "Disagreement among the four models is not calibrated uncertainty.",
        "HOMO, LUMO, and gap can inform molecular screening, but they do not directly describe an electrolyte, electrode interface, or battery performance.",
      ],
      privacy: "This page does not store the input, but the configured prediction service receives the submitted SMILES. Do not submit confidential molecules.",
      source: "View method and source →",
      back: "← Back to agent demos",
      inputRequired: "Enter a SMILES string before requesting a prediction.",
      inputTooLong: "SMILES must be 512 characters or fewer.",
      inputControl: "SMILES cannot contain control characters.",
      requestFailed: "The request failed. Check that the prediction service is online and allows SciencesLoop as a cross-origin client.",
      timeout: "The prediction timed out after 45 seconds.",
      responseRejected: "The backend response did not match the versioned prediction contract.",
      sampleOnly: "The public demo currently stores results only for ethanol (CCO). Choose Ethanol; any SMILES requires the private live backend.",
      savedResult: "Loaded saved ethanol output generated by the fixed local models; this is not browser-side live inference.",
      propertyNames: {
        mu: "Dipole moment μ",
        alpha: "Isotropic polarizability α",
        homo: "HOMO energy",
        lumo: "LUMO energy",
        gap: "HOMO–LUMO gap",
        r2: "Electronic spatial extent ⟨R²⟩",
        zpve: "Zero-point vibrational energy",
        u0: "Internal energy U₀ at 0 K",
        u298: "Internal energy U at 298 K",
        h298: "Enthalpy H at 298 K",
        g298: "Free energy G at 298 K",
        cv: "Heat capacity Cᵥ",
      },
    };

const study = locale === "zh"
  ? {
      backgroundTitle: "背景很简单",
      background: "MIST-28M 先在 Enamine REAL Space 的 SMILES 上进行 masked-language-model 预训练，再用 QM9 做 12 目标监督 fine-tuning。预训练模型的吸引力在于同一个分子表示可以适配许多下游任务；这里要检验的是，这种复用路线在准确率上能否匹敌为 QM9 专门优化的模型。MIST 由密歇根大学 Electrochemical Energy Group 开发；本文 benchmark、代码、训练和分析由张鲁独立完成。",
      dataTitle: "数据与训练",
      dataItems: [
        ["数据", "133,885 个 QM9 小型有机分子，12 个 DFT 计算性质"],
        ["划分", "107,108 train · 13,388 validation · 13,389 test"],
        ["特征", "Count ECFP4 的 2,048 个局部结构计数 + 17 个全局分子特征"],
        ["优化", "5 组 XGBoost、5 组 MLP；只用 validation 选参数和 ensemble 权重"],
        ["计算", "RTX PRO 2000 8GB Laptop GPU；完整运行 36.4 分钟"],
      ],
      resultTitle: "共同测试集结果",
      resultHelp: "平均标准化 MAE，越低越好。测试集只在所有选择冻结后读取一次。",
      targetTitle: "12 个性质逐项比较",
      targetHelp: "每一行按该性质中最高误差归一化柱长；数值仍是实际标准化 MAE。",
      conclusionTitle: "结论",
      conclusion: "优化后的 XGBoost（0.09434）与 fine-tuned MIST（0.09506）在这次点估计中基本持平；没有多随机种子和置信区间，不能把 0.00073 的差距说成决定性胜负。Ensemble 达到 0.08116，说明基础模型与传统模型包含互补信息。这个结果支持 foundation model + fine-tuning 的复用价值，但还不能证明预训练本身是改善的唯一原因。",
      sources: "方法、数据与来源",
      demoTitle: "试一个公开示例",
      demoLead: "选择乙醇 CCO，可以播放四个固定模型生成的 12 项保存结果；任意新分子需要私有实时后端。",
    }
  : {
      backgroundTitle: "The background is simple",
      background: "MIST-28M was pretrained with masked language modeling on SMILES from Enamine REAL Space, then supervised-fine-tuned on QM9 for 12 targets. A pretrained representation can be reused across many downstream tasks; this study asks whether that reusable path can match models optimized specifically for QM9. MIST was developed by the University of Michigan Electrochemical Energy Group. Lu Zhang independently designed and ran this benchmark, code, training, and analysis.",
      dataTitle: "Data and training",
      dataItems: [
        ["Data", "133,885 small QM9 molecules with 12 DFT-computed properties"],
        ["Split", "107,108 train · 13,388 validation · 13,389 test"],
        ["Features", "2,048 count-ECFP4 local-structure features + 17 global descriptors"],
        ["Search", "5 XGBoost and 5 MLP settings; validation-only model and blend selection"],
        ["Compute", "RTX PRO 2000 8GB Laptop GPU; 36.4-minute complete run"],
      ],
      resultTitle: "Common held-out test result",
      resultHelp: "Mean normalized MAE; lower is better. Test labels were loaded once after every choice was frozen.",
      targetTitle: "All 12 properties",
      targetHelp: "Bar width is scaled to the largest error within each property; labels retain actual normalized MAE.",
      conclusionTitle: "Conclusion",
      conclusion: "Optimized XGBoost (0.09434) and fine-tuned MIST (0.09506) are effectively at parity in this point estimate. Without repeated seeds and confidence intervals, their 0.00073 gap is not a decisive win. The ensemble reaches 0.08116, showing complementary information between the foundation and task-specific models. This supports the reuse value of foundation-model fine-tuning, but does not isolate pretraining as the sole cause.",
      sources: "Methods, data, and sources",
      demoTitle: "Try a public example",
      demoLead: "Choose ethanol (CCO) to replay saved 12-property outputs from four fixed models. New molecules require the private live backend.",
    };

const modelLabels = { ensemble: "Ensemble", xgboost: "XGBoost", mist: "MIST", mlp: "MLP", ridge: "Ridge" };
const overall = { ensemble: 0.08115898, xgboost: 0.09433632, mist: 0.09506432, mlp: 0.10036413, ridge: 0.37004856 };
const targets = [
  ["mu", { ensemble: .307169, xgboost: .371006, mist: .313150, mlp: .354812, ridge: .521526 }],
  ["alpha", { ensemble: .055902, xgboost: .064938, mist: .075184, mlp: .066560, ridge: .408352 }],
  ["homo", { ensemble: .178815, xgboost: .232815, mist: .187313, mlp: .211746, ridge: .391671 }],
  ["lumo", { ensemble: .092801, xgboost: .118009, mist: .107254, mlp: .112238, ridge: .288715 }],
  ["gap", { ensemble: .119303, xgboost: .151663, mist: .128906, mlp: .144751, ridge: .326438 }],
  ["r2", { ensemble: .097104, xgboost: .116319, mist: .121616, mlp: .117618, ridge: .385342 }],
  ["zpve", { ensemble: .017893, xgboost: .010000, mist: .028299, mlp: .036792, ridge: .276258 }],
  ["u0", { ensemble: .011420, xgboost: .001619, mist: .019865, mlp: .023555, ridge: .369774 }],
  ["u298", { ensemble: .012914, xgboost: .001462, mist: .025987, mlp: .023541, ridge: .369771 }],
  ["h298", { ensemble: .016510, xgboost: .001442, mist: .037158, mlp: .023563, ridge: .369769 }],
  ["g298", { ensemble: .017407, xgboost: .001431, mist: .040903, mlp: .023547, ridge: .369779 }],
  ["cv", { ensemble: .046670, xgboost: .061332, mist: .055139, mlp: .065646, ridge: .363187 }],
];
const modelOrder = ["ensemble", "xgboost", "mist", "mlp", "ridge"];
---

<section class="mtp-demo" data-mtp-demo>
  <header class="mtp-hero">
    <p class="mtp-eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="mtp-lead">{copy.lead}</p>
  </header>

  <section class="mtp-story" aria-labelledby="mtp-story-title">
    <div class="mtp-story-number" aria-hidden="true">4</div>
    <div>
      <h2 id="mtp-story-title">{copy.storyTitle}</h2>
      <p>{copy.story}</p>
    </div>
  </section>

  <section class="mtp-study" aria-labelledby="mtp-study-background">
    <div class="mtp-study-copy">
      <h2 id="mtp-study-background">{study.backgroundTitle}</h2>
      <p>{study.background}</p>
      <div class="mtp-source-links">
        <a href="https://arxiv.org/abs/2510.18900" target="_blank" rel="noopener">MIST paper ↗</a>
        <a href="https://huggingface.co/mist-models/mist-26.9M-kkgx0omx-qm9" target="_blank" rel="noopener">Hugging Face model ↗</a>
        <a href="https://doi.org/10.1038/sdata.2014.22" target="_blank" rel="noopener">QM9 paper ↗</a>
        <a href={repoHref} target="_blank" rel="noopener">Independent repo ↗</a>
      </div>
    </div>

    <div class="mtp-study-data">
      <h2>{study.dataTitle}</h2>
      <dl>{study.dataItems.map(([term, detail]) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
    </div>

    <div class="mtp-chart-card">
      <h2>{study.resultTitle}</h2>
      <p>{study.resultHelp}</p>
      <div class="mtp-overall-chart">
        {modelOrder.map((model) => (
          <div class={`mtp-bar-row is-${model}`}>
            <strong>{modelLabels[model]}</strong>
            <div><i style={`--mtp-width:${overall[model] / overall.ridge * 100}%`}></i></div>
            <span>{overall[model].toFixed(5)}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="mtp-chart-card">
      <h2>{study.targetTitle}</h2>
      <p>{study.targetHelp}</p>
      <div class="mtp-target-chart">
        {targets.map(([target, values]) => {
          const maximum = Math.max(...Object.values(values));
          return (
            <article>
              <h3>{target.toUpperCase()}</h3>
              {modelOrder.map((model) => (
                <div class={`mtp-mini-bar is-${model}`}>
                  <span>{modelLabels[model]}</span>
                  <div><i style={`--mtp-width:${values[model] / maximum * 100}%`}></i></div>
                  <small>{values[model].toFixed(4)}</small>
                </div>
              ))}
            </article>
          );
        })}
      </div>
    </div>

    <div class="mtp-conclusion">
      <h2>{study.conclusionTitle}</h2>
      <p>{study.conclusion}</p>
    </div>
  </section>

  <header class="mtp-demo-heading">
    <p class="mtp-eyebrow">Live prediction client</p>
    <h2>{study.demoTitle}</h2>
    <p>{study.demoLead}</p>
  </header>

  <div class="mtp-workspace">
    <section class="mtp-input-panel" aria-labelledby="mtp-input-title">
      <div class="mtp-api-status is-checking" data-mtp-status role="status" aria-live="polite">
        <span class="mtp-api-dot" aria-hidden="true"></span>
        <div>
          <strong data-mtp-status-title>{apiBaseUrl ? copy.apiReady : copy.apiUnavailable}</strong>
          <span data-mtp-status-detail>{apiBaseUrl ? copy.apiReadyDetail : copy.apiUnavailableDetail}</span>
        </div>
      </div>

      <form data-mtp-form novalidate>
        <label id="mtp-input-title" for="mtp-smiles">{copy.smilesLabel}</label>
        <textarea
          id="mtp-smiles"
          name="smiles"
          rows="3"
          maxlength="512"
          required
          autocomplete="off"
          autocapitalize="none"
          spellcheck="false"
          aria-describedby="mtp-smiles-help mtp-form-error"
          placeholder={copy.smilesPlaceholder}
          data-mtp-smiles
        ></textarea>
        <p id="mtp-smiles-help" class="mtp-help">{copy.smilesHelp}</p>

        <div class="mtp-examples" aria-label={copy.examplesLabel}>
          <span>{copy.examplesLabel}</span>
          {copy.examples.map(([name, smiles]) => (
            <button type="button" data-mtp-example={smiles}>{name} · <code>{smiles}</code></button>
          ))}
        </div>

        <p id="mtp-form-error" class="mtp-form-error" data-mtp-error role="alert" hidden></p>
        <div class="mtp-actions">
          <button class="mtp-primary" type="submit" data-mtp-submit disabled>{copy.predict}</button>
          <button class="mtp-secondary" type="button" data-mtp-clear>{copy.clear}</button>
        </div>
      </form>

      <details class="mtp-contract">
        <summary>{copy.contractTitle}</summary>
        <p>{copy.contract}</p>
      </details>
    </section>

    <aside class="mtp-model-panel" aria-labelledby="mtp-model-title">
      <h2 id="mtp-model-title">{copy.modelTitle}</h2>
      <ol>
        {copy.modelItems.map(([name, description]) => (
          <li><strong>{name}</strong><span>{description}</span></li>
        ))}
      </ol>
    </aside>
  </div>

  <section class="mtp-results" data-mtp-results aria-live="polite" aria-busy="false" hidden>
    <div class="mtp-results-header">
      <div>
        <p>{copy.resultKicker}</p>
        <h2>{copy.comparisonFor} <code data-mtp-result-smiles>—</code></h2>
      </div>
      <span>{copy.noTruth}</span>
    </div>

    <div class="mtp-focus-grid" data-mtp-focus aria-label={copy.focusLabel}></div>

    <div class="mtp-table-wrap">
      <table>
        <caption>{copy.tableCaption}</caption>
        <thead>
          <tr>
            <th scope="col">{copy.property}</th>
            <th scope="col">{copy.unit}</th>
            <th scope="col">Ridge</th>
            <th scope="col">XGBoost</th>
            <th scope="col">MLP</th>
            <th scope="col">MIST-28M</th>
          </tr>
        </thead>
        <tbody data-mtp-rows></tbody>
      </table>
    </div>
  </section>

  <section class="mtp-limitations" aria-labelledby="mtp-limitations-title">
    <h2 id="mtp-limitations-title">{copy.limitationsTitle}</h2>
    <ul>{copy.limitations.map((item) => <li>{item}</li>)}</ul>
    <p class="mtp-privacy">{copy.privacy}</p>
  </section>

  <p class="mtp-links">
    <a href={repoHref} target="_blank" rel="noopener">{copy.source}</a>
    <a href={agentHref}>{copy.back}</a>
  </p>
</section>

<script define:vars={{ apiBaseUrl, locale, copy }}>
  const root = document.querySelector("[data-mtp-demo]");

  if (root) {
    const schemaVersion = "live-demo-prediction-v1";
    const targetOrder = [
      "mu", "alpha", "homo", "lumo", "gap", "r2",
      "zpve", "u0", "u298", "h298", "g298", "cv",
    ];
    const unitOrder = [
      "D", "bohr^3", "hartree", "hartree", "hartree", "bohr^2",
      "hartree", "hartree", "hartree", "hartree", "hartree", "cal/(mol K)",
    ];
    const units = Object.fromEntries(targetOrder.map((target, index) => [target, unitOrder[index]]));
    const modelOrder = ["ridge", "xgboost", "mlp", "mist"];
    const modelLabels = {
      ridge: "ECFP Ridge",
      xgboost: "ECFP XGBoost",
      mlp: "ECFP MLP",
      mist: "MIST-28M",
    };
    const savedEthanol = {
      schema_version: schemaVersion,
      targets: targetOrder,
      units: unitOrder,
      predictions: Object.fromEntries(Object.entries({
        ridge: [1.3396884082, 61.3392107734, -0.2528990508, 0.0528809771, 0.3058005535, 889.2561941549, 0.1518519690, -314.9170463751, -314.9074639196, -314.9065966180, -314.9482269425, 28.8627842017],
        xgboost: [1.6197472811, 70.1255035400, -0.2506761253, 0.0685535818, 0.3192293048, 1099.7609863281, 0.1776768714, -345.4395446777, -355.2463989258, -344.2912292480, -352.7483520508, 30.6568374634],
        mlp: [1.4403435092, 29.5349387950, -0.2675354484, 0.0809012502, 0.3476619731, 107.1830194626, 0.0818269811, -160.2542125318, -159.5175985317, -159.3743437147, -160.0487629433, 14.7590991247],
        mist: [1.4286494255, 27.8105697632, -0.2621721923, 0.0833740532, 0.3473484516, 197.9102783203, 0.0817734301, -152.8612670898, -152.1833496094, -148.2150268555, -154.4786071777, 13.5655670166],
      }).map(([model, values]) => [model, Object.fromEntries(
        targetOrder.map((target, index) => [target, { value: values[index], unit: unitOrder[index] }])
      )])),
    };

    const form = root.querySelector("[data-mtp-form]");
    const input = root.querySelector("[data-mtp-smiles]");
    const submit = root.querySelector("[data-mtp-submit]");
    const clear = root.querySelector("[data-mtp-clear]");
    const status = root.querySelector("[data-mtp-status]");
    const statusTitle = root.querySelector("[data-mtp-status-title]");
    const statusDetail = root.querySelector("[data-mtp-status-detail]");
    const error = root.querySelector("[data-mtp-error]");
    const results = root.querySelector("[data-mtp-results]");
    const resultSmiles = root.querySelector("[data-mtp-result-smiles]");
    const focus = root.querySelector("[data-mtp-focus]");
    const rows = root.querySelector("[data-mtp-rows]");
    const examples = [...root.querySelectorAll("[data-mtp-example]")];
    let endpoint = null;
    let activeController = null;

    function exactArray(value, expected) {
      return Array.isArray(value)
        && value.length === expected.length
        && value.every((item, index) => item === expected[index]);
    }

    function exactKeys(value, expected) {
      if (!value || typeof value !== "object" || Array.isArray(value)) return false;
      const observed = Object.keys(value).sort();
      const wanted = [...expected].sort();
      return observed.length === wanted.length
        && observed.every((key, index) => key === wanted[index]);
    }

    function buildEndpoint(rawBase) {
      if (typeof rawBase !== "string" || !rawBase.trim()) return null;
      const base = new URL(rawBase.trim(), document.baseURI);
      if (!new Set(["http:", "https:"]).has(base.protocol) || base.username || base.password) {
        throw new Error("invalid prediction URL");
      }
      const loopback = new Set(["localhost", "127.0.0.1", "[::1]", "::1"]).has(base.hostname);
      if (location.protocol === "https:" && base.protocol !== "https:" && !loopback) {
        throw new Error("HTTPS required");
      }
      const withSlash = new URL(base.href.endsWith("/") ? base.href : `${base.href}/`);
      return new URL("v1/predict", withSlash).href;
    }

    function validateRequest(rawSmiles) {
      const smiles = typeof rawSmiles === "string" ? rawSmiles.trim() : "";
      if (!smiles) throw new Error(copy.inputRequired);
      if (smiles.length > 512) throw new Error(copy.inputTooLong);
      if (/[\u0000-\u001f\u007f]/u.test(smiles)) throw new Error(copy.inputControl);
      return { smiles };
    }

    function validateResponse(data) {
      if (!data || typeof data !== "object" || Array.isArray(data)) throw new Error(copy.responseRejected);
      if (data.schema_version !== schemaVersion) throw new Error(copy.responseRejected);
      if (!exactArray(data.targets, targetOrder) || !exactArray(data.units, unitOrder)) {
        throw new Error(copy.responseRejected);
      }
      if (!exactKeys(data.predictions, modelOrder)) throw new Error(copy.responseRejected);
      for (const model of modelOrder) {
        const records = data.predictions[model];
        if (!exactKeys(records, targetOrder)) throw new Error(copy.responseRejected);
        for (const target of targetOrder) {
          const record = records[target];
          if (!exactKeys(record, ["value", "unit"])) throw new Error(copy.responseRejected);
          if (typeof record.value !== "number" || !Number.isFinite(record.value)) {
            throw new Error(copy.responseRejected);
          }
          if (record.unit !== units[target]) throw new Error(copy.responseRejected);
        }
      }
      return data;
    }

    function setStatus(kind, title, detail) {
      status.className = `mtp-api-status is-${kind}`;
      statusTitle.textContent = title;
      statusDetail.textContent = detail;
    }

    function setError(message = "") {
      error.textContent = message;
      error.hidden = !message;
    }

    function setLoading(loading) {
      results.setAttribute("aria-busy", String(loading));
      input.readOnly = loading;
      submit.disabled = loading;
      submit.textContent = loading ? copy.predicting : endpoint ? copy.predict : copy.replay;
      examples.forEach((button) => {
        button.disabled = loading || (!endpoint && button.dataset.mtpExample !== "CCO");
      });
    }

    function showReadyStatus() {
      if (!endpoint) {
        setStatus("offline", copy.apiUnavailable, copy.apiUnavailableDetail);
        return;
      }
      setStatus("ready", copy.apiReady, copy.apiReadyDetail);
    }

    function formatValue(value) {
      const absolute = Math.abs(value);
      if (absolute >= 100) return value.toFixed(1);
      if (absolute >= 10) return value.toFixed(2);
      if (absolute >= 1) return value.toFixed(3);
      if (absolute >= 0.1) return value.toFixed(4);
      if (absolute >= 0.01) return value.toFixed(5);
      return value.toFixed(6);
    }

    function propertyLabel(target) {
      return copy.propertyNames[target] || target.toUpperCase();
    }

    function renderFocus(data) {
      const fragment = document.createDocumentFragment();
      ["homo", "lumo", "gap"].forEach((target) => {
        const card = document.createElement("article");
        card.className = "mtp-focus-card";
        const header = document.createElement("div");
        const title = document.createElement("h3");
        title.textContent = propertyLabel(target);
        const unit = document.createElement("span");
        unit.textContent = units[target];
        header.append(title, unit);
        const list = document.createElement("dl");
        modelOrder.forEach((model) => {
          const row = document.createElement("div");
          const label = document.createElement("dt");
          label.textContent = modelLabels[model];
          const value = document.createElement("dd");
          value.textContent = formatValue(data.predictions[model][target].value);
          row.append(label, value);
          list.append(row);
        });
        card.append(header, list);
        fragment.append(card);
      });
      focus.replaceChildren(fragment);
    }

    function renderTable(data) {
      const fragment = document.createDocumentFragment();
      targetOrder.forEach((target) => {
        const row = document.createElement("tr");
        if (["homo", "lumo", "gap"].includes(target)) row.className = "is-highlighted";
        const values = [
          propertyLabel(target),
          units[target],
          ...modelOrder.map((model) => formatValue(data.predictions[model][target].value)),
        ];
        values.forEach((value, index) => {
          const cell = document.createElement(index === 0 ? "th" : "td");
          cell.textContent = value;
          if (index === 0) cell.setAttribute("scope", "row");
          row.append(cell);
        });
        fragment.append(row);
      });
      rows.replaceChildren(fragment);
    }

    function renderResult(data, smiles) {
      resultSmiles.textContent = smiles;
      resultSmiles.title = smiles;
      renderFocus(data);
      renderTable(data);
      results.hidden = false;
    }

    async function requestPrediction(event) {
      event.preventDefault();
      setError();
      if (!endpoint) {
        let request;
        try {
          request = validateRequest(input.value);
        } catch (requestError) {
          setError(requestError instanceof Error ? requestError.message : copy.inputRequired);
          return;
        }
        if (request.smiles !== "CCO") {
          setError(copy.sampleOnly);
          return;
        }
        renderResult(validateResponse(savedEthanol), request.smiles);
        setStatus("success", copy.successTitle, copy.savedResult);
        return;
      }

      let request;
      try {
        request = validateRequest(input.value);
      } catch (requestError) {
        setError(requestError instanceof Error ? requestError.message : copy.inputRequired);
        input.focus();
        return;
      }

      activeController?.abort();
      const controller = new AbortController();
      activeController = controller;
      let timedOut = false;
      const timeout = window.setTimeout(() => {
        timedOut = true;
        controller.abort();
      }, 45_000);

      results.hidden = true;
      setLoading(true);
      setStatus("loading", copy.loadingTitle, copy.loadingDetail);

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(request),
          credentials: "omit",
          cache: "no-store",
          signal: controller.signal,
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = validateResponse(await response.json());
        renderResult(data, request.smiles);
        setStatus("success", copy.successTitle, copy.successDetail);
      } catch (requestError) {
        if (controller.signal.aborted && !timedOut) return;
        const message = timedOut
          ? copy.timeout
          : requestError instanceof TypeError
            ? copy.requestFailed
            : requestError instanceof Error && requestError.message === copy.responseRejected
              ? copy.responseRejected
              : requestError instanceof Error && requestError.message.startsWith("HTTP ")
                ? `${copy.requestFailed} (${requestError.message})`
                : copy.requestFailed;
        setError(message);
        setStatus("error", copy.errorTitle, message);
      } finally {
        window.clearTimeout(timeout);
        if (activeController === controller) {
          activeController = null;
          setLoading(false);
        }
      }
    }

    function clearPrediction() {
      activeController?.abort();
      activeController = null;
      form.reset();
      results.hidden = true;
      focus.replaceChildren();
      rows.replaceChildren();
      setError();
      setLoading(false);
      showReadyStatus();
      input.focus();
    }

    examples.forEach((button) => {
      button.addEventListener("click", () => {
        input.value = button.dataset.mtpExample || "";
        setError();
        input.focus();
      });
    });
    form.addEventListener("submit", requestPrediction);
    clear.addEventListener("click", clearPrediction);

    try {
      endpoint = buildEndpoint(apiBaseUrl);
      submit.disabled = false;
      examples.forEach((button) => {
        button.disabled = !endpoint && button.dataset.mtpExample !== "CCO";
      });
      showReadyStatus();
    } catch {
      endpoint = null;
      submit.disabled = true;
      setStatus("error", copy.apiInvalid, copy.apiInvalidDetail);
    }
  }
</script>

