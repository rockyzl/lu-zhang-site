---
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en" } = Astro.props as { locale?: Locale };

// Live endpoint: the REAL ChemGraph agent (Argonne LCF framework, Lu's hardened
// fork) wrapped in a small guarded FastAPI service on a free HF Space.
const SPACE_URL =
  import.meta.env.PUBLIC_CHEMGRAPH_URL ?? "https://rockyaaos-chemgraph-loop.hf.space";

const molecules = [
  "water", "methane", "ammonia", "methanol", "ethanol",
  "carbon dioxide", "benzene", "acetic acid", "formaldehyde", "hydrogen peroxide",
];

// The ChemGraph field note only exists in English; link both locales to it.
const blogHref = u("/blog/2026-06-13-chemgraph-scientific-agent-test/");

const copy = locale === "zh"
  ? {
      eyebrow: "Agentic 化学 · ChemGraph(Argonne LCF)",
      title: "看一个真实 agent 跑完整的化学工作流",
      lead: "一句自然语言进去,一个 agent <b>自己挑工具、真地跑仿真</b> —— 识别分子、生成三维结构、调用物理引擎算单点能,然后<b>对照工作流护栏审计自己的结果</b>。这不是脚本回放:每次点击都在线上调用<b>真实的 ChemGraph agent</b>(Argonne 的 agentic 计算化学框架,LangGraph + ASE),再把返回的 trace 逐步展示出来。",
      loopline: "问题 → 识别 → 建模 → 仿真 → 验证",
      qlabel: "问题(由分子 + 后端拼成)",
      molLabel: "分子",
      calcLabel: "后端",
      run: "▶ 运行工作流",
      running: "运行中…",
      rerun: "↺ 再跑一次",
      calcEmt: "EMT · 经典势",
      calcTb: "TBLite · GFN2-xTB",
      phases: {
        resolve: ["识别", "把名字变成机器可读的结构", "molecule_name_to_smiles"],
        build: ["建模", "把分子嵌成三维空间里的原子", "smiles_to_coordinate_file"],
        simulate: ["仿真", "调用物理引擎算单点能", "run_ase"],
        verify: ["验证", "对照工作流护栏审计结果", "workflow_guard"],
      },
      waking: "正在唤醒服务器并运行真实 agent(首次可能要 30–60 秒冷启动)…",
      thinking: "agent 正在选工具、跑仿真…",
      resultK: "结果 · 已审计 ✓",
      resultUnverified: "结果 · 未通过审计",
      energyOf: "{m} 的单点能",
      via: "后端",
      errPrefix: "运行失败:",
      errRate: "请求太频繁,请稍后再试。",
      errTimeout: "工作流超时了(服务器可能在冷启动),请再点一次。",
      errNet: "连不上 agent 服务,请稍后再试。",
      checks: {
        intent: "意图:单点能",
        backend: "后端:{c}",
        energy: "返回数值能量:{e}",
        guard: "工作流护栏:通过",
      },
      toolsLabel: "内置的工具与后端:",
      tools: ["结构生成", "ASE 运行引擎", "DFT · NWChem / ORCA", "XTB / TBLite", "MACE", "UMA", "热化学"],
      cap: '这是我在做的一类 <b>loop engineering</b> —— agent 不是一次性给答案,而是走一个「识别 → 建模 → 仿真 → 验证」的闭环,并对照护栏审计自己。框架来自 ',
      capLink1: "ChemGraph — Argonne Leadership Computing Facility",
      capMid: ";我做的可靠性加固(工作流正确性,eval 27/40 → 39/40)和踩坑记录见 ",
      capLink2: "现场笔记",
      note: "这里跑的是真实 agent(在免费 CPU 服务器上),返回完整 trace 后逐步展示。演示范围限定在小分子的单点能 + EMT / TBLite,以保证稳定。",
    }
  : {
      eyebrow: "Agentic chemistry · ChemGraph (Argonne LCF)",
      title: "Watch a real agent run a chemistry workflow",
      lead: "A natural-language question goes in. An agent <b>picks and runs real simulation tools</b> — resolve the molecule, build its 3D structure, run the physics engine for a single-point energy — then <b>audits its own result</b> against a workflow guard. This is not a canned replay: every click calls the <b>real ChemGraph agent</b> live (Argonne's agentic computational-chemistry framework, LangGraph + ASE) and steps through the trace it returns.",
      loopline: "question → resolve → build → simulate → verify",
      qlabel: "Question (built from the molecule + backend)",
      molLabel: "Molecule",
      calcLabel: "Backend",
      run: "▶ Run the workflow",
      running: "Running…",
      rerun: "↺ Run again",
      calcEmt: "EMT · classical",
      calcTb: "TBLite · GFN2-xTB",
      phases: {
        resolve: ["RESOLVE", "turn the name into a machine-readable structure", "molecule_name_to_smiles"],
        build: ["BUILD", "embed the molecule as atoms in space", "smiles_to_coordinate_file"],
        simulate: ["SIMULATE", "run the physics engine for a single-point energy", "run_ase"],
        verify: ["VERIFY", "audit the result against the workflow guard", "workflow_guard"],
      },
      waking: "Waking the server and running the real agent (first run can take 30–60s to cold-start)…",
      thinking: "The agent is choosing tools and running the simulation…",
      resultK: "Result · audited ✓",
      resultUnverified: "Result · audit did not pass",
      energyOf: "single-point energy of {m}",
      via: "via",
      errPrefix: "Run failed: ",
      errRate: "Too many requests — try again in a bit.",
      errTimeout: "The workflow timed out (the server may be cold-starting) — click Run again.",
      errNet: "Couldn't reach the agent service — please try again shortly.",
      checks: {
        intent: "intent: single-point energy",
        backend: "backend: {c}",
        energy: "numeric energy returned: {e}",
        guard: "workflow guard: passed",
      },
      toolsLabel: "Tools & backends built in:",
      tools: ["structure generation", "ASE run engine", "DFT · NWChem / ORCA", "XTB / TBLite", "MACE", "UMA", "thermochemistry"],
      cap: 'This is a kind of <b>loop engineering</b> I build — the agent never settles on a one-shot answer; it runs a resolve → build → simulate → verify loop and audits itself against a guard. Full framework: ',
      capLink1: "ChemGraph — Argonne Leadership Computing Facility",
      capMid: " · my reliability hardening (workflow correctness, eval 27/40 → 39/40) and field note: ",
      capLink2: "field note",
      note: "This runs the real agent (on a free CPU server) and steps through the trace it returns. The demo is scoped to single-point energies of small molecules with EMT / TBLite so it stays reliable.",
    };
---

<section class="cg" data-chemgraph data-space={SPACE_URL} data-locale={locale}>
  <span class="cg-eyebrow">{copy.eyebrow}</span>
  <h1 class="cg-h1">{copy.title}</h1>
  <p class="cg-lead" set:html={copy.lead}></p>
  <div class="cg-loopline">{copy.loopline}</div>

  <div class="cg-qcard">
    <div class="cg-controls">
      <label class="cg-field">
        <span class="cg-k">{copy.molLabel}</span>
        <select class="cg-select" data-mol>
          {molecules.map((m) => <option value={m}>{m}</option>)}
        </select>
      </label>
      <div class="cg-field">
        <span class="cg-k">{copy.calcLabel}</span>
        <div class="cg-seg">
          <button type="button" class="cg-calc is-on" data-calc="emt">{copy.calcEmt}</button>
          <button type="button" class="cg-calc" data-calc="tblite">{copy.calcTb}</button>
        </div>
      </div>
    </div>
    <div class="cg-qline"><span class="cg-qk">{copy.qlabel}</span><span class="cg-q" data-query></span></div>
    <div class="cg-bar">
      <button type="button" class="cg-run" data-run>{copy.run}</button>
      <span class="cg-status" data-status></span>
    </div>
  </div>

  <div class="cg-flow" data-flow></div>
  <div class="cg-result" data-result></div>

  <div class="cg-tools"><b>{copy.toolsLabel}</b>{copy.tools.map((t) => <span>{t}</span>)}</div>

  <p class="cg-cap">
    <span set:html={copy.cap}></span>
    <a href="https://github.com/argonne-lcf/ChemGraph" target="_blank" rel="noopener">{copy.capLink1}</a>
    <span set:html={copy.capMid}></span>
    <a href={blogHref}>{copy.capLink2}</a>.
  </p>
  <p class="cg-note">{copy.note}</p>
</section>

<script is:inline define:vars={{ copy, SPACE_URL }}>
  (() => {
    const root = document.querySelector("[data-chemgraph]");
    if (!root) return;
    const molSel = root.querySelector("[data-mol]");
    const calcBtns = [...root.querySelectorAll(".cg-calc")];
    const qEl = root.querySelector("[data-query]");
    const runBtn = root.querySelector("[data-run]");
    const statusEl = root.querySelector("[data-status]");
    const flow = root.querySelector("[data-flow]");
    const result = root.querySelector("[data-result]");

    const CALC_LABEL = { emt: "EMT", tblite: "TBLite" };
    let calc = "emt";
    let busy = false;

    const P = copy.phases;
    const PHASES = [
      { key: "resolve", tool: "molecule_name_to_smiles" },
      { key: "build", tool: "smiles_to_coordinate_file" },
      { key: "simulate", tool: "run_ase" },
      { key: "verify", tool: null },
    ];

    function query() {
      const m = molSel.value;
      return `Compute the single point energy of ${m} using the ${CALC_LABEL[calc]} calculator.`;
    }
    function syncQuery() { qEl.textContent = query(); }

    function skeleton() {
      flow.innerHTML = PHASES.map((p) => {
        const [ph, desc, tool] = P[p.key];
        return `<div class="cg-node ${p.key === "verify" ? "is-verify" : ""}" data-node="${p.key}">
          <div class="cg-ph">${ph}</div>
          <div class="cg-desc">${desc}</div>
          <div class="cg-io"><div class="cg-tool">${tool}()</div><div class="cg-body" data-body></div></div>
        </div>`;
      }).join("");
      result.className = "cg-result";
      result.innerHTML = "";
    }

    function setNode(key, cls) {
      const n = flow.querySelector(`[data-node="${key}"]`);
      if (n) { n.classList.remove("is-live", "is-done"); if (cls) n.classList.add(cls); }
    }
    function nodeBody(key, html) {
      const n = flow.querySelector(`[data-node="${key}"] [data-body]`);
      if (n) n.innerHTML = html;
    }
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));
    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));

    async function reveal(data) {
      const byTool = {};
      (data.steps || []).forEach((s) => { byTool[s.tool] = s; });

      // resolve
      setNode("resolve", "is-live"); await wait(650);
      const r = byTool["molecule_name_to_smiles"];
      nodeBody("resolve", r ? `<span class="cg-ok">${esc(r.summary)}</span>` : "—");
      setNode("resolve", "is-done");

      // build
      setNode("build", "is-live"); await wait(700);
      const b = byTool["smiles_to_coordinate_file"];
      nodeBody("build", b ? `<span class="cg-ok">${esc(b.summary)}</span>` : "—");
      setNode("build", "is-done");

      // simulate
      setNode("simulate", "is-live"); await wait(850);
      const s = byTool["run_ase"];
      const drv = s && s.args && s.args.params ? s.args.params : {};
      const drvLine = drv.driver ? `<div class="cg-arg">driver=<b>${esc(drv.driver)}</b> · ${esc(String(drv.calculator || "").split(" ")[0] || CALC_LABEL[calc])}</div>` : "";
      nodeBody("simulate", (drvLine || "") + (s ? `<span class="cg-ok">${esc(s.summary)}</span>` : "—"));
      setNode("simulate", "is-done");

      // verify
      setNode("verify", "is-live"); await wait(500);
      const e = data.energy;
      const eStr = e ? `${Number(e.value).toFixed(4)} ${e.unit || "eV"}` : "—";
      const checks = [
        copy.checks.intent,
        copy.checks.backend.replace("{c}", CALC_LABEL[calc]),
        copy.checks.energy.replace("{e}", eStr),
        copy.checks.guard,
      ];
      nodeBody("verify",
        `<div class="cg-checks">${checks.map((c) => `<span class="cg-chk">${esc(c)}</span>`).join("")}</div>`);
      const chks = [...flow.querySelectorAll(`[data-node="verify"] .cg-chk`)];
      chks.forEach((c, i) => setTimeout(() => c.classList.add("is-pass"), 200 * (i + 1)));
      await wait(200 * chks.length + 250);
      setNode("verify", "is-done");

      // result
      const ok = data.verified;
      const m = data.molecule || molSel.value;
      result.className = "cg-result is-show" + (ok ? "" : " is-warn");
      result.innerHTML =
        `<div class="cg-rk">${ok ? copy.resultK : copy.resultUnverified}</div>
         <div class="cg-rv">${esc(copy.energyOf.replace("{m}", m))} — <b>${eStr}</b>
           <small>${copy.via} ${CALC_LABEL[calc]}${calc === "tblite" ? " · GFN2-xTB" : ""}</small></div>`;
    }

    async function run() {
      if (busy) return;
      busy = true;
      runBtn.disabled = true;
      runBtn.textContent = copy.running;
      skeleton();
      setNode("resolve", "is-live");
      statusEl.textContent = copy.waking;
      let coldTimer = setTimeout(() => { statusEl.textContent = copy.thinking; }, 8000);

      const ctrl = new AbortController();
      const to = setTimeout(() => ctrl.abort(), 125000);
      try {
        const res = await fetch(SPACE_URL + "/run", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ molecule: molSel.value, calculator: calc }),
          signal: ctrl.signal,
        });
        clearTimeout(to); clearTimeout(coldTimer);
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.error) {
          const msg = res.status === 429 ? copy.errRate
            : res.status === 504 ? copy.errTimeout
            : (data.error || copy.errNet);
          statusEl.innerHTML = `<span class="cg-err">${copy.errPrefix}${esc(msg)}</span>`;
          skeleton();
        } else {
          statusEl.textContent = "";
          await reveal(data);
        }
      } catch (err) {
        clearTimeout(to); clearTimeout(coldTimer);
        const msg = err && err.name === "AbortError" ? copy.errTimeout : copy.errNet;
        statusEl.innerHTML = `<span class="cg-err">${copy.errPrefix}${esc(msg)}</span>`;
        skeleton();
      } finally {
        busy = false;
        runBtn.disabled = false;
        runBtn.textContent = copy.rerun;
      }
    }

    calcBtns.forEach((btn) => btn.addEventListener("click", () => {
      if (busy) return;
      calcBtns.forEach((b) => b.classList.remove("is-on"));
      btn.classList.add("is-on");
      calc = btn.dataset.calc;
      syncQuery();
    }));
    molSel.addEventListener("change", syncQuery);
    runBtn.addEventListener("click", run);

    skeleton();
    syncQuery();
  })();
</script>

<!-- Global (not scoped): the flow nodes / result / status are injected at runtime
     via innerHTML, so they never receive Astro's scoping attribute. All selectors
     are cg-* prefixed and nested under .cg, so global scoping is collision-safe. -->
<style is:global>
  .cg { max-width: 820px; margin: 0 auto; }
  .cg-eyebrow {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--accent);
  }
  .cg-h1 {
    font-size: clamp(25px, 4vw, 38px); letter-spacing: -.03em; font-weight: 730;
    margin: 8px 0 0; text-wrap: balance; line-height: 1.1;
  }
  .cg-lead { color: var(--ink-2); font-size: 15.5px; margin: 13px 0 0; max-width: 68ch; line-height: 1.6; }
  .cg-lead b { color: var(--ink); font-weight: 640; }
  .cg-loopline {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: .05em;
    text-transform: uppercase; color: var(--accent-deep); margin: 14px 0 0;
  }

  .cg-qcard {
    background: var(--card); border: 1px solid var(--line); border-radius: 14px;
    margin-top: 22px; padding: 16px 18px;
  }
  .cg-controls { display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-end; }
  .cg-field { display: flex; flex-direction: column; gap: 6px; }
  .cg-k {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--muted);
  }
  .cg-select {
    font-family: var(--font-sans); font-size: 14px; color: var(--ink);
    background: var(--paper); border: 1px solid var(--line-strong);
    border-radius: 9px; padding: 8px 12px; min-width: 180px; cursor: pointer;
  }
  .cg-select:focus-visible, .cg-calc:focus-visible, .cg-run:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }
  .cg-seg { display: flex; gap: 6px; }
  .cg-calc, .cg-run {
    font-family: var(--font-mono); font-size: 12.5px; cursor: pointer;
    border: 1px solid var(--line-strong); background: var(--paper); color: var(--ink);
    border-radius: 9px; padding: 8px 13px; transition: .12s;
  }
  .cg-calc:hover, .cg-run:hover { border-color: var(--accent); transform: translateY(-1px); }
  .cg-calc.is-on { background: var(--accent-soft); border-color: #bfe0d5; color: var(--accent-deep); }
  .cg-qline { margin-top: 15px; display: flex; flex-direction: column; gap: 4px; }
  .cg-qk {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--muted);
  }
  .cg-q { font-family: var(--font-mono); font-size: 13px; color: var(--ink-2); line-height: 1.5; }
  .cg-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 15px; }
  .cg-run { background: var(--accent); color: #fff; border-color: var(--accent); font-size: 13px; padding: 9px 16px; }
  .cg-run:hover { background: var(--accent-deep); }
  .cg-run:disabled { opacity: .6; cursor: default; transform: none; }
  .cg-status { font-family: var(--font-mono); font-size: 12px; color: var(--muted); flex: 1 1 auto; }
  .cg-err { color: #a23b2d; }

  .cg-flow { margin-top: 20px; border-left: 2px solid var(--line); }
  .cg-node {
    position: relative; padding: 0 0 4px 26px; margin-bottom: 14px;
    opacity: .34; transition: opacity .35s;
  }
  .cg-node.is-live, .cg-node.is-done { opacity: 1; }
  .cg-node::before {
    content: ""; position: absolute; left: -8px; top: 5px; width: 13px; height: 13px;
    border-radius: 50%; background: var(--card-2); border: 2px solid var(--line-strong); transition: .3s;
  }
  .cg-node.is-live::before {
    background: var(--accent); border-color: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft); animation: cg-pulse 1.1s ease-in-out infinite;
  }
  .cg-node.is-done::before { background: var(--accent); border-color: var(--accent); }
  .cg-node.is-verify.is-done::before { background: var(--honey); border-color: var(--honey); }
  @keyframes cg-pulse { 50% { box-shadow: 0 0 0 8px transparent; } }
  @media (prefers-reduced-motion: reduce) { .cg-node.is-live::before { animation: none; } }
  .cg-ph {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em;
    color: var(--accent); font-weight: 700;
  }
  .cg-node.is-verify .cg-ph { color: var(--honey); }
  .cg-desc { color: var(--muted); font-size: 13px; margin-top: 2px; }
  .cg-io {
    margin-top: 8px; background: var(--card); border: 1px solid var(--line);
    border-radius: 10px; overflow: hidden; display: none;
  }
  .cg-node.is-live .cg-io, .cg-node.is-done .cg-io { display: block; }
  .cg-tool {
    font-family: var(--font-mono); font-size: 12px; color: var(--accent-deep);
    background: var(--card-2); padding: 7px 12px; border-bottom: 1px solid var(--line);
  }
  .cg-body { padding: 9px 12px; font-family: var(--font-mono); font-size: 12px; color: var(--ink); min-height: 8px; }
  .cg-body:empty { padding: 0; }
  .cg-ok { color: var(--accent-deep); font-weight: 650; }
  .cg-arg { color: var(--muted); margin-bottom: 5px; word-break: break-word; }
  .cg-arg b { color: var(--ink-2); }
  .cg-checks { display: flex; flex-wrap: wrap; gap: 6px; }
  .cg-chk {
    font-family: var(--font-mono); font-size: 11px; color: var(--muted);
    border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px;
    opacity: .5; transition: .3s;
  }
  .cg-chk.is-pass { color: var(--accent-deep); background: var(--accent-soft); border-color: #bfe0d5; opacity: 1; }

  .cg-result {
    margin-top: 10px; background: var(--honey-soft); border: 1px solid #e7d3b0;
    border-radius: 12px; padding: 15px 18px; display: none;
  }
  .cg-result.is-show { display: block; }
  .cg-result.is-warn { background: #f7ece0; border-color: #e2c9a5; }
  .cg-rk {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .08em;
    text-transform: uppercase; color: #9a6a24;
  }
  .cg-rv { font-size: 19px; font-weight: 640; letter-spacing: -.01em; margin-top: 3px; }
  .cg-rv b { font-weight: 760; }
  .cg-rv small { display: block; font-weight: 500; color: var(--muted); font-size: 12.5px; margin-top: 3px; }

  .cg-tools {
    margin-top: 20px; font-family: var(--font-mono); font-size: 11.5px;
    color: var(--muted); line-height: 2;
  }
  .cg-tools b { color: var(--ink-2); margin-right: 4px; }
  .cg-tools span {
    border: 1px solid var(--line); border-radius: 6px; padding: 2px 7px;
    background: var(--card); margin: 0 3px;
  }
  .cg-cap { color: var(--muted); font-size: 13px; margin-top: 20px; max-width: 72ch; line-height: 1.65; }
  .cg-cap b { color: var(--ink-2); font-weight: 620; }
  .cg-cap a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .cg-note { color: var(--muted-2, var(--muted)); font-size: 12px; margin-top: 10px; max-width: 72ch; line-height: 1.6; }

  @media (max-width: 560px) {
    .cg-controls { gap: 14px; }
    .cg-select { min-width: 150px; }
  }
</style>
