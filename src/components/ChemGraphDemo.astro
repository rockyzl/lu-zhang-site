---
import { u } from "../lib/url";
import type { Locale } from "../lib/i18n";

const { locale = "en" } = Astro.props as { locale?: Locale };

// Live endpoint: the REAL ChemGraph agent (Argonne LCF framework, Lu's hardened
// fork) wrapped in a small guarded FastAPI service on a free HF Space.
const SPACE_URL =
  import.meta.env.PUBLIC_CHEMGRAPH_URL ?? "https://rockyaaos-chemgraph-loop.hf.space";

// The ChemGraph field note only exists in English; link both locales to it.
const blogHref = u("/blog/2026-06-13-chemgraph-scientific-agent-test/");

const copy = locale === "zh"
  ? {
      eyebrow: "Agentic 化学 · ChemGraph(Argonne LCF)",
      title: "跟真实的化学 agent 聊聊",
      lead: "用大白话问一个小分子的问题,一个<b>真实的 ChemGraph agent</b>(Argonne 的 agentic 计算化学框架,LangGraph + ASE)会自己挑工具、跑真实仿真、画出 3D 结构,并对照工作流护栏审计结果 —— 这是我在做的 <b>loop engineering</b> 的一个可运行例子。",
      greeting: "问我一个小分子的性质。能量和偶极是真实 live 计算(约 15–25 秒);频率/IR 谱、热化学较重,用真实 agent 预计算好即时返回。",
      placeholder: "比如:water 的 IR 谱?/ ammonia 的偶极?",
      send: "发送",
      tryLabel: "试试:",
      chips: [
        { t: "water 的单点能(EMT)", q: "What is the single point energy of water using EMT?" },
        { t: "ammonia 的偶极矩", q: "Dipole moment of ammonia" },
        { t: "water 的 IR 谱", q: "IR spectrum of water" },
        { t: "methane 的热化学", q: "Thermochemistry of methane" },
      ],
      you: "你",
      agent: "ChemGraph",
      stages: ["识别分子", "生成 3D 结构", "跑物理引擎", "审计结果"],
      thinking: "agent 正在选工具、跑仿真…",
      waking: "正在唤醒服务器(首次约 30–60 秒冷启动)…",
      cachedTag: "预计算的真实运行",
      liveTag: "live",
      verified: "已审计",
      unverified: "未通过审计",
      structure: "3D 结构",
      stepsLabel: "展开 agent 的步骤(工具调用、SMILES、坐标)",
      resEnergy: "单点能",
      resDipole: "偶极矩",
      resDipoleMag: "大小",
      resIR: "振动频率 · IR 谱",
      resThermo: "热化学(298.15 K)",
      thEnthalpy: "焓 H", thEntropy: "熵 S", thGibbs: "吉布斯自由能 G",
      irActive: "IR 活性模式",
      freqCol: "频率 (cm⁻¹)", intCol: "强度",
      errRate: "请求太频繁,请稍后再试。",
      errTimeout: "工作流超时了(服务器可能在冷启动),请再试一次。",
      errNet: "连不上 agent 服务,请稍后再试。",
      via: "后端",
      toolsLabel: "内置的工具与后端:",
      tools: ["分子识别 (PubChem)", "结构生成", "ASE 运行引擎", "TBLite · GFN2-xTB", "EMT", "振动 / IR", "热化学"],
      cap: "energy / dipole 每次都真实 live 计算;IR 谱和热化学要算 Hessian(约 1–3 分钟),用真实 agent 预计算好即时返回(标注为 cached)。约束在小分子上以保证可靠。框架:",
      capLink1: "ChemGraph — Argonne LCF",
      capMid: ";我的可靠性加固与踩坑记录见 ",
      capLink2: "现场笔记",
    }
  : {
      eyebrow: "Agentic chemistry · ChemGraph (Argonne LCF)",
      title: "Chat with a real chemistry agent",
      lead: "Ask a plain-language question about a small molecule. A <b>real ChemGraph agent</b> (Argonne's agentic computational-chemistry framework, LangGraph + ASE) picks its own tools, runs a real simulation, draws the 3D structure, and audits the result against a workflow guard — a working example of the <b>loop engineering</b> I build.",
      greeting: "Ask about a small molecule's properties. Energy and dipole run live (~15–25s). Vibrations / IR spectra and thermochemistry are heavier, so they're served from real precomputed agent runs.",
      placeholder: "e.g. IR spectrum of water?  ·  dipole of ammonia?",
      send: "Send",
      tryLabel: "Try:",
      chips: [
        { t: "Energy of water (EMT)", q: "What is the single point energy of water using EMT?" },
        { t: "Dipole moment of ammonia", q: "Dipole moment of ammonia" },
        { t: "IR spectrum of water", q: "IR spectrum of water" },
        { t: "Thermochemistry of methane", q: "Thermochemistry of methane" },
      ],
      you: "You",
      agent: "ChemGraph",
      stages: ["Resolve molecule", "Build 3D structure", "Run physics engine", "Audit result"],
      thinking: "The agent is choosing tools and running the simulation…",
      waking: "Waking the server (first run can take 30–60s to cold-start)…",
      cachedTag: "precomputed real run",
      liveTag: "live",
      verified: "audited",
      unverified: "audit did not pass",
      structure: "3D structure",
      stepsLabel: "Show the agent's steps (tool calls, SMILES, coordinates)",
      resEnergy: "Single-point energy",
      resDipole: "Dipole moment",
      resDipoleMag: "magnitude",
      resIR: "Vibrations · IR spectrum",
      resThermo: "Thermochemistry (298.15 K)",
      thEnthalpy: "Enthalpy H", thEntropy: "Entropy S", thGibbs: "Gibbs free energy G",
      irActive: "IR-active modes",
      freqCol: "Frequency (cm⁻¹)", intCol: "Intensity",
      errRate: "Too many requests — try again in a bit.",
      errTimeout: "The workflow timed out (the server may be cold-starting) — try again.",
      errNet: "Couldn't reach the agent service — please try again shortly.",
      via: "via",
      toolsLabel: "Tools & backends built in:",
      tools: ["molecule resolver (PubChem)", "structure generation", "ASE run engine", "TBLite · GFN2-xTB", "EMT", "vibrations / IR", "thermochemistry"],
      cap: "Energy & dipole run live on every ask; IR spectra and thermochemistry need a Hessian (~1–3 min), so they're served from real precomputed agent runs (flagged cached). Scoped to small molecules to stay reliable. Framework: ",
      capLink1: "ChemGraph — Argonne LCF",
      capMid: " · my reliability hardening & field note: ",
      capLink2: "field note",
    };
---

<section class="cg" data-chemgraph data-space={SPACE_URL} data-locale={locale}>
  <span class="cg-eyebrow">{copy.eyebrow}</span>
  <h1 class="cg-h1">{copy.title}</h1>
  <p class="cg-lead" set:html={copy.lead}></p>

  <div class="cg-chat">
    <div class="cg-log" data-log>
      <div class="cg-msg cg-msg--agent">
        <div class="cg-avatar" aria-hidden="true">CG</div>
        <div class="cg-bubble cg-greeting">{copy.greeting}</div>
      </div>
    </div>

    <div class="cg-chips" data-chips>
      <span class="cg-chips-label">{copy.tryLabel}</span>
      {copy.chips.map((c) => <button type="button" class="cg-chip" data-q={c.q}>{c.t}</button>)}
    </div>

    <form class="cg-input" data-form>
      <input type="text" class="cg-text" data-text placeholder={copy.placeholder}
             autocomplete="off" aria-label={copy.placeholder} />
      <button type="submit" class="cg-send" data-send>{copy.send}</button>
    </form>
  </div>

  <div class="cg-tools"><b>{copy.toolsLabel}</b>{copy.tools.map((t) => <span>{t}</span>)}</div>

  <p class="cg-cap">
    <span set:html={copy.cap}></span>
    <a href="https://github.com/argonne-lcf/ChemGraph" target="_blank" rel="noopener">{copy.capLink1}</a>
    <span set:html={copy.capMid}></span>
    <a href={blogHref}>{copy.capLink2}</a>.
  </p>
</section>

<script is:inline define:vars={{ copy, SPACE_URL }}>
  (() => {
    const root = document.querySelector("[data-chemgraph]");
    if (!root) return;
    const log = root.querySelector("[data-log]");
    const form = root.querySelector("[data-form]");
    const text = root.querySelector("[data-text]");
    const sendBtn = root.querySelector("[data-send]");
    const chips = root.querySelector("[data-chips]");

    const CALC_LABEL = { emt: "EMT", tblite: "TBLite" };
    let busy = false;

    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));
    // single page-level scroll: bring a message's top just below the sticky nav
    // (scroll-margin-top handles the offset) so a tall agent card reads
    // 3D → result → steps from the top instead of jumping to its bottom.
    const scrollTo = (el) => { try { el.scrollIntoView({ block: "start", behavior: "smooth" }); } catch (_) { el.scrollIntoView(); } };

    // ---- CPK-ish element data (warm palette) ----
    const EL = {
      H:{c:"#e8e2d4",s:0.32}, C:{c:"#3b423b",s:0.55}, N:{c:"#2f6fd0",s:0.54},
      O:{c:"#c0392b",s:0.52}, S:{c:"#c9a227",s:0.60}, P:{c:"#c1863c",s:0.62},
      F:{c:"#3aa76d",s:0.50}, Cl:{c:"#3aa76d",s:0.60}, def:{c:"#8a8f88",s:0.55},
    };
    const RADII = { H:0.31,C:0.76,N:0.71,O:0.66,S:1.05,P:1.07,F:0.57,Cl:1.02,def:0.7 };
    const elc = (s) => EL[s] || EL.def;
    const elr = (s) => RADII[s] != null ? RADII[s] : RADII.def;

    function mol3d(canvas, atoms) {
      const ctx = canvas.getContext("2d");
      const W = canvas.width, H = canvas.height, n = atoms.length;
      if (!n) return;
      const cx = atoms.reduce((a,p)=>a+p.x,0)/n, cy = atoms.reduce((a,p)=>a+p.y,0)/n, cz = atoms.reduce((a,p)=>a+p.z,0)/n;
      const A = atoms.map(p => ({el:p.el, x:p.x-cx, y:p.y-cy, z:p.z-cz}));
      let maxr = 0.6; A.forEach(p => { maxr = Math.max(maxr, Math.hypot(p.x,p.y,p.z)); });
      const scale = (Math.min(W,H)*0.34) / maxr;
      const bonds = [];
      for (let i=0;i<n;i++) for (let j=i+1;j<n;j++){
        const d = Math.hypot(A[i].x-A[j].x, A[i].y-A[j].y, A[i].z-A[j].z);
        if (d < (elr(A[i].el) + elr(A[j].el) + 0.45)) bonds.push([i,j]);
      }
      let rotY = 0.5, rotX = 0.32, dragging = false, lx = 0, ly = 0, spin = true, raf = 0;
      const rot = (p) => {
        const x1 = p.x*Math.cos(rotY)+p.z*Math.sin(rotY), z1 = -p.x*Math.sin(rotY)+p.z*Math.cos(rotY);
        const y2 = p.y*Math.cos(rotX)-z1*Math.sin(rotX), z2 = p.y*Math.sin(rotX)+z1*Math.cos(rotX);
        return { x:x1, y:y2, z:z2 };
      };
      const proj = (p) => { const f = 720/(720 - p.z*scale); return { X:W/2+p.x*scale*f, Y:H/2-p.y*scale*f, z:p.z, f }; };
      const lighten = (hex,amt) => { const v=parseInt(hex.slice(1),16); const r=Math.min(255,(v>>16)+amt),g=Math.min(255,((v>>8)&255)+amt),b=Math.min(255,(v&255)+amt); return `rgb(${r},${g},${b})`; };
      function draw(){
        ctx.clearRect(0,0,W,H);
        const R = A.map(rot), P = R.map(proj);
        bonds.forEach(([i,j])=>{
          const a=P[i], b=P[j], mx=(a.X+b.X)/2, my=(a.Y+b.Y)/2, lw=5*Math.min(a.f,b.f);
          ctx.lineWidth=lw; ctx.lineCap="round";
          ctx.strokeStyle=elc(A[i].el).c; ctx.beginPath(); ctx.moveTo(a.X,a.Y); ctx.lineTo(mx,my); ctx.stroke();
          ctx.strokeStyle=elc(A[j].el).c; ctx.beginPath(); ctx.moveTo(mx,my); ctx.lineTo(b.X,b.Y); ctx.stroke();
        });
        A.map((_,i)=>i).sort((a,b)=>R[a].z-R[b].z).forEach(i=>{
          const p=P[i], e=elc(A[i].el), rad=e.s*scale*0.5*p.f;
          const g=ctx.createRadialGradient(p.X-rad*0.35,p.Y-rad*0.35,rad*0.1,p.X,p.Y,rad);
          g.addColorStop(0, lighten(e.c,42)); g.addColorStop(1, e.c);
          ctx.fillStyle=g; ctx.beginPath(); ctx.arc(p.X,p.Y,rad,0,7); ctx.fill();
          ctx.lineWidth=1; ctx.strokeStyle="rgba(0,0,0,.16)"; ctx.stroke();
        });
      }
      const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      canvas.addEventListener("pointerdown",e=>{dragging=true;spin=false;lx=e.clientX;ly=e.clientY;try{canvas.setPointerCapture(e.pointerId);}catch(_){}});
      canvas.addEventListener("pointerup",()=>{dragging=false;});
      canvas.addEventListener("pointermove",e=>{ if(!dragging)return; rotY+=(e.clientX-lx)*0.01; rotX+=(e.clientY-ly)*0.01; lx=e.clientX; ly=e.clientY; draw(); });
      function loop(){ if(spin && !reduce){ rotY+=0.007; draw(); } raf=requestAnimationFrame(loop); }
      draw(); if(!reduce) loop();
    }

    // ---- IR stick spectrum ----
    function irSpectrum(canvas, rawModes) {
      const modes = (rawModes || []).filter(m => m.cm1 >= 100 && m.intensity > 1e-3);
      const ctx = canvas.getContext("2d"), W = canvas.width, H = canvas.height;
      const pad = { l: 8, r: 8, t: 10, b: 20 };
      const x0 = pad.l, x1 = W - pad.r, y0 = H - pad.b, y1 = pad.t;
      const FMIN = 0, FMAX = 4000;
      const maxI = Math.max(...modes.map(m => m.intensity), 1e-6);
      ctx.clearRect(0,0,W,H);
      // baseline + ticks
      ctx.strokeStyle = "#d3cebe"; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x0,y0); ctx.lineTo(x1,y0); ctx.stroke();
      ctx.fillStyle = "#9aa39a"; ctx.font = "9px ui-monospace, monospace"; ctx.textAlign = "center";
      for (let f=0; f<=4000; f+=1000) {
        const x = x0 + (f-FMIN)/(FMAX-FMIN)*(x1-x0);
        ctx.strokeStyle = "#e4e0d4"; ctx.beginPath(); ctx.moveTo(x,y0); ctx.lineTo(x,y0+3); ctx.stroke();
        ctx.fillText(String(f), x, y0+13);
      }
      // sticks
      modes.forEach(m => {
        const x = x0 + (m.cm1-FMIN)/(FMAX-FMIN)*(x1-x0);
        const h = (m.intensity/maxI) * (y0-y1);
        ctx.strokeStyle = "#0d7361"; ctx.lineWidth = 2; ctx.lineCap = "round";
        ctx.beginPath(); ctx.moveTo(x,y0); ctx.lineTo(x, y0-Math.max(h,1)); ctx.stroke();
      });
    }

    // ---- result panel HTML by task ----
    function resultHTML(p) {
      const r = p.result || {}, calc = p.calculator || CALC_LABEL.tblite;
      const fnum = (v, d=4) => (v == null ? "—" : Number(v).toFixed(d));
      if (r.energy) {
        return `<div class="cg-res">
          <div class="cg-res-k">${copy.resEnergy}</div>
          <div class="cg-res-v">${fnum(r.energy.value)} <small>${esc(r.energy.unit||"eV")} · ${copy.via} ${esc(calc)}</small></div></div>`;
      }
      if (r.dipole) {
        const v = r.dipole.vector || [];
        return `<div class="cg-res">
          <div class="cg-res-k">${copy.resDipole}</div>
          <div class="cg-res-v">${fnum(r.dipole.magnitude)} <small>${esc(r.dipole.unit||"e·Å")} · ${copy.resDipoleMag} · ${copy.via} ${esc(calc)}</small></div>
          <div class="cg-vec">[ ${v.map(x=>fnum(x,3)).join(",  ")} ]</div></div>`;
      }
      if (r.ir) {
        // keep real vibrational modes only — drop translations/rotations & spurious
        // near-zero modes below ~100 cm-1 (numerical noise off a loose minimum).
        const modes = (r.ir.modes||[]).filter(m=>m.cm1>=100 && m.intensity>1e-3).sort((a,b)=>b.intensity-a.intensity);
        const rows = modes.slice(0,8).sort((a,b)=>a.cm1-b.cm1).map(m =>
          `<tr><td>${m.cm1.toFixed(0)}</td><td>${m.intensity.toFixed(3)}</td></tr>`).join("");
        return `<div class="cg-res">
          <div class="cg-res-k">${copy.resIR} <small>· ${copy.via} ${esc(calc)}</small></div>
          <canvas class="cg-irc" width="440" height="130" data-ir></canvas>
          <div class="cg-freq"><div class="cg-freq-h">${copy.irActive}</div>
            <table class="cg-ftab"><thead><tr><th>${copy.freqCol}</th><th>${copy.intCol}</th></tr></thead>
            <tbody>${rows}</tbody></table></div></div>`;
      }
      if (r.thermo) {
        const t = r.thermo, un = t.unit || "eV";
        return `<div class="cg-res">
          <div class="cg-res-k">${copy.resThermo} <small>· ${copy.via} ${esc(calc)}</small></div>
          <div class="cg-thermo">
            <div class="cg-th"><span>${copy.thEnthalpy}</span><b>${fnum(t.enthalpy)} ${un}</b></div>
            <div class="cg-th"><span>${copy.thEntropy}</span><b>${t.entropy==null?"—":Number(t.entropy).toExponential(3)} ${un}/K</b></div>
            <div class="cg-th"><span>${copy.thGibbs}</span><b>${fnum(t.gibbs)} ${un}</b></div>
          </div></div>`;
      }
      return "";
    }

    // ---- folded steps (tool calls, SMILES, coords) ----
    function stepsHTML(p) {
      const steps = p.steps || [];
      const items = steps.map(s => {
        const d = s.detail || {};
        const chips = Object.entries(d).map(([k,v]) =>
          `<span class="cg-kv"><i>${esc(k)}</i> ${esc(v)}</span>`).join("");
        return `<div class="cg-step">
          <div class="cg-step-tool">${esc(s.tool)}()</div>
          <div class="cg-step-sum">${esc(s.summary)}</div>
          ${chips ? `<div class="cg-step-kv">${chips}</div>` : ""}</div>`;
      }).join("");
      const struct = p.structure && p.structure.atoms ? p.structure.atoms.length : 0;
      const coords = struct
        ? `<div class="cg-coords"><div class="cg-coords-h">molecule.xyz · ${struct} atoms</div>`
          + `<pre>${p.structure.atoms.map(a=>`${a.el.padEnd(2)} ${a.x.toFixed(4).padStart(9)} ${a.y.toFixed(4).padStart(9)} ${a.z.toFixed(4).padStart(9)}`).join("\n")}</pre></div>`
        : "";
      return `<details class="cg-steps"><summary>${copy.stepsLabel}</summary>
        <div class="cg-steps-body">${items}${coords}</div></details>`;
    }

    function cardHTML(p) {
      const ok = p.verified;
      const tag = p.cached ? `<span class="cg-tag cg-tag--cached">${copy.cachedTag}</span>`
                           : `<span class="cg-tag cg-tag--live">${copy.liveTag}</span>`;
      const vbadge = `<span class="cg-badge ${ok?"is-ok":"is-warn"}">${ok?"✓ "+copy.verified:copy.unverified}</span>`;
      const title = `${esc(p.molecule||"")}${p.formula?` · ${esc(p.formula)}`:""}`;
      const hasStruct = p.structure && p.structure.atoms && p.structure.atoms.length;
      return `<div class="cg-card">
        <div class="cg-card-top"><span class="cg-mol">${title}</span>${tag}${vbadge}</div>
        ${hasStruct ? `<div class="cg-struct"><div class="cg-struct-k">${copy.structure}</div><canvas class="cg-3d" width="300" height="200" data-3d></canvas></div>` : ""}
        ${resultHTML(p)}
        ${stepsHTML(p)}</div>`;
    }

    function addUser(txt) {
      const el = document.createElement("div");
      el.className = "cg-msg cg-msg--user";
      el.innerHTML = `<div class="cg-bubble">${esc(txt)}</div><div class="cg-avatar cg-avatar--you">${esc(copy.you)}</div>`;
      log.appendChild(el);
      return el;
    }

    function addThinking() {
      const el = document.createElement("div");
      el.className = "cg-msg cg-msg--agent";
      el.innerHTML = `<div class="cg-avatar" aria-hidden="true">CG</div>
        <div class="cg-bubble cg-thinking">
          <div class="cg-stages">${copy.stages.map((s,i)=>`<span class="cg-stage" data-si="${i}"><i></i>${esc(s)}</span>`).join("")}</div>
          <div class="cg-note" data-note>${esc(copy.thinking)}</div></div>`;
      log.appendChild(el);
      return el;
    }

    async function animateStages(el, until) {
      const stages = [...el.querySelectorAll(".cg-stage")];
      let i = 0;
      while (!until.done) {
        stages.forEach((s,k)=>s.classList.toggle("is-on", k<=i%stages.length));
        i++;
        await wait(600);
      }
      stages.forEach(s=>s.classList.add("is-on"));
    }

    function mountCanvases(host, p) {
      const c3d = host.querySelector("[data-3d]");
      if (c3d && p.structure && p.structure.atoms) mol3d(c3d, p.structure.atoms);
      const irc = host.querySelector("[data-ir]");
      if (irc && p.result && p.result.ir) irSpectrum(irc, p.result.ir.modes || []);
    }

    async function ask(q) {
      if (busy || !q.trim()) return;
      busy = true; sendBtn.disabled = true; text.value = "";
      // The landing state is deliberately compact. Once someone starts a real
      // run, give the trace, structure, and result card a normal reading width.
      root.classList.add("cg--conversation");
      if (chips) chips.style.display = "none";
      const userEl = addUser(q);
      const thinkEl = addThinking();
      scrollTo(userEl);
      const noteEl = thinkEl.querySelector("[data-note]");
      const flag = { done: false };
      animateStages(thinkEl, flag);
      const coldTimer = setTimeout(() => { if (noteEl) noteEl.textContent = copy.waking; }, 9000);

      const ctrl = new AbortController();
      const to = setTimeout(() => ctrl.abort(), 95000);
      try {
        const res = await fetch(SPACE_URL + "/run", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query: q }), signal: ctrl.signal,
        });
        clearTimeout(to); clearTimeout(coldTimer);
        const data = await res.json().catch(() => ({}));
        flag.done = true;
        await wait(350);
        if (!res.ok || data.error) {
          const msg = res.status === 429 ? copy.errRate
            : res.status === 504 ? copy.errTimeout
            : (data.error || copy.errNet);
          thinkEl.querySelector(".cg-bubble").innerHTML = `<div class="cg-err">${esc(msg)}</div>`;
        } else if (data.clarify) {
          // clarification node: the molecule/task isn't available — converse, don't error.
          const bubble = thinkEl.querySelector(".cg-bubble");
          bubble.classList.remove("cg-thinking");
          const chips = (data.suggestions || []).map((s) =>
            `<button type="button" class="cg-suggest" data-q="${esc(s.query)}">${esc(s.label)}</button>`).join("");
          bubble.innerHTML = `<div class="cg-clarify-msg">${esc(data.message)}</div>`
            + (chips ? `<div class="cg-suggests">${chips}</div>` : "");
          bubble.querySelectorAll(".cg-suggest").forEach((b) =>
            b.addEventListener("click", () => ask(b.dataset.q)));
          scrollTo(userEl);
        } else {
          const bubble = thinkEl.querySelector(".cg-bubble");
          bubble.classList.remove("cg-thinking");
          bubble.innerHTML = cardHTML(data);
          mountCanvases(bubble, data);
          scrollTo(userEl);
        }
      } catch (err) {
        clearTimeout(to); clearTimeout(coldTimer); flag.done = true;
        const msg = err && err.name === "AbortError" ? copy.errTimeout : copy.errNet;
        thinkEl.querySelector(".cg-bubble").innerHTML = `<div class="cg-err">${esc(msg)}</div>`;
      } finally {
        busy = false; sendBtn.disabled = false;
        try { text.focus({ preventScroll: true }); } catch (_) { /* older browsers */ }
      }
    }

    form.addEventListener("submit", (e) => { e.preventDefault(); ask(text.value); });
    root.querySelectorAll(".cg-chip").forEach(btn =>
      btn.addEventListener("click", () => ask(btn.dataset.q)));
  })();
</script>

