---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import HomeHero from "../components/home/HomeHero.astro";
import PlatformSection from "../components/home/PlatformSection.astro";
import ProofTrustSection from "../components/home/ProofTrustSection.astro";
import EcosystemSection from "../components/home/EcosystemSection.astro";
import HomeClosing from "../components/home/HomeClosing.astro";
---

<Base
  title="SciencesLoop — From scientific intent to measurement—and back"
  description="SciencesLoop connects models, protocols, existing instruments, and human review into traceable experimental loops, starting with adaptive electrochemistry."
  alternatePath={u("/zh/")}
>
  <div class="sl-home">
    <HomeHero locale="en" />
    <PlatformSection locale="en" />
    <ProofTrustSection locale="en" />
    <EcosystemSection locale="en" />
    <HomeClosing locale="en" />
  </div>
</Base>
