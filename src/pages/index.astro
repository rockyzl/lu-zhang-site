---
import Base from "../layouts/Base.astro";
import SiteAgent from "../components/SiteAgent.astro";
import { u } from "../lib/url";
import { detectLocale } from "../lib/i18n";
import { getFeaturedBlogPosts } from "../lib/blog";

const locale = detectLocale(Astro.url.pathname);
const lp = locale === "zh" ? "/zh" : "";
const featuredPosts = getFeaturedBlogPosts(3);

// Featured AI systems — exactly 3 (public-content-contract compliant).
// Property OS is a private case study: describe only, NO repo, NO real URL.
const featuredSystems = [
  {
    name: "Scientific Agent Lab",
    tagline: "Evidence-grounded scientific agents with replayable evals",
    description:
      "Explores how LLM agents can answer scientific questions while staying grounded in cited sources and testable through a deterministic evaluation harness.",
    status: "Public repository",
    tags: ["grounded agents", "eval harness", "LLM agents"],
    gradient: "from-rust to-amber",
    href: "https://github.com/rockyzl/scientific-agent-lab",
    external: true,
    cta: "View repository",
  },
  {
    name: "SciencesLoop Agent API",
    tagline: "Retrieval-grounded agent with an attribution guardrail",
    description:
      "A retrieval-grounded agent that answers questions about my public work, with an external-attribution guardrail to avoid misattributing others' work.",
    status: "Live demo",
    tags: ["RAG", "attribution guardrail", "grounded Q&A"],
    gradient: "from-amber to-teal",
    href: u(`${lp}/agent/`),
    external: false,
    cta: "Try the demo",
  },
  {
    name: "Property OS — Voice/SMS Operations Agent",
    tagline: "Interruptible real-time voice & SMS operations agent",
    description:
      "An interruptible real-time voice and SMS assistant for property operations: natural voice interaction, a safety-gated LLM layer, a read-only ops console, and explicit data-governance boundaries between operational records and financial ledgers.",
    status: "Private case study",
    tags: ["realtime voice", "safety-gated", "ops console"],
    gradient: "from-teal to-navy",
    href: null,
    external: false,
    cta: null,
  },
];

// Systems I Build — 4 capability cards (abstract the projects into a system).
const capabilities = [
  {
    label: "Capability 01",
    name: "Grounded Agents",
    text: "Agents that cite sources, preserve attribution, and avoid unsupported claims.",
  },
  {
    label: "Capability 02",
    name: "Eval-Driven AI",
    text: "Replayable traces, deterministic tests, and regression checks for agent behavior.",
  },
  {
    label: "Capability 03",
    name: "Safety-Gated Workflows",
    text: "Hard-coded safety screens, scoped tools, privacy boundaries, and human review.",
  },
  {
    label: "Capability 04",
    name: "Domain AI Systems",
    text: "AI systems for science, property operations, insurance intake, and other high-context workflows where correctness matters.",
  },
];

// Selected Projects — grouped teaser linking to /projects/.
const projectGroups = [
  {
    label: "Group 01",
    name: "Agent Infrastructure",
    items: ["Scientific Agent Lab", "SciencesLoop Agent API", "Realtime Synthetic Call Center"],
  },
  {
    label: "Group 02",
    name: "Science AI",
    items: ["Scientific Foundation Model Lab", "SciFM Registry", "RFB Formulation Agent"],
  },
  {
    label: "Group 03",
    name: "Operations AI",
    items: ["Property OS", "Insurance FNOL Agent"],
  },
];
---
<Base
  title="Lu Zhang — AI engineer for grounded, testable agents"
  description="AI engineer building grounded, testable agents for science and operations — retrieval, evaluation, safety guardrails, and domain expertise turned into reliable software."
>
  <div class="container">
    <section class="home-agent-hero">
      <div class="home-agent-intro">
        <span class="eyebrow">AI Engineer · Grounded agents · Evaluation-driven · Safe by design</span>
        <h1>AI engineer building grounded, testable agents for science and operations.</h1>
        <p class="lead">
          I build AI systems that combine retrieval, evaluation, safety
          guardrails, and domain expertise — turning complex knowledge
          workflows into reliable software.
        </p>
        <p class="role">
          15+ years in energy science at Argonne/JCESR now informs how I build
          agents: evidence-first, reproducible, and safe by design.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#featured-systems">View AI Systems</a>
          <a class="btn btn-ghost" href={u(`${lp}/agent/`)}>Try Agent Demo</a>
          <a class="btn btn-ghost" href={u(`${lp}/blog/`)}>Read Field Notes</a>
        </div>
      </div>
      <div class="home-agent-embed">
        <SiteAgent locale="en" mode="home" />
      </div>
    </section>

    <div class="section-head" id="featured-systems">
      <h2>Featured AI Systems</h2>
      <a class="more" href={u(`${lp}/projects/`)}>All projects →</a>
    </div>
    <div class="featured-grid">
      {featuredSystems.map((p) => {
        const Outer = p.href ? "a" : "div";
        const outerProps = p.href
          ? (p.external
              ? { href: p.href, target: "_blank", rel: "noopener", class: "project-card" }
              : { href: p.href, class: "project-card" })
          : { class: "project-card" };
        return (
          <Outer {...outerProps}>
            <div class={`cover gradient ${p.gradient}`}>
              <span class="glyph">{p.name}</span>
            </div>
            <div class="body">
              <div class="name">{p.name}</div>
              <div class="tagline">{p.tagline}</div>
              <div class="description">{p.description}</div>
              <div class="status">{p.cta ? `${p.status} · ${p.cta} →` : p.status}</div>
              <div class="tags">
                {p.tags.map((tg) => <span class="tag">{tg}</span>)}
              </div>
            </div>
          </Outer>
        );
      })}
    </div>

    <div class="section-head">
      <h2>Systems I Build</h2>
      <a class="more" href={u(`${lp}/projects/`)}>See how they fit →</a>
    </div>
    <section class="product-modules" aria-label="Capabilities">
      {capabilities.map((c) => (
        <div class="product-module">
          <span>{c.label}</span>
          <h2>{c.name}</h2>
          <p>{c.text}</p>
        </div>
      ))}
    </section>

    <div class="section-head">
      <h2>Why my science background matters</h2>
    </div>
    <p class="lead" style="margin-top: -0.4rem;">
      Before building AI systems, I spent over 15 years in energy science at
      Argonne and JCESR — electrochemical energy storage, redox-flow batteries,
      lithium-metal systems, and materials discovery. That background shapes how
      I build AI agents: I care about evidence, attribution, reproducibility,
      uncertainty, and safety boundaries — especially where mistakes are
      expensive.
    </p>
    <div class="agent-trust-strip" aria-label="Scientific foundation">
      <span>Scientific foundation</span>
      <span>15+ years in energy science · Argonne / JCESR</span>
      <span>97 publications</span>
      <span>28 US patents</span>
      <span>h-index 39</span>
    </div>
    <p style="margin-top: 1rem;">
      <a class="more" href={u(`${lp}/research-archive/`)}>View research archive →</a>
    </p>

    <div class="section-head">
      <h2>Selected Projects</h2>
      <a class="more" href={u(`${lp}/projects/`)}>All projects →</a>
    </div>
    <section class="product-modules" aria-label="Project groups">
      {projectGroups.map((g) => (
        <a class="product-module" href={u(`${lp}/projects/`)}>
          <span>{g.label}</span>
          <h2>{g.name}</h2>
          <p>{g.items.join(" · ")}</p>
        </a>
      ))}
    </section>

    <div class="section-head">
      <h2>Field Notes</h2>
      <a class="more" href={u(`${lp}/blog/`)}>All notes →</a>
    </div>
    <div class="blog-grid blog-grid--home">
      {featuredPosts.map((post) => (
        <article class="blog-card">
          <div class="blog-card-meta">
            <time datetime={post.dateLabel}>{post.dateLabel}</time>
            <span>{post.status ?? "note"}</span>
          </div>
          <h2><a href={u(`${lp}/blog/${post.slug}/`)}>{post.title}</a></h2>
          <p>{post.description}</p>
          <div class="blog-tags">
            {post.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="section-head">
      <h2>Contact</h2>
    </div>
    <p style="margin-bottom: 3rem;">
      Building something that needs grounded, testable agents? Reach me on
      <a href="https://github.com/rockyzl" target="_blank" rel="noopener">GitHub</a>,
      try the <a href={u(`${lp}/agent/`)}>agent demo</a>, or find me on
      <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a>
      and
      <a href="https://www.linkedin.com/in/lu-zhang-argonne/" target="_blank" rel="noopener">LinkedIn</a>.
    </p>
  </div>
</Base>
