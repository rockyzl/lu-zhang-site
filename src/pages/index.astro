---
import Base from "../layouts/Base.astro";
import publications from "../data/publications.json";
import patents from "../data/patents.json";
import conferences from "../data/conferences.json";

const totalCitations = publications.reduce((s, p) => s + (p.citations || 0), 0);
const firstAuthor = publications.filter((p) => p.role === "first").length;
const corresponding = publications.filter((p) => p.role === "corresponding").length;
const topCited = [...publications].sort((a, b) => b.citations - a.citations).slice(0, 5);
---
<Base title="Lu Zhang — Battery Scientist & Data Engineer">
  <h1>Lu Zhang, Ph.D.</h1>
  <p class="lead">
    Battery scientist with 17+ years at Argonne National Laboratory.
    Now bridging electrochemistry, machine learning, and industrial-scale
    energy storage. R&amp;D 100 Award (2014, Finalist 2015).
  </p>

  <div class="stats">
    <div class="stat"><div class="num">{publications.length}</div><div class="label">Journal articles</div></div>
    <div class="stat"><div class="num">{patents.length}</div><div class="label">US patents</div></div>
    <div class="stat"><div class="num">{conferences.length}</div><div class="label">Conference talks</div></div>
    <div class="stat"><div class="num">{totalCitations.toLocaleString()}</div><div class="label">Citations</div></div>
    <div class="stat"><div class="num">39</div><div class="label">h-index</div></div>
    <div class="stat"><div class="num">{firstAuthor + corresponding}</div><div class="label">First / corresp. author</div></div>
  </div>

  <div class="cards">
    <div class="card">
      <h3>Research</h3>
      <p>Redox flow batteries, Li-ion electrolytes, silicon-anode binders, computational chemistry. <a href="/publications/">Browse 143 papers →</a></p>
    </div>
    <div class="card">
      <h3>Inventions</h3>
      <p>23 issued US patents in flow battery chemistries, redox shuttles, electrolytes, and binders. <a href="/patents/">See patents →</a></p>
    </div>
    <div class="card">
      <h3>AI &amp; engineering</h3>
      <p>ML for materials discovery; production data-science pipelines (Cincinnati, Mercury, AAOS). <a href="/ai/">See projects →</a></p>
    </div>
  </div>

  <h2>Selected highly-cited work</h2>
  {topCited.map((p) => (
    <div class="entry">
      <div class="title">
        {p.doi ? <a href={p.doi}>{p.title}</a> : p.title}
        {p.role === "first" && <span class="badge first">first</span>}
        {p.role === "corresponding" && <span class="badge corresponding">corresp.</span>}
      </div>
      <div class="meta">{p.journal} · {p.year} · {p.citations} citations</div>
    </div>
  ))}
</Base>
