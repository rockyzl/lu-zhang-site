---
import Base from "../layouts/Base.astro";
import SiteAgent from "../components/SiteAgent.astro";
import { u } from "../lib/url";
import { detectLocale, t } from "../lib/i18n";
import publications from "../data/publications.json";
import patents from "../data/patents.json";
import conferences from "../data/conferences.json";
import news from "../data/news.json";
import featured from "../data/featured.json";
import aiProjects from "../data/ai_projects.json";
import { getFeaturedBlogPosts } from "../lib/blog";

const locale = detectLocale(Astro.url.pathname);
const lp = locale === "zh" ? "/zh" : "";

// Stats use AUTHORITATIVE counts (user-verified TSV 2026-04-27), not raw JSON
// — local publications.json is incomplete (87 journals; authoritative count is 97).
const SCI_COUNT = 97;
const BOOK_CHAPTER_COUNT = 2;
const PATENT_COUNT_TOTAL = 28;
const TALKS_TOTAL = 51; // 13 invited + 38 conference abstracts
const CITATION_COUNT = "4,700+";
const H_INDEX = 39;
const FIRST_OR_CORRESP = 59;
// (kept for any legacy references that still use these:)
const verifiedPubs = publications.filter((p) => p.verified);
const totalCitations = verifiedPubs.reduce((s, p) => s + (p.citations || 0), 0);
const firstAuthor = verifiedPubs.filter((p) => p.role === "first").length;
const corresponding = verifiedPubs.filter((p) => p.role === "corresponding").length;
const featuredPosts = getFeaturedBlogPosts(3);
const researchPrograms = [
  {
    name: "Scientific Workflow",
    label: "Program 01",
    text: "Agentic workflows, workflow engines, tool routing, evaluation gates, and reliable loops for scientific work.",
    href: `${lp}/agent/`,
  },
  {
    name: "Scientific State",
    label: "Program 02",
    text: "Scientific memory, literature evidence, structured state, provenance, and context systems that make decisions inspectable.",
    href: `${lp}/agent/`,
  },
  {
    name: "Scientific Foundation Models",
    label: "Program 03",
    text: "Representation learning, molecular/property models, solubility and battery-materials modeling, and foundation-model literacy.",
    href: `${lp}/ai/`,
  },
  {
    name: "Scientific Discovery",
    label: "Program 04",
    text: "Flow-battery decision support, benchmark graphs, property prediction, and future self-driving-lab interfaces.",
    href: `${lp}/energy-materials-ai/`,
  },
];

const openProblems = [
  "How should scientific agents represent state before making decisions?",
  "What should count as evaluation for a scientific workflow agent?",
  "How can literature, simulation, experiment, and human review share one trace?",
];

const labPrinciples = [
  "We are not building AI to answer scientific questions.",
  "We are building scientific infrastructure that helps scientists ask better questions, design better experiments, and make better decisions.",
];
---
<Base
  title="SciencesLoop — Open Research Lab for Scientific AI"
  description="SciencesLoop is an open research lab exploring AI-native scientific workflows, scientific state, intelligent agents, and evidence-driven systems for discovery."
>
  <div class="container">
    <section class="home-agent-hero">
      <div class="home-agent-intro">
        <span class="eyebrow">Open research lab · Scientific AI · Reliable agent systems</span>
        <h1>SciencesLoop</h1>
        <p class="role">An open laboratory for reliable Scientific AI.</p>
        <p class="lead">
          Building AI-native scientific workflows, scientific state systems,
          and reliable agents with context engineering, evaluation harnesses,
          and human-in-the-loop review.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={u(`${lp}/ai/`)}>Research Programs</a>
          <a class="btn btn-ghost" href={u(`${lp}/blog/`)}>Field Notes</a>
          <a class="btn btn-ghost" href={u(`${lp}/projects/`)}>Software</a>
          <a class="btn btn-ghost" href={u(`${lp}/agent/`)}>{t("home.cta.agent", locale)}</a>
          <a class="btn btn-ghost" href={u(`${lp}/ai/`)}>{t("home.cta.ai", locale)}</a>
          <a class="btn btn-ghost" href={u(`${lp}/publications/`)}>{t("home.cta.publications", locale)}</a>
          <a class="btn btn-ghost" href={u("/files/Lu_Zhang_CV.pdf")} target="_blank" rel="noopener">{locale === "zh" ? "↓ 学术 CV (PDF)" : "↓ Academic CV (PDF)"}</a>
          <a class="btn btn-ghost" href={u(`${lp}/about/`)}>{t("home.cta.about", locale)}</a>
        </div>
      </div>
      <div class="home-agent-embed">
        <SiteAgent locale="en" mode="home" />
      </div>
    </section>

    <div class="agent-trust-strip" aria-label="Agent boundaries">
      <span>Scientific workflow systems</span>
      <span>Scientific state and memory</span>
      <span>Agent reliability engineering</span>
      <span>Battery-materials discovery</span>
    </div>

    <section class="lab-manifesto" aria-label="SciencesLoop mission">
      <div>
        <span class="eyebrow">Mission</span>
        <h2>Scientific infrastructure for better decisions.</h2>
      </div>
      <div>
        {labPrinciples.map((line) => <p>{line}</p>)}
      </div>
    </section>

    <div class="section-head">
      <h2>Research Programs</h2>
      <a class="more" href={u(`${lp}/ai/`)}>Program map →</a>
    </div>
    <section class="product-modules" aria-label="SciencesLoop research programs">
      {researchPrograms.map((item) => (
        <a class="product-module" href={u(item.href)}>
          <span>{item.label}</span>
          <h2>{item.name}</h2>
          <p>{item.text}</p>
        </a>
      ))}
    </section>

    <section class="lab-split" aria-label="Open problems and people">
      <article>
        <span class="eyebrow">Open Problems</span>
        <h2>Questions driving the lab</h2>
        <ul>
          {openProblems.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article>
        <span class="eyebrow">People</span>
        <h2>Lu Zhang</h2>
        <p>
          Founder of SciencesLoop. Scientific AI Systems Engineer and former
          Argonne scientist connecting battery-materials research, production
          AI workflows, agent reliability engineering, and scientific
          infrastructure.
        </p>
        <a class="more" href={u(`${lp}/about/`)}>People page →</a>
      </article>
    </section>

    <div class="stat-bar">
      <div class="stat"><div class="num">{SCI_COUNT}</div><div class="label">{t("stat.papers", locale)}</div></div>
      <div class="stat"><div class="num">{BOOK_CHAPTER_COUNT}</div><div class="label">{locale === "zh" ? "著作章节" : "Book chapters"}</div></div>
      <div class="stat"><div class="num">{PATENT_COUNT_TOTAL}</div><div class="label">{t("stat.patents", locale)}</div></div>
      <div class="stat"><div class="num">{TALKS_TOTAL}</div><div class="label">{t("stat.talks", locale)}</div></div>
      <div class="stat"><div class="num">{CITATION_COUNT}</div><div class="label">{t("stat.citations", locale)}</div></div>
      <div class="stat"><div class="num">{H_INDEX}</div><div class="label">{t("stat.h", locale)}</div></div>
      <div class="stat"><div class="num">{FIRST_OR_CORRESP}</div><div class="label">{t("stat.first", locale)}</div></div>
    </div>

    <div class="section-head">
      <h2>{t("section.ai", locale)}</h2>
      <a class="more" href={u(`${lp}/ai/`)}>{t("section.ai.more", locale)}</a>
    </div>

    <div class="featured-grid">
      {aiProjects.map((p) => {
        const linkHref = p.site ?? p.repo ?? null;
        const Outer = linkHref ? "a" : "div";
        const outerProps = linkHref
          ? { href: linkHref, target: "_blank", rel: "noopener", class: "project-card" }
          : { class: "project-card" };
        return (
          <Outer {...outerProps}>
            {p.image ? (
              <div class="cover"><img src={u(p.image)} alt={p.name} loading="lazy" /></div>
            ) : (
              <div class={`cover gradient ${p.gradient ?? "from-rust to-amber"}`}>
                <span class="glyph">{p.name}</span>
              </div>
            )}
            <div class="body">
              <div class="name">{p.name}</div>
              <div class="tagline">{p.tagline}</div>
              <div class="description">{p.description}</div>
              <div class="status">{p.status}</div>
              <div class="tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
          </Outer>
        );
      })}
    </div>

    <div class="section-head">
      <h2>Field Notes</h2>
      <a class="more" href={u(`${lp}/blog/`)}>All notes →</a>
    </div>
    <div class="blog-grid blog-grid--home">
      {featuredPosts.map((post) => (
        <article class="blog-card">
          <div class="blog-card-meta">
            <time datetime={post.dateLabel}>{post.dateLabel}</time>
            <span>{post.status ?? "note"}</span>
          </div>
          <h2><a href={u(`${lp}/blog/${post.slug}/`)}>{post.title}</a></h2>
          <p>{post.description}</p>
          <div class="blog-tags">
            {post.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="section-head">
      <h2>{t("section.featured", locale)}</h2>
      <a class="more" href={u(`${lp}/publications/`)}>{t("section.featured.more", locale)}</a>
    </div>
    <div class="featured-grid">
      {featured.map((f) => (
        <a class="feature-card" href={f.doi ?? "#"}>
          {f.image ? (
            <div class="cover"><img src={u(f.image)} alt={f.title} loading="lazy" /></div>
          ) : (
            <div class={`cover gradient ${f.gradient ?? "from-amber to-rust"}`}>
              <span class="glyph">{f.journal}<br/><span style="font-weight:400; font-size:0.85em;">{f.year}</span></span>
            </div>
          )}
          <div class="body">
            <div class="title">{f.title}</div>
            <div class="meta">
              {f.journal} · {f.year}
              {f.citations ? ` · ${f.citations} citations` : ""}
              {f.role === "first" && <span class="badge first">first</span>}
              {f.role === "corresponding" && <span class="badge corresponding">corresp.</span>}
            </div>
            <div class="highlight">{f.highlight}</div>
          </div>
        </a>
      ))}
    </div>

    <div class="section-head">
      <h2>{t("section.recent", locale)}</h2>
      <span class="more">{t("section.recent.note", locale)}</span>
    </div>
    <div class="news-list">
      {news.map((n) => (
        <article class="news-item">
          <div class="news-meta">
            <div class="date">{n.date}</div>
            <span class={`news-tag ${n.tag}`}>{n.tag}</span>
          </div>
          <div class="news-body">
            <div class="title">
              {n.link ? <a href={n.link}>{n.title}</a> : n.title}
            </div>
            <div class="blurb">{n.blurb}</div>
          </div>
          {n.image && (
            <a class="preview" href={n.link ?? "#"}>
              <img src={u(n.image)} alt={n.title} loading="lazy" />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</Base>
