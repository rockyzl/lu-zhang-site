---
import Base from "../layouts/Base.astro";
import { detectLocale, t } from "../lib/i18n";
import publications from "../data/publications.json";
import bookChapters from "../data/book_chapters.json";

const locale = detectLocale(Astro.url.pathname);
// Only show ANL-affiliated papers (filters out same-name authors via parser-set verified flag).
const filtered = publications.filter((p) => p.verified);
const sorted = [...filtered].sort((a, b) => (b.year || 0) - (a.year || 0) || b.citations - a.citations);
const topics = [...new Set(filtered.map((p) => p.topic))].filter(Boolean);
const scholarUrl = (title) => `https://scholar.google.com/scholar?q=${encodeURIComponent(title + " Lu Zhang Argonne")}`;

// Reviews: known review articles (currently marked manually by DOI).
const REVIEW_DOIS = new Set([
  "https://doi.org/10.1146/annurev-matsci-080222-114725",
  "https://doi.org/10.1021/acs.chemrev.0c00800",
]);
const isReview = (p) => p.doi && REVIEW_DOIS.has(p.doi.toLowerCase());

// Take the highest-cited review-style paper for surfacing
const reviews = filtered.filter((p) => /liquid redoxmers for nonaqueous redox flow batteries/i.test(p.title));
---
<Base title={(locale === "zh" ? "论文 — " : "Publications — ") + "Lu Zhang"}>
  <div class="container" style="padding-top: 3rem;">
  <span class="eyebrow">{t("page.publications.eyebrow", locale)}</span>
  <h1>{t("page.publications.title", locale)}</h1>
  <p class="lead">{t("page.publications.lead", locale)} <span style="color: var(--c-muted); font-size: 0.9em;">({filtered.length} verified)</span></p>

  <div class="toolbar">
    <input id="q" type="search" placeholder={t("page.publications.search", locale)} />
    <select id="topic">
      <option value="">{t("page.publications.alltopics", locale)}</option>
      {topics.map((tp) => <option value={tp}>{tp}</option>)}
    </select>
    <select id="role">
      <option value="">{t("page.publications.anyrole", locale)}</option>
      <option value="first">{t("page.publications.first", locale)}</option>
      <option value="corresponding">{t("page.publications.corresp", locale)}</option>
      <option value="co">{t("page.publications.co", locale)}</option>
    </select>
  </div>

  <div class="section-head" style="margin-top: 2.5rem;">
    <h2 style="margin:0;">{t("page.publications.allpapers", locale)} ({sorted.length})</h2>
    <span class="more">{locale === "zh" ? "按年份倒序" : "newest first"}</span>
  </div>
  <div id="list">
    {sorted.map((p) => {
      const reviewBadge = reviews.includes(p);
      return (
        <div class="entry" data-topic={p.topic} data-role={p.role} data-text={(p.title + " " + p.authors + " " + p.journal).toLowerCase()}>
          <div class="title">
            <a href={p.doi || scholarUrl(p.title)} target={p.doi ? "_blank" : "_self"}>{p.title}</a>
            {p.role === "first" && <span class="badge first">first</span>}
            {p.role === "corresponding" && <span class="badge corresponding">corresp.</span>}
            {reviewBadge && <span class="badge" style="background: #e1ecff; color: #2456a8;">review</span>}
          </div>
          <div class="meta">{p.authors}</div>
          <div class="meta">{p.journal} · {p.year} · {p.citations} citations · <em>{p.topic}</em></div>
        </div>
      );
    })}
  </div>

  <div class="section-head" style="margin-top: 4rem;">
    <h2 style="margin:0;">{t("page.publications.chapters", locale)} ({bookChapters.length})</h2>
  </div>
  {bookChapters.map((c) => (
    <div class="entry">
      <div class="title">
        <a href={c.url} target="_blank" rel="noopener">{c.title}</a>
        {c.verified === false && <span class="badge" style="background: #f0ece2; color: #6b5c30;">{locale === "zh" ? "占位 · 待确认" : "placeholder"}</span>}
      </div>
      {c.title_cn && c.title_cn !== c.title && <div class="meta">{c.title_cn}</div>}
      <div class="meta">{c.authors}</div>
      <div class="meta">
        <strong style="color: var(--c-fg);">{c.book}</strong>
        {c.publisher && ` · ${c.publisher}`}
        {c.year && ` · ${c.year}`}
        {c.pages && ` · pp. ${c.pages}`}
        {c.isbn && ` · ISBN ${c.isbn}`}
      </div>
      {c.note && <div class="meta" style="font-style: italic;">{c.note}</div>}
    </div>
  ))}

  <p style="margin-top: 2rem; font-size: 0.93rem;">
    <a href={locale === "zh" ? "/zh/reports/" : "/reports/"}>
      {locale === "zh" ? "→ 查看 5 项 DOE / 阿贡 LDRD 技术报告" : "→ See 5 DOE / Argonne LDRD technical reports"}
    </a>
  </p>

  <script is:inline>
    const q = document.getElementById("q");
    const topic = document.getElementById("topic");
    const role = document.getElementById("role");
    function apply() {
      const qv = q.value.trim().toLowerCase();
      const tv = topic.value;
      const rv = role.value;
      document.querySelectorAll("#list .entry").forEach((el) => {
        const text = el.dataset.text || "";
        const matchQ = !qv || text.includes(qv);
        const matchT = !tv || el.dataset.topic === tv;
        const matchR = !rv || el.dataset.role === rv;
        el.style.display = matchQ && matchT && matchR ? "" : "none";
      });
    }
    [q, topic, role].forEach((el) => el.addEventListener("input", apply));
  </script>
  </div>
</Base>
