---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { detectLocale, t } from "../lib/i18n";
import projectsData from "../data/projects.json";

const locale = detectLocale(Astro.url.pathname);
const isZh = locale === "zh";
const lp = isZh ? "/zh" : "";

// Authoritative counts (user-verified TSV 2026-04-27) — same constants used on
// the home stat bar. Do NOT switch to dynamic compute (JSON is incomplete).
const SCI_COUNT = 97;
const BOOK_CHAPTER_COUNT = 2;
const PATENT_COUNT_TOTAL = 28;
const TALKS_TOTAL = 51;
const CITATION_COUNT = "4,700+";
const H_INDEX = 39;
const FIRST_OR_CORRESP = 59;

const SCHOLAR = "https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en";
const stats = [
  { n: SCI_COUNT, l: isZh ? "SCI 论文" : "papers", href: u(`${lp}/publications/`) },
  { n: BOOK_CHAPTER_COUNT, l: isZh ? "著作章节" : "book chapters", href: u(`${lp}/publications/`) },
  { n: PATENT_COUNT_TOTAL, l: isZh ? "专利" : "patents", href: u(`${lp}/patents/`) },
  { n: TALKS_TOTAL, l: isZh ? "报告" : "talks", href: u(`${lp}/talks/`) },
  { n: CITATION_COUNT, l: isZh ? "总被引" : "citations", href: SCHOLAR, external: true },
  { n: H_INDEX, l: "h-index", href: SCHOLAR, external: true },
  { n: FIRST_OR_CORRESP, l: isZh ? "一作/通讯" : "first / corresp.", href: u(`${lp}/publications/`) },
];

const archiveSections = [
  { href: `${lp}/publications/`, name_en: "Publications", name_zh: "论文", meta_en: "97 SCI + 2 book chapters", meta_zh: "97 篇 SCI + 2 章著作" },
  { href: `${lp}/patents/`, name_en: "US Patents", name_zh: "美国专利", meta_en: "28 total · 25 issued", meta_zh: "共 28 · 25 已授权" },
  { href: `${lp}/talks/`, name_en: "Talks & Presentations", name_zh: "学术报告", meta_en: "51 talks · 13 invited", meta_zh: "51 场 · 13 特邀" },
  { href: `${lp}/reports/`, name_en: "Technical Reports", name_zh: "技术报告", meta_en: "DOE / Argonne LDRD", meta_zh: "DOE / 阿贡 LDRD" },
  { href: `${lp}/awards/`, name_en: "Awards & Recognition", name_zh: "荣誉与认可", meta_en: "R&D 100 · DOE / JCESR", meta_zh: "R&D 100 · DOE / JCESR" },
  { href: `${lp}/mentorship-collaborators/`, name_en: "Mentorship & Collaborators", name_zh: "指导与合作者", meta_en: "13 mentees · 180+ collaborators", meta_zh: "13 学生 · 180+ 合作者" },
  { href: `${lp}/press/`, name_en: "Press & Media", name_zh: "媒体与报道", meta_en: "Argonne / DOE / industry", meta_zh: "阿贡 / DOE / 行业" },
];

const hasProjectUrl = (p) => typeof p.url === "string" && p.url.length > 0;
---
<Base
  title={(isZh ? "研究档案 — " : "Research Archive — ") + "SciencesLoop"}
  description={isZh
    ? "张鲁在电化学储能领域科学工作的公开记录：论文、专利、资助研究方向与项目历史，位于 AI 作品集之后。"
    : "A public record of Lu Zhang's scientific work in electrochemical energy storage — publications, patents, funded research themes, and project history, kept behind the AI portfolio."}
>
  <div class="container ra">
    <section class="ra-hero">
      <span class="eyebrow">{isZh ? "研究档案 · 科学根基" : "Research Archive · science foundation"}</span>
      <h1 class="ra-title">{isZh ? "研究档案" : "Research Archive"}</h1>
      <p class="ra-intro">
        {isZh
          ? <>转向 AI 工程之前，我在电化学储能领域做了 <b>15+ 年</b>研究 —— 液流电池、锂离子电解液、硅负极、膜材料、锂回收和自主式材料发现。这段背景仍塑造着我今天构建 AI 系统的方式：<b>以证据为先、可复现、具备领域意识</b>。这份档案保存公开的论文、专利、资助方向和项目历史。</>
          : <>Before moving into AI engineering, I spent <b>15+ years</b> in electrochemical energy storage — redox-flow batteries, Li-ion electrolytes, silicon anodes, membranes, lithium recovery, and autonomous materials discovery. That background still shapes how I build AI systems today: <b>evidence-first, reproducible, and domain-aware</b>. This archive keeps the public publications, patents, funded themes, and project history.</>}
      </p>
    </section>

    <div class="ra-stats">
      {stats.map((s) => (
        <a class="ra-stat" href={s.href} {...(s.external ? { target: "_blank", rel: "noopener" } : {})}>
          <div class="n">{s.n}</div><div class="l">{s.l}</div>
        </a>
      ))}
    </div>

    <section class="ra-sec">
      <div class="ra-sechead">{isZh ? "档案索引" : "Browse the record"}</div>
      <div class="ra-index">
        {archiveSections.map((s) => (
          <a class="ra-idx" href={u(s.href)}>
            <span class="nm">{isZh ? s.name_zh : s.name_en}</span>
            <span class="mt">{isZh ? s.meta_zh : s.meta_en}</span>
            <span class="ar">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="ra-sec">
      <div class="ra-sechead">{isZh ? "研究方向" : "Research themes"}</div>
      <div class="ra-themes">
        {projectsData.capability_themes.map((theme) => <span class="ra-theme">{theme}</span>)}
      </div>
    </section>

    <section class="ra-sec">
      <div class="ra-sechead">{isZh ? "精选研究项目 · 阿贡 DOE / JCESR / LDRD" : "Selected research projects · Argonne DOE / JCESR / LDRD"}</div>
      {projectsData.categories.map((cat) => (
        <div class="ra-catgroup">
          <div class="ra-cat"><span>{cat.title}</span><span class="c">{cat.items.length}</span></div>
          {cat.subtitle && <p class="ra-catsub">{cat.subtitle}</p>}
          {cat.items.map((p) => (
            <div class="ra-entry">
              <div class="ra-etitle">
                {hasProjectUrl(p) ? <a href={p.url} target="_blank" rel="noopener">{p.name} ↗</a> : <span>{p.name}</span>}
              </div>
              <div class="ra-emeta"><b>{p.funder}</b> · {p.years} · {p.role}</div>
              {p.highlights && p.highlights.length > 0 && (
                <ul class="ra-hl">{p.highlights.map((h) => <li>{h}</li>)}</ul>
              )}
            </div>
          ))}
        </div>
      ))}
    </section>

    <section class="ra-through">
      <div class="ra-sechead">{isZh ? "承前启后" : "The through-line"}</div>
      <p>
        {isZh
          ? "在犯错代价高昂的实验科学里做了十几年，养成了对证据、署名、可复现性和不确定性的本能重视 —— 这直接对应到我今天构建 AI 系统的方式：让 agent 以来源为依据、用确定性 eval 测试、加安全护栏，并在正确性关键处保留人工复核。"
          : "More than a decade in experimental science, where mistakes are expensive, built an instinct for evidence, attribution, reproducibility, and uncertainty — which maps directly onto how I build AI today: grounding agents in sources, testing with deterministic evals, gating with safety screens, and keeping human review where correctness matters."}
      </p>
      <a class="ra-cta" href={u(`${lp}/projects/`)}>{isZh ? "查看当前 AI 系统 →" : "See the current AI systems →"}</a>
    </section>
  </div>

  <style>
    .ra { max-width: 820px; }
    .ra .eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent); }
    .ra-hero { padding: 1.4rem 0 0; }
    .ra-title { font-size: clamp(32px, 5vw, 50px); letter-spacing: -.035em; font-weight: 730; margin: .5rem 0 0; }
    .ra-intro { font-size: 1.05rem; color: var(--c-fg); line-height: 1.65; margin: 1.2rem 0 0; max-width: 66ch; }
    .ra-intro b { font-weight: 640; color: var(--c-ink); }

    .ra-stats { display: flex; flex-wrap: wrap; gap: 1.4rem 1.9rem; margin: 2.2rem 0 0; padding: 1.3rem 0; border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); }
    .ra-stat { color: inherit; text-decoration: none; display: block; padding: .3rem .55rem .3rem 0; border-radius: 8px; transition: transform .14s; }
    .ra-stat .n { font-size: 1.45rem; font-weight: 700; letter-spacing: -.02em; color: var(--c-fg); transition: color .15s; display: inline-flex; align-items: baseline; gap: .28rem; }
    .ra-stat .n::after { content: "↗"; font-family: var(--font-mono); font-size: .62rem; color: var(--c-border-strong, #b9b3a0); transition: color .15s, transform .15s; }
    .ra-stat .l { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; color: var(--c-muted); margin-top: .2rem; transition: color .15s; }
    .ra-stat:hover { transform: translateY(-2px); }
    .ra-stat:hover .n { color: var(--c-accent); }
    .ra-stat:hover .n::after { color: var(--c-accent); transform: translate(1px, -1px); }
    .ra-stat:hover .l { color: var(--c-accent); }

    .ra-sec { padding: 2.4rem 0 0; }
    .ra-sechead { font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--c-muted); margin: 0 0 1rem; }

    .ra-index { display: flex; flex-direction: column; }
    .ra-idx { display: flex; align-items: baseline; gap: 1rem; padding: .85rem 0; border-top: 1px solid var(--c-border); color: inherit; text-decoration: none; }
    .ra-idx:first-of-type { border-top: 0; }
    .ra-idx .nm { font-size: 1rem; font-weight: 640; transition: color .15s; }
    .ra-idx:hover .nm { color: var(--c-accent); }
    .ra-idx .mt { font-family: var(--font-mono); font-size: .74rem; color: var(--c-muted); margin-left: auto; text-align: right; }
    .ra-idx .ar { color: var(--c-accent); font-family: var(--font-mono); }

    .ra-themes { display: flex; flex-wrap: wrap; gap: .5rem; }
    .ra-theme { font-family: var(--font-mono); font-size: .76rem; color: var(--c-fg-2, var(--c-fg)); background: var(--c-card); border: 1px solid var(--c-border); border-radius: 999px; padding: .35rem .7rem; }

    .ra-catgroup { margin-top: 1.8rem; }
    .ra-cat { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; font-size: 1.05rem; font-weight: 680; letter-spacing: -.01em; border-bottom: 1px solid var(--c-border); padding-bottom: .5rem; }
    .ra-cat .c { font-family: var(--font-mono); font-size: .8rem; font-weight: 400; color: var(--c-muted); }
    .ra-catsub { color: var(--c-muted); font-size: .9rem; margin: .55rem 0 0; }
    .ra-entry { padding: .95rem 0; border-bottom: 1px solid var(--c-border-soft); }
    .ra-etitle { font-size: .98rem; font-weight: 600; }
    .ra-etitle a { color: var(--c-accent); }
    .ra-emeta { font-family: var(--font-mono); font-size: .74rem; color: var(--c-muted); margin-top: .28rem; }
    .ra-emeta b { color: var(--c-fg); font-weight: 600; }
    .ra-hl { margin: .5rem 0 0; padding-left: 1.15rem; color: var(--c-fg); font-size: .9rem; line-height: 1.55; }
    .ra-hl li { margin: .15rem 0; }

    .ra-through { padding: 2.6rem 0 3.5rem; }
    .ra-through p { color: var(--c-fg); font-size: 1rem; line-height: 1.7; max-width: 66ch; margin: 0; }
    .ra-cta { display: inline-block; margin-top: 1rem; font-family: var(--font-mono); font-size: .82rem; color: var(--c-accent); }

    @media (max-width: 560px) {
      .ra-idx { flex-wrap: wrap; gap: .2rem; }
      .ra-idx .mt { margin-left: 0; text-align: left; flex-basis: 100%; }
    }
  </style>
</Base>
