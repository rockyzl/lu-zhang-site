---
import publications from "../data/publications.json";
import patents from "../data/patents.json";
import patentsExtra from "../data/patents_extra.json";
import bookChapters from "../data/book_chapters.json";
import techReports from "../data/tech_reports.json";
import invitedData from "../data/invited_talks.json";
import conferences from "../data/conferences.json";
import projectsData from "../data/projects.json";
import menteesData from "../data/mentees.json";

// Total conference presentations = invited talks + conference abstracts
const totalTalks = invitedData.talks.length + conferences.length;
// Mentees (graduate students + postdocs at ANL 2013–2023)
const studentList = menteesData.students;
const postdocList = menteesData.postdocs;
const studentNames = studentList.map((m) => m.name).join(", ");
const postdocNames = postdocList.map((m) => m.name).join(", ");
import { detectLocale, t } from "../lib/i18n";

// Sort + filter — only journal articles count as "papers"
const verifiedPubs = publications.filter((p) => p.verified && p.kind === "journal");
const top10 = [...verifiedPubs].sort((a, b) => b.citations - a.citations).slice(0, 10);
const firstAuthor = verifiedPubs.filter((p) => p.role === "first").length;
const corresp = verifiedPubs.filter((p) => p.role === "corresponding").length;
const SCI_COUNT = 97;
const BOOK_CHAPTER_COUNT = 2;
const PUBLICATION_TOTAL = SCI_COUNT + BOOK_CHAPTER_COUNT;
const TALKS_TOTAL = 51;
const FIRST_OR_CORRESP = 59;

const issued = [
  ...patents,
  ...patentsExtra.issued_continuations.map((p) => ({
    patent_no: p.patent_no, year: p.year, title_en: p.title_en, inventors: p.inventors,
  })),
];
const top10Patents = [...issued].sort((a, b) => b.year - a.year).slice(0, 10);

const allProjects = projectsData.categories.flatMap((c) => c.items);

const today = new Date().toISOString().slice(0, 10);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Lu Zhang — Scientific AI Systems Engineer CV</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap"
    />
    <style>
      :root {
        --c-fg: #1e293b;
        --c-muted: #64748b;
        --c-accent: #0066ff;
        --c-rule: #e2e8f0;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: "Inter", -apple-system, sans-serif;
        color: var(--c-fg);
        font-size: 10.5pt;
        line-height: 1.45;
        background: white;
      }
      .cv {
        max-width: 8.5in;
        margin: 0 auto;
        padding: 0.6in 0.65in;
      }
      h1, h2, h3 {
        font-family: "Newsreader", Georgia, serif;
        font-weight: 600;
        margin: 0;
        line-height: 1.18;
      }
      h1 { font-size: 28pt; letter-spacing: -0.01em; }
      h2 {
        font-size: 14pt;
        margin-top: 1.1em;
        padding-bottom: 0.18em;
        border-bottom: 1.5px solid var(--c-rule);
        color: var(--c-accent);
      }
      h3 { font-size: 11pt; font-weight: 600; }

      /* Header */
      .header {
        display: flex; justify-content: space-between; align-items: baseline;
        margin-bottom: 0.4em;
      }
      .header .role { color: var(--c-muted); font-size: 11pt; margin-top: 0.2em; }
      .contact {
        font-size: 9.5pt;
        color: var(--c-muted);
        line-height: 1.6;
      }
      .contact a { color: var(--c-accent); text-decoration: none; }
      .summary { margin: 0.6em 0 0.4em; font-size: 10.5pt; }

      /* Numbers chip line */
      .metrics {
        display: flex; flex-wrap: wrap; gap: 0.6em 1.2em;
        margin: 0.4em 0 0.5em;
        font-size: 9.5pt;
      }
      .metrics b { color: var(--c-accent); font-weight: 600; }

      /* Two-column entries */
      .entry {
        margin: 0.42em 0;
        page-break-inside: avoid;
      }
      .entry .row {
        display: flex; justify-content: space-between; align-items: baseline; gap: 1em;
      }
      .entry .meta { color: var(--c-muted); font-size: 9.5pt; white-space: nowrap; }
      .entry .title { font-weight: 500; }
      .entry .body { color: var(--c-muted); font-size: 9.5pt; margin-top: 0.1em; }

      ul { margin: 0.3em 0; padding-left: 1.2em; }
      li { margin: 0.18em 0; }
      .pubitem { margin: 0.32em 0; font-size: 9.5pt; line-height: 1.45; }
      .pubitem .ptitle { font-weight: 500; color: var(--c-fg); }
      .pubitem .pmeta { color: var(--c-muted); font-style: italic; }

      .footer {
        text-align: center; color: var(--c-muted); font-size: 8.5pt;
        margin-top: 0.8em; border-top: 1px solid var(--c-rule); padding-top: 0.5em;
      }

      /* Print rules */
      @page {
        size: letter;
        /* Per-page margin so EVERY page (incl. p2/p3) has top+bottom whitespace,
           not just the first/last. Previous version had margin:0 on @page +
           padding on .cv, which only padded the start/end of the flow. */
        margin: 0.6in 0.65in;
      }
      @media print {
        /* Drop container padding in print — the @page margin handles whitespace now. */
        .cv { padding: 0; }
        h2 { break-after: avoid; }
        .entry, .pubitem { break-inside: avoid; }
        /* Prevent orphan/widow lines at page edges */
        p, li { orphans: 2; widows: 2; }
      }
    </style>
  </head>
  <body>
    <div class="cv">
      <!-- Header -->
      <div class="header">
        <div>
          <h1>Lu Zhang, Ph.D.</h1>
          <div class="role">张鲁 · Scientific AI Systems Engineer</div>
        </div>
        <div class="contact" style="text-align: right;">
          <a href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a><br/>
          <a href="https://sciencesloop.com/">sciencesloop.com</a><br/>
          <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en">Google Scholar</a> ·
          <a href="https://www.linkedin.com/in/lu-zhang-argonne/">LinkedIn</a> ·
          <a href="https://github.com/rockyzl">GitHub</a>
        </div>
      </div>

      <p class="summary">
        Scientific AI Systems Engineer and former Argonne battery scientist
        building AI workflow systems for scientific discovery and operational
        decision support. Combines 14+ years of Argonne energy-storage and
        materials research with current AI/ML engineering work focused on
        context engineering, evaluation harnesses, multi-agent orchestration,
        and human-in-the-loop review.
      </p>

      <div class="metrics">
        <span><b>{SCI_COUNT}</b> peer-reviewed papers</span>
        <span><b>{PUBLICATION_TOTAL}</b> publications incl. book chapters</span>
        <span><b>28</b> US patents &amp; applications</span>
        <span><b>{TALKS_TOTAL}</b> conference talks</span>
        <span><b>4,700+</b> citations</span>
        <span>h-index <b>39</b></span>
        <span><b>{FIRST_OR_CORRESP}</b> first / corresp.</span>
      </div>

      <h2>Education</h2>
      <div class="entry">
        <div class="row"><div class="title">Ph.D., Organic Chemistry — <b>Chinese Academy of Sciences</b> (Technical Institute of Physics and Chemistry)</div><div class="meta">2001 – 2006</div></div>
        <div class="body">Advisor: Prof. 李嫕 (Yi Li). Combined master/PhD program; photochemistry / organic photophysics group.</div>
      </div>
      <div class="entry">
        <div class="row"><div class="title">B.S., Chemistry — <b>Shandong University</b></div><div class="meta">1996 – 2000</div></div>
      </div>

      <h2>Professional Experience</h2>
      <div class="entry">
        <div class="row"><div class="title">Data Science Engineer — <b>American Academy of Orthopaedic Surgeons (AAOS)</b></div><div class="meta">Feb 2026 – present</div></div>
        <div class="body">Production AI workflow systems with emphasis on context engineering, evaluation harnesses, multi-agent orchestration, and human-in-the-loop review; employer-specific details intentionally omitted.</div>
      </div>
      <div class="entry">
        <div class="row"><div class="title">Senior Data Scientist — <b>Mercury Insurance</b></div><div class="meta">Nov 2024 – Jan 2026</div></div>
        <div class="body">Applied ML, analytics pipelines, and model-governance workflows.</div>
      </div>
      <div class="entry">
        <div class="row"><div class="title">Data Scientist — <b>Cincinnati Insurance</b></div><div class="meta">Aug 2023 – Nov 2024</div></div>
        <div class="body">Loss prediction and analytics platforms.</div>
      </div>
      <div class="entry">
        <div class="row"><div class="title">Chemist → Senior Chemist — <b>Argonne National Laboratory</b></div><div class="meta">Jan 2009 – Aug 2023</div></div>
        <div class="body">Total tenure 14 years 7 months. JCESR Theme Lead, Sprint team leader, Y3 milestone lead. R&amp;D 100 Award (2014).</div>
      </div>
      <div class="entry">
        <div class="row"><div class="title">Postdoctoral Researcher — <b>Florida State University</b></div><div class="meta">2006 – 2008</div></div>
        <div class="body">Department of Chemistry and Biochemistry. PI: Prof. Lei Zhu.</div>
      </div>

      <h2>Awards & Recognition</h2>
      <ul>
        <li><b>R&amp;D 100 Award (2014)</b> — for redox-shuttle additive technology (the "Oscars of Innovation"). Core inventor on lithium-battery overcharge-protection redox-shuttle patents.</li>
        <li><b>R&amp;D 100 Award Finalist (2015)</b> — for high-voltage lithium-battery fluorinated electrolyte technology.</li>
        <li>Featured in <i>Argonne Today</i>, <i>JCESR Research Highlights</i>, <i>EurekAlert</i>, <i>Tech Xplore</i>, <i>PV Magazine</i>, <i>ScienceDaily</i>.</li>
      </ul>

      <h2>Selected Publications (top 10 by citations)</h2>
      <p style="font-size: 9.5pt; color: var(--c-muted); margin: 0.2em 0 0.5em;">
        Full list of {SCI_COUNT} peer-reviewed papers + {BOOK_CHAPTER_COUNT} book chapters at <a href="https://sciencesloop.com/publications/">sciencesloop.com/publications</a>.
      </p>
      {top10.map((p) => (
        <div class="pubitem">
          <span class="ptitle">{p.title}</span>
          <span class="pmeta"> — {p.journal}, {p.year}; {p.citations} citations.</span>
          {p.role === "first" && <span style="color:#1e40af; font-weight:500;"> [first author]</span>}
          {p.role === "corresponding" && <span style="color:#4338ca; font-weight:500;"> [corresponding]</span>}
        </div>
      ))}

      <h2>Book Chapters</h2>
      {bookChapters.map((c) => (
        <div class="pubitem">
          <span class="ptitle">{c.title}</span>
          <span class="pmeta"> — in <i>{c.book}</i>, {c.publisher}, {c.year}{c.isbn ? `; ISBN ${c.isbn.split(" ")[0]}` : ""}.</span>
        </div>
      ))}

      <h2>US Patents (selected — {issued.length} issued of 28 total)</h2>
      {top10Patents.map((p) => (
        <div class="pubitem">
          <span class="ptitle">{p.patent_no}</span>
          <span class="pmeta"> — {p.title_en} ({p.year}). Inventors: {p.inventors}.</span>
        </div>
      ))}

      <h2>Funded Research Projects (selected)</h2>
      {allProjects.slice(0, 6).map((p) => (
        <div class="entry">
          <div class="row"><div class="title">{p.name}</div><div class="meta">{p.years}</div></div>
          <div class="body">{p.funder} · {p.role}</div>
        </div>
      ))}

      <h2>Invited Talks (top 8)</h2>
      {invitedData.talks.slice(0, 8).map((talk) => (
        <div class="pubitem">
          <span class="ptitle">{talk.title}</span>
          <span class="pmeta"> — {talk.venue}, {talk.location}, {talk.year}.</span>
        </div>
      ))}

      <h2>Service & Peer Review</h2>
      <ul>
        <li><b>Co-author, DOE Flow Batteries Technology Strategy Assessment</b> (2023) — long-duration storage roadmap.</li>
        <li>Storage Innovations 2030 contributor (DOE framework, 2022).</li>
        <li>JCESR Theme / Sprint team leadership (3 universities + 2 national labs, 2015 – 2017).</li>
        <li>JCESR 2.0 self-reporting redoxmer Y3 milestone leader (2020).</li>
        <li><b>DOE SBIR Reviewer</b> (2013 – 2022, 10 years).</li>
        <li><b>NSF Review Panel for Energy Systems</b> (2019).</li>
        <li><b>DOE Energy Storage Innovations Prize Reviewer</b> (2023).</li>
        <li>Reviewer for 10+ international journals: J. Power Sources, ACS Energy Lett., Chem. Commun., Adv. Energy Mater., Nano Energy, J. Mater. Chem. A, Chemistry of Materials, ChemSusChem, Electrochim. Acta, ACS Appl. Energy Mater.</li>
      </ul>

      <h2>Mentorship</h2>
      <p style="font-size: 9.5pt; margin: 0.2em 0 0.4em;">
        Direct mentees at ANL (2013 – 2023): <b>{postdocList.length} postdoctoral fellows + {studentList.length} graduate students</b> ({postdocList.length + studentList.length} total).
      </p>
      <p style="font-size: 9.5pt; margin: 0.2em 0 0.4em;">
        <b>Postdocs:</b> {postdocNames}.
      </p>
      <p style="font-size: 9.5pt; margin: 0.2em 0 0.4em;">
        <b>Graduate students</b> (advised or co-advised; several were later co-advised with Xiaoliang Wei @ Purdue, Lei Zhu @ FSU, Shrayesh Patel @ UChicago): {studentNames}.
      </p>
      <p style="font-size: 9.5pt; margin: 0.2em 0 0.4em;">
        Other current placements: Tesla (Sisi Jiang, Quinton J. Meisner), Factorial Energy (Zhangxing Shi), Wildcat Discovery Technologies (Jinhua Huang), Living Proof Inc. (Jingjing Zhang), CNPC JICHAI POWER (Yuyue Zhao), ORNL (Bin Hu), ANL CSE Division Assistant Chemist + 2021 Argonne Postdoc Performance Award (Lily A. Robertson). Cross-institution JCESR Sprint teams spanned MIT, PNNL, UIUC, UMichigan, Purdue.
      </p>

      <div class="footer">
        Curriculum Vitae · Lu Zhang ·
        Generated {today} from <a href="https://sciencesloop.com/">sciencesloop.com</a>
      </div>
    </div>
  </body>
</html>
