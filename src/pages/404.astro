---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { detectLocale } from "../lib/i18n";

const locale = detectLocale(Astro.url.pathname);
const isZh = locale === "zh";

const links = [
  { href: "/about/",        en: "About",         zh: "简介" },
  { href: "/programs/",     en: "Programs",      zh: "研究方向" },
  { href: "/approach/",     en: "Approach",      zh: "方法" },
  { href: "/evolution/",    en: "Evolution",     zh: "演化" },
  { href: "/publications/", en: "Publications",  zh: "论文" },
  { href: "/patents/",      en: "Patents",       zh: "专利" },
  { href: "/awards/",       en: "Awards",        zh: "荣誉" },
];
---
<Base title="404 — Lu Zhang">
  <div class="container" style="padding: 5rem 0; text-align: center;">
    <div style="font-family: var(--font-serif); font-size: 6rem; font-weight: 600; color: var(--c-accent); line-height: 1; margin-bottom: 0.5rem;">
      404
    </div>
    <h1 style="margin-top: 0.5rem;">
      {isZh ? "页面跑丢了" : "Page not found"}
    </h1>
    <p class="lead" style="max-width: 520px; margin: 1rem auto;">
      {isZh
        ? "这条 URL 不存在或者已经搬走了。也可能是你打错了字。下面是几条常用入口："
        : "The URL you tried doesn't exist, or it moved. You may have typed it wrong. Some likely starting points:"}
    </p>

    <div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; margin: 2rem 0;">
      <a class="btn btn-primary" href={u(isZh ? "/zh/" : "/")}>
        {isZh ? "← 回首页" : "← Home"}
      </a>
      {links.map((l) => (
        <a class="btn btn-ghost" href={u((isZh ? "/zh" : "") + l.href)}>
          {isZh ? l.zh : l.en}
        </a>
      ))}
    </div>

    <p style="color: var(--c-muted); font-size: 0.9rem; margin-top: 3rem;">
      {isZh
        ? "或者用顶部导航或联系："
        : "Or use the top nav, or reach me at "}
      <a href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a>
    </p>
  </div>
</Base>
