---
import Base from "../../layouts/Base.astro";
import { detectLocale, t } from "../../lib/i18n";
import conferences from "../../data/conferences.json";
import invitedData from "../../data/invited_talks.json";

const locale = detectLocale(Astro.url.pathname);
const invited = invitedData.talks.sort((a, b) => b.year - a.year);
const sortedConf = [...conferences].sort((a, b) => b.year - a.year);

// Search-fallback URLs so every entry is clickable even without a stored URL.
const talkUrl = (t) =>
  t.url ?? `https://scholar.google.com/scholar?q=${encodeURIComponent(`${t.title} ${t.venue} Lu Zhang Argonne`)}`;
const confUrl = (c) =>
  c.url ?? `https://scholar.google.com/scholar?q=${encodeURIComponent(`${c.title} ${c.venue} Lu Zhang Argonne`)}`;
---
<Base title={(locale === "zh" ? "报告 — " : "Talks — ") + "张鲁 Lu Zhang"}>
  <div class="container" style="padding-top: 3rem;">
    <span class="eyebrow">{invited.length} invited · {conferences.length} abstracts</span>
    <h1>{t("page.talks.title", locale)}</h1>
    <p class="lead">{t("page.talks.lead", locale)}</p>

    <div class="section-head">
      <h2 style="margin:0;">{t("page.talks.invited", locale)} ({invited.length})</h2>
      <span class="more">2012 – 2024</span>
    </div>
    {invited.map((t) => (
      <div class="entry">
        <div class="title"><a href={talkUrl(t)} target="_blank" rel="noopener">{t.title}</a></div>
        <div class="meta">
          <strong style="color: var(--c-fg);">{t.venue}</strong>
          {" · "}{t.location}{" · "}{t.year}
          <span class="badge" style={`background: ${t.type.toLowerCase().includes("invited") || t.type.toLowerCase().includes("featured") ? "#dbeafe" : "#f1f5f9"}; color: ${t.type.toLowerCase().includes("invited") || t.type.toLowerCase().includes("featured") ? "#1e40af" : "#475569"};`}>{t.type}</span>
        </div>
      </div>
    ))}

    <div class="section-head" style="margin-top: 3rem;">
      <h2 style="margin:0;">{t("page.talks.abstracts", locale)} ({conferences.length})</h2>
      <span class="more">{t("section.recent.note", locale)}</span>
    </div>
    {sortedConf.map((c) => (
      <div class="entry">
        <div class="title"><a href={confUrl(c)} target="_blank" rel="noopener">{c.title}</a></div>
        <div class="meta">{c.venue} · {c.year}{c.citations ? ` · ${c.citations} citations` : ""}</div>
      </div>
    ))}

  </div>
</Base>
