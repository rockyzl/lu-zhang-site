---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url";
import { getBlogPosts } from "../../lib/blog";

const posts = getBlogPosts("zh");
---

<Base
  title="研究笔记 — SciencesLoop"
  description="SciencesLoop 关于 scientific agents、科学工作流、RAG、evaluation 和 AI for Science infrastructure 的研究笔记。"
>
  <div class="container">
    <section class="page-hero compact">
      <span class="eyebrow">研究笔记 · AI agents · 科学工作流</span>
      <h1>SciencesLoop 研究笔记</h1>
      <p class="lead">
        记录 Scientific AI 系统构建过程中的观察：agent 工作流、科学状态、RAG、evaluation、开放问题，以及电池材料研究与应用 AI infrastructure 的连接。
      </p>
    </section>

    <div class="blog-grid">
      {posts.map((post) => (
        <article class="blog-card">
          <div class="blog-card-meta">
            <time datetime={post.dateLabel}>{post.dateLabel}</time>
            <span>{post.status ?? "note"}</span>
          </div>
          <h2><a href={u(`/zh/blog/${post.slug}/`)}>{post.title}</a></h2>
          <p>{post.description}</p>
          <div class="blog-tags">
            {post.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">研究笔记流程</span>
        <h2>从观察到公开笔记</h2>
        <p>
          新文章是 <code>src/blog</code> 下的 Markdown 文件。
          用脚本生成带日期和 frontmatter 的草稿，再编辑正文并提交。
        </p>
      </div>
      <pre><code>npm run new:post -- --title "My AI agent note"</code></pre>
    </section>
  </div>
</Base>
