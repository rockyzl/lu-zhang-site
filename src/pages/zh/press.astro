---
import Base from "../../layouts/Base.astro";
import { detectLocale, t } from "../../lib/i18n";
import press from "../../data/press.json";

const locale = detectLocale(Astro.url.pathname);
const dated = press.items.filter((p) => p.date !== "—");
const profiles = press.items.filter((p) => p.date === "—");
dated.sort((a, b) => (b.date > a.date ? 1 : -1));
---
<Base title={(locale === "zh" ? "媒体 — " : "Press — ") + "Lu Zhang"}>
  <div class="container" style="padding-top: 3rem;">
    <span class="eyebrow">{t("page.press.eyebrow", locale)}</span>
    <h1>{t("page.press.title", locale)}</h1>
    <p class="lead">{t("page.press.lead", locale)}</p>

    <div class="section-head">
      <h2 style="margin:0;">{t("page.press.news", locale)}</h2>
      <span class="more">{t("section.recent.note", locale)}</span>
    </div>
    {dated.map((p) => (
      <article class="entry">
        <div class="title">
          <a href={p.url} target="_blank" rel="noopener">{p.title}</a>
        </div>
        <div class="meta">
          <strong style="color: var(--c-fg);">{p.outlet}</strong>
          {" · "}{p.date}
          <span class="badge" style="background: #e3f1ee; color: #2d5d5e;">{p.type}</span>
        </div>
        <div class="meta" style="margin-top: 0.4rem;">{p.summary}</div>
      </article>
    ))}

    <div class="section-head" style="margin-top: 3rem;">
      <h2 style="margin:0;">{t("page.press.profiles", locale)}</h2>
    </div>
    {profiles.map((p) => (
      <div class="entry">
        <div class="title">
          <a href={p.url} target="_blank" rel="noopener">{p.title}</a>
        </div>
        <div class="meta"><strong style="color: var(--c-fg);">{p.outlet}</strong></div>
        <div class="meta" style="margin-top: 0.4rem;">{p.summary}</div>
      </div>
    ))}

    <p style="color: var(--c-muted); font-size: 0.9rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--c-border-soft);">
      List compiled from public web search and Argonne's own press archive.
      Major omissions or new coverage to add? File an issue at the
      <a href="https://github.com/rockyzl/lu-zhang-site">GitHub repo</a>.
    </p>
  </div>
</Base>
