---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url";
import { detectLocale } from "../../lib/i18n";
import { liveDemos } from "../../data/demos";

const locale = detectLocale(Astro.url.pathname);
const isZh = locale === "zh";
const lp = isZh ? "/zh" : "";

const badgeClass = (status) => {
  const s = (status || "").toLowerCase();
  if (s.includes("demo") || s.includes("live") || s.includes("在线")) return "demo";
  if (s.includes("public") || s.includes("repo") || s.includes("公开") || s.includes("仓库")) return "repo";
  return "priv";
};

// Lab is a curated research map, not a mirror of every public demo. Keep the
// selection explicit by stable registry ID, while deriving public copy and
// routes from the shared demo registry.
const MOLECULAR_DEMO_IDS = [
  "chemgraph-loop",
  "molecular-property-predictor",
  "redox-rfb-predictor",
  "molecular-discovery-workflow",
];
const TRUSTWORTHY_AI_DEMO_IDS = [
  "condition-monitoring",
  "kit-battery-early-warning",
  "preventive-health-model-lab",
  "guidelinebench-oa",
];

const registryDemoCards = (ids: string[]) => ids.flatMap((id) => {
  const demo = liveDemos.find((candidate) => candidate.id === id);
  if (!demo) return [];
  return [{
    name: isZh ? demo.title.zh : demo.title.en,
    tagline_en: demo.tagline.en,
    tagline_zh: demo.tagline.zh,
    desc_en: demo.summary.en,
    desc_zh: demo.summary.zh,
    status_en: "Live demo",
    status_zh: "在线 Demo",
    tags: demo.tags,
    href: u(`${lp}${demo.path}`),
    external: false,
    cta_en: "Try the live demo",
    cta_zh: "试用 Demo",
  }];
});

// The two long-term lines ("rivers"). Public-safe by construction: cards link
// only to live demos or public repos. Private work may have a high-level
// project summary, but never a repository link.
const rivers = [
  {
    key: "molecular-discovery",
    name_en: "AI-assisted molecular discovery",
    name_zh: "AI 辅助分子发现",
    star_en: "Toward a trustworthy, reproducible system that reasons about molecular properties — from agentic chemistry workflows to foundation-model benchmarks to redox / battery-relevant candidates.",
    star_zh: "朝着一个可信、可复现、能对分子性质做推理的系统 —— 从 agentic 化学工作流，到基础模型 benchmark，再到氧化还原 / 电池相关候选分子。",
    items: [
      ...registryDemoCards(MOLECULAR_DEMO_IDS),
      {
        name: "Property-Aware Molecular Discovery Agent",
        tagline_en: "A forward/reverse molecular-discovery core",
        tagline_zh: "正向/反向分子发现内核",
        desc_en: "An early Python-first core organized around forward and reverse workflows — molecule→property dossier and target-property→candidate discovery — architected around a Query Planner, Skill Registry, and Evidence Objects rather than treating LLM output as scientific truth.",
        desc_zh: "一个 Python-first 的早期内核，围绕正向与反向工作流组织 —— 分子→性质档案、目标性质→候选发现 —— 架构围绕 Query Planner、Skill Registry 与 Evidence Objects，而不是把 LLM 输出当作科学真理。",
        status_en: "Early independent prototype",
        status_zh: "早期独立原型",
        tags: ["query planner", "skill registry", "evidence objects"],
        href: null,
        external: false,
        cta_en: null,
        cta_zh: null,
      },
      {
        name: "Scientific Foundation Model Lab",
        tagline_en: "Training and understanding scientific foundation models",
        tagline_zh: "训练与理解科学基础模型",
        desc_en: "A hands-on lab for training and understanding scientific foundation models — representation learning, property prediction, and model-literacy tooling.",
        desc_zh: "一个动手的实验室，用于训练和理解科学基础模型 —— 表示学习、性质预测，以及模型素养工具。",
        status_en: "Public repository",
        status_zh: "公开仓库",
        tags: ["foundation models", "representation learning"],
        href: "https://github.com/rockyzl/scientific-foundation-model-lab",
        external: true,
        cta_en: "See on GitHub",
        cta_zh: "在 GitHub 查看",
      },
    ],
  },
  {
    key: "trustworthy-ai",
    name_en: "Trustworthy & evaluable scientific AI",
    name_zh: "可信、可评估的科学 AI",
    star_en: "The layer below the science: when can you trust a result? Evaluation harnesses, honest limitation boundaries, deterministic reproducibility, and human-in-the-loop gates — the method that makes the discovery work above credible.",
    star_zh: "科学下面那一层：结果什么时候能信？评估 harness、诚实的局限边界、确定性可复现，以及人在环把关 —— 让上面那条发现之河可信的方法。",
    items: [
      {
        name: "Scientific Agent Lab",
        tagline_en: "An evaluation & reproducibility layer for scientific AI",
        tagline_zh: "科学 AI 的评估与可复现层",
        desc_en: "Not a science assistant but the layer below it — the “when can you trust the result?” spine. A deterministic, zero-dependency pipeline that separates evidence from assumptions, flags missing required data, refuses to conclude on gaps, and ships a reproducible, harness-scored trace. No LLM in the loop.",
        desc_zh: "不是科学助手，而是它下面那一层 —— 回答“结果什么时候能信”的骨架。一个确定性、零依赖的管道：把证据和假设分开、标出缺失的必需数据、证据不全时拒绝下结论，并交出可复现、可被评估 harness 打分的轨迹。全程无 LLM。",
        status_en: "Public repository",
        status_zh: "公开仓库",
        tags: ["evaluation harness", "reproducibility", "deterministic · no LLM"],
        href: "https://github.com/rockyzl/scientific-agent-lab",
        external: true,
        cta_en: "See on GitHub",
        cta_zh: "在 GitHub 查看",
      },
      ...registryDemoCards(TRUSTWORTHY_AI_DEMO_IDS),
    ],
  },
];
---
<Base
  title={(isZh ? "The Lab — 张鲁 Lu Zhang" : "The Lab — Lu Zhang") + " · SciencesLoop"}
  description={isZh
    ? "我在建什么：两条长期主线 —— AI 辅助分子发现，以及可信、可评估的科学 AI。可公开的项目会链接到在线 Demo 或公开仓库；早期原型只展示高层说明。"
    : "What I'm building: two long-term lines — AI-assisted molecular discovery, and trustworthy, evaluable scientific AI. Public projects link to a live demo or repository; early prototypes appear as high-level summaries."}
>
  <div class="container" style="padding-top: 3rem;">
    <span class="eyebrow">{isZh ? "我在建什么" : "What I'm building"}</span>
    <h1>{isZh ? "实验室" : "The Lab"}</h1>
    <p class="lead">
      {isZh
        ? "我的工作沿两条长期主线展开。一条是把东西造出来，一条是证明它何时可信 —— 后者是把前者做扎实的方法。项目会来会走；这两条河不会。可公开的项目可点开在线 Demo 或公开仓库；早期原型只保留高层说明。"
        : "My work runs along two long-term lines. One builds things; one proves when they can be trusted — and the second is the method that makes the first credible. Projects come and go; these two rivers don't. Public projects below link to live demos or repositories; early prototypes remain high-level summaries."}
    </p>
    <p style="color: var(--c-muted); font-size: 0.95rem; margin-top: 0.6rem;">
      {isZh ? "想看完整的项目分组？" : "Want the full grouped portfolio?"}
      {" "}
      <a class="more" href={u(`${lp}/projects/`)}>{isZh ? "全部项目 →" : "All projects →"}</a>
    </p>

    {rivers.map((r, ri) => (
      <section style="margin-top: 3rem;">
        <div class="section-head">
          <div class="section-title">
            <span class="eyebrow">{`0${ri + 1} — ` + (isZh ? "主线" : "River")}</span>
            <h2 style="margin: 0;">{isZh ? r.name_zh : r.name_en}</h2>
          </div>
          <span class="more">{r.items.length}</span>
        </div>
        <p style="color: var(--c-muted); font-size: 0.98rem; margin-top: -0.3rem; max-width: 70ch;">{isZh ? r.star_zh : r.star_en}</p>
        <div class="featured-grid">
          {r.items.map((p) => {
            const Outer = p.href ? "a" : "div";
            const outerProps = p.href
              ? (p.external
                  ? { href: p.href, target: "_blank", rel: "noopener", class: "project-card" }
                  : { href: p.href, class: "project-card" })
              : { class: "project-card" };
            const status = isZh ? p.status_zh : p.status_en;
            const cta = isZh ? p.cta_zh : p.cta_en;
            return (
              <Outer {...outerProps}>
                <span class={`badge ${badgeClass(status)}`}>● {status}</span>
                <div class="name">{p.name}</div>
                <div class="tagline">{isZh ? p.tagline_zh : p.tagline_en}</div>
                <div class="description">{isZh ? p.desc_zh : p.desc_en}</div>
                {cta && <div class="links">{cta} ↗</div>}
                <div class="tags">
                  {p.tags.map((tg) => <span class="tag">{tg}</span>)}
                </div>
              </Outer>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
