---
import Base from "../../layouts/Base.astro";
import ScienceArt from "../../components/ScienceArt.astro";
import { u } from "../../lib/url";
import { detectLocale, t } from "../../lib/i18n";

const locale = detectLocale(Astro.url.pathname);
const isZh = locale === "zh";

const education = isZh
  ? [
      "博士 · 有机化学 — 中国科学院 (2001 – 2006)。硕博连读阶段 2001 – 2004。",
      "学士 · 化学 — 山东大学 (1996 – 2000)",
    ]
  : [
      "Ph.D., Organic Chemistry — Chinese Academy of Sciences (2001 – 2006). Master's stage 2001 – 2004 under combined master/PhD program.",
      "B.S., Chemistry — Shandong University (1996 – 2000)",
    ];

const career = isZh
  ? [
      ["数据科学工程师", "AAOS（美国骨科医师学会）", "2026年2月 – 至今"],
      ["高级数据科学家", "Mercury Insurance（水星保险）", "2024年11月 – 2026年1月"],
      ["数据科学家", "Cincinnati Insurance（辛辛那提保险）", "2023年8月 – 2024年11月"],
      ["化学家 → 资深化学家", "Argonne National Laboratory（阿贡国家实验室）", "2009 – 2023"],
      ["博士后研究员", "Argonne National Laboratory", "2008 – 2009"],
      ["博士后研究员", "Florida State University（佛罗里达州立大学）", "2006 – 2008"],
    ]
  : [
      ["Data Science Engineer", "AAOS", "Feb 2026 – present"],
      ["Senior Data Scientist", "Mercury Insurance", "Nov 2024 – Jan 2026"],
      ["Data Scientist", "Cincinnati Insurance", "Aug 2023 – Nov 2024"],
      ["Chemist → Senior Chemist", "Argonne National Laboratory", "2009 – 2023"],
      ["Postdoctoral Fellow", "Argonne National Laboratory", "2008 – 2009"],
      ["Postdoctoral Researcher", "Florida State University", "2006 – 2008"],
    ];

// Detailed Recognition lists used to live here but were consolidated
// onto /awards/. About-page Recognition is now a 1-paragraph summary
// + cross-link.
---
<Base title={isZh ? "简介 — 张鲁" : "About — Lu Zhang"}>
  <div class="container" style="padding-top: 3rem;">
  <div style="display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; align-items: start;" class="about-hero">
    <div class="portrait square">
      <ScienceArt class="science-art" />
      <span class="placeholder-hint">{t("home.portrait.hint", locale)}</span>
      <img src={u("/images/portrait.jpg")} alt="Lu Zhang" onerror="this.remove()" />
    </div>
    <div>
      <span class="eyebrow">{t("about.eyebrow", locale)}</span>
      <h1 style="margin-top: 0;">{isZh ? "张鲁" : "Lu Zhang"}</h1>
      <p style="color: var(--c-muted); font-size: 1.1rem; margin-top: -0.4rem; margin-bottom: 1.2rem;">
        {isZh ? "Lu Zhang, Ph.D." : "张鲁, Ph.D."}
      </p>
      <p class="lead">{t("about.lead", locale)}</p>
      <p style="color: var(--c-muted); font-size: 0.95rem; margin-top: 1rem;">
        {t("about.based", locale)} <a href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a>。
      </p>
      <p style="margin-top: 1rem;">
        <a class="btn btn-primary" href={u("/files/Lu_Zhang_CV.pdf")} target="_blank" rel="noopener">
          {isZh ? "↓ 下载简历 (PDF)" : "↓ Download CV (PDF)"}
        </a>
      </p>
    </div>
  </div>
  <style>
    @media (max-width: 640px) {
      .about-hero { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
      .about-hero .portrait.square { max-width: 200px; }
    }
  </style>

  <h2>{t("about.education", locale)}</h2>
  <ul>{education.map((e) => <li set:html={e.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")}></li>)}</ul>

  <h2>{t("about.career", locale)}</h2>
  <ul>
    {career.map(([title_, org, when]) => (
      <li><strong>{title_}</strong>, {org} ({when})</li>
    ))}
  </ul>

  <h2>{t("about.recognition", locale)}</h2>
  <p style="font-size: 1rem; color: var(--c-fg);">
    {isZh
      ? "2014 年 R&D 100 大奖获得者（氧化还原穿梭剂技术），2015 年 Finalist。DOE Flow Battery Strategy Assessment 共同作者，JCESR Theme Lead，DOE SBIR / NSF / DOE ES Prize 评审专家，10+ 期刊审稿人。"
      : "R&D 100 Award (2014, redox-shuttle technology) and Finalist (2015). Co-author of DOE Flow Batteries Strategy Assessment, JCESR Theme Lead, DOE SBIR / NSF / DOE ES Prize panel reviewer, peer reviewer for 10+ journals."}
  </p>
  <p style="font-size: 0.95rem; color: var(--c-muted); margin-top: 0.6rem;">
    <strong style="color: var(--c-fg);">99</strong> {isZh ? "项论著（97 SCI + 2 章著作）" : "publications (97 SCI + 2 book chapters)"} ·
    <strong style="color: var(--c-fg);">28</strong> {isZh ? "项美国专利及申请" : "US patents & applications"} ·
    <strong style="color: var(--c-fg);">13</strong> {isZh ? "次特邀报告" : "invited talks"} ·
    <strong style="color: var(--c-fg);">180</strong> {isZh ? "位独立合作者" : "unique collaborators"} ·
    h-index <strong style="color: var(--c-fg);">39</strong> ·
    4,700+ {isZh ? "总被引" : "citations"}
  </p>
  <p style="margin-top: 1rem;">
    <a href={isZh ? "/zh/awards/" : "/awards/"} style="font-weight: 500;">
      {isZh ? "→ 查看完整荣誉与认可（含所有链接）" : "→ See full Awards & Recognition page (all links)"}
    </a>
  </p>

  <h2>{t("about.contact", locale)}</h2>
  <p>
    <a href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a> ·
    <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en">Google Scholar</a> ·
    <a href="https://github.com/rockyzl">GitHub</a> ·
    <a href="https://www.linkedin.com/in/lu-zhang-argonne/">LinkedIn</a>
  </p>
  </div>
</Base>
