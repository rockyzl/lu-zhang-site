---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url";
import { detectLocale, t } from "../../lib/i18n";
import aiProjects from "../../data/ai_projects.json";

const locale = detectLocale(Astro.url.pathname);

const industrial = [
  {
    name: "AAOS — Data Science Engineer",
    period: "Feb 2026 – present",
    note: "AAOS 的企业数据 / AI 工作流工具；公开页面仅保留高层信息。",
  },
  {
    name: "Mercury Insurance — Senior Data Scientist",
    period: "Nov 2024 – Jan 2026",
    note: "应用机器学习、分析管线和模型治理工作流。",
  },
  {
    name: "Cincinnati Insurance — Data Scientist",
    period: "Aug 2023 – Nov 2024",
    note: "Loss prediction and analytics platforms.",
  },
];
const workflow = [
  {
    step: "Scan",
    title: "跟踪 AI 研究信号",
    text: "收集选定 AI 实验室、AI for Science 创业公司、研究 feed 和技术博客的更新。",
  },
  {
    step: "Filter",
    title: "映射到科研工作流",
    text: "把普通模型新闻和真正相关的 agent、RAG、evaluation、simulation、robotic lab、科学决策支持信号分开。",
  },
  {
    step: "Build",
    title: "把强信号做成原型",
    text: "用小 demo 或 notebook 测试某个模式是否能帮助科学导航、formulation、证据审阅或 workflow automation。",
  },
  {
    step: "Publish",
    title: "发布带来源的工作笔记",
    text: "把有价值的发现整理成公开安全的文章，保留来源链接、开放问题和 SciencesLoop 视角。",
  },
];

const researchPrograms = [
  {
    name: "Scientific Workflow",
    label: "Program 01",
    text: "研究如何把科学问题转成可检查的 agent workflow：工具路由、状态、评估门、人工 review 和闭环执行。",
  },
  {
    name: "Scientific State",
    label: "Program 02",
    text: "研究 scientific memory、文献证据、实验上下文、provenance 和 workflow state，让科学决策不是一次性回答。",
  },
  {
    name: "Scientific Foundation Models",
    label: "Program 03",
    text: "跟踪和实验表示学习、分子/性质模型、溶解度、电池材料模型，以及 foundation-model 方法在科学系统中的作用。",
  },
  {
    name: "Scientific Discovery",
    label: "Program 04",
    text: "把 flow battery、property prediction、benchmark graph 和未来 self-driving-lab 接口作为 discovery sandbox。",
  },
];
---
<Base
  title="研究方向 — SciencesLoop"
  description="SciencesLoop 的四个 Scientific AI 研究方向：Scientific Workflow、Scientific State、Scientific Foundation Models 和 Scientific Discovery。"
>
  <div class="container">

    <section style="padding: 3rem 0 1rem;">
      <span class="eyebrow">SciencesLoop 研究方向</span>
      <h1>四个 Scientific AI 研究方向</h1>
      <p class="lead" style="font-size: 1.1rem; color: var(--c-fg); max-width: 760px;">
        SciencesLoop 不只是项目集合，而是一个开放研究实验室：围绕
        scientific workflow、scientific state、foundation models 和
        discovery systems 持续积累软件、笔记和实验。
      </p>
    </section>

    <section class="product-modules" aria-label="SciencesLoop research programs">
      {researchPrograms.map((item) => (
        <article class="product-module">
          <span>{item.label}</span>
          <h2>{item.name}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="lab-manifesto" aria-label="Research manifesto">
      <div>
        <span class="eyebrow">研究宣言</span>
        <h2>Scientific AI 不是问答界面。</h2>
      </div>
      <div>
        <p>
          SciencesLoop 的目标不是让 AI 直接回答科学问题，而是构建帮助科学家提出更好问题、
          设计更好实验、做出更好决策的科学基础设施。
        </p>
      </div>
    </section>

    <section class="workflow-steps" aria-label="SciencesLoop workflow">
      {workflow.map((item) => (
        <article>
          <span>{item.step}</span>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">Daily workflow</span>
        <h2>AI research radar → post → prototype</h2>
        <p>
          发布流程从自动收集来源开始，然后加入人工判断：这个信号为什么重要，
          它对 scientific agents 有什么影响，是否值得做成 SciencesLoop demo。
        </p>
      </div>
      <p>
        公开输出是研究笔记、小型原型和带来源的研究地图；内部脚本和 review log
        不进入公开正文。
      </p>
    </section>

    <div class="section-head">
      <h2>Agent and AI systems</h2>
      <span class="more">{aiProjects.length}</span>
    </div>
    <div class="featured-grid">
      {aiProjects.map((p) => {
        const linkHref = p.site ?? p.repo ?? null;
        const Outer = linkHref ? "a" : "div";
        const outerProps = linkHref
          ? { href: linkHref, target: "_blank", rel: "noopener", class: "project-card" }
          : { class: "project-card" };
        return (
          <Outer {...outerProps}>
            {p.image ? (
              <div class="cover"><img src={u(p.image)} alt={p.name} loading="lazy" /></div>
            ) : (
              <div class={`cover gradient ${p.gradient ?? "from-rust to-amber"}`}>
                <span class="glyph">{p.name}</span>
              </div>
            )}
            <div class="body">
              <div class="name">{p.name}</div>
              <div class="tagline">{p.tagline}</div>
              <div class="description">{p.description}</div>
              <div class="status">{p.status}</div>
              <div class="tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              {(p.site || p.repo) && (
                <div style="margin-top: 0.5rem; display: flex; gap: 0.6rem; font-size: 0.85rem;">
                  {p.site && <span style="color: var(--c-accent); font-weight: 500;">↗ Live site</span>}
                  {p.repo && <span style="color: var(--c-muted);">⌗ Source</span>}
                </div>
              )}
            </div>
          </Outer>
        );
      })}
    </div>

    <p style="color: var(--c-muted); font-size: 0.9rem; margin-top: 1.5rem;">
      More tools and experiments live on
      <a href="https://github.com/rockyzl">github.com/rockyzl</a>
      — primarily personal Claude Code skills, RAG / agent prototypes, and
      research scripts. They are not productized and not listed here.
    </p>

    <div class="section-head">
      <h2>{t("page.ai.industrial", locale)}</h2>
    </div>
    {industrial.map((p) => (
      <div class="entry">
        <div class="title">{p.name}</div>
        <div class="meta"><strong style="color: var(--c-fg);">{p.period}</strong> — {p.note}</div>
      </div>
    ))}

  </div>
</Base>
