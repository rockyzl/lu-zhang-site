---
import Base from "../../../layouts/Base.astro";
import ArticleComments from "../../../components/ArticleComments.astro";
import { u } from "../../../lib/url";
import { getBlogPosts } from "../../../lib/blog";

export function getStaticPaths() {
  return getBlogPosts("zh").map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = post.module;
const enSlug = post.slug.endsWith("-zh") ? post.slug.slice(0, -3) : post.slug;
const enAlternate = getBlogPosts("en").find((candidate) => candidate.slug === enSlug);
const alternatePath = enAlternate ? u(`/blog/${enAlternate.slug}/`) : undefined;
---

<Base title={`${post.title} — SciencesLoop`} description={post.description} alternatePath={alternatePath}>
  <article class="container blog-post">
    <a class="back-link" href={u("/zh/blog/")}>← 写作</a>
    <header class="blog-post-header">
      <div class="blog-card-meta">
        <time datetime={post.dateLabel}>{post.dateLabel}</time>
        <span>{post.status ?? "note"}</span>
      </div>
      <h1>{post.title}</h1>
      <p>{post.description}</p>
      <div class="blog-tags">
        {post.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <ArticleComments post={post} locale="zh" />
  </article>
</Base>
