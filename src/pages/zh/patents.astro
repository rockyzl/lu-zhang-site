---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url";
import { detectLocale, t } from "../../lib/i18n";
import patents from "../../data/patents.json";
import extra from "../../data/patents_extra.json";

const locale = detectLocale(Astro.url.pathname);

// Merge core 23 + 2 continuation patents → 25 issued total
const issued = [
  ...patents,
  ...extra.issued_continuations.map((p) => ({
    patent_no: p.patent_no,
    year: p.year,
    topic: p.topic,
    title_en: p.title_en,
    title_cn: p.title_cn,
    inventors: p.inventors,
    note: p.note,
  })),
];

const byTopic = issued.reduce((acc, p) => {
  (acc[p.topic] = acc[p.topic] || []).push(p);
  return acc;
}, {});

const ISSUED = issued.length;
const APPS = extra.published_applications.length + extra.internal_applications.length;
const TOTAL = ISSUED + APPS;
---
<Base title={(locale === "zh" ? "专利 — " : "Patents — ") + "Lu Zhang"}>
  <div class="container" style="padding-top: 3rem;">
    <span class="eyebrow">{TOTAL} total · {ISSUED} issued · {APPS} pending</span>
    <h1>{t("page.patents.title", locale)}</h1>
    <p class="lead">{t("page.patents.lead", locale)}</p>

    <h2 style="margin-top: 3rem;">{t("page.patents.issued", locale)} ({ISSUED})</h2>
    {Object.entries(byTopic).map(([topic, items]) => (
      <section>
        <h3 style="margin-top: 2rem;">{topic} <span style="color: var(--c-muted); font-weight: 400; font-size: 0.85em;">({items.length})</span></h3>
        {items.sort((a, b) => b.year - a.year).map((p) => (
          <div class="entry">
            <div class="title">
              <a href={`https://patents.google.com/patent/${p.patent_no.replace(/\s|,/g, "")}`}>{p.patent_no}</a>
              <span style="color: var(--c-muted); font-weight: 400;"> ({p.year})</span>
              {p.note && <span class="badge" style="background: #dbeafe; color: #1e40af;">continuation</span>}
            </div>
            <div class="meta">{p.title_en}</div>
            <div class="meta" style="font-style: italic;">Inventors: {p.inventors}</div>
          </div>
        ))}
      </section>
    ))}

    <h2 style="margin-top: 3rem;">{t("page.patents.published", locale)} ({extra.published_applications.length})</h2>
    {extra.published_applications.map((a) => (
      <div class="entry">
        <div class="title">
          <a href={a.link}>{a.app_no}</a>
          <span style="color: var(--c-muted); font-weight: 400;"> ({a.year})</span>
          <span class="badge" style={`background: ${a.status === 'Pending' ? '#cffafe' : '#f1f5f9'}; color: ${a.status === 'Pending' ? '#155e75' : '#475569'};`}>{a.status.toLowerCase()}</span>
        </div>
        <div class="meta">{a.title_en}</div>
        <div class="meta" style="font-style: italic;">Inventors: {a.inventors}</div>
        <div class="meta">Filing no.: {a.filing_no} · Topic: {a.topic}</div>
      </div>
    ))}

    <h2 style="margin-top: 3rem;">{t("page.patents.draft", locale)} ({extra.internal_applications.length})</h2>
    {extra.internal_applications.map((a) => (
      <div class="entry">
        <div class="title">
          {a.name}
          <span style="color: var(--c-muted); font-weight: 400;"> ({a.year})</span>
          <span class="badge" style="background: #f1f5f9; color: #475569;">non-provisional</span>
        </div>
        <div class="meta">{a.title_en}</div>
        <div class="meta">Provisional: {a.provisional_no}. {a.status}.</div>
        <div class="meta" style="font-style: italic;">Inventors: {a.inventors}</div>
        <div class="meta">{a.note}</div>
      </div>
    ))}

    <p style="color: var(--c-muted); font-size: 0.9rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--c-border-soft);">
      All patent records cross-referenced against USPTO and OSTI. Source
      data lives in a private patent ledger maintained alongside the
      application materials.
    </p>
  </div>
</Base>
