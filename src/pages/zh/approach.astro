---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url";
const gates = [["来源门控", "输入能否被识别、版本化，并追溯到允许的来源？"], ["质量门控", "证据是否达到声明的完整性与质量阈值？"], ["不确定性门控", "置信度是否足以支撑本次决策，还是系统应该拒答？"], ["批准门控", "拟议动作是否必须经过明确的人工复核？"]];
---
<Base title="方法 — SciencesLoop" description="SciencesLoop 如何围绕主张、溯源、不确定性、拒答与人工批准构建证据门控的科学工作流。" alternatePath={u("/approach/")}>
  <div class="sl-page">
    <section class="sl-page-hero"><span class="sl-chip proposed">产品架构 · 拟议</span><h1>让每个科学决策都能被追问。</h1><p class="sl-lead">核心单元不是一段 AI 回答，而是一份证据契约：主张、支撑它所需的证据、决策规则，以及可回放的执行记录。</p></section>
    <section class="sl-section sl-dark"><div class="sl-section-head"><span>01 · 证据契约</span><h2>主张 → 证据 → 门控 → 决策。</h2></div><div class="sl-trace"><div><b>C</b><strong>主张</strong><small>定义问题与允许的结论</small></div><i>→</i><div><b>E</b><strong>证据</strong><small>绑定数据、来源、版本与转换</small></div><i>→</i><div><b>G</b><strong>门控</strong><small>评估质量、不确定性与规则</small></div><i>→</i><div><b>D</b><strong>决策</strong><small>通过、拒答或请求复核</small></div></div></section>
    <section class="sl-section"><div class="sl-section-head"><span>02 · 四道门</span><h2>可靠性来自明确的停止规则。</h2></div><div class="sl-grid two">{gates.map(([name, text], i) => <article class="sl-card"><span class="sl-index">0{i + 1}</span><h3>{name}</h3><p>{text}</p></article>)}</div></section>
    <section class="sl-section"><div class="sl-section-head"><span>03 · 证据状态</span><h2>工作流必须说明它知道什么。</h2></div><div class="sl-state-table" role="table" aria-label="证据状态"><div role="row"><strong role="columnheader">状态</strong><strong role="columnheader">含义</strong><strong role="columnheader">允许行为</strong></div><div role="row"><span><i class="state ok"></i>已支持</span><span>所需证据存在并通过检查。</span><span>返回带溯源、范围明确的结果。</span></div><div role="row"><span><i class="state warn"></i>有条件</span><span>证据可用，但不确定性或假设很重要。</span><span>暴露边界，必要时请求复核。</span></div><div role="row"><span><i class="state stop"></i>不支持</span><span>缺少必要来源、字段或质量阈值。</span><span>拒答，不编造结论。</span></div></div></section>
    <section class="sl-section sl-note"><div><span class="sl-chip working">工作原型</span><h2>目前已有</h2><p>公开演示实现了这一模式的有限部分：确定性回放、带来源的身份核验、明确证据缺口与人工确认。</p></div><div><span class="sl-chip proposed">拟议方向</span><h2>下一步</h2><p>统一离线仪器导出、分析、不确定性、溯源与批准的科学工作流层。该架构尚不是经过验证的生产系统。</p></div></section>
    <section class="sl-section sl-contact"><div><h2>检查主张，而不是听口号。</h2><p>证据页将已演示行为与拟议产品方向分开。</p></div><a class="sl-button primary" href={u("/zh/evidence/")}>打开证据登记</a></section>
  </div>
</Base>
