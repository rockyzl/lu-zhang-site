---
import fs from 'node:fs';
import path from 'node:path';
import { u } from '../../lib/url';
const raw = fs.readFileSync(path.join(process.cwd(), 'public/demos/battery-research/index.html'), 'utf8');
const html = raw.replace('<head>', '<head><link rel="canonical" href="https://sciencesloop.com/agent/battery-research/"><link rel="alternate" hreflang="en" href="https://sciencesloop.com/agent/battery-research/"><link rel="alternate" hreflang="zh-CN" href="https://sciencesloop.com/zh/agent/battery-research/"><base href="' + u('/demos/battery-research/') + '">');
---
<Fragment set:html={html} />
