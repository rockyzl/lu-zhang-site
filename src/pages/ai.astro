---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { detectLocale, t } from "../lib/i18n";
import aiProjects from "../data/ai_projects.json";

const locale = detectLocale(Astro.url.pathname);

const industrial = [
  {
    name: "AAOS — Data Science Engineer",
    period: "Feb 2026 – present",
    note: "Voice agents and clinical data systems for the American Academy of Orthopaedic Surgeons.",
  },
  {
    name: "Mercury Insurance — Senior Data Scientist",
    period: "Nov 2024 – Jan 2026",
    note: "Pricing and risk models; production ML pipelines.",
  },
  {
    name: "Cincinnati Insurance — Data Scientist",
    period: "Aug 2023 – Nov 2024",
    note: "Loss prediction and analytics platforms.",
  },
];
const workflow = [
  {
    step: "Scan",
    title: "Track AI research signals",
    text: "Collect updates from frontier labs, China AI companies, AI for Science startups, research feeds, and technical blogs.",
  },
  {
    step: "Filter",
    title: "Map signals to scientific workflows",
    text: "Separate general model news from signals relevant to agents, RAG, evaluation, simulations, robotic labs, and scientific decision support.",
  },
  {
    step: "Build",
    title: "Turn strong signals into prototypes",
    text: "Use small demos and notebooks to test whether a pattern can help scientific navigation, formulation, evidence review, or workflow automation.",
  },
  {
    step: "Publish",
    title: "Write cited working notes",
    text: "Convert useful findings into public-safe posts with source links, open questions, and a ScientificLoop angle.",
  },
];
---
<Base title={(locale === "zh" ? "AI 与工程 — " : "AI & Engineering — ") + "Lu Zhang"}>
  <div class="container">

    <section style="padding: 3rem 0 1rem;">
      <span class="eyebrow">{t("page.ai.eyebrow", locale)}</span>
      <h1>AI Research Intelligence + Scientific Agents</h1>
      <p class="lead" style="font-size: 1.1rem; color: var(--c-fg); max-width: 760px;">
        ScientificLoop tracks AI agents, AI for Science, scientific workflow
        automation, and frontier model infrastructure, then turns the strongest
        signals into cited notes and small public-safe prototypes.
      </p>
    </section>

    <section class="workflow-steps" aria-label="ScientificLoop workflow">
      {workflow.map((item) => (
        <article>
          <span>{item.step}</span>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">Daily workflow</span>
        <h2>AI research radar → post → prototype</h2>
        <p>
          The publishing workflow starts with automated source collection, then
          adds human judgment: why the signal matters, how it affects scientific
          agents, and whether it suggests a ScientificLoop demo.
        </p>
      </div>
      <pre><code>npm run daily:radar
npm run new:post -- --title "Scientific agent workflow note"</code></pre>
    </section>

    <div class="section-head">
      <h2>Agent and AI systems</h2>
      <span class="more">{aiProjects.length}</span>
    </div>
    <div class="featured-grid">
      {aiProjects.map((p) => {
        const linkHref = p.site ?? p.repo ?? null;
        const Outer = linkHref ? "a" : "div";
        const outerProps = linkHref
          ? { href: linkHref, target: "_blank", rel: "noopener", class: "project-card" }
          : { class: "project-card" };
        return (
          <Outer {...outerProps}>
            {p.image ? (
              <div class="cover"><img src={u(p.image)} alt={p.name} loading="lazy" /></div>
            ) : (
              <div class={`cover gradient ${p.gradient ?? "from-rust to-amber"}`}>
                <span class="glyph">{p.name}</span>
              </div>
            )}
            <div class="body">
              <div class="name">{p.name}</div>
              <div class="tagline">{p.tagline}</div>
              <div class="description">{p.description}</div>
              <div class="status">{p.status}</div>
              <div class="tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              {(p.site || p.repo) && (
                <div style="margin-top: 0.5rem; display: flex; gap: 0.6rem; font-size: 0.85rem;">
                  {p.site && <span style="color: var(--c-accent); font-weight: 500;">↗ Live site</span>}
                  {p.repo && <span style="color: var(--c-muted);">⌗ Source</span>}
                </div>
              )}
            </div>
          </Outer>
        );
      })}
    </div>

    <p style="color: var(--c-muted); font-size: 0.9rem; margin-top: 1.5rem;">
      More tools and experiments live on
      <a href="https://github.com/rockyzl">github.com/rockyzl</a>
      — primarily personal Claude Code skills, RAG / agent prototypes, and
      research scripts. They are not productized and not listed here.
    </p>

    <div class="section-head">
      <h2>{t("page.ai.industrial", locale)}</h2>
    </div>
    {industrial.map((p) => (
      <div class="entry">
        <div class="title">{p.name}</div>
        <div class="meta"><strong style="color: var(--c-fg);">{p.period}</strong> — {p.note}</div>
      </div>
    ))}

  </div>
</Base>
