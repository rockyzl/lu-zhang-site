---
import Base from "../layouts/Base.astro";
import aiProjects from "../data/ai_projects.json";

const industrial = [
  {
    name: "AAOS — Data Science Engineer",
    period: "Feb 2026 – present",
    note: "Voice agents and clinical data systems for the American Academy of Orthopaedic Surgeons.",
  },
  {
    name: "Mercury Insurance — Senior Data Scientist",
    period: "Nov 2024 – Jan 2026",
    note: "Pricing and risk models; production ML pipelines.",
  },
  {
    name: "Cincinnati Insurance — Data Scientist",
    period: "Aug 2023 – Nov 2024",
    note: "Loss prediction and analytics platforms.",
  },
];
---
<Base title="AI &amp; Engineering — Lu Zhang">
  <div class="container">

    <section style="padding: 3rem 0 1rem;">
      <span class="eyebrow">AI · Tooling · Industrial ML</span>
      <h1>Where chemistry meets code</h1>
      <p class="lead" style="font-size: 1.1rem; color: var(--c-fg); max-width: 680px;">
        Most ML-for-materials systems are built by engineers without chemistry
        intuition; most battery scientists never operate production ML
        pipelines. The combination — a senior chemist with R&amp;D 100 winning
        flow-battery work and three years of insurance-grade ML at scale — is
        rare, and is the foundation for industrial-scale energy-storage AI
        going forward.
      </p>
    </section>

    <div class="section-head">
      <h2>Personal &amp; open-source projects</h2>
      <span class="more">{aiProjects.length} active</span>
    </div>
    <div class="featured-grid">
      {aiProjects.map((p) => (
        <div class="project-card">
          {p.image ? (
            <div class="cover"><img src={p.image} alt={p.name} loading="lazy" /></div>
          ) : (
            <div class={`cover gradient ${p.gradient ?? "from-rust to-amber"}`}>
              <span class="glyph">{p.name}</span>
            </div>
          )}
          <div class="body">
            <div class="name">{p.name}</div>
            <div class="tagline">{p.tagline}</div>
            <div class="description">{p.description}</div>
            <div class="status">{p.status}</div>
            <div class="tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="section-head">
      <h2>Industrial roles</h2>
    </div>
    {industrial.map((p) => (
      <div class="entry">
        <div class="title">{p.name}</div>
        <div class="meta"><strong style="color: var(--c-fg);">{p.period}</strong> — {p.note}</div>
      </div>
    ))}

    <div class="section-head">
      <h2>Why this combination matters</h2>
    </div>
    <p class="prose" style="font-size: 1rem; color: var(--c-fg); max-width: 720px;">
      The most interesting energy-AI work over the next decade will demand
      both depths: graduate-level electrochemistry intuition for posing the
      <em>right</em> questions, and production ML literacy for shipping
      systems that earn trust at scale. The
      <code style="font-family: var(--font-mono); background: var(--c-bg-soft); padding: 1px 6px; border-radius: 4px;">rfb-formulation-agent</code>
      project is the explicit attempt to compound the two.
    </p>

  </div>
</Base>
