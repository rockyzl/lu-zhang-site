---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
---
<Base title="About — Lu Zhang">
  <div class="container" style="padding-top: 3rem;">
  <div style="display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; align-items: start;" class="about-hero">
    <div class="portrait square">
      <div class="placeholder-mark">
        <span>L · Z</span>
        <span class="placeholder-hint">photo: drop public/images/portrait.jpg</span>
      </div>
      <img src={u("/images/portrait.jpg")} alt="Lu Zhang" onerror="this.remove()" />
    </div>
    <div>
      <span class="eyebrow">Bio</span>
      <h1 style="margin-top: 0;">Lu Zhang</h1>
      <p style="color: var(--c-muted); font-size: 1.1rem; margin-top: -0.4rem; margin-bottom: 1.2rem;">张鲁, Ph.D.</p>
      <p class="lead">
        Battery scientist and data engineer. After 14+ years at Argonne
        National Laboratory developing redox flow batteries, Li-ion
        electrolytes, and silicon-anode binders, now applying machine
        learning to industrial energy-storage problems.
      </p>
      <p style="color: var(--c-muted); font-size: 0.95rem; margin-top: 1rem;">
        Based in Chicago. Reachable at <a href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a>.
      </p>
    </div>
  </div>
  <style>
    @media (max-width: 640px) {
      .about-hero { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
      .about-hero .portrait.square { max-width: 200px; }
    }
  </style>

  <h2>Education</h2>
  <ul>
    <li><strong>Ph.D., Organic Chemistry</strong> — Chinese Academy of Sciences (2001 – 2006). Master's stage 2001 – 2004 under combined master/PhD program.</li>
    <li><strong>B.S., Chemistry</strong> — Shandong University (1996 – 2000)</li>
  </ul>

  <h2>Career</h2>
  <ul>
    <li><strong>Data Science Engineer</strong>, AAOS (Feb 2026 – present)</li>
    <li><strong>Senior Data Scientist</strong>, Mercury Insurance (Nov 2024 – Jan 2026)</li>
    <li><strong>Data Scientist</strong>, Cincinnati Insurance (Aug 2023 – Nov 2024)</li>
    <li><strong>Chemist → Senior Chemist</strong>, Argonne National Laboratory (2009 – 2023)</li>
    <li><strong>Postdoctoral Fellow</strong>, Argonne National Laboratory (2008 – 2009)</li>
    <li><strong>Postdoctoral Researcher</strong>, Florida State University (2006 – 2008)</li>
  </ul>

  <h2>Recognition</h2>
  <ul>
    <li>R&amp;D 100 Award (2014)</li>
    <li>R&amp;D 100 Award Finalist (2015)</li>
    <li>4,700+ citations · h-index 39 · i10-index 89</li>
  </ul>

  <h2>Contact</h2>
  <p>
    <a href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a> ·
    <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en">Google Scholar</a> ·
    <a href="https://github.com/rockyzl">GitHub</a> ·
    <a href="https://www.linkedin.com/">LinkedIn</a>
  </p>
  </div>
</Base>
