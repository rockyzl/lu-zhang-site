---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
---
<Base title="About — Lu Zhang">
  <div class="container" style="padding-top: 3rem;">
  <div style="display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; align-items: start;" class="about-hero">
    <div class="portrait square">
      <div class="placeholder-mark">
        <span>L · Z</span>
        <span class="placeholder-hint">photo: drop public/images/portrait.jpg</span>
      </div>
      <img src={u("/images/portrait.jpg")} alt="Lu Zhang" onerror="this.remove()" />
    </div>
    <div>
      <span class="eyebrow">Bio</span>
      <h1 style="margin-top: 0;">Lu Zhang</h1>
      <p style="color: var(--c-muted); font-size: 1.1rem; margin-top: -0.4rem; margin-bottom: 1.2rem;">张鲁, Ph.D.</p>
      <p class="lead">
        Battery scientist and data engineer. After 14+ years at Argonne
        National Laboratory developing redox flow batteries, Li-ion
        electrolytes, and silicon-anode binders, now applying machine
        learning to industrial energy-storage problems.
      </p>
      <p style="color: var(--c-muted); font-size: 0.95rem; margin-top: 1rem;">
        Based in Chicago. Reachable at <a href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a>.
      </p>
    </div>
  </div>
  <style>
    @media (max-width: 640px) {
      .about-hero { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
      .about-hero .portrait.square { max-width: 200px; }
    }
  </style>

  <h2>Education</h2>
  <ul>
    <li><strong>Ph.D., Organic Chemistry</strong> — Chinese Academy of Sciences (2001 – 2006). Master's stage 2001 – 2004 under combined master/PhD program.</li>
    <li><strong>B.S., Chemistry</strong> — Shandong University (1996 – 2000)</li>
  </ul>

  <h2>Career</h2>
  <ul>
    <li><strong>Data Science Engineer</strong>, AAOS (Feb 2026 – present)</li>
    <li><strong>Senior Data Scientist</strong>, Mercury Insurance (Nov 2024 – Jan 2026)</li>
    <li><strong>Data Scientist</strong>, Cincinnati Insurance (Aug 2023 – Nov 2024)</li>
    <li><strong>Chemist → Senior Chemist</strong>, Argonne National Laboratory (2009 – 2023)</li>
    <li><strong>Postdoctoral Fellow</strong>, Argonne National Laboratory (2008 – 2009)</li>
    <li><strong>Postdoctoral Researcher</strong>, Florida State University (2006 – 2008)</li>
  </ul>

  <h2>Recognition &amp; Awards</h2>
  <h3 style="margin-top: 1.5rem;">Major awards</h3>
  <ul>
    <li>
      <strong>R&amp;D 100 Award (2014)</strong> — for redox-shuttle additive
      technology. The "Oscars of Innovation" awarded annually by R&amp;D Magazine.
      Core inventor on lithium-battery overcharge-protection redox-shuttle
      patents that grew into the award-winning ANL technology.
    </li>
    <li>
      <strong>R&amp;D 100 Award Finalist (2015)</strong> — for high-voltage
      lithium-battery fluorinated electrolyte technology.
    </li>
  </ul>

  <h3 style="margin-top: 1.5rem;">Bibliometrics</h3>
  <ul>
    <li>4,700+ citations · h-index 39 · i10-index 89 (Google Scholar)</li>
    <li>143 peer-reviewed journal articles · 28 issued US patents &amp; applications · 38 conference abstracts</li>
    <li>13 invited / featured talks at MRS, ECS, IBS, ICESI, and university seminars</li>
  </ul>

  <h3 style="margin-top: 1.5rem;">DOE / JCESR leadership</h3>
  <ul>
    <li>
      <strong>Co-author, DOE Flow Batteries Technology Strategy Assessment (2023)</strong>
      — long-duration storage roadmap; engaged industry listening session
      (22 attendees, 14 commercial entities)
    </li>
    <li>
      <strong>Storage Innovations 2030</strong> contributor — DOE framework
      launched at the 2022 Energy Storage Grand Challenge Summit
    </li>
    <li>JCESR Theme / Sprint team leadership (3 universities + 2 national labs, 2015 – 2017)</li>
    <li>JCESR 2.0 self-reporting redoxmer Y3 milestone leader (2020)</li>
  </ul>

  <h3 style="margin-top: 1.5rem;">Government panel &amp; proposal review</h3>
  <ul>
    <li><strong>DOE SBIR Reviewer</strong> — Department of Energy Small Business Innovation Research (2013 – 2022, 10 years)</li>
    <li><strong>NSF Review Panel for Energy Systems</strong> — National Science Foundation (2019)</li>
    <li><strong>DOE Energy Storage Innovations Prize Reviewer</strong> — long-duration storage innovation awards (2023)</li>
  </ul>

  <h3 style="margin-top: 1.5rem;">Journal peer review</h3>
  <p style="font-size: 0.95rem; color: var(--c-fg);">
    Reviewer for 10+ international journals including
    <em>Journal of Power Sources</em>,
    <em>ACS Energy Letters</em>,
    <em>Chemical Communications</em>,
    <em>Advanced Energy Materials</em>,
    <em>Nano Energy</em>,
    <em>J. Materials Chemistry A</em>,
    <em>Chemistry of Materials</em>,
    <em>ChemSusChem</em>,
    <em>Electrochimica Acta</em>,
    <em>ACS Applied Energy Materials</em>.
  </p>

  <h3 style="margin-top: 1.5rem;">Other invited service</h3>
  <ul>
    <li>
      <em>Organic Molecules in Batteries</em> — invited seminar at Florida State University
      (alma mater of postdoc training, 2014)
    </li>
    <li>
      Mentored 6 postdocs and 3 graduate students at ANL; supervised
      cross-institution Sprint teams (MIT, PNNL, UIUC, UMichigan, Purdue)
    </li>
  </ul>

  <h3 style="margin-top: 1.5rem;">Featured in</h3>
  <ul>
    <li><em>Argonne Today</em> — liquid catholyte ANL-8/9 highlight</li>
    <li><em>JCESR Research Highlights</em> — multiple molecular-engineering breakthroughs</li>
    <li><em>EurekAlert</em> — self-reporting redox flow battery coverage</li>
  </ul>

  <h2>Contact</h2>
  <p>
    <a href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a> ·
    <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en">Google Scholar</a> ·
    <a href="https://github.com/rockyzl">GitHub</a> ·
    <a href="https://www.linkedin.com/">LinkedIn</a>
  </p>
  </div>
</Base>
