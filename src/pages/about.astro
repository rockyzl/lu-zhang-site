---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { detectLocale } from "../lib/i18n";

const locale = detectLocale(Astro.url.pathname);
const isZh = locale === "zh";

const stats = [
  { n: "15+", l: isZh ? "年能源科学" : "yrs energy science" },
  { n: "97", l: isZh ? "篇论文" : "papers" },
  { n: "28", l: isZh ? "项专利" : "patents" },
  { n: "39", l: "h-index" },
  { n: "4,700+", l: isZh ? "总被引" : "citations" },
];

const career = isZh
  ? [
      ["数据科学工程师", "AAOS", "2026.02 – 至今"],
      ["高级数据科学家", "Mercury Insurance", "2024.11 – 2026.01"],
      ["数据科学家", "Cincinnati Insurance", "2023.08 – 2024.11"],
      ["化学家 → 资深化学家", "Argonne National Laboratory", "2009 – 2023"],
      ["博士后", "Argonne · Florida State University", "2006 – 2009"],
    ]
  : [
      ["Data Science Engineer", "AAOS", "Feb 2026 – present"],
      ["Senior Data Scientist", "Mercury Insurance", "Nov 2024 – Jan 2026"],
      ["Data Scientist", "Cincinnati Insurance", "Aug 2023 – Nov 2024"],
      ["Chemist → Senior Chemist", "Argonne National Laboratory", "2009 – 2023"],
      ["Postdoctoral", "Argonne · Florida State University", "2006 – 2009"],
    ];

const education = isZh
  ? [
      ["博士 · 有机化学", "中国科学院", "2001 – 2006"],
      ["学士 · 化学", "山东大学", "1996 – 2000"],
    ]
  : [
      ["Ph.D., Organic Chemistry", "Chinese Academy of Sciences", "2001 – 2006"],
      ["B.S., Chemistry", "Shandong University", "1996 – 2000"],
    ];
---
<Base
  title={isZh ? "关于 — SciencesLoop" : "About — SciencesLoop"}
  description={isZh
    ? "SciencesLoop 创建者背景：科学研究、AI 系统工作与公开联系方式。"
    : "Founder background behind SciencesLoop: scientific research, AI systems work, and public contact links."}
>
  <div class="container ab">
    <section class="ab-hero">
      <div class="ab-top">
        <span class="ab-mark" aria-hidden="true">LZ</span>
        <div>
          <span class="eyebrow">{isZh ? "关于 · SciencesLoop" : "About · SciencesLoop"}</span>
          <h1 class="ab-name">{isZh ? "Lu Zhang / 张鲁" : "Lu Zhang"}</h1>
          <p class="ab-role">{isZh ? "AI 工程师 · 科学系统构建者 · Ph.D." : "AI Engineer · Scientific Systems Builder · Ph.D."}</p>
        </div>
      </div>
      <p class="ab-intro">
        {isZh ? (
          <>我构建<span class="accent">有据可查、可测试的 AI 智能体</span>，用于科学与运营 —— 把高上下文的知识工作流变成可靠的软件。SciencesLoop 是我把这些工作放在公开处的地方：研究笔记、小工具，以及关于"怎样让 agent 可靠"的 AI-for-Science 实验。</>
        ) : (
          <>I build <span class="accent">grounded, testable AI agents</span> for science and operations — turning high-context knowledge workflows into reliable software. SciencesLoop is where I keep the work in the open: field notes, small tools, and AI-for-Science experiments focused on what makes agents reliable.</>
        )}
      </p>
      <div class="ab-meta">
        <span>{isZh ? "常驻芝加哥" : "Based in Chicago"}</span>
        <span class="dot">·</span>
        <a class="mail" href="mailto:zhanglu77@gmail.com">zhanglu77@gmail.com</a>
        <a class="cv" href={u("/files/Lu_Zhang_CV.pdf")} target="_blank" rel="noopener">{isZh ? "↓ 学术 CV (PDF)" : "↓ Academic CV (PDF)"}</a>
      </div>
    </section>

    <div class="ab-stats">
      {stats.map((s) => (
        <div class="ab-stat"><div class="n">{s.n}</div><div class="l">{s.l}</div></div>
      ))}
    </div>

    <section class="ab-sec">
      <div class="ab-sechead">{isZh ? "履历" : "Career"}</div>
      {career.map(([title_, org, when]) => (
        <div class="ab-row">
          <div class="when">{when}</div>
          <div class="what"><strong>{title_}</strong>, <span class="org">{org}</span></div>
        </div>
      ))}
    </section>

    <section class="ab-sec">
      <div class="ab-sechead">{isZh ? "教育" : "Education"}</div>
      {education.map(([deg, school, when]) => (
        <div class="ab-row">
          <div class="when">{when}</div>
          <div class="what"><strong>{deg}</strong> — <span class="org">{school}</span></div>
        </div>
      ))}
    </section>

    <section class="ab-sec">
      <div class="ab-sechead">{isZh ? "荣誉" : "Recognition"}</div>
      <div class="ab-row">
        <div class="when">2014 · 2015</div>
        <div class="what">
          {isZh
            ? <><strong>R&D 100 大奖</strong>（氧化还原穿梭剂技术）与 Finalist — <span class="org">DOE Flow Batteries Strategy Assessment 共同作者、JCESR Theme Lead</span></>
            : <><strong>R&D 100 Award</strong> (redox-shuttle technology) &amp; Finalist — <span class="org">co-author, DOE Flow Batteries Strategy Assessment; JCESR Theme Lead</span></>}
        </div>
      </div>
      <p class="ab-links">
        <a href={u(isZh ? "/zh/awards/" : "/awards/")}>{isZh ? "完整荣誉与认可 →" : "Full awards & recognition →"}</a>
        <a href={u(isZh ? "/zh/research-archive/" : "/research-archive/")}>{isZh ? "研究档案 →" : "Research archive →"}</a>
      </p>
    </section>

    <section class="ab-sec">
      <div class="ab-sechead">{isZh ? "联系" : "Contact"}</div>
      <p class="ab-contact">
        <a href="mailto:zhanglu77@gmail.com">Email</a>
        <a href="https://scholar.google.com/citations?user=Wx7oSUwAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a>
        <a href="https://github.com/rockyzl" target="_blank" rel="noopener">GitHub</a>
        <a href="https://www.linkedin.com/in/lu-zhang-argonne/" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </section>

    <p class="ab-foot">{isZh ? "完整学术记录 —— 论文、专利、演讲 —— 都在研究档案里。" : "Full academic record — publications, patents, talks — lives in the research archive."}</p>
  </div>

  <style>
    .ab { max-width: 760px; }
    .ab .eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent); }
    .ab-hero { padding: 1.4rem 0 0; }
    .ab-top { display: flex; align-items: flex-start; gap: 1rem; }
    .ab-mark { flex-shrink: 0; width: 44px; height: 44px; border-radius: 12px; border: 1.5px solid var(--c-border); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 14px; color: var(--c-accent); margin-top: 6px; }
    .ab-name { font-size: clamp(32px, 5vw, 50px); letter-spacing: -.035em; font-weight: 730; margin: .35rem 0 0; line-height: 1.02; }
    .ab-role { color: var(--c-muted); font-family: var(--font-mono); font-size: .9rem; margin: .5rem 0 0; }
    .ab-intro { font-size: 1.05rem; color: var(--c-fg); line-height: 1.6; margin: 1.25rem 0 0; max-width: 60ch; }
    .ab-intro .accent { color: var(--c-accent); font-weight: 600; }
    .ab-meta { display: flex; flex-wrap: wrap; gap: .6rem 1.2rem; align-items: center; margin: 1.3rem 0 0; font-size: .95rem; color: var(--c-muted); }
    .ab-meta .dot { color: var(--c-border-strong, var(--c-border)); }
    .ab-meta .mail { color: var(--c-accent); }
    .ab-meta .cv { font-family: var(--font-mono); font-size: .78rem; background: var(--c-accent); color: #fff; border-radius: 9px; padding: .55rem .9rem; }

    .ab-stats { display: flex; flex-wrap: wrap; gap: 1.8rem; margin: 2.2rem 0 0; padding: 1.3rem 0; border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); }
    .ab-stat .n { font-size: 1.4rem; font-weight: 700; letter-spacing: -.02em; color: var(--c-fg); }
    .ab-stat .l { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; color: var(--c-muted); margin-top: .2rem; }

    .ab-sec { padding: 2.1rem 0 0; }
    .ab-sechead { font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--c-muted); margin: 0 0 .9rem; }
    .ab-row { display: flex; gap: 1.4rem; padding: .85rem 0; border-top: 1px solid var(--c-border); }
    .ab-sec .ab-row:first-of-type { border-top: 0; }
    .ab-row .when { flex: 0 0 132px; font-family: var(--font-mono); font-size: .78rem; color: var(--c-muted); padding-top: .12rem; }
    .ab-row .what { font-size: .98rem; color: var(--c-fg); }
    .ab-row .what strong { font-weight: 640; }
    .ab-row .what .org { color: var(--c-muted); }
    .ab-links { display: flex; flex-wrap: wrap; gap: 1.2rem; margin: 1rem 0 0; }
    .ab-links a { font-family: var(--font-mono); font-size: .8rem; color: var(--c-accent); }
    .ab-contact { display: flex; flex-wrap: wrap; gap: 1.2rem; margin: 0; }
    .ab-contact a { font-family: var(--font-mono); font-size: .85rem; color: var(--c-accent); }
    .ab-foot { color: var(--c-muted); font-size: .9rem; margin: 1.8rem 0 3.5rem; }

    @media (max-width: 600px) {
      .ab-row { flex-direction: column; gap: .15rem; }
      .ab-row .when { flex-basis: auto; }
    }
  </style>
</Base>
