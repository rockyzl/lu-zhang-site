---
import Base from "../layouts/Base.astro";
import patents from "../data/patents.json";

const byTopic = patents.reduce((acc, p) => {
  (acc[p.topic] = acc[p.topic] || []).push(p);
  return acc;
}, {});
---
<Base title="Patents — Lu Zhang">
  <div class="container" style="padding-top: 3rem;">
  <span class="eyebrow">28 issued · 23 detailed below</span>
  <h1>US Patents</h1>
  <p class="lead">28 issued US patents in flow battery chemistries, redox shuttles, electrolytes, and binders. The 23 below are the OSTI-verified subset; 5 additional patents are being added.</p>

  {Object.entries(byTopic).map(([topic, items]) => (
    <section>
      <h2>{topic}</h2>
      {items.sort((a, b) => b.year - a.year).map((p) => (
        <div class="entry">
          <div class="title">
            <a href={`https://patents.google.com/patent/${p.patent_no.replace(/\s|,/g, "")}`}>{p.patent_no}</a>
            <span style="color:var(--c-muted)"> ({p.year})</span>
          </div>
          <div class="meta">{p.title_en}</div>
          <div class="meta">{p.title_cn}</div>
          <div class="meta">Inventors: {p.inventors}</div>
        </div>
      ))}
    </section>
  ))}

  <p style="color: var(--c-muted); font-size: 0.92rem; margin-top: 1.5rem; padding: 1rem; background: var(--c-bg-soft); border-radius: var(--radius-sm); border: 1px solid var(--c-border-soft);">
    <strong style="color: var(--c-fg);">+ 5 additional patents</strong> issued
    but not yet itemized here. Details (patent number, year, title,
    co-inventors) being collected from USPTO and supplementary records.
  </p>
  </div>
</Base>
