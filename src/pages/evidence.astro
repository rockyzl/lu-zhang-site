---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { liveDemos } from "../data/demos";

const selected = ["kit-battery-early-warning", "redox-rfb-predictor", "molecular-discovery-workflow", "chemgraph-loop"]
  .map((id) => liveDemos.find((demo) => demo.id === id))
  .filter(Boolean);
const notes: Record<string, { proves: string; not: string }> = {
  "kit-battery-early-warning": { proves: "A replayable comparison on transformed, derived public battery data, including matched forecasts with and without EIS.", not: "A production alarm, prospective laboratory validation, or autonomous experiment control." },
  "redox-rfb-predictor": { proves: "A human-confirmed identity checkpoint before a fixed model produces a bounded prediction.", not: "Experimental redox validation or a general-purpose materials discovery engine." },
  "molecular-discovery-workflow": { proves: "Source-backed identity resolution and explicit evidence gaps instead of invented property values.", not: "New experimental measurements or autonomous laboratory operation." },
  "chemgraph-loop": { proves: "A runnable tool workflow with a workflow guard and inspectable intermediate behavior.", not: "Wet-lab validation, calibrated scientific accuracy across domains, or real instrument control." },
};
---
<Base title="Evidence — SciencesLoop" description="An evidence register for SciencesLoop: what public demonstrations establish, what they do not establish, and the current product boundary." alternatePath={u("/zh/evidence/")}>
  <div class="sl-page">
    <section class="sl-page-hero"><span class="sl-chip live">Evidence register · updated 2026-08-05</span><h1>Separate demonstrated behavior from proposed capability.</h1><p class="sl-lead">These public artifacts are evidence of bounded workflow patterns. They are not evidence of wet-lab validation, production readiness, or autonomous instrument control.</p></section>

    <section class="sl-section"><div class="sl-section-head"><span>01 · Public artifacts</span><h2>Runnable demonstrations with explicit limits.</h2></div><div class="sl-grid two">{selected.map((demo) => demo && <article class="sl-card evidence-card"><div class="sl-card-top"><span class="sl-chip live">Live demonstration</span><span class="sl-id">{demo.id}</span></div><h3>{demo.title.en}</h3><p>{demo.summary.en}</p><div class="sl-claim"><strong>Demonstrates</strong><p>{notes[demo.id].proves}</p></div><div class="sl-claim limit"><strong>Does not establish</strong><p>{notes[demo.id].not}</p></div><a class="sl-text-link" href={u(demo.path)}>Run the demonstration →</a></article>)}</div></section>

    <section class="sl-section"><div class="sl-section-head"><span>02 · Claim ledger</span><h2>Current public position.</h2></div><div class="sl-ledger"><div><span class="sl-chip live">Demonstrated</span><p>Bounded public workflows can preserve sources, expose intermediate states, require confirmation, abstain on gaps, and support deterministic replay in selected cases.</p></div><div><span class="sl-chip working">Working prototype</span><p>Pieces of an evidence-gated workflow architecture exist across public artifacts, but not yet as one validated electrochemistry product.</p></div><div><span class="sl-chip proposed">Proposed</span><p>Offline CV/EIS inference, anomaly review, provenance, and approval gates around brownfield laboratory instruments.</p></div><div><span class="sl-chip risk">Not demonstrated</span><p>Wet-lab validation, inter-laboratory transfer, autonomous instrument control, customer deployment, or production reliability.</p></div></div></section>

    <section class="sl-section sl-contact"><div><h2>Have a validation question?</h2><p>Ask for the artifact, input, metric, or boundary behind a claim.</p></div><a class="sl-button primary" href="mailto:luzhang@sciencesloop.com?subject=SciencesLoop%20evidence%20question">Contact SciencesLoop</a></section>
  </div>
</Base>
