---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { detectLocale, t } from "../lib/i18n";
import aiProjects from "../data/ai_projects.json";

const locale = detectLocale(Astro.url.pathname);
const isZh = locale === "zh";

const workflow = [
  {
    step: "Scan",
    title: "Track AI research signals",
    text: "Collect updates from selected AI labs, AI for Science startups, research feeds, and technical blogs.",
  },
  {
    step: "Filter",
    title: "Map signals to scientific workflows",
    text: "Separate general model news from signals relevant to agents, RAG, evaluation, simulations, robotic labs, and scientific decision support.",
  },
  {
    step: "Build",
    title: "Turn strong signals into prototypes",
    text: "Use small demos and notebooks to test whether a pattern can help scientific navigation, formulation, evidence review, or workflow automation.",
  },
  {
    step: "Publish",
    title: "Write cited working notes",
    text: "Convert useful findings into public notes with source links, open questions, and practical tests.",
  },
];

const researchPrograms = isZh
  ? [
      {
        id: "scientific-workflow",
        name: "Scientific Workflow",
        label: "Program 01",
        text: "研究如何把科学问题转成可检查的 agent workflow：工具路由、状态、评估门、人工 review 和闭环执行。",
      },
      {
        id: "scientific-state",
        name: "Scientific State",
        label: "Program 02",
        text: "研究 scientific memory、文献证据、实验上下文、provenance 和 workflow state，让科学决策不是一次性回答。",
      },
      {
        id: "scientific-foundation-models",
        name: "Scientific Foundation Models",
        label: "Program 03",
        text: "跟踪和实验表示学习、分子/性质模型、溶解度、电池材料模型，以及 foundation-model 方法在科学系统中的作用。",
      },
      {
        id: "scientific-discovery",
        name: "Scientific Discovery",
        label: "Program 04",
        text: "把 flow battery、property prediction、benchmark graph 和未来 self-driving-lab 接口作为 discovery sandbox。",
      },
    ]
  : [
      {
        id: "scientific-workflow",
        name: "Scientific Workflow",
        label: "Program 01",
        text: "Agentic workflow systems that convert scientific questions into tool routing, state, evaluation gates, human review, and closed-loop execution.",
      },
      {
        id: "scientific-state",
        name: "Scientific State",
        label: "Program 02",
        text: "Scientific memory, evidence, experimental context, provenance, and workflow state for inspectable scientific decisions.",
      },
      {
        id: "scientific-foundation-models",
        name: "Scientific Foundation Models",
        label: "Program 03",
        text: "Representation learning, molecular/property models, solubility and battery-materials modeling, and foundation-model methods for scientific systems.",
      },
      {
        id: "scientific-discovery",
        name: "Scientific Discovery",
        label: "Program 04",
        text: "Flow-battery decision support, property prediction, benchmark graphs, and future interfaces to self-driving laboratories.",
      },
    ];
---
<Base
  title={(isZh ? "Research Programs — " : "Research Programs — ") + "SciencesLoop"}
  description="SciencesLoop research programs: Scientific Workflow, Scientific State, Scientific Foundation Models, and Scientific Discovery."
>
  <div class="container">

    <section style="padding: 3rem 0 1rem;">
      <span class="eyebrow">SciencesLoop Research Programs</span>
      <h1>{isZh ? "四个 Scientific AI 研究方向" : "Four programs for Scientific AI"}</h1>
      <p class="lead" style="font-size: 1.1rem; color: var(--c-fg); max-width: 760px;">
        {isZh
          ? "SciencesLoop 不只是项目集合，而是一个开放研究实验室：围绕 scientific workflow、scientific state、foundation models 和 discovery systems 持续积累软件、笔记和实验。"
          : "SciencesLoop is not a project list. It is an open research lab organized around scientific workflow, scientific state, foundation models, and discovery systems."}
      </p>
    </section>

    <section class="product-modules" aria-label="SciencesLoop research programs">
      {researchPrograms.map((item) => (
        <article class="product-module" id={item.id}>
          <span>{item.label}</span>
          <h2>{item.name}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="lab-manifesto" aria-label="Research manifesto">
      <div>
        <span class="eyebrow">Research Manifesto</span>
        <h2>{isZh ? "Scientific AI 不是问答界面。" : "Scientific AI is not a Q&A interface."}</h2>
      </div>
      <div>
        <p>
          {isZh
            ? "SciencesLoop 的目标不是让 AI 直接回答科学问题，而是构建帮助科学家提出更好问题、设计更好实验、做出更好决策的科学基础设施。"
            : "SciencesLoop is not building AI to answer scientific questions. It is building scientific infrastructure that helps scientists ask better questions, design better experiments, and make better decisions."}
        </p>
      </div>
    </section>

    <section class="workflow-steps" aria-label="SciencesLoop workflow">
      {workflow.map((item) => (
        <article>
          <span>{item.step}</span>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">{isZh ? "Operating loop" : "Operating loop"}</span>
        <h2>{isZh ? "信号 → 判断 → 原型 → 公开笔记" : "Signal → judgment → prototype → field note"}</h2>
        <p>
          {isZh
            ? "SciencesLoop 把公开 AI for Science 信号映射到科学工作流问题，再用小原型和带来源的笔记检验哪些模式真的有用。"
            : "SciencesLoop maps public AI-for-Science signals to scientific workflow problems, then uses small prototypes and cited notes to test which patterns are useful."}
        </p>
      </div>
      <p>
        {isZh
          ? "公开输出是研究笔记、可检查的原型和研究地图；页面只展示可公开解释的结论和证据。"
          : "Public outputs are field notes, inspectable prototypes, and research maps; the site keeps the visible layer focused on evidence and interpretation."}
      </p>
    </section>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">{isZh ? "WIP case study" : "WIP case study"}</span>
        <h2>{isZh ? "Energy AI 原型" : "Energy AI prototype"}</h2>
        <p>
          {isZh
            ? "Energy Materials AI 是 Scientific Discovery 方向下的当前应用案例：把论文、专利、数据库、实验记录和性质模型组织成可追踪的研发决策。它仍处于原型和问题发现阶段。"
            : "Energy Materials AI is the current applied case under Scientific Discovery: turning papers, patents, databases, experiment records, and property models into traceable R&D decisions. It is still a prototype and discovery effort."}
        </p>
      </div>
      <p>
        <a class="more" href={u(isZh ? "/zh/energy-materials-ai/" : "/energy-materials-ai/")}>
          {isZh ? "查看 Energy AI 原型 →" : "View Energy AI prototype →"}
        </a>
      </p>
    </section>

    <div class="section-head">
      <h2>{isZh ? "当前 AI 系统与原型" : "Current AI systems and prototypes"}</h2>
      <span class="more">{aiProjects.length}</span>
    </div>
    <div class="featured-grid">
      {aiProjects.map((p) => {
        const linkHref = p.site ?? p.repo ?? null;
        const Outer = linkHref ? "a" : "div";
        const outerProps = linkHref
          ? { href: linkHref, target: "_blank", rel: "noopener", class: "project-card" }
          : { class: "project-card" };
        return (
          <Outer {...outerProps}>
            {p.image ? (
              <div class="cover"><img src={u(p.image)} alt={p.name} loading="lazy" /></div>
            ) : (
              <div class={`cover gradient ${p.gradient ?? "from-rust to-amber"}`}>
                <span class="glyph">{p.name}</span>
              </div>
            )}
            <div class="body">
              <div class="name">{p.name}</div>
              <div class="tagline">{p.tagline}</div>
              <div class="description">{p.description}</div>
              <div class="status">{p.status}</div>
              <div class="tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              {(p.site || p.repo) && (
                <div style="margin-top: 0.5rem; display: flex; gap: 0.6rem; font-size: 0.85rem;">
                  {p.site && <span style="color: var(--c-accent); font-weight: 500;">↗ Live site</span>}
                  {p.repo && <span style="color: var(--c-muted);">⌗ Source</span>}
                </div>
              )}
            </div>
          </Outer>
        );
      })}
    </div>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">{isZh ? "Evidence base" : "Evidence base"}</span>
        <h2>{isZh ? "科研记录仍是这个系统的基础。" : "The research record remains the foundation."}</h2>
        <p>
          {isZh
            ? "这些 program 建立在公开论文、专利、DOE/JCESR 项目和电池材料研究经验之上。AI 领先呈现，但科研证据不隐藏。"
            : "These programs build on public papers, patents, DOE/JCESR projects, and battery-materials research experience. The AI work leads, but the scientific record stays visible."}
        </p>
      </div>
      <p>
        <a class="more" href={u(isZh ? "/zh/publications/" : "/publications/")}>{isZh ? "论文 →" : "Publications →"}</a>
        {" · "}
        <a class="more" href={u(isZh ? "/zh/patents/" : "/patents/")}>{isZh ? "专利 →" : "Patents →"}</a>
        {" · "}
        <a class="more" href={u(isZh ? "/zh/projects/" : "/projects/")}>{isZh ? "科研项目 →" : "Research Projects →"}</a>
      </p>
    </section>

  </div>
</Base>
