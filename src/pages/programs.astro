---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { detectLocale, t } from "../lib/i18n";
import aiProjects from "../data/ai_projects.json";

const locale = detectLocale(Astro.url.pathname);
const isZh = locale === "zh";

const workflow = [
  {
    step: "Scan",
    title: "Track AI research signals",
    text: "Collect updates from selected AI labs, AI for Science startups, research feeds, and technical blogs.",
  },
  {
    step: "Filter",
    title: "Map signals to scientific workflows",
    text: "Separate general model news from signals relevant to agents, RAG, evaluation, simulations, robotic labs, and scientific decision support.",
  },
  {
    step: "Build",
    title: "Turn strong signals into prototypes",
    text: "Use small demos and notebooks to test whether a pattern can help scientific navigation, formulation, evidence review, or workflow automation.",
  },
  {
    step: "Publish",
    title: "Write cited working notes",
    text: "Convert useful findings into public notes with source links, open questions, and practical tests.",
  },
];

const researchPrograms = isZh
  ? [
      {
        id: "scientific-workflow",
        name: "Scientific Workflow",
        label: "Program 01",
        text: "研究如何把科学问题转成可检查的 agent workflow：工具路由、状态、评估门、人工 review 和闭环执行。",
      },
      {
        id: "scientific-state",
        name: "Scientific State",
        label: "Program 02",
        text: "研究 scientific memory、文献证据、实验上下文、provenance 和 workflow state，让科学决策不是一次性回答。",
      },
      {
        id: "scientific-foundation-models",
        name: "Scientific Foundation Models",
        label: "Program 03",
        text: "跟踪和实验表示学习、分子/性质模型、溶解度、电池材料模型，以及 foundation-model 方法在科学系统中的作用。",
      },
      {
        id: "scientific-discovery",
        name: "Scientific Discovery",
        label: "Program 04",
        text: "把 flow battery、property prediction、benchmark graph 和未来 self-driving-lab 接口作为 discovery sandbox。",
      },
    ]
  : [
      {
        id: "scientific-workflow",
        name: "Scientific Workflow",
        label: "Program 01",
        text: "Agentic workflow systems that convert scientific questions into tool routing, state, evaluation gates, human review, and closed-loop execution.",
      },
      {
        id: "scientific-state",
        name: "Scientific State",
        label: "Program 02",
        text: "Scientific memory, evidence, experimental context, provenance, and workflow state for inspectable scientific decisions.",
      },
      {
        id: "scientific-foundation-models",
        name: "Scientific Foundation Models",
        label: "Program 03",
        text: "Representation learning, molecular/property models, solubility and battery-materials modeling, and foundation-model methods for scientific systems.",
      },
      {
        id: "scientific-discovery",
        name: "Scientific Discovery",
        label: "Program 04",
        text: "Flow-battery decision support, property prediction, benchmark graphs, and future interfaces to self-driving laboratories.",
      },
    ];

const caseStudies = isZh
  ? [
      {
        title: "RFB Formulation Agent",
        status: "prototype · private pre-v0.1",
        problem: "在不信任 ungrounded model output 的前提下，筛选 redox-flow-battery electrolyte 候选。",
        approach: "Anthropic tool-use loop、RDKit/SMARTS 化学过滤、文献 ingest/verify/extract pipeline、SQLite candidate engine 和严格 provenance。",
        built: "已构建 tool-use loop、多阶段化学过滤 pipeline、DOI-verified retrieval 和 Streamlit UI；document RAG 仍是 stub，并按 stub 标注。",
        evaluation: "No-hallucinated-DOI contracts、可审计 evidence IDs 和小规模 blind query test。",
        output: "带 `verdict → why → recommendations → caveats → evidence IDs` 的候选 shortlist，供科学家人工 review。",
      },
      {
        title: "ChemGraph Workflow Contributions",
        status: "contribution notes · no ownership claim",
        problem: "Scientific agent 需要展示 molecule、calculation、tool calls、result 和 failure state，而不能只给流利答案。",
        approach: "围绕 calculator routing、MCP-facing workflow、workflow trace isolation 和 evaluation 的本地复现与贡献工作。",
        built: "公开笔记记录了本地运行、workflow failure 和可检查 trace；ChemGraph 是 Argonne 的 framework，不是 SciencesLoop 项目。",
        evaluation: "小问题 smoke tests、可见 workflow trace、result rendering 和 state isolation 检查。",
        output: "一个用于理解 scientific-agent reliability 的实战案例：答案之外，过程也必须可审查。",
      },
      {
        title: "scifm Series",
        status: "early registry · prototype",
        problem: "Science foundation model 论文和仓库很多，但本地是否可运行、是否可复现，经常不清楚。",
        approach: "建立 registry 和 smoke-test harness，记录模型、输入、运行状态和失败原因。",
        built: "早期 `scifm-01-registry`，目标是验证哪些 science foundation models 实际可以 local-runnable。",
        evaluation: "Smoke tests 区分 didn't crash、loaded、ran、produced useful output 等状态，而不是把能启动当成成功。",
        output: "面向科学 AI builder 的可审计 model-readiness registry。",
      },
      {
        title: "Molecular-Property ML Pipeline",
        status: "public · baseline-anchored",
        problem: "用真实分子数据建立可运行的 property prediction pipeline，同时保留诚实 baseline。",
        approach: "RDKit featurization、PyTorch MLP、Random Forest baseline 和可解释的 evaluation loop。",
        built: "`scientific-foundation-model-lab` 中的 ESOL/AqSolDB solubility pipeline。",
        evaluation: "与 classical baseline 对照，记录 training behavior、failure mode 和 baseline gap。",
        output: "一个可公开展示的 molecular-property ML slice，为 Scientific Foundation Models 方向提供实证基础。",
      },
    ]
  : [
      {
        title: "RFB Formulation Agent",
        status: "prototype · private pre-v0.1",
        problem: "Screen redox-flow-battery electrolyte candidates without trusting ungrounded model output.",
        approach: "An Anthropic tool-use loop, RDKit/SMARTS chemistry filters, literature ingest/verify/extract pipeline, SQLite candidate engine, and strict provenance.",
        built: "The tool-use loop, multi-stage chemistry filter pipeline, DOI-verified retrieval, and Streamlit UI are built. Document RAG is still a stub and labeled as such.",
        evaluation: "No-hallucinated-DOI contracts, auditable evidence IDs, and a small blind query test.",
        output: "Evidence-backed candidate shortlists with `verdict → why → recommendations → caveats → evidence IDs`, ready for human scientific review.",
      },
      {
        title: "ChemGraph Workflow Contributions",
        status: "contribution notes · no ownership claim",
        problem: "A scientific agent must expose molecule, calculation, tool calls, result, and failure state, not only a fluent answer.",
        approach: "Local reproduction and contribution work around calculator routing, MCP-facing workflow, workflow-trace isolation, and evaluation.",
        built: "The public note documents local runs, workflow failures, and inspectable traces. ChemGraph is Argonne's framework, not a SciencesLoop project.",
        evaluation: "Small-question smoke tests, visible workflow traces, result rendering checks, and state-isolation checks.",
        output: "A practical reliability case: for scientific agents, the process must be reviewable as well as the answer.",
      },
      {
        title: "scifm Series",
        status: "early registry · prototype",
        problem: "Science foundation-model papers and repos are plentiful, but local runnability and reproducibility are often unclear.",
        approach: "A registry and smoke-test harness that records model, input, run state, and failure reason.",
        built: "Early `scifm-01-registry`, aimed at verifying which science foundation models are actually local-runnable.",
        evaluation: "Smoke tests distinguish did-not-crash, loaded, ran, and produced useful output instead of treating startup as success.",
        output: "An auditable model-readiness registry for scientific AI builders.",
      },
      {
        title: "Molecular-Property ML Pipeline",
        status: "public · baseline-anchored",
        problem: "Build a runnable property-prediction pipeline on real molecular data while keeping an honest baseline.",
        approach: "RDKit featurization, PyTorch MLP, Random Forest baseline, and an inspectable evaluation loop.",
        built: "The ESOL/AqSolDB solubility pipeline in `scientific-foundation-model-lab`.",
        evaluation: "Comparison with a classical baseline, with training behavior, failure mode, and baseline gap recorded.",
        output: "A public molecular-property ML slice that supports the Scientific Foundation Models program with concrete evidence.",
      },
    ];
---
<Base
  title={(isZh ? "Research Programs — " : "Research Programs — ") + "SciencesLoop"}
  description="SciencesLoop research programs: Scientific Workflow, Scientific State, Scientific Foundation Models, and Scientific Discovery."
>
  <div class="container">

    <section style="padding: 3rem 0 1rem;">
      <span class="eyebrow">SciencesLoop Research Programs</span>
      <h1>{isZh ? "四个 Scientific AI 研究方向" : "Four programs for Scientific AI"}</h1>
      <p class="lead" style="font-size: 1.1rem; color: var(--c-fg); max-width: 760px;">
        {isZh
          ? "SciencesLoop 不只是项目集合，而是一个开放研究实验室：围绕 scientific workflow、scientific state、foundation models 和 discovery systems 持续积累软件、笔记和实验。"
          : "SciencesLoop is not a project list. It is an open research lab organized around scientific workflow, scientific state, foundation models, and discovery systems."}
      </p>
    </section>

    <section class="product-modules" aria-label="SciencesLoop research programs">
      {researchPrograms.map((item) => (
        <article class="product-module" id={item.id}>
          <span>{item.label}</span>
          <h2>{item.name}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="lab-manifesto" aria-label="Research manifesto">
      <div>
        <span class="eyebrow">Research Manifesto</span>
        <h2>{isZh ? "Scientific AI 不是问答界面。" : "Scientific AI is not a Q&A interface."}</h2>
      </div>
      <div>
        <p>
          {isZh
            ? "SciencesLoop 的目标不是让 AI 直接回答科学问题，而是构建帮助科学家提出更好问题、设计更好实验、做出更好决策的科学基础设施。"
            : "SciencesLoop is not building AI to answer scientific questions. It is building scientific infrastructure that helps scientists ask better questions, design better experiments, and make better decisions."}
        </p>
      </div>
    </section>

    <section class="workflow-steps" aria-label="SciencesLoop workflow">
      {workflow.map((item) => (
        <article>
          <span>{item.step}</span>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">{isZh ? "Operating loop" : "Operating loop"}</span>
        <h2>{isZh ? "信号 → 判断 → 原型 → 公开笔记" : "Signal → judgment → prototype → field note"}</h2>
        <p>
          {isZh
            ? "SciencesLoop 把公开 AI for Science 信号映射到科学工作流问题，再用小原型和带来源的笔记检验哪些模式真的有用。"
            : "SciencesLoop maps public AI-for-Science signals to scientific workflow problems, then uses small prototypes and cited notes to test which patterns are useful."}
        </p>
      </div>
      <p>
        {isZh
          ? "公开输出是研究笔记、可检查的原型和研究地图；页面只展示可公开解释的结论和证据。"
          : "Public outputs are field notes, inspectable prototypes, and research maps; the site keeps the visible layer focused on evidence and interpretation."}
      </p>
    </section>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">{isZh ? "WIP case study" : "WIP case study"}</span>
        <h2>{isZh ? "Energy AI 原型" : "Energy AI prototype"}</h2>
        <p>
          {isZh
            ? "Energy Materials AI 是 Scientific Discovery 方向下的当前应用案例：把论文、专利、数据库、实验记录和性质模型组织成可追踪的研发决策。它仍处于原型和问题发现阶段。"
            : "Energy Materials AI is the current applied case under Scientific Discovery: turning papers, patents, databases, experiment records, and property models into traceable R&D decisions. It is still a prototype and discovery effort."}
        </p>
      </div>
      <p>
        <a class="more" href={u(isZh ? "/zh/energy-materials-ai/" : "/energy-materials-ai/")}>
          {isZh ? "查看 Energy AI 原型 →" : "View Energy AI prototype →"}
        </a>
      </p>
    </section>

    <div class="section-head" id="case-studies">
      <h2>{isZh ? "Case Studies" : "Case Studies"}</h2>
      <span class="more">{caseStudies.length}</span>
    </div>
    <section class="case-study-grid" aria-label="SciencesLoop case studies">
      {caseStudies.map((item) => (
        <article class="case-study-card">
          <div class="case-study-status">{item.status}</div>
          <h2>{item.title}</h2>
          <dl>
            <div>
              <dt>{isZh ? "Problem" : "Problem"}</dt>
              <dd>{item.problem}</dd>
            </div>
            <div>
              <dt>{isZh ? "Approach" : "Approach"}</dt>
              <dd>{item.approach}</dd>
            </div>
            <div>
              <dt>{isZh ? "What's built" : "What's built"}</dt>
              <dd>{item.built}</dd>
            </div>
            <div>
              <dt>{isZh ? "Evaluation" : "Evaluation"}</dt>
              <dd>{item.evaluation}</dd>
            </div>
            <div>
              <dt>{isZh ? "Scientist gets" : "Scientist gets"}</dt>
              <dd>{item.output}</dd>
            </div>
          </dl>
        </article>
      ))}
    </section>

    <div class="section-head">
      <h2>{isZh ? "当前 AI 系统与原型" : "Current AI systems and prototypes"}</h2>
      <span class="more">{aiProjects.length}</span>
    </div>
    <div class="featured-grid">
      {aiProjects.map((p) => {
        const linkHref = p.site ?? p.repo ?? null;
        const Outer = linkHref ? "a" : "div";
        const outerProps = linkHref
          ? { href: linkHref, target: "_blank", rel: "noopener", class: "project-card" }
          : { class: "project-card" };
        return (
          <Outer {...outerProps}>
            {p.image ? (
              <div class="cover"><img src={u(p.image)} alt={p.name} loading="lazy" /></div>
            ) : (
              <div class={`cover gradient ${p.gradient ?? "from-rust to-amber"}`}>
                <span class="glyph">{p.name}</span>
              </div>
            )}
            <div class="body">
              <div class="name">{p.name}</div>
              <div class="tagline">{p.tagline}</div>
              <div class="description">{p.description}</div>
              <div class="status">{p.status}</div>
              <div class="tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              {(p.site || p.repo) && (
                <div style="margin-top: 0.5rem; display: flex; gap: 0.6rem; font-size: 0.85rem;">
                  {p.site && <span style="color: var(--c-accent); font-weight: 500;">↗ Live site</span>}
                  {p.repo && <span style="color: var(--c-muted);">⌗ Source</span>}
                </div>
              )}
            </div>
          </Outer>
        );
      })}
    </div>

    <section class="workflow-panel">
      <div>
        <span class="eyebrow">{isZh ? "Evidence base" : "Evidence base"}</span>
        <h2>{isZh ? "科研记录仍是这个系统的基础。" : "The research record remains the foundation."}</h2>
        <p>
          {isZh
            ? "这些 program 建立在公开论文、专利、DOE/JCESR 项目和电池材料研究经验之上。AI 领先呈现，但科研证据不隐藏。"
            : "These programs build on public papers, patents, DOE/JCESR projects, and battery-materials research experience. The AI work leads, but the scientific record stays visible."}
        </p>
      </div>
      <p>
        <a class="more" href={u(isZh ? "/zh/publications/" : "/publications/")}>{isZh ? "论文 →" : "Publications →"}</a>
        {" · "}
        <a class="more" href={u(isZh ? "/zh/patents/" : "/patents/")}>{isZh ? "专利 →" : "Patents →"}</a>
        {" · "}
        <a class="more" href={u(isZh ? "/zh/projects/" : "/projects/")}>{isZh ? "科研项目 →" : "Research Projects →"}</a>
      </p>
    </section>

  </div>
</Base>
